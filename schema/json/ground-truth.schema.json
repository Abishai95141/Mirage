{
  "$defs": {
    "Endpoint": {
      "additionalProperties": false,
      "properties": {
        "asn": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asn"
        },
        "country": {
          "anyOf": [
            {
              "maxLength": 2,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "ip": {
          "anyOf": [
            {
              "format": "ipvanyaddress",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ip"
        },
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "pseudonym": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pseudonym"
        }
      },
      "title": "Endpoint",
      "type": "object"
    }
  },
  "$id": "https://mirage.invalid/schema/0.3.0/ground-truth.schema.json",
  "additionalProperties": false,
  "properties": {
    "attack_version": {
      "title": "Attack Version",
      "type": "string"
    },
    "attempts": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempts"
    },
    "dst": {
      "$ref": "#/$defs/Endpoint"
    },
    "end_ts": {
      "format": "date-time",
      "title": "End Ts",
      "type": "string"
    },
    "evidence": {
      "default": "input",
      "enum": [
        "input",
        "upload",
        "auth",
        "connect"
      ],
      "title": "Evidence",
      "type": "string"
    },
    "input_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Sha256"
    },
    "kind": {
      "const": "step",
      "default": "step",
      "title": "Kind",
      "type": "string"
    },
    "outcome": {
      "default": "unchecked",
      "enum": [
        "ok",
        "failed",
        "unchecked"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "procedure_id": {
      "title": "Procedure Id",
      "type": "string"
    },
    "protocol": {
      "title": "Protocol",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "session_ref": {
      "title": "Session Ref",
      "type": "string"
    },
    "src": {
      "$ref": "#/$defs/Endpoint"
    },
    "start_ts": {
      "format": "date-time",
      "title": "Start Ts",
      "type": "string"
    },
    "status": {
      "enum": [
        "ran",
        "failed",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "step_id": {
      "title": "Step Id",
      "type": "string"
    },
    "tactic": {
      "anyOf": [
        {
          "pattern": "^TA\\d{4}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tactic"
    },
    "technique_id": {
      "anyOf": [
        {
          "pattern": "^T\\d{4}(\\.\\d{3})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Technique Id"
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "session_ref",
    "step_id",
    "procedure_id",
    "attack_version",
    "protocol",
    "src",
    "dst",
    "start_ts",
    "end_ts",
    "status"
  ],
  "title": "GroundTruth",
  "type": "object"
}
