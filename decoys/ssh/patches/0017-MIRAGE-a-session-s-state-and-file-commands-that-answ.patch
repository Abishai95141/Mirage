+class SharedCases(unittest.TestCase):
+    """The same file is run against mirage_schema.ops in the MIRAGE
+    repository, which is the contract; this module must agree with it."""
+
+    def test_every_case_gets_its_verdict(self) -> None:
+        self.assertGreaterEqual(len(CASES), 100)
+        for case in CASES:
+            ops = expand(case["ops"])
+            with self.subTest(case["name"]):
+                if case["ok"]:
+                    self.assertEqual(len(check_shape(ops)), len(ops or []))
+                else:
+                    with self.assertRaises(Rejected):
+                        check_shape(ops)
+
+    def test_the_kinds_are_the_contracts(self) -> None:
+        named = {o["op"] for c in CASES if c["ok"] for o in (c["ops"] or [])}
+        self.assertEqual(named, set(mirage_state.KINDS))
+
