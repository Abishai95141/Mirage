+class PropertyTests(StateTestBase):
+    """Random sequences of valid operations give the same filesystem through
+    the applier as through the mutators called directly."""
+
+    NAMES = ("a", "b", "c", "d")
+
+    def sequence(
+        self, rng: random.Random, dirs: set[str], files: set[str]
+    ) -> list[dict[str, Any]]:
+        """Up to eight operations that are valid one after another, given what
+        is there (``dirs`` and ``files``, kept up to date)."""
+        ops: list[dict[str, Any]] = []
+        for _ in range(rng.randint(1, 8)):
+            kind = rng.choice(["mkdir", "write", "write", "remove", "rename", "chmod", "chown"])
+            parent = rng.choice(sorted(dirs))
+            path = f"{parent}/{rng.choice(self.NAMES)}"
+            taken = path in dirs or path in files
+            if kind == "mkdir" and not taken:
+                dirs.add(path)
+                ops.append({"op": "mkdir", "path": path, "mode": rng.choice([0o755, 0o700, 0o777])})
+            elif kind == "write" and path not in dirs:
+                op: dict[str, Any] = {"op": "write", "path": path, "content": "x" * rng.randint(0, 40)}
+                if rng.random() < 0.5:
+                    op["mode"] = rng.choice([0o644, 0o600, 0o755])
+                files.add(path)
+                ops.append(op)
+            elif kind == "remove" and files:
+                gone = rng.choice(sorted(files))
+                files.discard(gone)
+                ops.append({"op": "remove", "path": gone})
+            elif kind == "remove":
+                empty = [d for d in dirs if d != "/tmp/p" and not any(x.startswith(d + "/") for x in dirs | files)]
+                if empty:
+                    gone = rng.choice(sorted(empty))
+                    dirs.discard(gone)
+                    ops.append({"op": "remove", "path": gone})
+            elif kind == "rename" and files and path not in dirs:
+                old = rng.choice(sorted(files))
+                if old != path:
+                    files.discard(old)
+                    files.add(path)
+                    ops.append({"op": "rename", "path": old, "to": path})
+            elif kind == "chmod" and files | (dirs - {"/tmp/p"}):
+                target = rng.choice(sorted(files | (dirs - {"/tmp/p"})))
+                ops.append({"op": "chmod", "path": target, "mode": rng.choice([0o600, 0o644, 0o711, 0o4755])})
+            elif kind == "chown" and files:
+                op = {"op": "chown", "path": rng.choice(sorted(files))}
+                op.update(rng.choice([{"uid": 33}, {"gid": 33}, {"uid": 1000, "gid": 1000}]))
+                ops.append(op)
+        return ops
+
+    @staticmethod
+    def directly(fs: Any, op: dict[str, Any]) -> None:
+        kind, path = op["op"], op["path"]
+        if kind == "mkdir":
+            fs.mkdir(path, 0, 0, 4096, stat.S_IFDIR | op["mode"])
+        elif kind == "write":
+            content = op["content"].encode()
+            if fs.getfile(path, follow_symlinks=False) is None:
+                fs.mkfile(path, 0, 0, len(content), stat.S_IFREG | op.get("mode", 0o644))
+            else:
+                fs.update_size(path, len(content))
+            fs.getfile(path, follow_symlinks=False)[cfs.A_CONTENTS] = content
+        elif kind == "remove":
+            if fs.getfile(path, follow_symlinks=False)[cfs.A_TYPE] == cfs.T_DIR:
+                fs.rmdir(path)
+            else:
+                fs.remove(path)
+        elif kind == "rename":
+            fs.rename(path, op["to"])
+        elif kind == "chmod":
+            fs.chmod(path, op["mode"])
+        elif kind == "chown":
+            fs.chown(path, op.get("uid", -1), op.get("gid", -1))
+
+    def test_the_applier_and_the_mutators_agree(self) -> None:
+        rng = random.Random(20261117)
+        kinds: set[str] = set()
+        for round_ in range(150):
+            applied, direct = self.session(), self.session()
+            for proto in (applied, direct):
+                proto.fs.mkdir("/tmp/p", 0, 0, 4096, stat.S_IFDIR | 0o755)
+            dirs: set[str] = {"/tmp/p"}
+            files: set[str] = set()
+            for _ in range(rng.randint(1, 4)):  # several answers in one session
+                ops = self.sequence(rng, dirs, files)
+                kinds |= {o["op"] for o in ops}
+                apply(applied.cmdstack[0], ops, limited=False)
+                for op in ops:
+                    self.directly(direct.fs, op)
+
+            def shape(fs: Any) -> dict[str, tuple[Any, ...]]:
+                return snapshot(fs, "/tmp/p")
+
+            self.assertEqual(shape(applied.fs), shape(direct.fs), f"round {round_}")
+            a = [(e["op"], e.get("path")) for e in mirage_state.journal_of(applied).entries]
+            d = [(e["op"], e.get("path")) for e in mirage_state.journal_of(direct).entries]
+            self.assertEqual(a, d, f"round {round_}: the journals differ")
+        self.assertEqual(kinds, set(mirage_state.FILESYSTEM))
+
+    def test_a_session_s_changes_stay_its_own(self) -> None:
+        other = self.session()
+        apply(self.shell, [{"op": "write", "path": "/tmp/private", "content": "x"}])
+        apply(self.shell, [{"op": "chmod", "path": "/etc/passwd", "mode": 0o600}])
+        self.assertFalse(other.fs.exists("/tmp/private"))
+        self.assertNotEqual(
+            other.fs.getfile("/etc/passwd")[cfs.A_MODE] & 0o777,
+            self.fs.getfile("/etc/passwd")[cfs.A_MODE] & 0o777,
+        )
+
