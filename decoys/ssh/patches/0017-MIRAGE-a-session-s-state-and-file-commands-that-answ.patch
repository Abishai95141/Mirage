+++ b/src/cowrie/commands/mirage_fileutils.py
@@ -0,0 +1,1339 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE: mkdir, rmdir, chown and chgrp as GNU coreutils 9.1 on Debian 12
+# ABOUTME: runs them: their options, their wording, and the modes that stop a user.
+
+"""Four commands that change the tree, as a real Debian 12 host answers them.
+
+Stock Cowrie's ``mkdir`` took every argument as a directory to make, so that
+``mkdir -p ~/.ssh`` made one called ``-p``; its ``rmdir`` went round the
+filesystem's own mutator and so reported nothing; and it had no ``chown`` or
+``chgrp`` at all. All four are among the first things a script does on a host
+it has just entered.
+
+Each implements the options below and declines the rest (see ``Declining``).
+The wording is coreutils 9.1's in the C locale, which is what a session on
+the reference host prints.
+"""
+
+from __future__ import annotations
+
+import getopt
+import os
+import posixpath
+import stat
+from typing import Any, ClassVar
+
+from cowrie import mirage_state
+from cowrie.commands.mirage_coreutils import Declining, Users
+from cowrie.shell import fs as cfs
+
+commands = {}
+
+
+def option_error(name: str, err: getopt.GetoptError) -> str:
+    """A bad option as GNU's getopt_long words it."""
+    long_form = err.msg.startswith("option --")
+    if "requires argument" in err.msg:
+        if long_form:
+            return f"{name}: option '--{err.opt}' requires an argument\n"
+        return f"{name}: option requires an argument -- '{err.opt}'\n"
+    if "must not have an argument" in err.msg:
+        return f"{name}: option '--{err.opt}' doesn't allow an argument\n"
+    if "not a unique prefix" in err.msg:
+        return f"{name}: option '--{err.opt}' is ambiguous\n"
+    if long_form:
+        return f"{name}: unrecognized option '--{err.opt}'\n"
+    return f"{name}: invalid option -- '{err.opt}'\n"
+
+
+class _FileCommand(Declining):
+    short: ClassVar[str] = ""
+    long: ClassVar[tuple[str, ...]] = ()
+
+    @classmethod
+    def _parse(cls, args: list[str]) -> tuple[list[tuple[str, str]], list[str]]:
+        return getopt.gnu_getopt(args, cls.short, list(cls.long))
+
+    def parsed(self) -> tuple[dict[str, str], list[str]] | None:
+        """The options and operands, or None after reporting a bad option."""
+        try:
+            opts, operands = self._parse(self.args)
+        except getopt.GetoptError as err:
+            self.errorWrite(option_error(self.name, err))
+            self.errorWrite(f"Try '{self.name} --help' for more information.\n")
+            self.exit_code = 1
+            return None
+        return dict(opts), operands
+
+    def missing(self, after: str | None = None) -> None:
+        tail = f" after '{after}'" if after is not None else ""
+        self.errorWrite(f"{self.name}: missing operand{tail}\n")
+        self.errorWrite(f"Try '{self.name} --help' for more information.\n")
+        self.exit_code = 1
+
+
+def _octal(text: str) -> int | None:
+    if not text or len(text) > 4 or any(c not in "01234567" for c in text):
+        return None
+    return int(text, 8)
+
+
+# ------------------------------------------------------------------- mkdir
+
+
+class Command_mkdir(_FileCommand):
+    name = "mkdir"
+    program = "/usr/bin/mkdir"
+    short = "pvm:"
+    long = ("parents", "verbose", "mode=")
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        try:
+            opts, _ = cls._parse(args)
+        except getopt.GetoptError as err:
+            # --help, --version, -Z and --context are GNU mkdir's, and not here.
+            return err.opt in ("help", "version", "Z", "context")
+        # A symbolic mode (u=rwx,go=) is GNU mkdir's too.
+        return any(o in ("-m", "--mode") and _octal(v) is None and _symbolic(v) for o, v in opts)
+
+    def call(self) -> None:
+        if self.mirage_declines(self.args):
+            self.not_emulated()
+            return
+        got = self.parsed()
+        if got is None:
+            return
+        opts, operands = got
+        mode = 0o755
+        given = opts.get("-m", opts.get("--mode"))
+        if given is not None:
+            parsed = _octal(given)
+            if parsed is None:
+                self.errorWrite(f"mkdir: invalid mode '{given}'\n")
+                self.exit_code = 1
+                return
+            mode = parsed
+        if not operands:
+            self.missing()
+            return
+        self.parents = "-p" in opts or "--parents" in opts
+        self.verbose = "-v" in opts or "--verbose" in opts
+        self.access = mirage_state.Access(self.shell)
+        for operand in operands:
+            self.make(operand, mode)
+
+    def fail(self, shown: str, code: int) -> None:
+        self.errorWrite(f"mkdir: cannot create directory '{shown}': {os.strerror(code)}\n")
+        self.exit_code = 1
+
+    def make(self, operand: str, mode: int) -> None:
+        path = self.fs.resolve_path(operand, self.cwd)
+        if self.parents:
+            # Each missing directory above it first, shown as typed up to there.
+            pieces = [p for p in operand.split("/") if p]
+            shown = "/" if operand.startswith("/") else ""
+            for index, piece in enumerate(pieces):
+                shown += piece if shown in ("", "/") else f"/{piece}"
+                last = index == len(pieces) - 1
+                # A directory made on the way is writable by its maker whatever
+                # the umask or -m says; only the last takes the mode asked for.
+                if not self.one(shown, mode if last else 0o755, exist_ok=True):
+                    return
+            return
+        if path == "/" or self.fs.lexists(path):
+            self.fail(operand, 17)  # EEXIST
+            return
+        self.one(operand, mode, exist_ok=False)
+
+    def one(self, shown: str, mode: int, exist_ok: bool) -> bool:
+        path = self.fs.resolve_path(shown, self.cwd)
+        if path == "/" or self.fs.lexists(path):
+            if exist_ok and (path == "/" or self.fs.isdir(path)):
+                return True
+            self.fail(shown, 17)
+            return False
+        try:
+            self.access.may_create(path)
+        except mirage_state.Rejected as e:
+            self.fail(shown, e.code or 13)
+            return False
+        try:
+            self.fs.mkdir(
+                path, self.user["uid"], self.user["gid"], 4096, stat.S_IFDIR | mode
+            )
+        except OSError as e:
+            self.fail(shown, e.errno or 2)
+            return False
+        if self.verbose:
+            self.write(f"mkdir: created directory '{shown}'\n")
+        return True
+
+
+def _symbolic(text: str) -> bool:
+    return bool(text) and all(c in "ugoarwxXst+-=," for c in text)
+
+
+# ------------------------------------------------------------------- rmdir
+
+
+class Command_rmdir(_FileCommand):
+    name = "rmdir"
+    program = "/usr/bin/rmdir"
+    short = "pv"
+    long = ("parents", "verbose", "ignore-fail-on-non-empty")
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        try:
+            cls._parse(args)
+        except getopt.GetoptError as err:
+            return err.opt in ("help", "version")
+        return False
+
+    def call(self) -> None:
+        if self.mirage_declines(self.args):
+            self.not_emulated()
+            return
+        got = self.parsed()
+        if got is None:
+            return
+        opts, operands = got
+        if not operands:
+            self.missing()
+            return
+        parents = "-p" in opts or "--parents" in opts
+        self.verbose = "-v" in opts or "--verbose" in opts
+        self.quiet_full = "--ignore-fail-on-non-empty" in opts
+        self.access = mirage_state.Access(self.shell)
+        for operand in operands:
+            if not self.remove(operand, "failed to remove") or not parents:
+                continue
+            shown = operand.rstrip("/")
+            while "/" in shown:
+                shown = shown.rsplit("/", 1)[0]
+                if not shown or not self.remove(shown, "failed to remove directory"):
+                    break
+
+    def remove(self, shown: str, words: str) -> bool:
+        path = self.fs.resolve_path(shown, self.cwd)
+        code = 0
+        node = self.fs.getfile(path, follow_symlinks=False) if path != "/" else None
+        if path == "/":
+            code = 16  # EBUSY
+        elif node is None:
+            code = 2
+        elif node[cfs.A_TYPE] != cfs.T_DIR:
+            code = 20  # ENOTDIR
+        elif node[cfs.A_CONTENTS]:
+            code = 39  # ENOTEMPTY
+        else:
+            try:
+                self.access.may_unlink(path)
+            except mirage_state.Rejected as e:
+                code = e.code or 13
+        if self.verbose:
+            self.write(f"rmdir: removing directory, '{shown}'\n")
+        if code:
+            if not (code == 39 and self.quiet_full):
+                self.errorWrite(f"rmdir: {words} '{shown}': {os.strerror(code)}\n")
+                self.exit_code = 1
+            return False
+        self.fs.rmdir(path)
+        return True
+
+
+# ------------------------------------------------------------------- chown, chgrp
+
+
+class Command_chown(_FileCommand):
+    name = "chown"
+    program = "/usr/bin/chown"
+    short = "Rvcfh"
+    long = ("recursive", "verbose", "changes", "silent", "quiet", "no-dereference")
+    group_only: ClassVar[bool] = False
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        try:
+            cls._parse(args)
+        except getopt.GetoptError as err:
+            return err.opt in (
+                "help", "version", "reference", "from", "dereference",
+                "preserve-root", "no-preserve-root", "H", "L", "P",
+            )  # fmt: skip
+        return False
+
+    def call(self) -> None:
+        if self.mirage_declines(self.args):
+            self.not_emulated()
+            return
+        got = self.parsed()
+        if got is None:
+            return
+        opts, operands = got
+        if not operands:
+            self.missing()
+            return
+        if len(operands) == 1:
+            self.missing(operands[0])
+            return
+        spec, files = operands[0], operands[1:]
+        self.users = Users()
+        wanted = self.owner(spec)
+        if wanted is None:
+            self.exit_code = 1
+            return
+        self.recursive = "-R" in opts or "--recursive" in opts
+        self.verbose = "-v" in opts or "--verbose" in opts
+        self.changes = "-c" in opts or "--changes" in opts
+        self.silent = bool({"-f", "--silent", "--quiet"} & set(opts))
+        for operand in files:
+            path = self.fs.resolve_path(operand, self.cwd)
+            if not self.fs.lexists(path):
+                if not self.silent:
+                    self.errorWrite(
+                        f"{self.name}: cannot access '{operand}': No such file or directory\n"
+                    )
+                self.exit_code = 1
+                continue
+            self.change(operand, path, wanted)
+
+    def owner(self, spec: str) -> tuple[int, int] | None:
+        """(uid, gid) from OWNER[:GROUP], -1 for a side left as it is."""
+        if self.group_only:
+            gid = self.group_id(spec)
+            if gid is None:
+                self.errorWrite(f"{self.name}: invalid group: '{spec}'\n")
+                return None
+            self.named = (False, True)
+            return -1, gid
+        sep = ":" if ":" in spec else ("." if "." in spec and self.user_id(spec) is None else "")
+        user, group = spec.split(sep, 1) if sep else (spec, "")
+        if sep == ".":
+            self.errorWrite(f"{self.name}: warning: '.' should be ':': '{spec}'\n")
+        # What the change is told as: a user named, a group named or implied.
+        self.named = (bool(user), bool(group) or bool(sep and user))
+        uid = gid = -1
+        if user:
+            found = self.user_id(user)
+            if found is None:
+                self.errorWrite(f"{self.name}: invalid user: '{spec}'\n")
+                return None
+            uid = found
+        if group:
+            found = self.group_id(group)
+            if found is None:
+                self.errorWrite(f"{self.name}: invalid group: '{spec}'\n")
+                return None
+            gid = found
+        elif sep and user:
+            # "owner:" gives the file the owner's own login group.
+            entry = self.users.entry(user)
+            gid = int(entry["pw_gid"]) if entry else -1
+        if not user and not group:
+            return -1, -1
+        return uid, gid
+
+    def user_id(self, text: str) -> int | None:
+        entry = self.users.entry(text)
+        if entry is not None:
+            return int(entry["pw_uid"])
+        return int(text) if text.isdigit() and int(text) < 2**32 - 1 else None
+
+    def group_id(self, text: str) -> int | None:
+        for entry in self.users.group:
+            if entry["gr_name"] == text:
+                return int(entry["gr_gid"])
+        return int(text) if text.isdigit() and int(text) < 2**32 - 1 else None
+
+    def spec(self, uid: int, gid: int) -> str:
+        """An owner as chown -v writes one: the user if a user was named, the
+        group if a group was, and a lone group with its colon (":daemon")."""
+        user, group = self.users.name(uid), self.users.group_name(gid)
+        if self.group_only:
+            return group
+        if self.named[0] and self.named[1]:
+            return f"{user}:{group}"
+        return user if self.named[0] else f":{group}"
+
+    def before(self, uid: int, gid: int) -> str:
+        user, group = self.users.name(uid), self.users.group_name(gid)
+        if self.group_only:
+            return group
+        # "chown :group" is told as a change of ownership, from both.
+        return user if self.named[0] and not self.named[1] else f"{user}:{group}"
+
+    def change(self, shown: str, path: str, wanted: tuple[int, int]) -> None:
+        node = self.fs.getfile(path)
+        if node is None:  # a link to nothing
+            if not self.silent:
+                self.errorWrite(
+                    f"{self.name}: cannot dereference '{shown}': No such file or directory\n"
+                )
+            self.exit_code = 1
+            return
+        # A directory's entries first, then the directory, as chown -R goes.
+        if self.recursive and node[cfs.A_TYPE] == cfs.T_DIR:
+            for name in sorted(x[cfs.A_NAME] for x in node[cfs.A_CONTENTS]):
+                self.change(posixpath.join(shown, name), posixpath.join(path, name), wanted)
+        had = (int(node[cfs.A_UID]), int(node[cfs.A_GID]))
+        uid = had[0] if wanted[0] == -1 else wanted[0]
+        gid = had[1] if wanted[1] == -1 else wanted[1]
+        what = "group" if self.group_only else "ownership"
+        if (uid, gid) != had and not self.allowed(had, uid, gid):
+            if not self.silent:
+                self.errorWrite(
+                    f"{self.name}: changing {what} of '{shown}': Operation not permitted\n"
+                )
+            if self.verbose:
+                self.write(
+                    f"failed to change {what} of '{shown}' from {self.before(*had)} "
+                    f"to {self.spec(uid, gid)}\n"
+                )
+            self.exit_code = 1
+        elif (uid, gid) != had:
+            self.fs.chown(path, uid, gid)
+            if self.verbose or self.changes:
+                self.write(
+                    f"changed {what} of '{shown}' from {self.before(*had)} "
+                    f"to {self.spec(uid, gid)}\n"
+                )
+        elif self.verbose:
+            self.write(f"{what} of '{shown}' retained as {self.spec(*had)}\n")
+
+    def allowed(self, had: tuple[int, int], uid: int, gid: int) -> bool:
+        """Root may give a file to anyone. Anyone else may only move a file of
+        their own to another of their own groups."""
+        me = int(self.user["uid"])
+        if me == 0:
+            return True
+        if had[0] != me or uid != me:
+            return False
+        mine: list[Any] = self.users.groups_of(str(self.user["username"]), int(self.user["gid"]))
+        return gid in mine
+
+
+class Command_chgrp(Command_chown):
+    name = "chgrp"
+    program = "/usr/bin/chgrp"
+    group_only = True
+
+
+for _name, _class in (
+    ("mkdir", Command_mkdir),
+    ("rmdir", Command_rmdir),
+    ("chown", Command_chown),
+    ("chgrp", Command_chgrp),
+):
+    commands[_name] = _class
+    commands[f"/bin/{_name}"] = _class
+    commands[f"/usr/bin/{_name}"] = _class
+
+
+# ------------------------------------------------------------------- shared by the rest
+
+
+def _base(operand: str) -> str:
+    return posixpath.basename(operand.rstrip("/")) or "/"
+
+
+def _perm(node: Any) -> int:
+    return int(node[cfs.A_MODE]) & 0o7777
+
+
+def _mode_string(mode: int) -> str:
+    """rwxr-xr-x, with s, S, t and T where the special bits are set."""
+    out = []
+    for shift, special, letter in ((6, 0o4000, "s"), (3, 0o2000, "s"), (0, 0o1000, "t")):
+        bits = (mode >> shift) & 7
+        execute = "x" if bits & 1 else "-"
+        if mode & special:
+            execute = letter if bits & 1 else letter.upper()
+        out.append(("r" if bits & 4 else "-") + ("w" if bits & 2 else "-") + execute)
+    return "".join(out)
+
+
+class _TreeCommand(_FileCommand):
+    """What cp, mv, rm, touch and ln share: operands, a target directory, and
+    the checks of who may do what."""
+
+    declined: ClassVar[tuple[str, ...]] = ("help", "version")
+    interactive: ClassVar[tuple[str, ...]] = ()
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        try:
+            opts, _ = cls._parse(args)
+        except getopt.GetoptError as err:
+            return err.opt in cls.declined
+        # An option that asks a question, or one of GNU's this does not do.
+        return any(o in cls.interactive for o, _ in opts)
+
+    def fail(self, text: str) -> None:
+        self.errorWrite(f"{self.name}: {text}\n")
+        self.exit_code = 1
+
+    def resolved(self, operand: str) -> str:
+        return str(self.fs.resolve_path(operand, self.cwd))
+
+    def node(self, path: str, follow: bool = True) -> Any:
+        if not path:
+            return None
+        return self.fs.getfile(path, follow_symlinks=follow)
+
+    def is_dir(self, operand: str, follow: bool = True) -> bool:
+        node = self.node(self.resolved(operand), follow) if operand else None
+        return node is not None and node[cfs.A_TYPE] == cfs.T_DIR
+
+    def setup(self) -> tuple[dict[str, str], list[str]] | None:
+        if self.mirage_declines(self.args):
+            self.not_emulated()
+            return None
+        got = self.parsed()
+        if got is None:
+            return None
+        self.access = mirage_state.Access(self.shell)
+        return got
+
+    def destination(
+        self, opts: dict[str, str], operands: list[str]
+    ) -> tuple[list[str], str, bool] | None:
+        """(sources, destination, whether each goes into it), as cp, mv and ln
+        read their operands; None after reporting what is missing."""
+        into_dir = opts.get("-t", opts.get("--target-directory"))
+        if into_dir is not None:
+            if not operands:
+                self.missing_file()
+                return None
+            if not self.is_dir(into_dir):
+                code = 20 if self.node(self.resolved(into_dir)) is not None else 2
+                self.fail(f"target directory '{into_dir}': {os.strerror(code)}")
+                return None
+            return operands, into_dir, True
+        if not operands:
+            self.missing_file()
+            return None
+        if len(operands) == 1:
+            self.errorWrite(
+                f"{self.name}: missing destination file operand after '{operands[0]}'\n"
+                f"Try '{self.name} --help' for more information.\n"
+            )
+            self.exit_code = 1
+            return None
+        sources, dest = operands[:-1], operands[-1]
+        no_target = "-T" in opts or "--no-target-directory" in opts
+        if not no_target and self.is_dir(dest):
+            return sources, dest, True
+        if len(sources) > 1:
+            code = 20 if self.node(self.resolved(dest)) is not None else 2
+            self.fail(f"target '{dest}': {os.strerror(code)}")
+            return None
+        return sources, dest, False
+
+    def missing_file(self) -> None:
+        self.errorWrite(
+            f"{self.name}: missing file operand\nTry '{self.name} --help' for more information.\n"
+        )
+        self.exit_code = 1
+
+    def code_of(self, check: Any, *args: Any) -> int:
+        """The error number a check gives, or 0 if it passes."""
+        try:
+            check(*args)
+        except mirage_state.Rejected as e:
+            return e.code or 13
+        return 0
+
+
+# ------------------------------------------------------------------- cp
+
+
+class Command_cp(_TreeCommand):
+    name = "cp"
+    program = "/usr/bin/cp"
+    short = "adfHLnPpRrTt:uvx"
+    long = (
+        "archive", "force", "recursive", "no-clobber", "preserve", "update", "verbose",
+        "target-directory=", "no-target-directory", "no-dereference", "dereference",
+        "one-file-system",
+    )  # fmt: skip
+    declined = (
+        "help", "version", "i", "interactive", "l", "link", "s", "symbolic-link", "b",
+        "backup", "parents", "attributes-only", "sparse", "reflink", "S", "suffix",
+        "strip-trailing-slashes", "remove-destination", "copy-contents", "Z", "context",
+        "debug", "no-preserve",
+    )  # fmt: skip
+
+    def call(self) -> None:
+        got = self.setup()
+        if got is None:
+            return
+        opts, operands = got
+        placed = self.destination(opts, operands)
+        if placed is None:
+            return
+        sources, dest, into = placed
+        has = lambda *names: any(n in opts for n in names)  # noqa: E731
+        self.recursive = has("-r", "-R", "-a", "--recursive", "--archive")
+        self.preserve = has("-p", "-a", "--preserve", "--archive")
+        self.verbose = has("-v", "--verbose")
+        self.no_clobber = has("-n", "--no-clobber")
+        self.update = has("-u", "--update")
+        # A link named on the command line is followed; one met inside a tree
+        # being copied is copied as a link, unless -L says otherwise.
+        self.keep_links = has("-P", "-d", "-a", "--no-dereference", "--archive")
+        self.follow_all = has("-L", "--dereference")
+        for src in sources:
+            target = posixpath.join(dest, _base(src)) if into else dest
+            self.copy(src, target, top=True)
+
+    def copy(self, shown: str, target: str, top: bool = False) -> None:
+        path, to = self.resolved(shown) if shown else "", self.resolved(target)
+        follow = self.follow_all or (top and not self.keep_links)
+        node = self.node(path, follow)
+        if node is None:
+            self.fail(f"cannot stat '{shown}': No such file or directory")
+            return
+        there = self.node(to, False)
+        if node[cfs.A_TYPE] == cfs.T_DIR:
+            self.copy_dir(shown, target, path, to, node, there)
+            return
+        if to == path:
+            self.fail(f"'{shown}' and '{target}' are the same file")
+            return
+        if target.endswith("/") and (there is None or there[cfs.A_TYPE] != cfs.T_DIR):
+            if there is not None:
+                self.fail(f"cannot stat '{target}': Not a directory")
+            else:
+                self.fail(f"cannot create regular file '{target}': Not a directory")
+            return
+        if there is not None and there[cfs.A_TYPE] == cfs.T_DIR:
+            self.fail(f"cannot overwrite directory '{target}' with non-directory")
+            return
+        if there is not None and (
+            self.no_clobber or (self.update and there[cfs.A_CTIME] >= node[cfs.A_CTIME])
+        ):
+            return
+        if node[cfs.A_TYPE] == cfs.T_LINK:
+            if there is not None:
+                self.fs.remove(to)
+            code = self.code_of(self.access.may_create, to)
+            if code:
+                self.fail(f"cannot create symbolic link '{target}': {os.strerror(code)}")
+                return
+            self.fs.symlink(str(node[cfs.A_TARGET]), to, self.user["uid"], self.user["gid"])
+        else:
+            if self.code_of(self.access.may_read, path):
+                self.fail(f"cannot open '{shown}' for reading: Permission denied")
+                return
+            code = self.code_of(self.access.may_write, to)
+            if code:
+                self.fail(f"cannot create regular file '{target}': {os.strerror(code)}")
+                return
+            self.copy_file(node, to, there)
+        if self.verbose:
+            self.write(f"'{shown}' -> '{target}'\n")
+
+    def copy_file(self, node: Any, to: str, there: Any) -> None:
+        size = int(node[cfs.A_SIZE])
+        if there is None:
+            # A new file is the copier's, with the source's mode less the umask.
+            mode = _perm(node) if self.preserve else _perm(node) & 0o777 & ~0o022
+            self.fs.mkfile(to, self.user["uid"], self.user["gid"], size, stat.S_IFREG | mode)
+        else:
+            self.fs.update_size(to, size)  # a file that was there keeps its mode and owner
+        made = self.fs.getfile(to)
+        made[cfs.A_CONTENTS] = node[cfs.A_CONTENTS] if node[cfs.A_TYPE] == cfs.T_FILE else []
+        made[cfs.A_REALFILE] = node[cfs.A_REALFILE]
+        made[cfs.A_SIZE] = size
+        if self.preserve:
+            made[cfs.A_CTIME] = node[cfs.A_CTIME]
+            if there is None and int(self.user["uid"]) == 0:
+                made[cfs.A_UID], made[cfs.A_GID] = node[cfs.A_UID], node[cfs.A_GID]
+
+    def copy_dir(self, shown: str, target: str, path: str, to: str, node: Any, there: Any) -> None:
+        if not self.recursive:
+            self.fail(f"-r not specified; omitting directory '{shown}'")
+            return
+        if to == path or to.startswith(path.rstrip("/") + "/"):
+            self.fail(f"cannot copy a directory, '{shown}', into itself, '{target}'")
+            return
+        if there is not None and self.node(to)[cfs.A_TYPE] != cfs.T_DIR:
+            self.fail(f"cannot overwrite non-directory '{target}' with directory '{shown}'")
+            return
+        names = [x[cfs.A_NAME] for x in node[cfs.A_CONTENTS]]
+        if there is None:
+            code = self.code_of(self.access.may_create, to)
+            if code:
+                self.fail(f"cannot create directory '{target}': {os.strerror(code)}")
+                return
+            mode = _perm(node) if self.preserve else _perm(node) & 0o777 & ~0o022
+            self.fs.mkdir(to, self.user["uid"], self.user["gid"], 4096, stat.S_IFDIR | mode)
+            if self.preserve and int(self.user["uid"]) == 0:
+                made = self.fs.getfile(to)
+                made[cfs.A_UID], made[cfs.A_GID] = node[cfs.A_UID], node[cfs.A_GID]
+            if self.verbose:
+                self.write(f"'{shown}' -> '{target}'\n")
+        for name in names:
+            self.copy(posixpath.join(shown, name), posixpath.join(target, name))
+
+
+# ------------------------------------------------------------------- mv
+
+
+class Command_mv(_TreeCommand):
+    name = "mv"
+    program = "/usr/bin/mv"
+    short = "fnTt:uv"
+    long = (
+        "force", "no-clobber", "update", "verbose", "target-directory=", "no-target-directory",
+    )  # fmt: skip
+    declined = (
+        "help", "version", "i", "interactive", "b", "backup", "S", "suffix",
+        "strip-trailing-slashes", "Z", "context", "debug", "exchange", "no-copy",
+    )  # fmt: skip
+
+    def call(self) -> None:
+        got = self.setup()
+        if got is None:
+            return
+        opts, operands = got
+        placed = self.destination(opts, operands)
+        if placed is None:
+            return
+        sources, dest, into = placed
+        self.verbose = "-v" in opts or "--verbose" in opts
+        self.no_clobber = "-n" in opts or "--no-clobber" in opts
+        self.update = "-u" in opts or "--update" in opts
+        for src in sources:
+            self.move(src, posixpath.join(dest, _base(src)) if into else dest)
+
+    def move(self, shown: str, target: str) -> None:
+        path, to = self.resolved(shown) if shown else "", self.resolved(target)
+        node = self.node(path, False)
+        if node is None:
+            self.fail(f"cannot stat '{shown}': No such file or directory")
+            return
+        is_dir = node[cfs.A_TYPE] == cfs.T_DIR
+        if to == path:
+            self.fail(f"'{shown}' and '{target}' are the same file")
+            return
+        if is_dir and to.startswith(path.rstrip("/") + "/"):
+            self.fail(f"cannot move '{shown}' to a subdirectory of itself, '{target}'")
+            return
+        there = self.node(to, False)
+        if there is not None:
+            there_dir = there[cfs.A_TYPE] == cfs.T_DIR
+            if there_dir and not is_dir:
+                self.fail(f"cannot overwrite directory '{target}' with non-directory")
+                return
+            if is_dir and not there_dir:
+                self.fail(f"cannot overwrite non-directory '{target}' with directory '{shown}'")
+                return
+            if there_dir and there[cfs.A_CONTENTS]:
+                self.fail(f"cannot move '{shown}' to '{target}': Directory not empty")
+                return
+            if self.no_clobber or (self.update and there[cfs.A_CTIME] >= node[cfs.A_CTIME]):
+                return
+        code = self.code_of(self.access.may_create, to) or self.code_of(
+            self.access.may_unlink, path
+        )
+        if code:
+            self.fail(f"cannot move '{shown}' to '{target}': {os.strerror(code)}")
+            return
+        if there is not None and there[cfs.A_TYPE] == cfs.T_DIR:
+            self.fs.rmdir(to)
+        self.fs.rename(path, to)
+        if self.verbose:
+            self.write(f"renamed '{shown}' -> '{target}'\n")
+
+
+# ------------------------------------------------------------------- rm
+
+
+class Command_rm(_TreeCommand):
+    name = "rm"
+    program = "/usr/bin/rm"
+    short = "dfrRv"
+    long = ("dir", "force", "recursive", "verbose", "one-file-system", "preserve-root")
+    declined = ("help", "version", "I", "interactive", "no-preserve-root")
+    short_with_prompt: ClassVar[str] = "dfirRv"
+
+    @classmethod
+    def _parse(cls, args: list[str]) -> tuple[list[tuple[str, str]], list[str]]:
+        return getopt.gnu_getopt(args, cls.short_with_prompt, list(cls.long))
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        try:
+            opts, operands = cls._parse(args)
+        except getopt.GetoptError as err:
+            return err.opt in cls.declined
+        # -i asks before each removal; with nothing to remove it asks nothing.
+        return bool(operands) and any(o == "-i" for o, _ in opts)
+
+    def call(self) -> None:
+        got = self.setup()
+        if got is None:
+            return
+        opts, operands = got
+        self.force = "-f" in opts or "--force" in opts
+        self.recursive = bool({"-r", "-R", "--recursive"} & set(opts))
+        self.empty_dirs = "-d" in opts or "--dir" in opts
+        self.verbose = "-v" in opts or "--verbose" in opts
+        if not operands:
+            if not self.force:
+                self.missing()
+            return
+        for operand in operands:
+            self.remove(operand, top=True)
+
+    def remove(self, shown: str, top: bool = False) -> bool:
+        if top and _base(shown) in (".", "..") and self.recursive:
+            self.fail(f"refusing to remove '.' or '..' directory: skipping '{shown}'")
+            return False
+        path = self.resolved(shown) if shown else ""
+        node = self.node(path, False)
+        if node is None:
+            if not self.force:
+                self.fail(f"cannot remove '{shown}': No such file or directory")
+            return False
+        if node[cfs.A_TYPE] != cfs.T_DIR:
+            code = self.code_of(self.access.may_unlink, path)
+            if code:
+                self.fail(f"cannot remove '{shown}': {os.strerror(code)}")
+                return False
+            self.fs.remove(path)
+            if self.verbose:
+                self.write(f"removed '{shown}'\n")
+            return True
+        if path == "/" and self.recursive:
+            self.errorWrite(
+                "rm: it is dangerous to operate recursively on '/'\n"
+                "rm: use --no-preserve-root to override this failsafe\n"
+            )
+            self.exit_code = 1
+            return False
+        if not self.recursive:
+            if not self.empty_dirs or path == "/":
+                self.fail(f"cannot remove '{shown}': Is a directory")
+                return False
+            if node[cfs.A_CONTENTS]:
+                self.fail(f"cannot remove '{shown}': Directory not empty")
+                return False
+        else:
+            seen = self.access.at(path)
+            if node[cfs.A_CONTENTS] and not (self.access.may(seen, 4) and self.access.may(seen, 2)):
+                self.fail(f"cannot remove '{shown}': Permission denied")
+                return False
+            emptied = True
+            for name in [x[cfs.A_NAME] for x in node[cfs.A_CONTENTS]]:
+                emptied = self.remove(posixpath.join(shown, name)) and emptied
+            if not emptied:
+                return False
+        code = self.code_of(self.access.may_unlink, path)
+        if code:
+            self.fail(f"cannot remove '{shown}': {os.strerror(code)}")
+            return False
+        self.fs.rmdir(path)
+        if self.verbose:
+            self.write(f"removed directory '{shown}'\n")
+        return True
+
+
+# ------------------------------------------------------------------- touch
+
+
+def _when(text: str, now: float) -> float | None:
+    """The time a ``touch -d`` string means, for the forms understood here."""
+    import datetime as dt
+
+    text = text.strip()
+    if text in ("now", ""):
+        return now
+    if text in ("yesterday", "tomorrow"):
+        return now + (86400 if text == "tomorrow" else -86400)
+    if text.startswith("@") and text[1:].isdigit():
+        return float(text[1:])
+    words = text.split()
+    if len(words) == 3 and words[0].isdigit() and words[2] == "ago":
+        unit = {"second": 1, "minute": 60, "hour": 3600, "day": 86400, "week": 604800}.get(
+            words[1].rstrip("s")
+        )
+        return now - int(words[0]) * unit if unit else None
+    try:
+        parsed = dt.datetime.fromisoformat(text)
+    except ValueError:
+        return None
+    if parsed.tzinfo is None:
+        parsed = parsed.replace(tzinfo=dt.UTC)
+    return parsed.timestamp()
+
+
+def _stamp(text: str) -> float | None:
+    """``touch -t``: [[CC]YY]MMDDhhmm[.ss]."""
+    import datetime as dt
+
+    main, _, seconds = text.partition(".")
+    if not main.isdigit() or len(main) not in (8, 10, 12) or (seconds and len(seconds) != 2):
+        return None
+    year = dt.datetime.now(dt.UTC).year
+    if len(main) == 12:
+        year, main = int(main[:4]), main[4:]
+    elif len(main) == 10:
+        yy, main = int(main[:2]), main[2:]
+        year = (1900 if yy >= 69 else 2000) + yy
+    try:
+        parsed = dt.datetime(
+            year, int(main[:2]), int(main[2:4]), int(main[4:6]), int(main[6:8]),
+            int(seconds or 0), tzinfo=dt.UTC,
+        )  # fmt: skip
+    except ValueError:
+        return None
+    return parsed.timestamp()
+
+
+class Command_touch(_TreeCommand):
+    name = "touch"
+    program = "/usr/bin/touch"
+    short = "acd:fhmr:t:"
+    long = ("no-create", "date=", "no-dereference", "reference=", "time=")
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        import time as _time
+
+        try:
+            opts, _ = cls._parse(args)
+        except getopt.GetoptError as err:
+            return err.opt in cls.declined
+        # A date written some way this does not read is GNU's to parse.
+        return any(o in ("-d", "--date") and _when(v, _time.time()) is None for o, v in opts)
+
+    def call(self) -> None:
+        import time as _time
+
+        got = self.setup()
+        if got is None:
+            return
+        opts, operands = got
+        when = _time.time()
+        if "-t" in opts:
+            stamp = _stamp(opts["-t"])
+            if stamp is None:
+                self.fail(f"invalid date format '{opts['-t']}'")
+                return
+            when = stamp
+        given = opts.get("-d", opts.get("--date"))
+        if given is not None:
+            when = _when(given, when) or when
+        reference = opts.get("-r", opts.get("--reference"))
+        if reference is not None:
+            node = self.node(self.resolved(reference))
+            if node is None:
+                self.fail(f"failed to get attributes of '{reference}': No such file or directory")
+                return
+            when = float(node[cfs.A_CTIME])
+        if not operands:
+            self.missing_file()
+            return
+        for operand in operands:
+            path = self.resolved(operand) if operand else ""
+            node = self.node(path)
+            if node is not None:
+                seen = self.access.at(path, follow=True)
+                if int(self.user["uid"]) not in (0, seen.uid) and not self.access.may(seen, 2):
+                    self.fail(f"cannot touch '{operand}': Permission denied")
+                    continue
+                self.fs.utime(path, when, when)
+                continue
+            if "-c" in opts or "--no-create" in opts:
+                continue
+            code = 2 if not path else self.code_of(self.access.may_write, path)
+            if code:
+                self.fail(f"cannot touch '{operand}': {os.strerror(code)}")
+                continue
+            self.fs.mkfile(path, self.user["uid"], self.user["gid"], 0, stat.S_IFREG | 0o644)
+            self.fs.getfile(path)[cfs.A_CTIME] = when
+
+
+# ------------------------------------------------------------------- ln
+
+
+class Command_ln(_TreeCommand):
+    name = "ln"
+    program = "/usr/bin/ln"
+    short = "sfnvTrt:LP"
+    long = (
+        "symbolic", "force", "no-dereference", "verbose", "no-target-directory", "relative",
+        "target-directory=", "logical", "physical",
+    )  # fmt: skip
+    declined = ("help", "version", "b", "backup", "i", "interactive", "S", "suffix", "d", "F")
+
+    def call(self) -> None:
+        got = self.setup()
+        if got is None:
+            return
+        opts, operands = got
+        has = lambda *names: any(n in opts for n in names)  # noqa: E731
+        self.symbolic = has("-s", "--symbolic")
+        self.force = has("-f", "--force")
+        self.verbose = has("-v", "--verbose")
+        self.relative = has("-r", "--relative")
+        if not operands:
+            self.missing_file()
+            return
+        into_dir = opts.get("-t", opts.get("--target-directory"))
+        if into_dir is None and len(operands) == 1:
+            self.link(operands[0], _base(operands[0]))  # a link of the same name, here
+            return
+        if into_dir is not None:
+            targets, dest, into = operands, into_dir, True
+            if not self.is_dir(into_dir):
+                code = 20 if self.node(self.resolved(into_dir)) is not None else 2
+                self.fail(f"target directory '{into_dir}': {os.strerror(code)}")
+                return
+        else:
+            targets, dest = operands[:-1], operands[-1]
+            # With -n, a destination that is a link to a directory is the link.
+            follow = not has("-n", "--no-dereference")
+            into = not has("-T", "--no-target-directory") and self.is_dir(dest, follow)
+            if not into and len(targets) > 1:
+                code = 20 if self.node(self.resolved(dest)) is not None else 2
+                self.fail(f"target '{dest}': {os.strerror(code)}")
+                return
+        for target in targets:
+            self.link(target, posixpath.join(dest, _base(target)) if into else dest)
+
+    def link(self, target: str, shown: str) -> None:
+        to = self.resolved(shown)
+        kind = "symbolic" if self.symbolic else "hard"
+        if not self.symbolic:
+            source = self.resolved(target) if target else ""
+            node = self.node(source, False)
+            if node is None:
+                self.fail(f"failed to access '{target}': No such file or directory")
+                return
+            if node[cfs.A_TYPE] == cfs.T_DIR:
+                self.fail(f"{target}: hard link not allowed for directory")
+                return
+        elif not target:
+            self.fail(f"failed to create symbolic link '{shown}' -> '': No such file or directory")
+            return
+        there = self.node(to, False)
+        if there is not None:
+            if not self.force:
+                self.fail(f"failed to create {kind} link '{shown}': File exists")
+                return
+            if there[cfs.A_TYPE] == cfs.T_DIR:
+                self.fail(f"'{shown}': cannot overwrite directory")
+                return
+            code = self.code_of(self.access.may_unlink, to)
+            if code:
+                self.fail(f"cannot remove '{shown}': {os.strerror(code)}")
+                return
+            self.fs.remove(to)
+        code = self.code_of(self.access.may_create, to)
+        if code:
+            self.fail(f"failed to create {kind} link '{shown}': {os.strerror(code)}")
+            return
+        if self.symbolic:
+            text = target
+            if self.relative:
+                text = posixpath.relpath(self.resolved(target), posixpath.dirname(to))
+            self.fs.symlink(text, to, self.user["uid"], self.user["gid"])
+            if self.verbose:
+                self.write(f"'{shown}' -> '{text}'\n")
+        else:
+            self.fs.hardlink(source, to)
+            if self.verbose:
+                self.write(f"'{shown}' => '{target}'\n")
+
+
+# ------------------------------------------------------------------- chmod
+
+
+def _apply_symbolic(text: str, mode: int, is_dir: bool, umask: int = 0o022) -> int | None:
+    """``mode`` after a symbolic change such as ``u+x,go-r``, or None if the
+    text is not one. With no who given the change is for everyone, less the
+    bits the umask holds back."""
+    for clause in text.split(","):
+        i = 0
+        who = ""
+        while i < len(clause) and clause[i] in "ugoa":
+            who += clause[i]
+            i += 1
+        if i >= len(clause) or clause[i] not in "+-=":
+            return None
+        affected = 0
+        for letter in who.replace("a", "ugo") or "ugo":
+            affected |= {"u": 0o4700, "g": 0o2070, "o": 0o1007}[letter]
+        while i < len(clause) and clause[i] in "+-=":
+            op = clause[i]
+            i += 1
+            perms = ""
+            while i < len(clause) and clause[i] not in "+-=":
+                perms += clause[i]
+                i += 1
+            numeric = False
+            if perms in ("u", "g", "o"):
+                copied = (mode >> {"u": 6, "g": 3, "o": 0}[perms]) & 7
+                bits = (copied << 6 | copied << 3 | copied) & affected
+            elif perms and not who and all(c in "01234567" for c in perms) and len(perms) <= 4:
+                # An operator with a number (+111, -7, =600): those bits, as given.
+                bits, numeric = int(perms, 8), True
+            else:
+                if any(c not in "rwxXst" for c in perms):
+                    return None
+                bits = 0
+                for c in perms:
+                    if c == "r":
+                        bits |= 0o444
+                    elif c == "w":
+                        bits |= 0o222
+                    elif c == "x" or (c == "X" and (is_dir or mode & 0o111)):
+                        bits |= 0o111
+                    elif c == "s":
+                        bits |= 0o6000
+                    elif c == "t":
+                        bits |= 0o1000
+                bits &= affected
+                if not who:
+                    bits &= ~umask | 0o7000
+            if op == "+":
+                mode |= bits
+            elif op == "-":
+                mode &= ~bits
+            elif numeric:
+                mode = bits | (mode & 0o6000 if is_dir else 0)
+                continue
+            else:
+                keep = ~affected & 0o7777
+                if not who:
+                    keep = umask & 0o777  # "=r" sets everyone's, but for the umask's bits
+                if is_dir:
+                    keep |= mode & 0o6000  # a directory keeps its set-ID bits
+                mode = (mode & keep) | bits
+    return mode & 0o7777
+
+
+class Command_chmod(_TreeCommand):
+    name = "chmod"
+    program = "/usr/bin/chmod"
+    short = "Rvcf"
+    long = ("recursive", "verbose", "changes", "silent", "quiet", "reference=")
+    declined = ("preserve-root", "no-preserve-root")
+    long_with_help: ClassVar[tuple[str, ...]] = (*long, "help", "version")
+
+    @classmethod
+    def _parse(cls, args: list[str]) -> tuple[list[tuple[str, str]], list[str]]:
+        # A mode may look like an option (-x, -rw): it is one of the operands.
+        guarded = []
+        seen_mode = False
+        for arg in args:
+            looks_like_mode = (
+                len(arg) > 1
+                and arg[0] == "-"
+                and arg[1] != "-"
+                and (all(c in "rwxXstugo" for c in arg[1:]) or arg[1:].isdigit())
+            )
+            if looks_like_mode and not seen_mode:
+                guarded.append("\0" + arg)
+                seen_mode = True
+            else:
+                guarded.append(arg)
+        opts, operands = getopt.gnu_getopt(guarded, cls.short, list(cls.long_with_help))
+        return opts, [o[1:] if o.startswith("\0") else o for o in operands]
+
+    def call(self) -> None:
+        got = self.setup()
+        if got is None:
+            return
+        opts, operands = got
+        if "--help" in opts or "--version" in opts:
+            # The stock command's own texts, on the stream GNU writes them to.
+            from cowrie.commands import chmod as stock
+
+            self.write(stock.CHMOD_HELP if "--help" in opts else stock.CHMOD_VERSION)
+            return
+        reference = opts.get("--reference")
+        if reference is not None:
+            node = self.node(self.resolved(reference))
+            if node is None:
+                self.fail(f"failed to get attributes of '{reference}': No such file or directory")
+                return
+            text, files = f"{_perm(node):o}", operands
+        elif not operands:
+            self.missing()
+            return
+        else:
+            text, files = operands[0], operands[1:]
+        if not files:
+            self.missing(None if reference is not None else text)
+            return
+        octal = _octal(text)
+        if octal is None and (_apply_symbolic(text, 0, False) is None or text.isdigit()):
+            self.errorWrite(
+                f"chmod: invalid mode: '{text}'\nTry 'chmod --help' for more information.\n"
+            )
+            self.exit_code = 1
+            return
+        self.recursive = "-R" in opts or "--recursive" in opts
+        self.verbose = "-v" in opts or "--verbose" in opts
+        self.changes = "-c" in opts or "--changes" in opts
+        self.silent = bool({"-f", "--silent", "--quiet"} & set(opts))
+        for operand in files:
+            self.change(operand, text, octal)
+
+    def change(self, shown: str, text: str, octal: int | None) -> None:
+        path = self.resolved(shown) if shown else ""
+        node = self.node(path)
+        if node is None:
+            if not self.silent:
+                self.errorWrite(f"chmod: cannot access '{shown}': No such file or directory\n")
+            self.exit_code = 1
+            return
+        is_dir = node[cfs.A_TYPE] == cfs.T_DIR
+        had = _perm(node)
+        if octal is not None:
+            # A directory keeps its set-ID bits under a mode of four digits or fewer.
+            new = octal | (had & 0o6000 if is_dir else 0)
+        else:
+            new = _apply_symbolic(text, had, is_dir)
+        if int(self.user["uid"]) not in (0, int(node[cfs.A_UID])):
+            if not self.silent:
+                self.errorWrite(
+                    f"chmod: changing permissions of '{shown}': Operation not permitted\n"
+                )
+            self.exit_code = 1
+        elif new != had:
+            self.fs.chmod(path, new)
+            if self.verbose or self.changes:
+                self.write(
+                    f"mode of '{shown}' changed from {had:04o} ({_mode_string(had)}) "
+                    f"to {new:04o} ({_mode_string(new)})\n"
+                )
+        elif self.verbose:
+            self.write(f"mode of '{shown}' retained as {had:04o} ({_mode_string(had)})\n")
+        if octal is None:
+            # With no who given, the umask held some of the change back: chmod
+            # does what it may, says what it did not, and fails.
+            asked = _apply_symbolic(text, had, is_dir, umask=0)
+            if asked != new and int(self.user["uid"]) in (0, int(node[cfs.A_UID])):
+                if not self.silent:
+                    self.errorWrite(
+                        f"chmod: {shown}: new permissions are {_mode_string(new)}, "
+                        f"not {_mode_string(asked or 0)}\n"
+                    )
+                self.exit_code = 1
+        if self.recursive and is_dir:
+            for name in sorted(x[cfs.A_NAME] for x in node[cfs.A_CONTENTS]):
+                child = posixpath.join(path, name)
+                if not self.fs.islink(child):  # chmod -R does not follow links it meets
+                    self.change(posixpath.join(shown, name), text, octal)
+
+
+# ------------------------------------------------------------------- tee
+
+
+class Command_tee(_FileCommand):
+    """Copies its input to its output and to each file, which then holds it:
+    stock Cowrie's made the files and left them empty."""
+
+    name = "tee"
+    program = "/usr/bin/tee"
+    short = "aip"
+    long = ("append", "ignore-interrupts")
+    consumes_stdin = True
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        try:
+            cls._parse(args)
+        except getopt.GetoptError as err:
+            return err.opt in ("help", "version", "output-error")
+        return False
+
+    def start(self) -> None:
+        self.files: dict[str, bytearray] = {}
+        self.ignore_interrupts = False
+        if self.mirage_declines(self.args):
+            self.not_emulated()
+            self.exit()
+            return
+        got = self.parsed()
+        if got is None:
+            self.exit()
+            return
+        opts, operands = got
+        append = "-a" in opts or "--append" in opts
+        self.ignore_interrupts = "-i" in opts or "--ignore-interrupts" in opts
+        access = mirage_state.Access(self.shell)
+        for operand in operands:
+            path = self.fs.resolve_path(operand, self.cwd)
+            try:
+                access.may_write(path)
+            except mirage_state.Rejected as e:
+                self.errorWrite(f"tee: {operand}: {os.strerror(e.code or 13)}\n")
+                self.exit_code = 1
+                continue
+            held = bytearray()
+            if self.fs.getfile(path) is None:
+                self.fs.mkfile(path, self.user["uid"], self.user["gid"], 0, stat.S_IFREG | 0o644)
+            elif append:
+                try:
+                    held = bytearray(self.fs.file_contents(path))
+                except Exception:
+                    held = bytearray()
+            self.files[path] = held
+            self.store(path)
+        if self.input_data is not None:
+            self.take(self.input_data)
+            self.exit()
+
+    def store(self, path: str) -> None:
+        held = self.files[path]
+        self.fs.update_size(path, len(held))
+        node = self.fs.getfile(path)
+        node[cfs.A_CONTENTS] = bytes(held)
+        node[cfs.A_REALFILE] = None
+
+    def take(self, data: bytes) -> None:
+        if not data:
+            return
+        self.writeBytes(data)
+        for path, held in self.files.items():
+            held.extend(data)
+            self.store(path)
+
+    def lineReceived(self, line: str) -> None:
+        self.protocol.events.dispatch(
+            "cowrie.session.input", "INPUT (%(realm)s): %(input)s", realm="tee", input=line
+        )
+        self.take(line.rstrip("\n").encode("utf8") + b"\n")
+
+    def handle_CTRL_C(self) -> None:
+        if not self.ignore_interrupts:
+            self.write("^C\n")
+            self.exit(130)
+
+    def handle_CTRL_D(self) -> None:
+        self.exit()
+
+    def eofReceived(self) -> None:
+        self.exit()
+
+
+for _name, _class in (
+    ("cp", Command_cp),
+    ("mv", Command_mv),
+    ("rm", Command_rm),
+    ("touch", Command_touch),
+    ("ln", Command_ln),
+    ("chmod", Command_chmod),
+    ("tee", Command_tee),
+):
+    commands[_name] = _class
+    commands[f"/bin/{_name}"] = _class
+    commands[f"/usr/bin/{_name}"] = _class
