+# ------------------------------------------------------------------- checksums
+
+_hashes: Any = None
+
+
+def recorded_hash(path: str, kind: str) -> str | None:
+    """The image's own checksum of ``path`` from the deployment's table, if it
+    carries one: the real bytes of its programs are not in the emulated tree."""
+    global _hashes
+    if _hashes is None:
+        where = CowrieConfig.get("mirage", "file_hashes", fallback="")
+        _hashes = False
+        if where:
+            try:
+                # Read-only and never written: the image's filesystem is read-only, and
+                # SQLite must not look for a journal or a lock beside the file.
+                _hashes = sqlite3.connect(
+                    f"file:{where}?mode=ro&immutable=1", uri=True, check_same_thread=False
+                )
+            except sqlite3.Error as e:
+                log.warn("file hashes not loaded from {path}: {err!r}", path=where, err=e)
+    if not _hashes:
+        return None
+    try:
+        row = _hashes.execute(f"SELECT {kind} FROM hashes WHERE path = ?", (path,)).fetchone()  # noqa: S608
+    except sqlite3.Error:
+        return None
+    return row[0].hex() if row and row[0] is not None else None
+
+
+def reset_hashes_for_tests() -> None:
+    global _hashes
+    if _hashes:
+        _hashes.close()
+    _hashes = None
+
+
+class _Sum(_Reads):
+    kind: ClassVar[str] = "md5"
+    tag: ClassVar[str] = "MD5"
+    short = "bct"
+    long = ("binary", "check", "text", "tag", "quiet", "status", "warn", "strict",
+            "ignore-missing")  # fmt: skip
+    declined = ("help", "version", "z", "zero")
+
+    def prepare(self) -> bool:
+        got = self.options()
+        if got is None:
+            return False
+        self.opts, self.operands = got
+        return True
+
+    def digest(self, operand: str) -> str | None:
+        """The checksum of one operand, or None after reporting why not."""
+        if operand == "-":
+            return hashlib.new(self.kind, self.stdin()).hexdigest()
+        path = self.fs.resolve_path(operand, self.cwd) if operand else ""
+        node = self.fs.getfile(path) if path else None
+        if node is not None and node[cfs.A_TYPE] == cfs.T_FILE:
+            holds = (
+                isinstance(node[cfs.A_CONTENTS], bytes)
+                or bool(node[cfs.A_REALFILE])
+                or int(node[cfs.A_SIZE]) == 0
+            )
+            if not holds:
+                # One of the image's programs or libraries: its bytes are not in
+                # the tree, but the deployment may have recorded their checksum.
+                real, _ = canonical(self.fs, path, "/", "e")
+                known = recorded_hash(real or path, self.kind)
+                if known is None:
+                    self.unanswerable = True
+                    return None
+                try:
+                    mirage_state.Access(self.shell).may_read(path)
+                except mirage_state.Rejected as e:
+                    self.fail(f"{operand}: {os.strerror(e.code or 13)}")
+                    return None
+                return known
+        data = self.read(operand)
+        return None if data is None else hashlib.new(self.kind, data).hexdigest()
+
+    def work(self) -> None:
+        self.unanswerable = False
+        if "-c" in self.opts or "--check" in self.opts:
+            self.check()
+            return
+        lines = []
+        for operand in self.operands or ["-"]:
+            value = self.digest(operand)
+            if value is None:
+                continue
+            if "--tag" in self.opts:
+                lines.append(f"{self.tag} ({operand}) = {value}\n")
+            else:
+                mark = "*" if "-b" in self.opts or "--binary" in self.opts else " "
+                lines.append(f"{value} {mark}{operand}\n")
+        if self.unanswerable:
+            self.not_emulated()
+            return
+        self.write("".join(lines))
+
+    def check(self) -> None:
+        failed = unread = 0
+        quiet = "--quiet" in self.opts or "--status" in self.opts
+        for _operand, data in self.inputs():
+            for line in data.decode("utf8", "replace").splitlines():
+                value, sep, name = line.partition(" ")
+                name = name[1:] if sep and name[:1] in " *" else name
+                if not sep or len(value) != hashlib.new(self.kind).digest_size * 2:
+                    continue
+                path = self.fs.resolve_path(name, self.cwd)
+                if not self.fs.exists(path):
+                    self.errorWrite(f"{self.name}: {name}: No such file or directory\n")
+                    if "--status" not in self.opts:
+                        self.write(f"{name}: FAILED open or read\n")
+                    unread += 1
+                    continue
+                got = self.digest(name)
+                if got == value.lower():
+                    if not quiet:
+                        self.write(f"{name}: OK\n")
+                else:
+                    failed += 1
+                    if "--status" not in self.opts:
+                        self.write(f"{name}: FAILED\n")
+        if "--status" not in self.opts:
+            if unread:
+                noun = "listed file" if unread == 1 else "listed files"
+                self.errorWrite(f"{self.name}: WARNING: {unread} {noun} could not be read\n")
+            if failed:
+                noun = "computed checksum" if failed == 1 else "computed checksums"
+                self.errorWrite(f"{self.name}: WARNING: {failed} {noun} did NOT match\n")
+        if failed or unread:
+            self.exit_code = 1
+
+
+def _sum(program: str, kind: str, tag: str) -> type[_Sum]:
+    return type(
+        f"Command_{program}",
+        (_Sum,),
+        {"name": program, "program": f"/usr/bin/{program}", "kind": kind, "tag": tag},
+    )
+
+
+# ------------------------------------------------------------------- lines of numbers and text
