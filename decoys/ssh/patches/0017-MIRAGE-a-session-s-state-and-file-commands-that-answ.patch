+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE: small programs whose answer is a function of their arguments, their
+# ABOUTME: input and the tree: cut, xargs, readlink, realpath, the checksums and others.
+
+"""Programs stock Cowrie lacked or had in outline, as Debian 12 runs them.
+
+Every one of these is determined by what it is given: its arguments, its
+standard input, and the files it reads. So they are computed here, and the
+answer is the one the real program gives. Each implements the options below
+and declines the rest (see ``Declining``); the wording of errors is the real
+program's in the C locale.
+
+The checksum programs need a file's bytes. The emulated tree holds the bytes
+of small text files only, so for the image's own programs and libraries the
+deployment may carry a table of their real checksums (``[mirage]
+file_hashes``, written when the image's tree is built). A file the session
+wrote is hashed from what was written. A file that is neither is something
+this cannot answer truthfully, and the command says so by declining.
+"""
+
+from __future__ import annotations
+
+import getopt
+import hashlib
+import os
+import posixpath
+import random
+import shlex
+import sqlite3
+import stat
+import string
+from typing import Any, ClassVar
+
+from twisted.logger import Logger
+
+from cowrie import mirage_state
+from cowrie.commands.mirage_coreutils import Declining
+from cowrie.commands.mirage_fileutils import option_error
+from cowrie.commands.mirage_find import Runs
+from cowrie.core.config import CowrieConfig
+from cowrie.shell import fs as cfs
+
+log = Logger()
+commands = {}
+
+
+class _Tool(Declining):
+    short: ClassVar[str] = ""
+    long: ClassVar[tuple[str, ...]] = ()
+    declined: ClassVar[tuple[str, ...]] = ("help", "version")
+
+    @classmethod
+    def _parse(cls, args: list[str]) -> tuple[list[tuple[str, str]], list[str]]:
+        return getopt.gnu_getopt(args, cls.short, list(cls.long))
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        try:
+            cls._parse(args)
+        except getopt.GetoptError as err:
+            return err.opt in cls.declined
+        return False
+
+    def options(self) -> tuple[dict[str, str], list[str]] | None:
+        """The options and operands; None after declining or a bad option."""
+        if self.mirage_declines(self.args):
+            self.not_emulated()
+            return None
+        try:
+            opts, operands = self._parse(self.args)
+        except getopt.GetoptError as err:
+            self.errorWrite(option_error(self.name, err))
+            self.try_help()
+            return None
+        return dict(opts), operands
+
+    def try_help(self) -> None:
+        self.errorWrite(f"Try '{self.name} --help' for more information.\n")
+        self.exit_code = 1
+
+    def usage(self, text: str) -> None:
+        self.errorWrite(f"{self.name}: {text}\n")
+        self.try_help()
+
+    def fail(self, text: str) -> None:
+        self.errorWrite(f"{self.name}: {text}\n")
+        self.exit_code = 1
+
+
+class _Reads(_Tool):
+    """A tool that reads files, or its standard input when given none."""
+
+    consumes_stdin = True
+
+    def start(self) -> None:
+        self.operands: list[str] = []
+        if not self.prepare():
+            if not self.exited:
+                self.exit()
+            return
+        wants_stdin = not self.operands or "-" in self.operands
+        piped = self.input_data is not None or getattr(self.pp, "stdin_from_pipe", False)
+        if wants_stdin and not piped:
+            return  # reads the terminal until end of file
+        self.finish()
+
+    def prepare(self) -> bool:
+        raise NotImplementedError
+
+    def work(self) -> None:
+        raise NotImplementedError
+
+    def finish(self) -> None:
+        if not self.exited:
+            self.work()
+            self.exit()
+
+    def lineReceived(self, line: str) -> None:
+        # What is typed at a program is input like any other, and is logged.
+        self.protocol.events.dispatch(
+            "cowrie.command.input",
+            "INPUT (%(realm)s): %(input)s",
+            realm=self.name,
+            input=line.rstrip("\n"),
+        )
+        typed = line.rstrip("\n").encode("utf8")
+        self.input_data = (self.input_data or b"") + typed + b"\n"
+
+    def handle_CTRL_D(self) -> None:
+        self.finish()
+
+    def eofReceived(self) -> None:
+        self.finish()
+
+    def stdin(self) -> bytes:
+        return self.input_data or b""
+
+    def read(self, operand: str, words: str = "{name}: {operand}: {error}") -> bytes | None:
+        """A file's bytes ("-" is standard input), or None after reporting."""
+        if operand == "-":
+            return self.stdin()
+        path = self.fs.resolve_path(operand, self.cwd) if operand else ""
+        code = 0
+        try:
+            mirage_state.Access(self.shell).may_read(path)
+        except mirage_state.Rejected as e:
+            code = e.code or 13
+        if not code and self.fs.isdir(path):
+            code = 21
+        if code:
+            self.errorWrite(
+                words.format(name=self.name, operand=operand, error=os.strerror(code)) + "\n"
+            )
+            self.exit_code = 1
+            return None
+        try:
+            return bytes(self.fs.file_contents(path))
+        except Exception:
+            return b""
+
+    def inputs(self) -> list[tuple[str, bytes]]:
+        out = []
+        for operand in self.operands or ["-"]:
+            data = self.read(operand)
+            if data is not None:
+                out.append((operand, data))
+        return out
+
+
+# ------------------------------------------------------------------- cut
+
+
+def _ranges(spec: str, what: str) -> list[tuple[int, int | None]]:
+    """A cut LIST as 1-based inclusive ranges; ValueError with cut's wording."""
+    out: list[tuple[int, int | None]] = []
+    numbered = "fields" if what == "field" else "byte/character positions"
+    for part in spec.split(","):
+        low, dash, high = part.partition("-")
+        for text in (low, high):
+            if text and not text.isdigit():
+                invalid = "field value" if what == "field" else "byte/character position"
+                raise ValueError(f"invalid {invalid} '{part if dash else text}'")
+        if not dash:
+            if not low:
+                raise ValueError(f"{numbered} are numbered from 1")
+            first, last = int(low), int(low)
+        else:
+            if not low and not high:
+                raise ValueError("invalid range with no endpoint: -")
+            first = int(low) if low else 1
+            last = int(high) if high else None
+        if first == 0 or last == 0:
+            raise ValueError(f"{numbered} are numbered from 1")
+        if last is not None and last < first:
+            raise ValueError("invalid decreasing range")
+        out.append((first, last))
+    return out
+
+
+class Command_cut(_Reads):
+    name = "cut"
+    program = "/usr/bin/cut"
+    short = "b:c:d:f:sn"
+    long = ("bytes=", "characters=", "delimiter=", "fields=", "only-delimited",
+            "complement", "output-delimiter=")  # fmt: skip
+    declined = ("z", "zero-terminated")
+
+    def prepare(self) -> bool:
+        if "--help" in self.args or "--version" in self.args:
+            # The stock command's own texts.
+            from cowrie.commands import cut as stock
+
+            self.exec_command(self.pp, stock.Command_cut, *self.args)
+            return False
+        got = self.options()
+        if got is None:
+            return False
+        opts, self.operands = got
+        lists = [(o, v) for o, v in opts.items() if o in ("-b", "-c", "-f", "--bytes", "--characters", "--fields")]
+        if not lists:
+            self.usage("you must specify a list of bytes, characters, or fields")
+            return False
+        if len(lists) > 1:
+            self.usage("only one list may be specified")
+            return False
+        which, spec = lists[0]
+        self.by_field = which in ("-f", "--fields")
+        delimiter = opts.get("-d", opts.get("--delimiter"))
+        if delimiter is not None and not self.by_field:
+            self.usage("an input delimiter may be specified only when operating on fields")
+            return False
+        if delimiter is not None and len(delimiter) > 1:
+            self.usage("the delimiter must be a single character")
+            return False
+        self.only_delimited = "-s" in opts or "--only-delimited" in opts
+        if self.only_delimited and not self.by_field:
+            self.usage("suppressing non-delimited lines makes sense\n\tonly when operating on fields")
+            return False
+        try:
+            self.ranges = _ranges(spec, "field" if self.by_field else "char")
+        except ValueError as e:
+            self.usage(str(e))
+            return False
+        self.delimiter = "\t" if delimiter is None else (delimiter or "\0")
+        self.complement = "--complement" in opts
+        self.joiner = opts.get("--output-delimiter", self.delimiter if self.by_field else "")
+        return True
+
+    def chosen(self, count: int) -> list[int]:
+        """The 0-based positions kept, of ``count``, in the input's order."""
+        keep = [False] * count
+        for first, last in self.ranges:
+            for i in range(first - 1, min(count, last if last is not None else count)):
+                keep[i] = True
+        return [i for i in range(count) if keep[i] != self.complement]
+
+    def work(self) -> None:
+        for _operand, data in self.inputs():
+            lines = data.decode("utf8", "replace").split("\n")
+            if lines and lines[-1] == "":
+                lines.pop()
+            for line in lines:
+                if not self.by_field:
+                    picked = self.chosen(len(line))
+                    self.write(self.grouped(line, picked) + "\n")
+                elif self.delimiter not in line:
+                    if not self.only_delimited:
+                        self.write(line + "\n")
+                else:
+                    fields = line.split(self.delimiter)
+                    self.write(self.joiner.join(fields[i] for i in self.chosen(len(fields))) + "\n")
+
+    def grouped(self, line: str, picked: list[int]) -> str:
+        if not self.joiner:
+            return "".join(line[i] for i in picked)
+        runs, last = [], None
+        for i in picked:
+            if last is not None and i == last + 1:
+                runs[-1] += line[i]
+            else:
+                runs.append(line[i])
+            last = i
+        return self.joiner.join(runs)
+
+
+# ------------------------------------------------------------------- paths
+
+
+def canonical(fs: Any, path: str, cwd: str, need: str) -> tuple[str | None, int]:
+    """``path`` with every link followed and every ``.`` and ``..`` taken out,
+    and the error number where it cannot be made. ``need`` says what must
+    exist: ``e`` all of it, ``f`` all but its last part, ``m`` none of it."""
+    pending = [p for p in (path if path.startswith("/") else f"{cwd}/{path}").split("/") if p]
+    done: list[str] = []
+    hops = 0
+    while pending:
+        part = pending.pop(0)
+        if part == ".":
+            continue
+        if part == "..":
+            if done:
+                done.pop()
+            continue
+        here = "/" + "/".join([*done, part])
+        node = fs.getfile(here, follow_symlinks=False)
+        if node is None:
+            if need == "e" or (need == "f" and pending):
+                return None, 2
+            done.append(part)
+            if need == "f":
+                return "/" + "/".join(done), 0
+            continue
+        if node[cfs.A_TYPE] == cfs.T_LINK:
+            hops += 1
+            if hops > 40:
+                return None, 40
+            target = str(node[cfs.A_TARGET] or "")
+            own_text = cfs._links_verbatim() or node[cfs.A_REALFILE] == cfs.OWN_TEXT
+            if target.startswith("/") or not own_text:
+                done = []
+            pending = [p for p in target.split("/") if p] + pending
+            continue
+        if node[cfs.A_TYPE] != cfs.T_DIR and pending and need != "m":
+            return None, 20
+        done.append(part)
+    return "/" + "/".join(done), 0
+
+
+class Command_readlink(_Tool):
+    name = "readlink"
+    program = "/usr/bin/readlink"
+    short = "femnvqsz"
+    long = ("canonicalize", "canonicalize-existing", "canonicalize-missing", "no-newline",
+            "verbose", "quiet", "silent")  # fmt: skip
+
+    def call(self) -> None:
+        got = self.options()
+        if got is None:
+            return
+        opts, operands = got
+        if not operands:
+            self.usage("missing operand")
+            return
+        need = next(
+            (n for n, names in (("f", ("-f", "--canonicalize")), ("e", ("-e", "--canonicalize-existing")),
+                                ("m", ("-m", "--canonicalize-missing"))) if any(x in opts for x in names)),
+            None,
+        )  # fmt: skip
+        verbose = "-v" in opts or "--verbose" in opts
+        end = "" if ("-n" in opts or "--no-newline" in opts) and len(operands) == 1 else "\n"
+        for operand in operands:
+            code = 0
+            if need:
+                found, code = canonical(self.fs, operand, self.cwd, need)
+            else:
+                path = self.fs.resolve_path(operand, self.cwd) if operand else ""
+                node = self.fs.getfile(path, follow_symlinks=False) if path else None
+                found = None
+                if node is None:
+                    code = 2
+                elif node[cfs.A_TYPE] != cfs.T_LINK:
+                    code = 22
+                else:
+                    found = str(node[cfs.A_TARGET] or "")
+            if found is None:
+                if verbose:
+                    self.errorWrite(f"readlink: {operand}: {os.strerror(code)}\n")
+                self.exit_code = 1
+            else:
+                self.write(found + end)
+
