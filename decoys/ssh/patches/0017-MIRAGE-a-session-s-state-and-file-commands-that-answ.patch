+from cowrie.mirage_state import Rejected, apply, check_shape, view
+from cowrie.shell import fs as cfs
+from cowrie.shell.protocol import HoneyPotInteractiveProtocol
+from cowrie.test.eventcapture import capture_eventlog
+from cowrie.test.fake_server import FakeAvatar, FakeServer
+from cowrie.test.fake_transport import FakeTransport
+
+os.environ["COWRIE_HONEYPOT_DATA_PATH"] = "data"
+os.environ["COWRIE_HONEYPOT_DOWNLOAD_PATH"] = tempfile.gettempdir()
+os.environ["COWRIE_SHELL_FILESYSTEM"] = "src/cowrie/data/fs.pickle"
+
+PROMPT = b"root@unitTest:~# "
+CASES = json.loads(
+    (Path(__file__).parent / "mirage_ops_cases.json").read_text(encoding="utf8")
+)["cases"]
+
