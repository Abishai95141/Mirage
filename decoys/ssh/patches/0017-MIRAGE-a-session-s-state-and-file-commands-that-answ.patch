+class StateTestBase(unittest.TestCase):
+    def setUp(self) -> None:
+        mirage_gate.reset_for_tests(None)
+        self.proto = self.session()
+        self.shell = self.proto.cmdstack[0]
+        self.fs = self.proto.fs
+        self.journal = mirage_state.journal_of(self.proto)
+
+    def session(self) -> Any:
+        proto = HoneyPotInteractiveProtocol(FakeAvatar(FakeServer()))
+        self.tr = FakeTransport("", "31337")
+        proto.makeConnection(self.tr)
+        proto.events, self.events = capture_eventlog()
+        proto.fs.events = proto.events
+        self.tr.clear()
+        self.addCleanup(proto.connectionLost)
+        return proto
+
+    def tearDown(self) -> None:
+        mirage_gate.reset_for_tests()
+
+    def run_line(self, line: str) -> bytes:
+        self.tr.clear()
+        self.proto.lineReceived(line.encode() + b"\n")
+        return self.tr.value()
+
+    def changes(self) -> list[tuple[str, str]]:
+        return [(e["op"], e["path"]) for e in self.events if e["eventid"] == "cowrie.fs.change"]
+
+    def as_user(self, uid: int = 1000) -> None:
+        self.shell.user = {**self.shell.user, "uid": uid, "gid": uid, "username": "caleb"}
+
+    def refused(self, ops: Any, why: str = "", **kw: Any) -> None:
+        """``ops`` are rejected, and the session is exactly as it was."""
+        before = snapshot(self.fs, "/tmp"), snapshot(self.fs, "/root")
+        state = (self.shell.cwd, dict(self.shell.environ), self.journal.seq, len(self.events))
+        with self.assertRaises(Rejected) as caught:
+            apply(self.shell, ops, **kw)
+        self.assertIn(why, str(caught.exception))
+        self.assertEqual((snapshot(self.fs, "/tmp"), snapshot(self.fs, "/root")), before)
+        self.assertEqual(
+            (self.shell.cwd, dict(self.shell.environ), self.journal.seq, len(self.events)), state
+        )
+
