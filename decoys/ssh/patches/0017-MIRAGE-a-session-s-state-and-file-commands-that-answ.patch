+class Command_getconf(_Tool):
+    """Stock Cowrie answered every ``getconf`` with "32": the word size of a
+    machine no deployment claims to be, and the page size and the processor
+    count as well. The few variables below are the ones people ask for; they
+    are amd64 Debian 12's, and the processor count is the hardware class's.
+    Any other variable is declined."""
+
+    name = "getconf"
+    program = "/usr/bin/getconf"
+    FIXED: ClassVar[dict[str, str]] = {
+        "LONG_BIT": "64",
+        "WORD_BIT": "32",
+        "CHAR_BIT": "8",
+        "INT_MAX": "2147483647",
+        "PAGE_SIZE": "4096",
+        "PAGESIZE": "4096",
+        "CLK_TCK": "100",
+        "ARG_MAX": "2097152",
+        "OPEN_MAX": "1024",
+        "GNU_LIBC_VERSION": "glibc 2.36",
+        "GNU_LIBPTHREAD_VERSION": "NPTL 2.36",
+        "_POSIX_VERSION": "200809",
+        "LEVEL1_DCACHE_LINESIZE": "64",
+    }
+    FOR_A_PATH: ClassVar[dict[str, str]] = {"NAME_MAX": "255", "PATH_MAX": "4096"}
+    CPUS = ("_NPROCESSORS_ONLN", "_NPROCESSORS_CONF", "NPROCESSORS_ONLN", "NPROCESSORS_CONF")
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        if not args or len(args) > 2 or args[0].startswith("-"):
+            return bool(args)  # -a and -v are the real program's; no operand is a usage error
+        known = args[0] in cls.FIXED or args[0] in cls.CPUS or args[0] in cls.FOR_A_PATH
+        return not known and args[0].isupper() and len(args) == 1
+
+    def call(self) -> None:
+        if self.mirage_declines(self.args):
+            self.not_emulated()
+            return
+        if not self.args:
+            self.errorWrite(
+                "Usage: getconf [-v SPEC] VAR\n  or:  getconf [-v SPEC] PATH_VAR PATH\n\n"
+                "Get the configuration value for variable VAR, or for variable PATH_VAR\n"
+                "for path PATH.  If SPEC is given, give values for compilation\n"
+                "environment SPEC.\n\n"
+                "For bug reporting instructions, please see:\n"
+                "<http://www.debian.org/Bugs/>.\n"
+            )
+            self.exit_code = 2
+            return
+        name = self.args[0]
+        if name in self.FOR_A_PATH and len(self.args) == 2:
+            path = self.fs.resolve_path(self.args[1], self.cwd)
+            if not self.fs.exists(path):
+                self.errorWrite(f"getconf: {self.args[1]}: No such file or directory\n")
+                self.exit_code = 3
+                return
+            self.write(self.FOR_A_PATH[name] + "\n")
+        elif name in self.FIXED and len(self.args) == 1:
+            self.write(self.FIXED[name] + "\n")
+        elif name in self.CPUS and len(self.args) == 1:
+            self.write(f"{self.processors()}\n")
+        else:
+            self.errorWrite(f"getconf: Unrecognized variable `{name}'\n")
+            self.exit_code = 2
+
+    def processors(self) -> int:
+        try:
+            text = self.fs.file_contents("/proc/cpuinfo").decode("utf8", "replace")
+        except Exception:
+            return 1
+        return max(1, sum(1 for line in text.splitlines() if line.startswith("processor")))
+
+
+# ------------------------------------------------------------------- xargs
+
+
+def _xargs_words(text: str) -> list[str]:
+    """Standard input cut into arguments as xargs cuts it: at blanks and
+    newlines, with quotes and backslashes protecting them. ValueError names
+    an unmatched quote."""
+    words: list[str] = []
+    word: list[str] | None = None
+    i = 0
+    while i < len(text):
+        c = text[i]
+        if c in "\"'":
+            end = text.find(c, i + 1)
+            if end < 0 or "\n" in text[i:end]:
+                raise ValueError("single" if c == "'" else "double")
+            word = (word or []) + [text[i + 1 : end]]
+            i = end + 1
+            continue
+        if c == "\\" and i + 1 < len(text):
+            word = (word or []) + [text[i + 1]]
+            i += 2
+            continue
+        if c in " \t\n":
+            if word is not None:
+                words.append("".join(word))
+                word = None
+        else:
+            word = (word or []) + [c]
+        i += 1
+    if word is not None:
+        words.append("".join(word))
+    return words
+
+
+class Command_xargs(Runs):
+    name = "xargs"
+    program = "/usr/bin/xargs"
+    consumes_stdin = True
+    short = "0rtxn:I:L:d:"
+    long = ("null", "no-run-if-empty", "verbose", "exit", "max-args=", "replace=",
+            "max-lines=", "delimiter=")  # fmt: skip
+
+    @classmethod
+    def _parse(cls, args: list[str]) -> tuple[list[tuple[str, str]], list[str]]:
+        # Options end at the command: what follows it is the command's own.
+        return getopt.getopt(args, cls.short, list(cls.long))
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        try:
+            cls._parse(args)
+        except getopt.GetoptError as err:
+            return err.opt in (
+                "help", "version", "a", "arg-file", "E", "e", "eof", "i", "l", "P",
+                "max-procs", "p", "interactive", "s", "max-chars", "show-limits",
+                "process-slot-var", "o", "open-tty",
+            )  # fmt: skip
+        return False
+
+    def start(self) -> None:
+        self.lines: list[str] = []
+        if self.mirage_declines(self.args):
+            self.not_emulated()
+            self.exit()
+            return
+        try:
+            opts_list, command = self._parse(self.args)
+        except getopt.GetoptError as err:
+            self.errorWrite(f"xargs: invalid option -- '{err.opt}'\n")
+            self.exit(1)
+            return
+        self.opts, self.command = dict(opts_list), command or ["echo"]
+        if self.input_data is None and not getattr(self.pp, "stdin_from_pipe", False):
+            return  # reads the terminal until end of file
+        self.go()
+
+    def lineReceived(self, line: str) -> None:
+        typed = line.rstrip("\n").encode("utf8")
+        self.input_data = (self.input_data or b"") + typed + b"\n"
+
+    def handle_CTRL_D(self) -> None:
+        self.go()
+
+    def eofReceived(self) -> None:
+        if not self.exited and not getattr(self, "going", False):
+            self.go()
+
+    def go(self) -> None:
+        self.going = True
+        opts = self.opts
+        text = (self.input_data or b"").decode("utf8", "replace")
+        replace = opts.get("-I", opts.get("--replace"))
+        per_line = opts.get("-L", opts.get("--max-lines"))
+        delimiter = opts.get("-d", opts.get("--delimiter"))
+        try:
+            if "-0" in opts or "--null" in opts:
+                groups = [[w] for w in text.split("\0") if w]
+            elif delimiter is not None:
+                groups = [[w] for w in text.rstrip("\n").split(delimiter[:1] or "\n") if w]
+            elif replace is not None:
+                groups = [[line.strip()] for line in text.split("\n") if line.strip()]
+            elif per_line is not None:
+                groups = [_xargs_words(line) for line in text.split("\n") if line.strip()]
+            else:
+                groups = [[w] for w in _xargs_words(text)]
+        except ValueError as e:
+            self.errorWrite(
+                f"xargs: unmatched {e} quote; by default quotes are special to xargs "
+                "unless you use the -0 option\n"
+            )
+            self.exit(1)
+            return
+        size = opts.get("-n", opts.get("--max-args"))
+        lines: list[list[str]] = []
+        if replace is not None:
+            lines = [[w.replace(replace, g[0]) for w in self.command] for g in groups]
+        elif per_line is not None:
+            count = max(1, int(per_line)) if per_line.isdigit() else 1
+            for i in range(0, len(groups), count):
+                lines.append([*self.command, *[w for g in groups[i : i + count] for w in g]])
+        else:
+            words = [w for g in groups for w in g]
+            count = int(size) if size and size.isdigit() and int(size) > 0 else len(words) or 1
+            for i in range(0, len(words), count):
+                lines.append([*self.command, *words[i : i + count]])
+            if not words and "-r" not in opts and "--no-run-if-empty" not in opts:
+                lines.append(list(self.command))
+        if lines and not self.program_exists(self.command[0]):
+            self.errorWrite(f"xargs: {self.command[0]}: No such file or directory\n")
+            self.exit(127)
+            return
+        if "-t" in opts or "--verbose" in opts:
+            for words in lines:
+                self.errorWrite(" ".join(words) + "\n")
+        # Each command's failure is noted in a variable of the child shell,
+        # which ends with xargs's own status for it: 123 if any failed.
+        script = [" ".join(shlex.quote(w) for w in words) + " || _mirage_xargs=123" for words in lines]
+        if script:
+            # Unset, it expands to nothing, and exit takes the last status: 0.
+            script.append("exit $_mirage_xargs")
+        self.run_lines(script)
+
+    def ran(self, status: int) -> None:
+        self.exit(status)
+
+
+for _name, _class in (
+    ("cut", Command_cut),
+    ("readlink", Command_readlink),
+    ("realpath", Command_realpath),
+    ("basename", Command_basename),
+    ("dirname", Command_dirname),
+    ("md5sum", _sum("md5sum", "md5", "MD5")),
+    ("sha1sum", _sum("sha1sum", "sha1", "SHA1")),
+    ("sha256sum", _sum("sha256sum", "sha256", "SHA256")),
+    ("sha512sum", _sum("sha512sum", "sha512", "SHA512")),
+    ("seq", Command_seq),
+    ("tac", Command_tac),
+    ("rev", Command_rev),
+    ("nl", Command_nl),
+    ("printenv", Command_printenv),
+    ("mktemp", Command_mktemp),
+    ("xargs", Command_xargs),
+    ("getconf", Command_getconf),
+):
+    commands[_name] = _class
+    commands[f"/bin/{_name}"] = _class
+    commands[f"/usr/bin/{_name}"] = _class
