+class Command_mktemp(_Tool):
+    name = "mktemp"
+    program = "/usr/bin/mktemp"
+    short = "dqutp:"
+    long = ("directory", "quiet", "dry-run", "tmpdir=", "suffix=")
+    declined = ("help", "version", "V")
+
+    def call(self) -> None:
+        got = self.options()
+        if got is None:
+            return
+        opts, operands = got
+        if len(operands) > 1:
+            self.usage("too many templates")
+            return
+        directory = "-d" in opts or "--directory" in opts
+        template = operands[0] if operands else "tmp.XXXXXXXXXX"
+        suffix = opts.get("--suffix", "")
+        base = opts.get("-p", opts.get("--tmpdir"))
+        if not operands or "-t" in opts or base is not None:
+            base = base or self.environ.get("TMPDIR") or "/tmp"
+            template = posixpath.join(base, template)
+        stem = template.rstrip("X")
+        count = len(template) - len(stem)
+        if count < 3:
+            self.fail(f"too few X's in template '{template}'")
+            return
+        letters = string.ascii_letters + string.digits
+        for _ in range(100):
+            shown = stem + "".join(random.choice(letters) for _ in range(count)) + suffix
+            path = self.fs.resolve_path(shown, self.cwd)
+            if not self.fs.lexists(path):
+                break
+        if "-u" not in opts and "--dry-run" not in opts:
+            try:
+                mirage_state.Access(self.shell).may_create(path)
+            except mirage_state.Rejected as e:
+                if "-q" not in opts and "--quiet" not in opts:
+                    kind = "directory" if directory else "file"
+                    self.errorWrite(
+                        f"mktemp: failed to create {kind} via template '{template + suffix}': "
+                        f"{os.strerror(e.code or 13)}\n"
+                    )
+                self.exit_code = 1
+                return
+            uid, gid = self.user["uid"], self.user["gid"]
+            if directory:
+                self.fs.mkdir(path, uid, gid, 4096, stat.S_IFDIR | 0o700)
+            else:
+                self.fs.mkfile(path, uid, gid, 0, stat.S_IFREG | 0o600)
+        self.write(shown + "\n")
+
