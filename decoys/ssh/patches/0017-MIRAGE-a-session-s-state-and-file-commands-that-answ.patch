+class JournalTests(StateTestBase):
+    def test_what_the_shell_changes_is_journalled_in_order(self) -> None:
+        self.run_line("mkdir /tmp/j && touch /tmp/j/a && mv /tmp/j/a /tmp/j/b")
+        self.run_line("chmod 600 /tmp/j/b; rm /tmp/j/b; rmdir /tmp/j")
+        entries = self.journal.since(0)
+        self.assertEqual([e["seq"] for e in entries], list(range(1, len(entries) + 1)))
+        self.assertEqual(
+            [(e["op"], e["path"]) for e in entries],
+            [
+                ("mkdir", "/tmp/j"),
+                ("create", "/tmp/j/a"),
+                ("rename", "/tmp/j/a"),
+                ("chmod", "/tmp/j/b"),
+                ("remove", "/tmp/j/b"),
+                ("rmdir", "/tmp/j"),
+            ],
+        )
+        self.assertEqual(entries[2]["new_path"], "/tmp/j/b")
+        self.assertEqual(entries[0]["mode"], 0o755)  # permission bits, not the type
+        self.assertEqual(entries[3]["mode"], 0o600)
+        # And it is the same list the events are.
+        self.assertEqual([(e["op"], e["path"]) for e in entries], self.changes())
+
+    def test_since_gives_what_came_after(self) -> None:
+        self.run_line("mkdir /tmp/a /tmp/b /tmp/c")
+        self.assertEqual([e["path"] for e in self.journal.since(1)], ["/tmp/b", "/tmp/c"])
+        self.assertEqual(self.journal.since(3), [])
+        self.assertEqual(self.journal.since(99), [])
+
+    def test_directory_and_environment_are_noted_when_looked_at(self) -> None:
+        self.journal.sync(self.shell)  # the baseline: nothing is journalled for it
+        self.assertEqual(self.journal.seq, 0)
+        self.run_line("cd /tmp; export EDITOR=vi; X=1; unset TMOUT")
+        self.journal.sync(self.shell)
+        got = [(e["op"], e.get("path") or e.get("name"), e.get("value")) for e in self.journal.entries]
+        self.assertEqual(
+            got,
+            [
+                ("cd", "/tmp", None),
+                ("unsetenv", "TMOUT", None),
+                ("setenv", "EDITOR", "vi"),
+                ("setenv", "X", "1"),
+            ],
+        )
+        self.journal.sync(self.shell)
+        self.assertEqual(len(self.journal.entries), 4)  # nothing changed, nothing added
+        self.assertEqual(self.journal.changed_env(self.shell), {"EDITOR": "vi", "X": "1"})
+
+    def test_a_journal_over_its_cap_stops_and_says_so(self) -> None:
+        for i in range(mirage_state.MAX_JOURNAL):
+            self.journal.add("chmod", path=f"/tmp/{i}", mode=0o644)
+        self.assertFalse(self.journal.full)
+        self.journal.add("chmod", path="/tmp/one-more", mode=0o644)
+        self.assertTrue(self.journal.full)
+        self.assertEqual(self.journal.seq, mirage_state.MAX_JOURNAL)
+        self.journal.add("chmod", path="/tmp/later", mode=0o644)
+        self.assertEqual(len(self.journal.entries), mirage_state.MAX_JOURNAL)
+
+    def test_the_cap_is_in_bytes_too(self) -> None:
+        big = "v" * 4000
+        while not self.journal.full:
+            self.journal.add("setenv", name="A", value=big)
+        self.assertLess(len(self.journal.entries), mirage_state.MAX_JOURNAL)
+        self.assertLessEqual(self.journal.size, mirage_state.MAX_JOURNAL_BYTES)
+
+    def test_replaying_the_journal_on_a_fresh_filesystem_gives_the_sessions(self) -> None:
+        self.run_line("mkdir -p /tmp/r/sub && cd /tmp/r && echo hello > note && cp note sub/copy")
+        self.run_line("chmod 640 note; mv sub/copy sub/kept; touch gone; rm gone; mkdir d; rmdir d")
+        apply(
+            self.shell,
+            [
+                {"op": "write", "path": "/tmp/r/made.conf", "content": "a=1\n", "mode": 0o600},
+                {"op": "mkdir", "path": "/tmp/r/cache"},
+                {"op": "chown", "path": "/tmp/r/cache", "uid": 33, "gid": 33},
+            ],
+        )
+        fresh = self.session().fs
+        for e in self.journal.since(0):
+            op, path = e["op"], e.get("path")
+            if op == "mkdir":
+                fresh.mkdir(path, e["uid"], e["gid"], 4096, stat.S_IFDIR | e["mode"])
+            elif op == "create":
+                fresh.mkfile(path, e["uid"], e["gid"], e["size"], stat.S_IFREG | e["mode"])
+            elif op == "write" and "size" in e:
+                fresh.update_size(path, e["size"])
+            elif op == "remove":
+                fresh.remove(path)
+            elif op == "rmdir":
+                fresh.rmdir(path)
+            elif op == "rename":
+                fresh.rename(path, e["new_path"])
+            elif op == "chmod":
+                fresh.chmod(path, e["mode"])
+            elif op == "chown":
+                fresh.chown(path, e["uid"], e["gid"])
+
+        def shape(fs: Any) -> dict[str, tuple[Any, ...]]:
+            return {p: v[:5] for p, v in snapshot(fs, "/tmp/r").items()}
+
+        self.assertEqual(shape(fresh), shape(self.fs))
+        self.assertIn("/tmp/r/sub/kept", shape(fresh))
+        self.assertNotIn("/tmp/r/gone", shape(fresh))
+
