@@ -0,0 +1,594 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE: find as GNU findutils 4.9 on Debian 12 runs it: an expression of
+# ABOUTME: tests, operators and actions over the emulated tree, with find's own errors.
+
+"""find, and what runs commands for it.
+
+Stock Cowrie's ``find`` knew ``-name``, ``-type`` and ``-maxdepth``, called
+everything else an "unknown argument" (which is not what find says), and
+exited 0 for a path that is not there. A person who has just got into a host
+looks for what is on it with find before anything else: set-uid programs,
+keys, configuration, what changed lately.
+
+This one parses the expression as find does (``!`` binds tightest, then
+juxtaposition and ``-a``, then ``-o``; parentheses group), walks the tree in
+the order the tree holds it, and implements the tests and actions below. A
+primary of GNU find that is not here makes the command decline (see
+``Declining``), so that it can be answered some other way instead of wrongly.
+"""
+
+from __future__ import annotations
+
+import fnmatch
+import os
+import posixpath
+import shlex
+import time
+from typing import TYPE_CHECKING, Any, ClassVar
+
+from cowrie import mirage_state
+from cowrie.commands.mirage_coreutils import Declining, Users
+from cowrie.commands.mirage_fileutils import _apply_symbolic, _mode_string, _octal
+from cowrie.shell import fs as cfs
+
+if TYPE_CHECKING:
+    from collections.abc import Callable
+
+commands = {}
+
+TYPES = {
+    "f": cfs.T_FILE,
+    "d": cfs.T_DIR,
+    "l": cfs.T_LINK,
+    "b": cfs.T_BLK,
+    "c": cfs.T_CHR,
+    "s": cfs.T_SOCK,
+    "p": cfs.T_FIFO,
+}
+LETTER = {v: k for k, v in TYPES.items()}
+# Primaries GNU find has and this does not: asked for, the command declines.
+NOT_HERE = frozenset(
+    """-regex -iregex -regextype -samefile -inum -fstype -lname -ilname -used -context
+    -fls -fprint -fprint0 -fprintf -ok -okdir -execdir -newerXY -anewer -cnewer -xtype
+    -ipath -iwholename -files0-from -warn -nowarn -ignore_readdir_race
+    -noignore_readdir_race -help --help -version --version -L -H -D -O""".split()
+)
+TAKES_ARG = frozenset(
+    """-name -iname -path -wholename -type -user -group -uid -gid -perm -size -newer
+    -mtime -ctime -atime -mmin -cmin -amin -links -maxdepth -mindepth -printf""".split()
+)
+NO_ARG = frozenset(
+    """-print -print0 -ls -delete -prune -quit -empty -readable -writable -executable
+    -nouser -nogroup -true -false -depth -d -xdev -mount -noleaf -daystart""".split()
+)
+PRINTF_OK = frozenset("pfhPsmMugUGydlink%")
+UNITS = {"c": 1, "w": 2, "b": 512, "k": 1024, "M": 1024**2, "G": 1024**3}
+
+
+class Bad(Exception):
+    """The expression is not one find accepts: its message, as find words it."""
+
+
+class Entry:
+    __slots__ = ("depth", "node", "path", "shown", "start")
+
+    def __init__(self, shown: str, path: str, node: Any, depth: int, start: str) -> None:
+        self.shown, self.path, self.node, self.depth, self.start = shown, path, node, depth, start
+
+    @property
+    def name(self) -> str:
+        return posixpath.basename(self.shown.rstrip("/")) or self.shown
+
+
+class Runs(Declining):
+    """A command that has the shell run command lines for it, in a shell of
+    its own that writes where this command writes."""
+
+    def run_lines(self, lines: list[str]) -> None:
+        """Run them in order, then call ``ran`` with the child's last status."""
+        from cowrie.shell.honeypot import HoneyPotShell
+
+        if not lines:
+            self.ran(0)
+            return
+        self._child = HoneyPotShell(self.protocol, interactive=False)
+        self.protocol.cmdstack.append(self._child)
+        self._child.lineReceived("\n".join(lines))
+        # The child takes itself off the stack when its last command is done,
+        # now or later, and resumes this command (see resume).
+
+    def resume(self) -> None:
+        child = getattr(self, "_child", None)
+        if child is not None and child not in self.protocol.cmdstack:
+            self._child = None
+            self.ran(int(child.last_exit_code))
+
+    def ran(self, status: int) -> None:
+        self.exit()
+
+    def program_exists(self, word: str) -> bool:
+        if word in self.shell.functions:
+            return True
+        paths = self.environ.get("PATH", "").split(":")
+        return self.protocol.getCommand(word, paths, self.cwd) is not None
+
+
+class Command_find(Runs):
+    name = "find"
+    program = "/usr/bin/find"
+    PRIMARIES: ClassVar[frozenset[str]] = TAKES_ARG | NO_ARG | {"-exec", "-a", "-and", "-o"}
+
+    @classmethod
+    def split(cls, args: list[str]) -> tuple[list[str], list[str]]:
+        """(start points, expression)."""
+        for index, arg in enumerate(args):
+            if arg in ("(", ")", "!", ",") or (arg.startswith("-") and len(arg) > 1):
+                return args[:index], args[index:]
+        return list(args), []
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        _, expr = cls.split(args)
+        if any(a in NOT_HERE or a.startswith("-newer") and a != "-newer" for a in expr):
+            return True
+        outputs = sum(a in ("-print", "-print0", "-ls", "-printf") for a in expr)
+        execs = expr.count("-exec")
+        # Commands run after the walk here; with something printed during it,
+        # or tests that depend on a command's result, the order would differ.
+        if execs and (outputs or execs > 1 or "-o" in expr or "-or" in expr):
+            return True
+        if execs and expr[-1] not in (";", "+"):
+            return False  # a malformed -exec: find's own error
+        for index, arg in enumerate(expr):
+            if arg == "-printf" and index + 1 < len(expr):
+                fmt = expr[index + 1]
+                letters = [fmt[i + 1] for i, c in enumerate(fmt[:-1]) if c == "%"]
+                if any(ch not in PRINTF_OK for ch in letters):
+                    return True
+        return False
+
+    # -- the command
+
+    def start(self) -> None:
+        self.status = 0
+        self.pending: list[str] = []  # command lines -exec asked for
+        self.batch: tuple[list[str], list[str]] | None = None
+        self.stop = False
+        if self.mirage_declines(self.args):
+            self.not_emulated()
+            self.exit()
+            return
+        starts, words = self.split(self.args)
+        self.users = Users()
+        self.access = mirage_state.Access(self.shell)
+        self.now = time.time()
+        self.maxdepth: int | None = None
+        self.mindepth = 0
+        self.depth_first = False
+        self.has_action = False
+        try:
+            self.words, self.pos = words, 0
+            test = self.parse_or()
+            if self.pos < len(self.words):
+                if self.words[self.pos] == ")":
+                    raise Bad("you have too many ')'")
+                raise Bad(f"paths must precede expression: `{self.words[self.pos]}'")
+        except Bad as e:
+            self.errorWrite(f"find: {e}\n")
+            self.exit(1)
+            return
+        for shown in starts or ["."]:
+            if self.stop:
+                break
+            path = self.fs.resolve_path(shown, self.cwd)
+            node = self.fs.getfile(path, follow_symlinks=False) if shown else None
+            if node is None:
+                self.errorWrite(f"find: '{shown}': No such file or directory\n")
+                self.status = 1
+                continue
+            self.walk(Entry(shown, path, node, 0, shown), test)
+        if self.batch is not None and self.batch[1]:
+            head, found = self.batch
+            self.pending.append(" ".join(shlex.quote(w) for w in [*head, *found]))
+        self.run_lines(self.pending)
+
+    def ran(self, status: int) -> None:
+        self.exit(self.status)
+
+    def walk(self, entry: Entry, test: Callable[[Entry], bool]) -> None:
+        self.prune = False
+        judged = entry.depth >= self.mindepth
+        if judged and not self.depth_first:
+            self.judge(entry, test)
+        if self.stop:
+            return
+        is_dir = entry.node[cfs.A_TYPE] == cfs.T_DIR
+        deeper = self.maxdepth is None or entry.depth < self.maxdepth
+        if is_dir and deeper and not (self.prune and not self.depth_first):
+            seen = self.access.at(entry.path)
+            if seen is not None and not (self.access.may(seen, 4) and self.access.may(seen, 1)):
+                self.errorWrite(f"find: '{entry.shown}': Permission denied\n")
+                self.status = 1
+            else:
+                for child in list(entry.node[cfs.A_CONTENTS]):
+                    name = child[cfs.A_NAME]
+                    shown = entry.shown + name if entry.shown.endswith("/") else f"{entry.shown}/{name}"
+                    path = posixpath.join(entry.path, name)
+                    # Fetched by path, so that what is changed is this session's own.
+                    node = self.fs.getfile(path, follow_symlinks=False)
+                    if node is not None:
+                        self.walk(Entry(shown, path, node, entry.depth + 1, entry.start), test)
+                    if self.stop:
+                        return
+        if judged and self.depth_first:
+            self.judge(entry, test)
+
+    def judge(self, entry: Entry, test: Callable[[Entry], bool]) -> None:
+        if test(entry) and not self.has_action:
+            self.write(entry.shown + "\n")
+
+    # -- the expression
+
+    def peek(self) -> str | None:
+        return self.words[self.pos] if self.pos < len(self.words) else None
+
+    def parse_or(self) -> Callable[[Entry], bool]:
+        if self.peek() in ("-o", "-or"):
+            raise Bad("invalid expression; you have used a binary operator '-o' with nothing before it.")
+        left = self.parse_and()
+        while self.peek() in ("-o", "-or"):
+            self.pos += 1
+            if self.peek() in (None, ")"):
+                raise Bad("invalid expression; you have used a binary operator '-o' with nothing after it.")
+            right = self.parse_and()
+            left = (lambda a, b: lambda e: a(e) or b(e))(left, right)
+        return left
+
+    def parse_and(self) -> Callable[[Entry], bool]:
+        terms: list[Callable[[Entry], bool]] = []
+        while self.peek() not in (None, ")", "-o", "-or"):
+            if self.peek() in ("-a", "-and"):
+                self.pos += 1
+                continue
+            terms.append(self.parse_not())
+        if not terms:
+            return lambda e: True
+        return lambda e: all(t(e) for t in terms)
+
+    def parse_not(self) -> Callable[[Entry], bool]:
+        word = self.peek()
+        if word in ("!", "-not"):
+            self.pos += 1
+            if self.peek() in (None, ")", "-o", "-or", "-a", "-and"):
+                raise Bad(f"expected an expression after '{word}'")
+            inner = self.parse_not()
+            return lambda e: not inner(e)
+        if word == "(":
+            self.pos += 1
+            inner = self.parse_or()
+            if self.peek() != ")":
+                raise Bad(
+                    "invalid expression; I was expecting to find a ')' somewhere but did not see one."
+                )
+            self.pos += 1
+            return inner
+        return self.primary()
+
+    def argument(self, name: str) -> str:
+        if self.pos >= len(self.words):
+            raise Bad(f"missing argument to `{name}'")
+        value = self.words[self.pos]
+        self.pos += 1
+        return value
+
+    def number(self, name: str, text: str) -> tuple[str, int]:
+        """A numeric argument: its sign (+, - or none) and its value."""
+        sign = text[0] if text[:1] in "+-" else ""
+        digits = text[len(sign) :]
+        if not digits.isdigit():
+            raise Bad(f"invalid argument `{text}' to `{name}'")
+        return sign, int(digits)
+
+    @staticmethod
+    def compare(sign: str, wanted: int, value: int) -> bool:
+        return value > wanted if sign == "+" else value < wanted if sign == "-" else value == wanted
+
+    def primary(self) -> Callable[[Entry], bool]:
+        name = self.words[self.pos]
+        self.pos += 1
+        if name not in self.PRIMARIES:
+            if name.startswith("-") or name in (",",):
+                raise Bad(f"unknown predicate `{name}'")
+            raise Bad(f"paths must precede expression: `{name}'")
+        if name in ("-maxdepth", "-mindepth"):
+            text = self.argument(name)
+            if not text.isdigit():
+                raise Bad(
+                    f"Expected a positive decimal integer argument to {name}, but got '{text}'"
+                )
+            if name == "-maxdepth":
+                self.maxdepth = int(text)
+            else:
+                self.mindepth = int(text)
+            return lambda e: True
+        if name in ("-depth", "-d"):
+            self.depth_first = True
+            return lambda e: True
+        if name in ("-xdev", "-mount", "-noleaf", "-daystart", "-true"):
+            return lambda e: True
+        if name == "-false":
+            return lambda e: False
+        if name in ("-name", "-iname"):
+            pattern = self.argument(name)
+            if name == "-iname":
+                return lambda e: fnmatch.fnmatchcase(e.name.lower(), pattern.lower())
+            return lambda e: fnmatch.fnmatchcase(e.name, pattern)
+        if name in ("-path", "-wholename"):
+            pattern = self.argument(name)
+            return lambda e: fnmatch.fnmatchcase(e.shown, pattern)
+        if name == "-type":
+            text = self.argument(name)
+            kinds = set()
+            for letter in text.split(","):
+                if letter not in TYPES:
+                    raise Bad(f"Unknown argument to -type: {letter}")
+                kinds.add(TYPES[letter])
+            return lambda e: e.node[cfs.A_TYPE] in kinds
+        if name in ("-user", "-uid"):
+            text = self.argument(name)
+            if name == "-uid":
+                sign, wanted = self.number(name, text)
+                return lambda e: self.compare(sign, wanted, int(e.node[cfs.A_UID]))
+            entry = self.users.entry(text)
+            if entry is None and not text.isdigit():
+                raise Bad(f"'{text}' is not the name of a known user")
+            uid = int(entry["pw_uid"]) if entry else int(text)
+            return lambda e: int(e.node[cfs.A_UID]) == uid
+        if name in ("-group", "-gid"):
+            text = self.argument(name)
+            if name == "-gid":
+                sign, wanted = self.number(name, text)
+                return lambda e: self.compare(sign, wanted, int(e.node[cfs.A_GID]))
+            found = next((g for g in self.users.group if g["gr_name"] == text), None)
+            if found is None and not text.isdigit():
+                raise Bad(f"'{text}' is not the name of an existing group")
+            gid = int(found["gr_gid"]) if found else int(text)
+            return lambda e: int(e.node[cfs.A_GID]) == gid
+        if name in ("-nouser", "-nogroup"):
+            if name == "-nouser":
+                known = {int(p["pw_uid"]) for p in self.users.passwd}
+                return lambda e: int(e.node[cfs.A_UID]) not in known
+            groups = {int(g["gr_gid"]) for g in self.users.group}
+            return lambda e: int(e.node[cfs.A_GID]) not in groups
+        if name == "-perm":
+            text = self.argument(name)
+            how = text[0] if text[:1] in "-/" else ""
+            body = text[len(how) :]
+            mode = _octal(body) if body.isdigit() else _apply_symbolic(body, 0, False)
+            if mode is None or (body.isdigit() and _octal(body) is None):
+                raise Bad(f"invalid mode '{text}'")
+            if how == "-":
+                return lambda e: int(e.node[cfs.A_MODE]) & mode == mode
+            if how == "/":
+                return lambda e: bool(int(e.node[cfs.A_MODE]) & mode) or mode == 0
+            return lambda e: int(e.node[cfs.A_MODE]) & 0o7777 == mode
+        if name == "-size":
+            text = self.argument(name)
+            unit = UNITS.get(text[-1:]) if text[-1:].isalpha() else 512
+            if unit is None:
+                raise Bad(f"invalid -size type `{text[-1]}'")
+            sign, wanted = self.number(name, text.rstrip("cwbkMG") or text)
+            return lambda e: self.compare(sign, wanted, -(-self.size(e.node) // unit))
+        if name == "-empty":
+            return lambda e: (
+                not e.node[cfs.A_CONTENTS]
+                if e.node[cfs.A_TYPE] == cfs.T_DIR
+                else e.node[cfs.A_TYPE] == cfs.T_FILE and self.size(e.node) == 0
+            )
+        if name == "-newer":
+            text = self.argument(name)
+            other = self.fs.getfile(self.fs.resolve_path(text, self.cwd))
+            if other is None:
+                raise Bad(f"'{text}': No such file or directory")
+            stamp = float(other[cfs.A_CTIME])
+            return lambda e: float(e.node[cfs.A_CTIME]) > stamp
+        if name in ("-mtime", "-ctime", "-atime", "-mmin", "-cmin", "-amin"):
+            sign, wanted = self.number(name, self.argument(name))
+            unit = 60 if name.endswith("min") else 86400
+            return lambda e: self.compare(
+                sign, wanted, int(max(0.0, self.now - float(e.node[cfs.A_CTIME])) // unit)
+            )
+        if name == "-links":
+            sign, wanted = self.number(name, self.argument(name))
+            return lambda e: self.compare(sign, wanted, self.links(e.node))
+        if name in ("-readable", "-writable", "-executable"):
+            bit = {"-readable": 4, "-writable": 2, "-executable": 1}[name]
+
+            def allowed(e: Entry) -> bool:
+                seen = self.access.at(e.path, follow=True)
+                if seen is None:
+                    return False
+                if bit == 1 and self.access.uid == 0:
+                    return seen.kind == "dir" or bool(seen.mode & 0o111)
+                return self.access.may(seen, bit)
+
+            return allowed
+        if name == "-prune":
+
+            def prune(e: Entry) -> bool:
+                self.prune = True
+                return True
+
+            return prune
+        if name == "-quit":
+            self.has_action = True
+
+            def quit_(e: Entry) -> bool:
+                self.stop = True
+                return True
+
+            return quit_
+        if name in ("-print", "-print0"):
+            self.has_action = True
+            end = "\n" if name == "-print" else "\0"
+
+            def show(e: Entry) -> bool:
+                self.write(e.shown + end)
+                return True
+
+            return show
+        if name == "-ls":
+            self.has_action = True
+
+            def listing(e: Entry) -> bool:
+                self.write(self.ls_line(e))
+                return True
+
+            return listing
+        if name == "-printf":
+            self.has_action = True
+            fmt = self.argument(name)
+
+            def formatted(e: Entry) -> bool:
+                self.write(self.printf(fmt, e))
+                return True
+
+            return formatted
+        if name == "-delete":
+            self.has_action = True
+            self.depth_first = True
+            return self.delete
+        # -exec
+        self.has_action = True
+        head: list[str] = []
+        while self.pos < len(self.words) and self.words[self.pos] not in (";", "+"):
+            head.append(self.words[self.pos])
+            self.pos += 1
+        if self.pos >= len(self.words) or not head:
+            raise Bad("missing argument to `-exec'")
+        end = self.words[self.pos]
+        self.pos += 1
+        if end == "+" and head[-1] == "{}":
+            self.batch = (head[:-1], [])
+
+            def collect(e: Entry) -> bool:
+                assert self.batch is not None
+                self.batch[1].append(e.shown)
+                return True
+
+            return collect
+        missing = not self.program_exists(head[0])
+
+        def run(e: Entry) -> bool:
+            if missing:
+                self.errorWrite(f"find: '{head[0]}': No such file or directory\n")
+                return False
+            words = [w.replace("{}", e.shown) for w in head]
+            self.pending.append(" ".join(shlex.quote(w) for w in words))
+            return True
+
+        return run
+
+    # -- what the tests and actions read
+
+    @staticmethod
+    def size(node: Any) -> int:
+        if node[cfs.A_TYPE] == cfs.T_LINK:
+            return len(str(node[cfs.A_TARGET] or ""))
+        return int(node[cfs.A_SIZE])
+
+    @staticmethod
+    def links(node: Any) -> int:
+        if node[cfs.A_TYPE] != cfs.T_DIR:
+            return 1
+        return 2 + sum(1 for x in node[cfs.A_CONTENTS] if x[cfs.A_TYPE] == cfs.T_DIR)
+
+    def type_and_mode(self, node: Any) -> str:
+        kind = LETTER.get(node[cfs.A_TYPE], "f")
+        return ("-" if kind == "f" else kind) + _mode_string(int(node[cfs.A_MODE]) & 0o7777)
+
+    def ls_line(self, e: Entry) -> str:
+        from cowrie.commands.mirage_coreutils import inode_of
+
+        node = e.node
+        size = self.size(node)
+        blocks = 0 if node[cfs.A_TYPE] == cfs.T_LINK else -(-size // 4096) * 4
+        stamp = float(node[cfs.A_CTIME])
+        recent = abs(self.now - stamp) < 15552000  # six months, as ls decides it
+        when = time.strftime("%b %e %H:%M" if recent else "%b %e  %Y", time.gmtime(stamp))
+        shown = e.shown
+        if node[cfs.A_TYPE] == cfs.T_LINK:
+            shown += f" -> {node[cfs.A_TARGET]}"
+        return (
+            f"{inode_of(e.path):9d} {blocks:6d} {self.type_and_mode(node)} {self.links(node):3d} "
+            f"{self.users.name(int(node[cfs.A_UID])):<8} "
+            f"{self.users.group_name(int(node[cfs.A_GID])):<8} {size:8d} {when} {shown}\n"
+        )
+
+    def printf(self, fmt: str, e: Entry) -> str:
+        from cowrie.commands.mirage_coreutils import inode_of
+
+        node = e.node
+        start = e.start.rstrip("/") or "/"
+        relative = e.shown[len(start) :].lstrip("/") if e.shown.startswith(start) else e.shown
+        values = {
+            "p": e.shown,
+            "f": e.name,
+            "h": posixpath.dirname(e.shown.rstrip("/")) or ("/" if e.shown.startswith("/") else "."),
+            "P": relative,
+            "s": str(self.size(node)),
+            "m": f"{int(node[cfs.A_MODE]) & 0o7777:o}",
+            "M": self.type_and_mode(node),
+            "u": self.users.name(int(node[cfs.A_UID])),
+            "g": self.users.group_name(int(node[cfs.A_GID])),
+            "U": str(node[cfs.A_UID]),
+            "G": str(node[cfs.A_GID]),
+            "y": LETTER.get(node[cfs.A_TYPE], "f"),
+            "d": str(e.depth),
+            "l": str(node[cfs.A_TARGET] or "") if node[cfs.A_TYPE] == cfs.T_LINK else "",
+            "i": str(inode_of(e.path)),
+            "n": str(self.links(node)),
+            "k": str(-(-self.size(node) // 4096) * 4),
+            "%": "%",
+        }
+        escapes = {"n": "\n", "t": "\t", "0": "\0", "\\": "\\", "r": "\r", "a": "\a"}
+        out, i = [], 0
+        while i < len(fmt):
+            c = fmt[i]
+            if c == "%" and i + 1 < len(fmt):
+                out.append(values.get(fmt[i + 1], "%" + fmt[i + 1]))
+                i += 2
+            elif c == "\\" and i + 1 < len(fmt):
+                out.append(escapes.get(fmt[i + 1], "\\" + fmt[i + 1]))
+                i += 2
+            else:
+                out.append(c)
+                i += 1
+        return "".join(out)
+
+    def delete(self, e: Entry) -> bool:
+        if e.path == "/" or e.shown in (".", "./"):
+            return True
+        try:
+            self.access.may_unlink(e.path)
+        except mirage_state.Rejected as bad:
+            self.errorWrite(f"find: cannot delete '{e.shown}': {os.strerror(bad.code or 13)}\n")
+            self.status = 1
+            return False
+        node = self.fs.getfile(e.path, follow_symlinks=False)
+        if node is None:
+            return False
+        if node[cfs.A_TYPE] == cfs.T_DIR:
+            if node[cfs.A_CONTENTS]:
+                self.errorWrite(f"find: cannot delete '{e.shown}': Directory not empty\n")
+                self.status = 1
+                return False
+            self.fs.rmdir(e.path)
+        else:
+            self.fs.remove(e.path)
+        return True
+
+
+commands["find"] = Command_find
+commands["/usr/bin/find"] = Command_find
+commands["/bin/find"] = Command_find
