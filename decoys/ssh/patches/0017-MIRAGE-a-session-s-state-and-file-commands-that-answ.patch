+def expand(value: Any) -> Any:
+    """'@repeat:X:N' is X written N times; the cases file keeps long values short."""
+    if isinstance(value, str):
+        return re.sub(r"@repeat:(.):(\d+)", lambda m: m.group(1) * int(m.group(2)), value)
+    if isinstance(value, list):
+        return [expand(v) for v in value]
+    if isinstance(value, dict):
+        return {k: expand(v) for k, v in value.items()}
+    return value
+
+
+def snapshot(fs: Any, top: str) -> dict[str, tuple[Any, ...]]:
+    """Everything at and under ``top``: type, mode, owner, size and contents."""
+    out: dict[str, tuple[Any, ...]] = {}
+
+    def walk(path: str) -> None:
+        node = fs.getfile(path, follow_symlinks=False)
+        if node is None:
+            return
+        contents = node[cfs.A_CONTENTS]
+        out[path] = (
+            node[cfs.A_TYPE],
+            node[cfs.A_MODE],
+            node[cfs.A_UID],
+            node[cfs.A_GID],
+            node[cfs.A_SIZE] if node[cfs.A_TYPE] == cfs.T_FILE else None,
+            bytes(contents) if isinstance(contents, bytes) else None,
+        )
+        if node[cfs.A_TYPE] == cfs.T_DIR:
+            for name in sorted(x[cfs.A_NAME] for x in contents):
+                walk(f"{path.rstrip('/')}/{name}")
+
+    walk(top)
+    return out
+
