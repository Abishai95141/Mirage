+class Command_realpath(_Tool):
+    name = "realpath"
+    program = "/usr/bin/realpath"
+    short = "emsqLP"
+    long = ("canonicalize-existing", "canonicalize-missing", "strip", "no-symlinks", "quiet",
+            "relative-to=", "logical", "physical")  # fmt: skip
+    declined = ("help", "version", "z", "zero", "relative-base")
+
+    def call(self) -> None:
+        got = self.options()
+        if got is None:
+            return
+        opts, operands = got
+        if not operands:
+            self.usage("missing operand")
+            return
+        need = "e" if "-e" in opts or "--canonicalize-existing" in opts else "f"
+        if "-m" in opts or "--canonicalize-missing" in opts:
+            need = "m"
+        lexical = any(o in opts for o in ("-s", "--strip", "--no-symlinks"))
+        base = opts.get("--relative-to")
+        if base is not None:
+            base, _ = canonical(self.fs, base, self.cwd, "m")
+        for operand in operands:
+            if lexical:
+                joined = operand if operand.startswith("/") else f"{self.cwd}/{operand}"
+                found, code = posixpath.normpath(joined), 0
+            else:
+                found, code = canonical(self.fs, operand, self.cwd, need)
+            if found is None:
+                if "-q" not in opts and "--quiet" not in opts:
+                    self.errorWrite(f"realpath: {operand}: {os.strerror(code)}\n")
+                self.exit_code = 1
+                continue
+            self.write((posixpath.relpath(found, base) if base else found) + "\n")
+
