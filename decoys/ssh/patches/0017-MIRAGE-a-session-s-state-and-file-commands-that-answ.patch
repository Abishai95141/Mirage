+class ChecksumTests(Base):
+    """The image's programs are in the tree as names and sizes, not bytes."""
+
+    def setUp(self) -> None:
+        import hashlib
+        import sqlite3
+
+        from cowrie.commands import mirage_moreutils
+
+        super().setUp()
+        self.moreutils = mirage_moreutils
+        self.table = os.path.join(tempfile.mkdtemp(), "hashes.db")
+        db = sqlite3.connect(self.table)
+        db.execute("CREATE TABLE hashes (path TEXT PRIMARY KEY, md5 BLOB, sha1 BLOB, sha256 BLOB, sha512 BLOB)")
+        self.real = b"the real bytes of the program\n"
+        sums = [hashlib.new(k, self.real).digest() for k in ("md5", "sha1", "sha256", "sha512")]
+        # The table names a file by its real path: /bin is a link on Debian 12.
+        for path in ("/bin/ls", "/usr/bin/ls"):
+            db.execute("INSERT INTO hashes VALUES (?, ?, ?, ?, ?)", (path, *sums))
+        db.commit()
+        db.close()
+        self.md5 = hashlib.md5(self.real).hexdigest()  # noqa: S324
+        self.addCleanup(self.restore)
+
+    def restore(self) -> None:
+        os.environ.pop("COWRIE_MIRAGE_FILE_HASHES", None)
+        self.moreutils.reset_hashes_for_tests()
+
+    def forget(self) -> None:
+        """A deployment with no table (the configuration may name one of its own)."""
+        os.environ["COWRIE_MIRAGE_FILE_HASHES"] = "/nonexistent/hashes.db"
+        self.moreutils.reset_hashes_for_tests()
+
+    def use_table(self) -> None:
+        os.environ["COWRIE_MIRAGE_FILE_HASHES"] = self.table
+        self.moreutils.reset_hashes_for_tests()
+
+    def test_a_program_of_the_image_has_its_recorded_checksum(self) -> None:
+        self.use_table()
+        self.assertEqual(self.run_line("md5sum /bin/ls"), f"{self.md5}  /bin/ls\n")
+        self.assertRegex(self.run_line("sha256sum /bin/ls"), r"^[0-9a-f]{64}  /bin/ls\n$")
+        self.assertEqual(self.run_line("md5sum --tag /bin/ls"), f"MD5 (/bin/ls) = {self.md5}\n")
+        self.assertEqual(self.run_line(f"echo '{self.md5}  /bin/ls' | md5sum -c"), "/bin/ls: OK\n")
+
+    def test_without_a_record_it_is_not_guessed(self) -> None:
+        self.forget()
+        self.assertIn("cannot execute binary file", self.run_line("md5sum /bin/ls"))
+        self.use_table()
+        self.assertIn("cannot execute binary file", self.run_line("md5sum /bin/cat"))  # not in the table
+
+    def test_what_the_session_wrote_is_hashed_as_written(self) -> None:
+        self.use_table()
+        self.assertEqual(
+            self.run_line("echo hello > /tmp/h; md5sum /tmp/h"),
+            "b1946ac92492d2347c6235b4d2611184  /tmp/h\n",
+        )
+        # A program the session has overwritten is no longer the image's.
+        self.assertEqual(
+            self.run_line("cp /tmp/h /tmp/ls; md5sum /tmp/ls"),
+            "b1946ac92492d2347c6235b4d2611184  /tmp/ls\n",
+        )
+
