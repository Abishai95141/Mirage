index 0000000..37fadbb
--- /dev/null
+++ b/src/cowrie/mirage_state.py
@@ -0,0 +1,814 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE session state. A journal of what a session changed, an applier
+# ABOUTME: for operations decided outside the emulator, and the view sent with them.
+
+"""MIRAGE session state for the Cowrie shell.
+
+Cowrie owns a session's filesystem, working directory and environment, and
+nothing outside it may change them directly. Two things outside it need to:
+a responder that answers a command the emulator has nothing for, and a policy
+that plants a file. Both send *operations* from a small vocabulary. This
+module is the only door they come through.
+
+``Journal``
+    What the session changed, numbered from 1: every ``cowrie.fs.change`` the
+    filesystem reports, plus changes of directory and environment and the
+    processes an answer started. The responder keeps a mirror built from it,
+    so that what it validates against is what the session has. It is capped;
+    a session over the cap no longer has a complete journal and stops being
+    offered to the responder.
+
+``apply``
+    Takes one answer's operations. Checks their shape, then checks each
+    against the session's own filesystem in order (the parent exists, the
+    user may make the change, nothing protected is touched, the session
+    stays inside its caps), and only then calls the mutators an emulated
+    command calls. All of an answer's operations apply, or none: an error
+    part-way undoes what was done and no event is emitted.
+
+``view``
+    The part of the filesystem a command names, as the session's user could
+    see it for themselves: what is sent with a request so that an answer can
+    agree with the files that are there.
+
+The vocabulary and its caps are the gate contract's (``mirage_schema.ops`` in
+the MIRAGE repository). The two are held to the same verdicts by a shared
+file of cases, ``test/mirage_ops_cases.json``.
+"""
+
+from __future__ import annotations
+
+import errno
+import json
+import posixpath
+import re
+import stat
+import time
+from typing import TYPE_CHECKING, Any
+
+from twisted.logger import Logger
+
+from cowrie.shell import fs as cfs
+
+if TYPE_CHECKING:
+    from collections.abc import Callable, Iterable
+
+    from cowrie.shell.honeypot import HoneyPotShell
+
+log = Logger()
+
+# The contract's caps (mirage_schema.ops, mirage_schema.respond).
+MAX_OPS = 8
+MAX_WRITE_BYTES = 4096
+MAX_PATH_BYTES = 1024
+MAX_VALUE_BYTES = 4096
+PROTECTED = ("/proc", "/sys", "/dev")
+MAX_SLICE = 256
+HEAD_BYTES = 1024
+MAX_CHILDREN = 200
+# What one session's answers may add up to (the responder holds the same).
+SESSION_WRITE_BYTES = 64 * 1024
+SESSION_FILES = 64
+SESSION_PROCESSES = 16
+# The journal itself.
+MAX_JOURNAL = 4096
+MAX_JOURNAL_BYTES = 256 * 1024
+MAX_ENV_SENT = 64
+
+KINDS = (
+    "mkdir",
+    "write",
+    "remove",
+    "rename",
+    "chmod",
+    "chown",
+    "cd",
+    "setenv",
+    "unsetenv",
+    "proc_start",
+    "proc_end",
+)
+FILESYSTEM = frozenset({"mkdir", "write", "remove", "rename", "chmod", "chown"})
+_NEEDS: dict[str, tuple[str, ...]] = {
+    "mkdir": ("path",),
+    "write": ("path", "content"),
+    "remove": ("path",),
+    "rename": ("path", "to"),
+    "chmod": ("path", "mode"),
+    "chown": ("path",),
+    "cd": ("path",),
+    "setenv": ("name", "value"),
+    "unsetenv": ("name",),
+    "proc_start": ("args",),
+    "proc_end": ("pid",),
+}
+_MAY: dict[str, tuple[str, ...]] = {
+    "mkdir": ("mode",),
+    "write": ("mode",),
+    "chown": ("uid", "gid"),
+}
+_FIELDS = ("path", "to", "content", "mode", "uid", "gid", "name", "value", "args", "pid")
+_STRINGS = ("path", "to", "content", "name", "value", "args")
+_RANGES = {"mode": (0, 0o7777), "uid": (0, 65535), "gid": (0, 65535), "pid": (2, 4194304)}
+_NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,127}$")
+
+
+class Rejected(Exception):
+    """An answer's operations cannot be applied. None of them is.
+
+    ``code`` is the error number the kernel would give for the same refusal,
+    where there is one: the emulator's own commands use these checks too, and
+    report with it."""
+
+    def __init__(self, message: str, code: int = 0) -> None:
+        super().__init__(message)
+        self.code = code
+
+
+# ------------------------------------------------------------------- journal
+
+
+class Journal:
+    """What one session changed, in order."""
+
+    def __init__(self) -> None:
+        self.entries: list[dict[str, Any]] = []
+        self.seq = 0
+        self.size = 0
+        self.full = False
+        # Where the shell was and what it had set when last looked at, and
+        # what it had set to begin with.
+        self._cwd: str | None = None
+        self._env: dict[str, str] | None = None
+        self.env0: dict[str, str] = {}
+        # Processes answers have started: pid -> (command line, when).
+        self.procs: dict[int, tuple[str, float]] = {}
+        # What applied operations have added up to.
+        self.written = 0
+        self.made = 0
+
+    def add(self, op: str, **fields: Any) -> None:
+        if self.full:
+            return
+        entry: dict[str, Any] = {"seq": self.seq + 1, "op": op}
+        for key, value in fields.items():
+            if value is None:
+                continue
+            if key == "mode":
+                value = int(value) & 0o7777  # the event carries the file type too
+            entry[key] = value
+        size = len(json.dumps(entry, separators=(",", ":")))
+        if len(self.entries) >= MAX_JOURNAL or self.size + size > MAX_JOURNAL_BYTES:
+            # From here on the journal would have holes, and a mirror built
+            # from it would be wrong. The session is answered by the emulator
+            # alone for the rest of its life.
+            self.full = True
+            return
+        self.seq += 1
+        self.size += size
+        self.entries.append(entry)
+
+    def sync(self, shell: HoneyPotShell) -> None:
+        """Note a change of directory or environment since last looked.
+
+        The shell changes these in many places (``cd``, ``export``, an
+        assignment, ``unset``, a subshell ending), so they are compared here,
+        before each command, and not hooked at each."""
+        cwd, env = shell.cwd, shell.environ
+        if self._env is None:
+            self._cwd, self._env, self.env0 = cwd, dict(env), dict(env)
+            return
+        if cwd != self._cwd:
+            self.add("cd", path=cwd)
+            self._cwd = cwd
+        if env != self._env:
+            for name in sorted(set(self._env) - set(env)):
+                self.add("unsetenv", name=name)
+            for name in sorted(env):
+                if self._env.get(name) != env[name]:
+                    self.add("setenv", name=name, value=str(env[name])[:MAX_VALUE_BYTES])
+            self._env = dict(env)
+
+    def since(self, seq: int) -> list[dict[str, Any]]:
+        """The entries after number ``seq``."""
+        return self.entries[seq:] if seq < len(self.entries) else []
+
+    def changed_env(self, shell: HoneyPotShell) -> dict[str, str]:
+        """What the session has set that it did not start with."""
+        out = {
+            k: str(v)[:256]
+            for k, v in shell.environ.items()
+            if self.env0.get(k) != v and _NAME.match(k)
+        }
+        return dict(sorted(out.items())[:MAX_ENV_SENT])
+
+
+def journal_of(protocol: Any) -> Journal:
+    """The session's journal, made the first time it is asked for."""
+    journal = getattr(protocol, "mirage_journal", None)
+    if journal is None:
+        journal = protocol.mirage_journal = Journal()
+        protocol.fs.mirage_journal = journal
+    return journal  # type: ignore[no-any-return]
+
+
+# ------------------------------------------------------------------- shape
+
+
+def protected(path: str) -> bool:
+    return any(path == p or path.startswith(p + "/") for p in PROTECTED)
+
+
+def well_formed(path: str) -> str | None:
+    """What is wrong with a path as a path, or None. It must be absolute and
+    already in its simplest form: what is checked is then what is applied."""
+    if not path.startswith("/"):
+        return "not absolute"
+    if "\0" in path or len(path.encode("utf8", "replace")) > MAX_PATH_BYTES:
+        return "not a usable path"
+    if posixpath.normpath(path) != path:
+        return "not normalised"
+    return None
+
+
+def check_shape(raw: Any) -> list[dict[str, Any]]:
+    """The operations of one answer with nothing but their own fields, or
+    ``Rejected`` naming the first thing wrong."""
+    if raw is None:
+        return []
+    if not isinstance(raw, list):
+        raise Rejected("operations are a list")
+    if len(raw) > MAX_OPS:
+        raise Rejected(f"more than {MAX_OPS} operations")
+    out = []
+    for index, item in enumerate(raw, 1):
+        try:
+            out.append(_one(item))
+        except Rejected as e:
+            raise Rejected(f"operation {index}: {e}") from None
+    return out
+
+
+def _one(item: Any) -> dict[str, Any]:
+    if not isinstance(item, dict):
+        raise Rejected("not an object")
+    kind = item.get("op")
+    if not isinstance(kind, str) or kind not in KINDS:
+        raise Rejected("no operation of that name")
+    unknown = set(item) - {"op", *_FIELDS}
+    if unknown:
+        raise Rejected(f"{kind} does not take {sorted(unknown)}")
+    op: dict[str, Any] = {"op": kind}
+    for field in _FIELDS:
+        value = item.get(field)
+        if value is None:
+            continue
+        if field in _STRINGS:
+            if not isinstance(value, str):
+                raise Rejected(f"{kind}: {field} is not text")
+        else:
+            low, high = _RANGES[field]
+            if isinstance(value, bool) or not isinstance(value, int) or not low <= value <= high:
+                raise Rejected(f"{kind}: {field} is not a number from {low} to {high}")
+        op[field] = value
+    given = set(op) - {"op"}
+    needs, may = set(_NEEDS[kind]), set(_MAY.get(kind, ()))
+    if needs - given:
+        raise Rejected(f"{kind} needs {sorted(needs - given)}")
+    if given - needs - may:
+        raise Rejected(f"{kind} does not take {sorted(given - needs - may)}")
+    if kind == "chown" and "uid" not in op and "gid" not in op:
+        raise Rejected("chown needs a uid or a gid")
+    for field in ("path", "to"):
+        if field not in op:
+            continue
+        wrong = well_formed(op[field])
+        if wrong:
+            raise Rejected(f"{kind}: {field} is {wrong}")
+        if kind in FILESYSTEM and protected(op[field]):
+            raise Rejected(f"{kind}: {field} is under a directory the kernel fills")
+    if kind in FILESYSTEM and op["path"] == "/":
+        raise Rejected(f"{kind}: not the root")
+    if "content" in op and len(op["content"].encode("utf8", "replace")) > MAX_WRITE_BYTES:
+        raise Rejected(f"write: content over {MAX_WRITE_BYTES} bytes")
+    if "name" in op and not _NAME.match(op["name"]):
+        raise Rejected(f"{kind}: not a variable name")
+    for field in ("value", "args"):
+        if field in op and (
+            len(op[field].encode("utf8", "replace")) > MAX_VALUE_BYTES or "\0" in op[field]
+        ):
+            raise Rejected(f"{kind}: {field} is too long or holds a NUL")
+    return op
+
+
+# ------------------------------------------------------------------- applier
+
+
+class _Seen:
+    """What is at a path, for the checks: taken from the filesystem, then
+    overlaid with what the operations checked so far would have done."""
+
+    __slots__ = ("gid", "kind", "mode", "uid")
+
+    def __init__(self, kind: str, mode: int = 0, uid: int = 0, gid: int = 0) -> None:
+        self.kind, self.mode, self.uid, self.gid = kind, mode, uid, gid
+
+
+def _kind(node: cfs.Node) -> str:
+    return {cfs.T_DIR: "dir", cfs.T_FILE: "file", cfs.T_LINK: "link"}.get(node[cfs.A_TYPE], "other")
+
+
+class _Check:
+    def __init__(
+        self,
+        shell: HoneyPotShell | None,
+        protected_paths: Iterable[str],
+        *,
+        fs: Any = None,
+        user: dict[str, Any] | None = None,
+    ) -> None:
+        self.fs = fs if fs is not None else shell.protocol.fs  # type: ignore[union-attr]
+        who = user if user is not None else shell.user  # type: ignore[union-attr]
+        self.uid = int(who.get("uid", 0))
+        self.gid = int(who.get("gid", 0))
+        self.overlay: dict[str, _Seen | None] = {}
+        self.protected_paths = frozenset(protected_paths)
+
+    def at(self, path: str, follow: bool = False) -> _Seen | None:
+        if path in self.overlay:
+            return self.overlay[path]
+        if path == "/":
+            return _Seen("dir", stat.S_IFDIR | 0o755, 0, 0)
+        # A path under something the overlay removed or renamed is gone too.
+        probe = posixpath.dirname(path)
+        while probe not in ("/", ""):
+            if probe in self.overlay and (self.overlay[probe] is None):
+                return None
+            probe = posixpath.dirname(probe)
+        try:
+            node = self.fs.getfile(path, follow_symlinks=follow)
+        except Exception:
+            node = None
+        if node is None:
+            return None
+        return _Seen(_kind(node), int(node[cfs.A_MODE]), int(node[cfs.A_UID]), int(node[cfs.A_GID]))
+
+    def may(self, seen: _Seen, bit: int) -> bool:
+        """Whether the user has ``bit`` (4 read, 2 write, 1 search) on it."""
+        if self.uid == 0:
+            return True
+        if seen.uid == self.uid:
+            return bool(seen.mode & (bit << 6))
+        if seen.gid == self.gid:
+            return bool(seen.mode & (bit << 3))
+        return bool(seen.mode & bit)
+
+    def directory(self, path: str, why: str) -> _Seen:
+        """The directory at ``path`` (through links), which the user can
+        reach, or ``Rejected``."""
+        probe = "/"
+        for piece in [p for p in path.split("/") if p]:
+            above = self.at(probe, follow=True)
+            if above is None:
+                raise Rejected(f"{why} does not exist", errno.ENOENT)
+            if above.kind != "dir":
+                raise Rejected(f"{why} is not a directory", errno.ENOTDIR)
+            if not self.may(above, 1):
+                raise Rejected(f"{why} cannot be reached", errno.EACCES)
+            probe = posixpath.join(probe, piece)
+        seen = self.at(path, follow=True)
+        if seen is None:
+            raise Rejected(f"{why} does not exist", errno.ENOENT)
+        if seen.kind != "dir":
+            raise Rejected(f"{why} is not a directory", errno.ENOTDIR)
+        return seen
+
+    def writable_parent(self, path: str) -> _Seen:
+        parent = self.directory(posixpath.dirname(path), "the parent directory")
+        if not (self.may(parent, 2) and self.may(parent, 1)):
+            raise Rejected("the user may not write there", errno.EACCES)
+        return parent
+
+    def unlinkable(self, path: str, seen: _Seen) -> None:
+        """An entry may be taken out of its directory: the directory is
+        writable, and in a sticky one the entry or the directory is the
+        user's."""
+        parent = self.writable_parent(path)
+        if parent.mode & stat.S_ISVTX and self.uid not in (0, seen.uid, parent.uid):
+            raise Rejected(
+                "the directory is sticky and the entry is another user's", errno.EPERM
+            )
+
+    def one(self, op: dict[str, Any], totals: dict[str, int], procs: set[int]) -> None:
+        kind = op["op"]
+        if kind in FILESYSTEM:
+            for field in ("path", "to"):
+                if op.get(field) in self.protected_paths:
+                    raise Rejected("the path holds a planted token")
+            self._filesystem(op, totals)
+        elif kind == "cd":
+            seen = self.directory(op["path"], "the directory")
+            if not self.may(seen, 1):
+                raise Rejected("the user may not enter it")
+        elif kind == "proc_start":
+            totals["procs"] += 1
+            if totals["procs"] > SESSION_PROCESSES:
+                raise Rejected("the session's answers have started their limit")
+        elif kind == "proc_end":
+            if op["pid"] not in procs:
+                raise Rejected("not a process this session started")
+            procs.discard(op["pid"])
+
+    def _filesystem(self, op: dict[str, Any], totals: dict[str, int]) -> None:
+        kind, path = op["op"], op["path"]
+        seen = self.at(path)
+        if kind == "mkdir":
+            self.writable_parent(path)
+            if seen is not None:
+                raise Rejected("the path exists")
+            self.overlay[path] = _Seen("dir", op.get("mode", 0o755), self.uid, self.gid)
+            return
+        if kind == "write":
+            size = len(op["content"].encode("utf8"))
+            if seen is None:
+                self.writable_parent(path)
+                totals["made"] += 1
+                if totals["made"] > SESSION_FILES:
+                    raise Rejected("the session's answers have made their limit of files")
+                self.overlay[path] = _Seen("file", op.get("mode", 0o644), self.uid, self.gid)
+            else:
+                self.directory(posixpath.dirname(path), "the parent directory")
+                if seen.kind != "file":
+                    raise Rejected("the path is not a file")
+                if not self.may(seen, 2):
+                    raise Rejected("the user may not write the file")
+            totals["written"] += size
+            if totals["written"] > SESSION_WRITE_BYTES:
+                raise Rejected("the session's answers have written their limit")
+            return
+        if seen is None:
+            raise Rejected("the path does not exist")
+        if kind == "remove":
+            self.unlinkable(path, seen)
+            if seen.kind == "dir" and self._has_entries(path):
+                raise Rejected("the directory is not empty")
+            self.overlay[path] = None
+            return
+        if kind == "rename":
+            to = op["to"]
+            if to == path or to.startswith(path + "/"):
+                raise Rejected("the new path is the old one or inside it")
+            self.unlinkable(path, seen)
+            self.writable_parent(to)
+            target = self.at(to)
+            if target is not None and target.kind == "dir":
+                raise Rejected("the new path is a directory")
+            if seen.kind == "dir":
+                # The checks after this one look through the overlay by path;
+                # a moved directory's entries would need moving in it too.
+                raise Rejected("a directory is not renamed by an answer")
+            self.overlay[to], self.overlay[path] = seen, None
+            return
+        self.directory(posixpath.dirname(path), "the parent directory")
+        if seen.kind == "link":
+            raise Rejected("the path is a link")
+        if kind == "chmod":
+            if self.uid not in (0, seen.uid):
+                raise Rejected("only the owner may change the mode")
+            self.overlay[path] = _Seen(seen.kind, op["mode"], seen.uid, seen.gid)
+            return
+        if self.uid != 0:  # chown
+            raise Rejected("only root may change the owner")
+        self.overlay[path] = _Seen(
+            seen.kind, seen.mode, op.get("uid", seen.uid), op.get("gid", seen.gid)
+        )
+
+    def _has_entries(self, path: str) -> bool:
+        under = path + "/"
+        made = [p for p, s in self.overlay.items() if p.startswith(under) and s is not None]
+        if made:
+            return True
+        try:
+            names = self.fs.listdir(path)
+        except Exception:
+            return False
+        return any(self.overlay.get(under + name, True) is not None for name in names)
+
+
+def apply(
+    shell: HoneyPotShell,
+    raw: Any,
+    *,
+    protected_paths: Iterable[str] = (),
+    limited: bool = True,
+) -> list[dict[str, Any]]:
+    """Apply one answer's operations to the session, all or none.
+
+    Returns the operations applied. Raises ``Rejected`` with nothing changed
+    and nothing emitted. ``limited`` holds them to the session's caps: the
+    responder's answers are; a file the policy plants is not counted against
+    what the model may write.
+    """
+    protocol = shell.protocol
+    journal = journal_of(protocol)
+    journal.sync(shell)  # where the shell is before, so that what changes is seen after
+    ops = check_shape(raw)
+    check = _Check(shell, protected_paths)
+    totals = {"written": journal.written, "made": journal.made, "procs": len(journal.procs)}
+    if not limited:
+        totals = {"written": 0, "made": 0, "procs": 0}
+    procs = set(journal.procs)
+    for index, op in enumerate(ops, 1):
+        try:
+            check.one(op, totals, procs)
+        except Rejected as e:
+            raise Rejected(f"operation {index} ({op['op']}): {e}") from None
+
+    fs = protocol.fs
+    undo: list[Callable[[], None]] = []
+    held: list[tuple[str, str, dict[str, Any]]] = []
+    fs._mirage_held = held
+    state = (shell.cwd, dict(shell.environ), dict(journal.procs), fs.newcount)
+    started: list[tuple[str, int, str]] = []
+    try:
+        for op in ops:
+            _do(shell, op, check.uid, check.gid, undo, started)
+    except Exception as e:
+        # Should not happen: every operation was checked against this very
+        # filesystem. If a mutator still refuses, put back what was done.
+        for step in reversed(undo):
+            try:
+                step()
+            except Exception:
+                log.failure("mirage: an operation could not be undone")
+        shell.cwd, shell.environ = state[0], state[1]
+        journal.procs = state[2]
+        fs.newcount = state[3]
+        raise Rejected(f"could not be applied: {type(e).__name__}") from e
+    finally:
+        fs._mirage_held = None
+
+    # Everything applied: now, and only now, say so. Each change is reported
+    # as the same event an emulated command's change is, and journalled.
+    for name, path, fields in held:
+        fs._mirage_change(name, path, **fields)
+    for name, pid, args in started:
+        if name == "proc_start":
+            journal.add("proc_start", pid=pid, args=args)
+        else:
+            journal.add("proc_end", pid=pid)
+    if limited:
+        journal.written = totals["written"]
+        journal.made = totals["made"]
+    journal.sync(shell)  # a cd or a variable an operation set
+    return ops
+
+
+def _do(
+    shell: HoneyPotShell,
+    op: dict[str, Any],
+    uid: int,
+    gid: int,
+    undo: list[Callable[[], None]],
+    started: list[tuple[str, int, str]],
+) -> None:
+    fs = shell.protocol.fs
+    kind = op["op"]
+    path = op.get("path", "")
+    parent = posixpath.dirname(path)
+    if kind == "mkdir":
+        fs.mkdir(path, uid, gid, 4096, stat.S_IFDIR | op.get("mode", 0o755))
+        undo.append(lambda: _unlink(fs, path))
+    elif kind == "write":
+        content = op["content"].encode("utf8")
+        node = fs.getfile(path, follow_symlinks=False)
+        if node is None:
+            if not fs.mkfile(path, uid, gid, len(content), stat.S_IFREG | op.get("mode", 0o644)):
+                raise OSError("the filesystem takes no more files")
+            undo.append(lambda: _unlink(fs, path))
+            node = fs.getfile(path, follow_symlinks=False)
+        else:
+            before = (node[cfs.A_CONTENTS], node[cfs.A_REALFILE], node[cfs.A_SIZE])
+
+            def restore(node: cfs.Node = node, before: tuple[Any, Any, Any] = before) -> None:
+                node[cfs.A_CONTENTS], node[cfs.A_REALFILE], node[cfs.A_SIZE] = before
+
+            undo.append(restore)
+            fs.update_size(path, len(content))
+            node = fs.getfile(path, follow_symlinks=False)
+        # The contents live in the node, as the image's own small files do.
+        node[cfs.A_CONTENTS] = content
+        node[cfs.A_REALFILE] = None
+        node[cfs.A_CTIME] = time.time()
+    elif kind == "remove":
+        node = fs.getfile(path, follow_symlinks=False)
+        if node[cfs.A_TYPE] == cfs.T_DIR:
+            fs.rmdir(path)
+        else:
+            fs.remove(path)
+        undo.append(lambda: fs.link_entry(node, parent))
+    elif kind == "rename":
+        to = op["to"]
+        replaced = fs.getfile(to, follow_symlinks=False)
+        fs.rename(path, to)
+
+        def back() -> None:
+            moved = fs.getfile(to, follow_symlinks=False)
+            fs.unlink_entry(moved, posixpath.dirname(to))
+            moved[cfs.A_NAME] = posixpath.basename(path)
+            fs.link_entry(moved, parent)
+            if replaced is not None:
+                fs.link_entry(replaced, posixpath.dirname(to))
+
+        undo.append(back)
+    elif kind == "chmod":
+        node = fs.getfile(path, follow_symlinks=False)
+        mode = node[cfs.A_MODE]
+        fs.chmod(path, op["mode"])
+        undo.append(lambda: node.__setitem__(cfs.A_MODE, mode))
+    elif kind == "chown":
+        node = fs.getfile(path, follow_symlinks=False)
+        owner = (node[cfs.A_UID], node[cfs.A_GID])
+        fs.chown(path, op.get("uid", -1), op.get("gid", -1))
+
+        def reown() -> None:
+            node[cfs.A_UID], node[cfs.A_GID] = owner
+
+        undo.append(reown)
+    elif kind == "cd":
+        shell.cwd = path
+    elif kind == "setenv":
+        environ = dict(shell.environ)
+        environ[op["name"]] = op["value"]
+        shell.environ = environ
+    elif kind == "unsetenv":
+        environ = dict(shell.environ)
+        environ.pop(op["name"], None)
+        shell.environ = environ
+    elif kind == "proc_start":
+        journal = journal_of(shell.protocol)
+        pid = int(shell.protocol.next_pid())
+        journal.procs[pid] = (op["args"], time.time())
+        started.append(("proc_start", pid, op["args"]))
+    elif kind == "proc_end":
+        journal = journal_of(shell.protocol)
+        journal.procs.pop(op["pid"], None)
+        started.append(("proc_end", op["pid"], ""))
+
+
+def _unlink(fs: Any, path: str) -> None:
+    node = fs.getfile(path, follow_symlinks=False)
+    if node is not None:
+        fs.unlink_entry(node, posixpath.dirname(path))
+
+
+# ------------------------------------------------------------------- the view
+
+
+def named_paths(argv: list[str], cwd: str) -> list[str]:
+    """The paths a command line names, made absolute: every argument that is
+    not an option. More than the command will read, which is the safe side."""
+    out = []
+    for arg in argv[1:]:
+        if not arg or "\0" in arg or (arg.startswith("-") and "=" not in arg):
+            continue
+        # name=value and --option=value name their value.
+        value = arg.split("=", 1)[1] if "=" in arg and not arg.startswith("/") else arg
+        if not value:
+            continue
+        path = value if value.startswith("/") else posixpath.join(cwd, value)
+        out.append(posixpath.normpath(path))
+    return list(dict.fromkeys(out))
+
+
+def view(
+    shell: HoneyPotShell, argv: list[str], hidden: Iterable[str] = ()
+) -> list[dict[str, Any]]:
+    """What is at the paths ``argv`` names, the directories holding them and
+    the working directory, as the session's user could see it. ``hidden``
+    paths (the planted tokens) are shown to exist and no more: their contents
+    are for whoever reads them on the decoy, not for a prompt."""
+    fs = shell.protocol.fs
+    check = _Check(shell, ())
+    hidden = frozenset(hidden)
+    named = named_paths(argv, shell.cwd)
+    wanted = list(named)
+    for path in named:
+        wanted.append(posixpath.dirname(path))
+    wanted.append(shell.cwd)
+    listed = {*named, shell.cwd}
+    out = []
+    for path in dict.fromkeys(wanted):
+        if len(out) >= MAX_SLICE or well_formed(path):
+            continue
+        out.append(_entry(fs, check, path, path in listed, path in hidden))
+    return out
+
+
+def _entry(fs: Any, check: _Check, path: str, listing: bool, hide: bool) -> dict[str, Any]:
+    try:
+        node = fs.getfile(path, follow_symlinks=False)
+    except Exception:
+        node = None
+    if node is None:
+        return {"path": path, "type": "missing"}
+    kind = _kind(node)
+    entry: dict[str, Any] = {
+        "path": path,
+        "type": kind,
+        "mode": int(node[cfs.A_MODE]) & 0o7777,
+        "uid": int(node[cfs.A_UID]),
+        "gid": int(node[cfs.A_GID]),
+        "size": int(node[cfs.A_SIZE]),
+    }
+    seen = _Seen(kind, int(node[cfs.A_MODE]), int(node[cfs.A_UID]), int(node[cfs.A_GID]))
+    if kind == "link":
+        entry["target"] = str(node[cfs.A_TARGET] or "")[:MAX_PATH_BYTES]
+    elif kind == "dir" and listing and check.may(seen, 4):
+        try:
+            names = sorted(fs.listdir(path))
+        except Exception:
+            names = []
+        entry["children"] = names[:MAX_CHILDREN]
+    elif kind == "file" and listing and not hide and check.may(seen, 4):
+        head = _head(fs, path, int(node[cfs.A_SIZE]))
+        if head is not None:
+            entry["head"] = head
+    return entry
+
+
+def _head(fs: Any, path: str, size: int) -> str | None:
+    """The beginning of a small text file, or None for anything else."""
+    if size <= 0 or size > 64 * 1024 or path in fs.generated_files or protected(path):
+        return None
+    try:
+        data = fs.file_contents(path)
+    except Exception:
+        return None
+    if not data or b"\0" in data[:HEAD_BYTES]:
+        return None
+    try:
+        return data[:HEAD_BYTES].decode("utf8")
+    except UnicodeDecodeError:
+        try:
+            return data[: HEAD_BYTES - 3].decode("utf8")
+        except UnicodeDecodeError:
+            return None
+
+
+class Access(_Check):
+    """The same checks for the emulator's own commands: whether a user may
+    make an entry at a path, take one away, or write a file. ``Rejected.code``
+    is the error number to report."""
+
+    def __init__(
+        self,
+        shell: HoneyPotShell | None = None,
+        *,
+        fs: Any = None,
+        user: dict[str, Any] | None = None,
+    ) -> None:
+        super().__init__(shell, (), fs=fs, user=user)
+
+    @staticmethod
+    def _kernel(path: str) -> None:
+        """Nothing is made under /proc (it has no such file) or /sys (it is
+        not permitted), whoever asks."""
+        if path == "/proc" or path.startswith("/proc/"):
+            raise Rejected("nothing is made under /proc", errno.ENOENT)
+        if path == "/sys" or path.startswith("/sys/"):
+            raise Rejected("nothing is made under /sys", errno.EACCES)
+
+    def may_create(self, path: str) -> None:
+        self._kernel(path)
+        self.writable_parent(path)
+
+    def may_unlink(self, path: str) -> None:
+        seen = self.at(path)
+        if seen is None:
+            raise Rejected("the path does not exist", errno.ENOENT)
+        self.unlinkable(path, seen)
+
+    def may_write(self, path: str) -> None:
+        """Open ``path`` for writing, making it if it is not there."""
+        if path.startswith("/dev/"):
+            return
+        self.directory(posixpath.dirname(path), "the parent directory")
+        seen = self.at(path, follow=True)
+        if seen is None:
+            if self.at(path) is not None:  # a link to nothing: made through it
+                return
+            self._kernel(path)
+            self.writable_parent(path)
+        elif seen.kind == "dir":
+            raise Rejected("the path is a directory", errno.EISDIR)
+        elif not self.may(seen, 2):
+            raise Rejected("the user may not write the file", errno.EACCES)
+
+    def may_read(self, path: str) -> None:
+        self.directory(posixpath.dirname(path), "the parent directory")
+        seen = self.at(path, follow=True)
+        if seen is None:
+            raise Rejected("the path does not exist", errno.ENOENT)
+        if not self.may(seen, 4):
+            raise Rejected("the user may not read it", errno.EACCES)
