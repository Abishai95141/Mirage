+
+class Command_seq(_Tool):
+    name = "seq"
+    program = "/usr/bin/seq"
+    short = "ws:f:"
+    long = ("equal-width", "separator=", "format=")
+
+    @classmethod
+    def _parse(cls, args: list[str]) -> tuple[list[tuple[str, str]], list[str]]:
+        # A negative number is an operand, not a bundle of options.
+        guarded = ["\0" + a if a[:1] == "-" and a[1:2].isdigit() else a for a in args]
+        opts, operands = getopt.gnu_getopt(guarded, cls.short, list(cls.long))
+        return opts, [o.lstrip("\0") for o in operands]
+
+    def call(self) -> None:
+        got = self.options()
+        if got is None:
+            return
+        opts, operands = got
+        if not operands:
+            self.usage("missing operand")
+            return
+        if len(operands) > 3:
+            self.usage(f"extra operand '{operands[3]}'")
+            return
+        numbers = []
+        for text in operands:
+            try:
+                numbers.append(float(text))
+            except ValueError:
+                self.usage(f"invalid floating point argument: '{text}'")
+                return
+        first, step, last = 1.0, 1.0, numbers[-1]
+        if len(numbers) >= 2:
+            first = numbers[0]
+        if len(numbers) == 3:
+            step = numbers[1]
+            if step == 0:
+                self.usage(f"invalid Zero increment value: '{operands[1]}'")
+                return
+        places = max((len(t.partition(".")[2]) for t in operands[:-1] if "." in t), default=0)
+        values, n = [], 0
+        while len(values) < 100_000:
+            value = first + n * step
+            if (step > 0 and value > last + 1e-9) or (step < 0 and value < last - 1e-9):
+                break
+            values.append(value)
+            n += 1
+        fmt = opts.get("-f", opts.get("--format"))
+        if fmt is not None:
+            try:
+                shown = [fmt % v for v in values]
+            except (TypeError, ValueError):
+                self.usage(f"format '{fmt}' has no % directive")
+                return
+        else:
+            shown = [f"{v:.{places}f}" for v in values]
+            if "-w" in opts or "--equal-width" in opts:
+                width = max((len(s) for s in shown), default=0)
+                shown = [s.zfill(width) for s in shown]
+        if shown:
+            self.write(opts.get("-s", opts.get("--separator", "\n")).join(shown) + "\n")
+
+
+class Command_tac(_Reads):
+    name = "tac"
+    program = "/usr/bin/tac"
+    declined = ("help", "version", "b", "before", "r", "regex", "s", "separator")
+
+    def prepare(self) -> bool:
+        got = self.options()
+        if got is None:
+            return False
+        _, self.operands = got
+        return True
+
+    def work(self) -> None:
+        for operand in self.operands or ["-"]:
+            data = self.read(operand, "{name}: failed to open '{operand}' for reading: {error}")
+            if data is None:
+                continue
+            records = data.split(b"\n")
+            last = records.pop()  # what follows the final newline: often nothing
+            out = [r + b"\n" for r in records]
+            if last:
+                out.append(last)
+            self.writeBytes(b"".join(reversed(out)))
