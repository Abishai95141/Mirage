diff --git a/src/cowrie/test/test_mirage_file_reference.py b/src/cowrie/test/test_mirage_file_reference.py
new file mode 100644
index 0000000..ababad5
--- /dev/null
+++ b/src/cowrie/test/test_mirage_file_reference.py
@@ -0,0 +1,96 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: Holds MIRAGE's file commands to what a real Debian 12 host printed for the
+# ABOUTME: same command lines: stdout, stderr and status, byte for byte.
+
+"""``mirage_file_reference.jsonl`` is a recording: each line is a command line
+sent as an SSH exec request to the reference host (a Debian 12 container with
+the deployment's services) and what came back. This test sends the same lines
+to the emulated shell and expects the same bytes.
+
+Some lines cannot be compared here and are named in ``SKIP`` with the reason:
+the unit tests' filesystem is stock Cowrie's small tree, not the reference
+image, so a line that reads the image's own files answers differently, and
+stock Cowrie's ``su`` does not run a command as another user. The probe suite
+(``eval/probes`` in the MIRAGE repository) compares the deployed decoy to the
+live reference host for those.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import unittest
+from pathlib import Path
+
+from cowrie import mirage_gate
+from cowrie.test.test_mirage_stderr import run_exec
+
+RECORDS = [
+    json.loads(line)
+    for line in (Path(__file__).parent / "mirage_file_reference.jsonl")
+    .read_text(encoding="utf8")
+    .splitlines()
+]
+
+# A substring of the command line -> why it is not compared here.
+SKIP = {
+    "su -s /bin/sh nobody": "stock su does not run a command as another user",
+    "find /etc/ssh": "reads the reference image's own files",
+    "find / -maxdepth 1": "reads the reference image's own files",
+    "find /root -maxdepth": "reads the reference image's own files",
+    "cut -d: -f1 /etc/shells": "reads the reference image's own files",
+    "www-data": "an account the stock tree's /etc/passwd may not have",
+    "-newer /etc/hostname": "compares against the image's file times",
+    "readlink /bin;": "reads the reference image's own links",
+    "realpath /bin/sh": "reads the reference image's own links",
+    "printenv | grep -c": "counts the reference session's variables",
+}
+# The reference host's name, where a line prints /etc/hostname.
+HOSTNAME = "web01"
+
+
+def masked(text: str) -> str:
+    """A listing's time of day is when it was made: the recording's is not now."""
+    return re.sub(r"[A-Z][a-z]{2} [ \d]\d \d\d:\d\d", "<when>", text)
+
+
+def skipped(cmd: str) -> str | None:
+    return next((why for part, why in SKIP.items() if part in cmd), None)
+
+
+class ReferenceTests(unittest.TestCase):
+    maxDiff = None
+
+    def setUp(self) -> None:
+        mirage_gate.reset_for_tests(None)
+
+    def tearDown(self) -> None:
+        mirage_gate.reset_for_tests()
+
+    def test_the_recording_is_whole(self) -> None:
+        self.assertGreaterEqual(len(RECORDS), 110)
+        compared = [r for r in RECORDS if skipped(r["cmd"]) is None]
+        self.assertGreaterEqual(len(compared), 95)
+
+    def test_every_line_answers_as_the_reference_host_did(self) -> None:
+        wrong = []
+        for record in RECORDS:
+            cmd = record["cmd"]
+            if skipped(cmd):
+                continue
+            out, err = run_exec(cmd.encode())
+            got = (masked(out.decode("utf8", "replace")), err.decode("utf8", "replace"))
+            want = (masked(record["stdout"]), record["stderr"])
+            if HOSTNAME in want[0]:
+                host = run_exec(b"cat /etc/hostname")[0].decode().strip()
+                want = (want[0].replace(HOSTNAME, host), want[1])
+            if got != want:
+                wrong.append((cmd, want, got))
+        report = []
+        for cmd, want, got in wrong:
+            report.append(f"\n$ {cmd}")
+            for name, w, g in (("stdout", want[0], got[0]), ("stderr", want[1], got[1])):
+                if w != g:
+                    report.append(f"  {name} wanted: {w!r}")
+                    report.append(f"  {name} got:    {g!r}")
+        self.assertEqual(len(wrong), 0, f"{len(wrong)} lines differ:" + "\n".join(report))
diff --git a/src/cowrie/test/test_mirage_fileutils.py b/src/cowrie/test/test_mirage_fileutils.py
new file mode 100644
index 0000000..4f3a72c
--- /dev/null
+++ b/src/cowrie/test/test_mirage_fileutils.py
@@ -0,0 +1,487 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: Tests MIRAGE's mkdir, rmdir, chown and chgrp against what GNU coreutils
+# ABOUTME: 9.1 prints on Debian 12 (the probe suite holds them to the real host).
+
+from __future__ import annotations
+
+import os
+import tempfile
+import unittest
+from typing import Any
+
+from cowrie import mirage_gate, mirage_render
+from cowrie.shell import fs as cfs
+from cowrie.shell.protocol import HoneyPotInteractiveProtocol
+from cowrie.test.eventcapture import capture_eventlog
+from cowrie.test.fake_server import FakeAvatar, FakeServer
+from cowrie.test.fake_transport import FakeTransport
+
+os.environ["COWRIE_HONEYPOT_DATA_PATH"] = "data"
+os.environ["COWRIE_HONEYPOT_DOWNLOAD_PATH"] = tempfile.gettempdir()
+os.environ["COWRIE_SHELL_FILESYSTEM"] = "src/cowrie/data/fs.pickle"
+
+PROMPT = b"root@unitTest:~# "
+TRY = "Try '{0} --help' for more information.\n"
+
+
+class Base(unittest.TestCase):
+    def setUp(self) -> None:
+        mirage_gate.reset_for_tests(None)
+        self.proto = HoneyPotInteractiveProtocol(FakeAvatar(FakeServer()))
+        self.tr = FakeTransport("", "31337")
+        self.proto.makeConnection(self.tr)
+        self.proto.events, self.events = capture_eventlog()
+        self.proto.fs.events = self.proto.events
+        self.shell = self.proto.cmdstack[0]
+        self.fs = self.proto.fs
+        self.tr.clear()
+
+    def tearDown(self) -> None:
+        self.proto.connectionLost()
+        mirage_gate.reset_for_tests()
+
+    def run_line(self, line: str) -> str:
+        self.tr.clear()
+        self.proto.lineReceived(line.encode() + b"\n")
+        out = self.tr.value()
+        self.assertTrue(out.endswith(PROMPT) or b"# " in out[-40:] or b"$ " in out[-40:], out)
+        return out.rsplit(b"\n", 1)[0].decode() + "\n" if b"\n" in out else ""
+
+    def status(self) -> str:
+        return self.run_line("echo $?").strip()
+
+    def as_user(self) -> None:
+        self.shell.user = {**self.shell.user, "uid": 1000, "gid": 1000, "username": "caleb"}
+
+    def node(self, path: str) -> Any:
+        return self.fs.getfile(path, follow_symlinks=False)
+
+    def changes(self) -> list[tuple[str, str]]:
+        return [(e["op"], e["path"]) for e in self.events if e["eventid"] == "cowrie.fs.change"]
+
+
+class MkdirTests(Base):
+    def test_parents_are_made_and_an_existing_directory_is_no_error(self) -> None:
+        self.assertEqual(self.run_line("mkdir -p /tmp/a/b/c"), "")
+        self.assertEqual(self.status(), "0")
+        self.assertTrue(self.fs.isdir("/tmp/a/b/c"))
+        self.assertFalse(self.fs.exists("/root/-p"))  # what stock Cowrie made of it
+        self.assertEqual(self.run_line("mkdir -p /tmp/a/b/c /tmp/a"), "")
+        self.assertEqual(self.status(), "0")
+        self.assertEqual(self.run_line("cd /tmp; mkdir --parents x/y; ls x; cd"), "y\n")
+
+    def test_without_parents_a_missing_one_is_an_error(self) -> None:
+        self.assertEqual(
+            self.run_line("mkdir /tmp/no/such"),
+            "mkdir: cannot create directory '/tmp/no/such': No such file or directory\n",
+        )
+        self.assertEqual(self.status(), "1")
+
+    def test_what_exists_is_reported_as_typed(self) -> None:
+        self.run_line("cd /tmp; mkdir here; touch file")
+        self.assertEqual(
+            self.run_line("mkdir here"), "mkdir: cannot create directory 'here': File exists\n"
+        )
+        self.assertEqual(
+            self.run_line("mkdir -p file"), "mkdir: cannot create directory 'file': File exists\n"
+        )
+        self.assertEqual(
+            self.run_line("mkdir file/x"),
+            "mkdir: cannot create directory 'file/x': Not a directory\n",
+        )
+        self.assertEqual(
+            self.run_line("mkdir -p file/x/y"),
+            "mkdir: cannot create directory 'file': File exists\n",
+        )
+        self.assertEqual(self.run_line("mkdir /"), "mkdir: cannot create directory '/': File exists\n")
+
+    def test_several_operands_carry_on_past_a_failure(self) -> None:
+        out = self.run_line("mkdir /tmp/one /tmp/no/such /tmp/two")
+        self.assertIn("'/tmp/no/such': No such file or directory", out)
+        self.assertTrue(self.fs.isdir("/tmp/one") and self.fs.isdir("/tmp/two"))
+        self.assertEqual(self.status(), "1")
+
+    def test_mode_and_verbose(self) -> None:
+        self.assertEqual(
+            self.run_line("mkdir -v -m 700 /tmp/private"),
+            "mkdir: created directory '/tmp/private'\n",
+        )
+        self.assertEqual(self.node("/tmp/private")[cfs.A_MODE] & 0o7777, 0o700)
+        self.assertEqual(
+            self.run_line("mkdir -pv /tmp/v/w"),
+            "mkdir: created directory '/tmp/v'\nmkdir: created directory '/tmp/v/w'\n",
+        )
+        self.run_line("mkdir -p -m 700 /tmp/m/n")
+        # Only the last takes the mode: the ones made on the way are 755.
+        self.assertEqual(self.node("/tmp/m")[cfs.A_MODE] & 0o7777, 0o755)
+        self.assertEqual(self.node("/tmp/m/n")[cfs.A_MODE] & 0o7777, 0o700)
+        self.assertEqual(self.run_line("mkdir -m 9z /tmp/q"), "mkdir: invalid mode '9z'\n")
+        self.assertEqual(self.status(), "1")
+
+    def test_no_operand_and_a_bad_option(self) -> None:
+        self.assertEqual(self.run_line("mkdir"), "mkdir: missing operand\n" + TRY.format("mkdir"))
+        self.assertEqual(self.run_line("mkdir -p"), "mkdir: missing operand\n" + TRY.format("mkdir"))
+        self.assertEqual(
+            self.run_line("mkdir -q /tmp/x"), "mkdir: invalid option -- 'q'\n" + TRY.format("mkdir")
+        )
+        self.assertEqual(
+            self.run_line("mkdir --frob /tmp/x"),
+            "mkdir: unrecognized option '--frob'\n" + TRY.format("mkdir"),
+        )
+        self.assertEqual(self.status(), "1")
+
+    def test_a_user_is_stopped_by_the_modes_and_owns_what_they_make(self) -> None:
+        self.as_user()
+        self.assertEqual(
+            self.run_line("mkdir /etc/mine"),
+            "mkdir: cannot create directory '/etc/mine': Permission denied\n",
+        )
+        self.assertEqual(
+            self.run_line("mkdir -p /opt/a/b"),
+            "mkdir: cannot create directory '/opt/a': Permission denied\n",
+        )
+        self.assertEqual(self.run_line("mkdir /tmp/mine"), "")
+        made = self.node("/tmp/mine")
+        self.assertEqual((made[cfs.A_UID], made[cfs.A_GID]), (1000, 1000))
+
+    def test_the_options_it_lacks_are_declined_not_refused(self) -> None:
+        for args in (["--help"], ["--version"], ["-Z", "/tmp/z"], ["-m", "u=rwx,go=", "/tmp/s"]):
+            self.assertEqual(mirage_render.tier(self.shell, ["mkdir", *args]), "none", args)
+        for args in (["-p", "/tmp/a"], ["-m", "700", "/tmp/a"], ["/tmp/a"], ["-q"]):
+            self.assertEqual(mirage_render.tier(self.shell, ["mkdir", *args]), "emulated", args)
+        self.assertIn("cannot execute binary file", self.run_line("mkdir --version"))
+
+
+class RmdirTests(Base):
+    def test_it_removes_and_says_so_to_the_filesystem(self) -> None:
+        self.run_line("mkdir -p /tmp/r/s")
+        del self.events[:]
+        self.assertEqual(self.run_line("rmdir /tmp/r/s"), "")
+        self.assertEqual(self.changes(), [("rmdir", "/tmp/r/s")])  # stock Cowrie reported nothing
+        self.assertFalse(self.fs.exists("/tmp/r/s"))
+
+    def test_its_errors(self) -> None:
+        self.run_line("mkdir -p /tmp/full/in; touch /tmp/afile")
+        self.assertEqual(
+            self.run_line("rmdir /tmp/full"),
+            "rmdir: failed to remove '/tmp/full': Directory not empty\n",
+        )
+        self.assertEqual(self.status(), "1")
+        self.assertEqual(
+            self.run_line("rmdir /tmp/absent"),
+            "rmdir: failed to remove '/tmp/absent': No such file or directory\n",
+        )
+        self.assertEqual(
+            self.run_line("rmdir /tmp/afile"),
+            "rmdir: failed to remove '/tmp/afile': Not a directory\n",
+        )
+        self.assertEqual(self.run_line("rmdir"), "rmdir: missing operand\n" + TRY.format("rmdir"))
+        self.assertEqual(self.run_line("rmdir --ignore-fail-on-non-empty /tmp/full"), "")
+        self.assertEqual(self.status(), "0")
+        self.assertTrue(self.fs.isdir("/tmp/full"))
+
+    def test_parents_and_verbose(self) -> None:
+        self.run_line("cd /tmp; mkdir -p a/b/c a/keep")
+        self.assertEqual(
+            self.run_line("rmdir -pv a/b/c"),
+            "rmdir: removing directory, 'a/b/c'\n"
+            "rmdir: removing directory, 'a/b'\n"
+            "rmdir: removing directory, 'a'\n"
+            "rmdir: failed to remove directory 'a': Directory not empty\n",
+        )
+        self.assertFalse(self.fs.exists("/tmp/a/b"))
+        self.assertTrue(self.fs.isdir("/tmp/a/keep"))
+
+    def test_a_user_cannot_remove_from_where_they_cannot_write(self) -> None:
+        self.run_line("mkdir /opt/theirs /tmp/roots")
+        self.as_user()
+        self.assertEqual(
+            self.run_line("rmdir /opt/theirs"),
+            "rmdir: failed to remove '/opt/theirs': Permission denied\n",
+        )
+        # /tmp is sticky: writable by all, but another user's entry stays.
+        self.assertEqual(
+            self.run_line("rmdir /tmp/roots"),
+            "rmdir: failed to remove '/tmp/roots': Operation not permitted\n",
+        )
+        self.assertEqual(self.run_line("mkdir /tmp/own; rmdir /tmp/own"), "")
+
+
+class ChownTests(Base):
+    def owner(self, path: str) -> tuple[int, int]:
+        node = self.node(path)
+        return int(node[cfs.A_UID]), int(node[cfs.A_GID])
+
+    def setUp(self) -> None:
+        super().setUp()
+        self.run_line("mkdir -p /tmp/o/d; touch /tmp/o/f /tmp/o/d/g")
+        del self.events[:]
+
+    def test_owner_group_and_both(self) -> None:
+        self.assertEqual(self.run_line("chown daemon /tmp/o/f"), "")
+        self.assertEqual(self.owner("/tmp/o/f"), (1, 0))
+        self.run_line("chown :daemon /tmp/o/f")
+        self.assertEqual(self.owner("/tmp/o/f"), (1, 1))
+        self.run_line("chown root:root /tmp/o/f")
+        self.assertEqual(self.owner("/tmp/o/f"), (0, 0))
+        self.run_line("chown daemon: /tmp/o/f")  # the owner's own login group
+        self.assertEqual(self.owner("/tmp/o/f"), (1, 1))
+        self.run_line("chown 1234:5678 /tmp/o/f")  # numbers need no entry
+        self.assertEqual(self.owner("/tmp/o/f"), (1234, 5678))
+        self.assertEqual(self.changes()[0], ("chown", "/tmp/o/f"))
+        self.assertIn("1234 5678", " ".join(self.run_line("ls -ln /tmp/o/f").split()))
+
+    def test_recursive_and_verbose(self) -> None:
+        self.assertEqual(
+            self.run_line("chown -Rv daemon:daemon /tmp/o"),
+            # What is in a directory first, then the directory.
+            "changed ownership of '/tmp/o/d/g' from root:root to daemon:daemon\n"
+            "changed ownership of '/tmp/o/d' from root:root to daemon:daemon\n"
+            "changed ownership of '/tmp/o/f' from root:root to daemon:daemon\n"
+            "changed ownership of '/tmp/o' from root:root to daemon:daemon\n",
+        )
+        self.assertEqual(self.owner("/tmp/o/d/g"), (1, 1))
+        self.assertEqual(
+            self.run_line("chown -v daemon:daemon /tmp/o/f"),
+            "ownership of '/tmp/o/f' retained as daemon:daemon\n",
+        )
+        self.assertEqual(self.run_line("chown -c daemon:daemon /tmp/o/f"), "")
+        # Only what was named is told: a user alone, a user alone.
+        self.assertEqual(
+            self.run_line("chown -c root /tmp/o/f"),
+            "changed ownership of '/tmp/o/f' from daemon to root\n",
+        )
+        self.assertEqual(
+            self.run_line("chown -v :daemon /tmp/o/f"),
+            "ownership of '/tmp/o/f' retained as :daemon\n",
+        )
+
+    def test_its_errors(self) -> None:
+        self.assertEqual(self.run_line("chown"), "chown: missing operand\n" + TRY.format("chown"))
+        self.assertEqual(
+            self.run_line("chown root"),
+            "chown: missing operand after 'root'\n" + TRY.format("chown"),
+        )
+        self.assertEqual(
+            self.run_line("chown nosuchuser /tmp/o/f"), "chown: invalid user: 'nosuchuser'\n"
+        )
+        self.assertEqual(
+            self.run_line("chown root:nosuchgroup /tmp/o/f"),
+            "chown: invalid group: 'root:nosuchgroup'\n",
+        )
+        self.assertEqual(
+            self.run_line("chown root /tmp/o/absent /tmp/o/f"),
+            "chown: cannot access '/tmp/o/absent': No such file or directory\n",
+        )
+        self.assertEqual(self.status(), "1")
+        self.assertEqual(self.run_line("chown -f root /tmp/o/absent"), "")
+        self.assertEqual(self.status(), "1")
+
+    def test_only_root_gives_a_file_away(self) -> None:
+        self.run_line("chown 1000:1000 /tmp/o/f")
+        self.as_user()
+        self.assertEqual(
+            self.run_line("chown root /tmp/o/f"),
+            "chown: changing ownership of '/tmp/o/f': Operation not permitted\n",
+        )
+        self.assertEqual(
+            self.run_line("chown 1000 /tmp/o/d"),
+            "chown: changing ownership of '/tmp/o/d': Operation not permitted\n",
+        )
+        self.assertEqual(self.owner("/tmp/o/f"), (1000, 1000))
+        self.assertEqual(self.run_line("chown 1000 /tmp/o/f"), "")  # nothing changes: allowed
+
+    def test_chgrp(self) -> None:
+        self.assertEqual(
+            self.run_line("chgrp -v daemon /tmp/o/f"),
+            "changed group of '/tmp/o/f' from root to daemon\n",
+        )
+        self.assertEqual(self.owner("/tmp/o/f"), (0, 1))
+        self.assertEqual(
+            self.run_line("chgrp -v daemon /tmp/o/f"), "group of '/tmp/o/f' retained as daemon\n"
+        )
+        self.assertEqual(self.run_line("chgrp nosuch /tmp/o/f"), "chgrp: invalid group: 'nosuch'\n")
+        self.assertEqual(
+            self.run_line("chgrp root"), "chgrp: missing operand after 'root'\n" + TRY.format("chgrp")
+        )
+        self.run_line("chgrp -R 33 /tmp/o")
+        self.assertEqual(self.owner("/tmp/o/d/g"), (0, 33))
+
+    def test_the_options_they_lack_are_declined(self) -> None:
+        for name in ("chown", "chgrp"):
+            self.assertEqual(
+                mirage_render.tier(self.shell, [name, "--reference=/etc", "/tmp/o/f"]), "none"
+            )
+            self.assertEqual(mirage_render.tier(self.shell, [name, "-R", "root", "/tmp/o"]), "emulated")
+
+
+class UnprivilegedTests(Base):
+    """What a user who is not root is refused, in the words the reference host
+    used for the same commands run as ``nobody``."""
+
+    def setUp(self) -> None:
+        super().setUp()
+        self.run_line("touch /tmp/roots; mkdir /tmp/mine; chown 1000:1000 /tmp/mine")
+        self.run_line("echo data > /tmp/mine/own; chown 1000:1000 /tmp/mine/own")
+        self.as_user()
+
+    def test_the_system_directories_are_closed(self) -> None:
+        for line, said in (
+            ("mkdir /etc/x", "mkdir: cannot create directory '/etc/x': Permission denied"),
+            ("mkdir -p /opt/a/b", "mkdir: cannot create directory '/opt/a': Permission denied"),
