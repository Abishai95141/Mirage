diff --git a/src/cowrie/mirage_state.py b/src/cowrie/mirage_state.py
index 37fadbb..3a6abc6 100644
--- a/src/cowrie/mirage_state.py
+++ b/src/cowrie/mirage_state.py
@@ -146,6 +146,10 @@ class Journal:
         # What applied operations have added up to.
         self.written = 0
         self.made = 0
+        # How far the responder has been sent this journal, and the output tokens
+        # its answers to this login have used (told to the gate, mirage_gate).
+        self.sent = 0
+        self.spent = 0
 
     def add(self, op: str, **fields: Any) -> None:
         if self.full:
@@ -204,10 +208,16 @@ class Journal:
 
 
 def journal_of(protocol: Any) -> Journal:
-    """The session's journal, made the first time it is asked for."""
+    """The session's journal, made the first time it is asked for. It belongs to
+    the login, as the file system does: a second channel of the same connection
+    (another exec request, a shell after an SFTP transfer) carries on with the
+    journal the first one began, so the responder's picture of the session and
+    the count of what its answers have used go on from where they were."""
     journal = getattr(protocol, "mirage_journal", None)
     if journal is None:
-        journal = protocol.mirage_journal = Journal()
+        held = getattr(protocol.fs, "mirage_journal", None)
+        journal = held if isinstance(held, Journal) else Journal()
+        protocol.mirage_journal = journal
         protocol.fs.mirage_journal = journal
     return journal  # type: ignore[no-any-return]
 
