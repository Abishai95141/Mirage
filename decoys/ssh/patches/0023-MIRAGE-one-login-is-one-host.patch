 src/cowrie/mirage_state.py                | 14 ++++-
 src/cowrie/shell/server.py                |  6 ++
 src/cowrie/shell/session.py               |  2 +-
 src/cowrie/test/test_mirage_connection.py | 68 +++++++++++++++++++++++
 6 files changed, 91 insertions(+), 8 deletions(-)
