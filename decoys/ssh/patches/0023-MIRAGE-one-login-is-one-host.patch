diff --git a/src/cowrie/test/test_mirage_connection.py b/src/cowrie/test/test_mirage_connection.py
new file mode 100644
index 0000000..9118743
--- /dev/null
+++ b/src/cowrie/test/test_mirage_connection.py
@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: Tests that one login is one host: every channel of a connection has
+# ABOUTME: the same file system, the same journal and the same count of tokens.
+
+from __future__ import annotations
+
+import unittest
+from typing import Any
+from unittest import mock
+
+from cowrie import mirage_state
+from cowrie.shell import server as shellserver
+from cowrie.shell.protocol import HoneyPotInteractiveProtocol
+from cowrie.test.fake_transport import FakeTransport
+from cowrie.test.test_mirage_gate import PROMPT, GateTestBase
+
+
+class ServerTests(unittest.TestCase):
+    def test_the_file_system_is_made_once_for_a_connection(self) -> None:
+        # Each channel's session asks for it (shell/session.py, filetransfer.py).
+        server = shellserver.CowrieServer(mock.Mock())
+        server.initFileSystem("/root")
+        first = server.fs
+        first.mkdir("/tmp/made-by-the-first-channel", 0, 0, 4096, 0o40755)
+        server.initFileSystem("/root")
+        self.assertIs(server.fs, first)
+        self.assertTrue(server.fs.exists("/tmp/made-by-the-first-channel"))
+
+    def test_another_connection_has_its_own(self) -> None:
+        one, other = (shellserver.CowrieServer(mock.Mock()) for _ in range(2))
+        one.initFileSystem("/root")
+        other.initFileSystem("/root")
+        one.fs.mkdir("/tmp/only-here", 0, 0, 4096, 0o40755)
+        self.assertFalse(other.fs.exists("/tmp/only-here"))
+
+
+class ChannelTests(GateTestBase):
+    """Two channels of one login: the second protocol is given the first's avatar."""
+
+    def second(self) -> tuple[Any, FakeTransport]:
+        proto = HoneyPotInteractiveProtocol(self.proto.user)
+        transport = FakeTransport("", "31337")
+        proto.makeConnection(transport)
+        proto.events = self.proto.events
+        transport.clear()
+        self.addCleanup(proto.connectionLost)
+        return proto, transport
+
+    def test_what_one_channel_made_the_next_one_sees(self) -> None:
+        self.run_line("mkdir /tmp/kept; echo marker > /tmp/kept/file")
+        proto, transport = self.second()
+        proto.lineReceived(b"cat /tmp/kept/file\n")
+        self.assertEqual(transport.value(), b"marker\n" + PROMPT)
+
+    def test_the_journal_and_what_it_counts_go_on(self) -> None:
+        self.run_line("mkdir /tmp/kept")
+        journal = mirage_state.journal_of(self.proto)
+        journal.sync(self.proto.cmdstack[0])
+        journal.sent, journal.spent = journal.seq, 42
+        seq = journal.seq
+        self.assertGreater(seq, 0)
+        proto, _ = self.second()
+        self.assertIs(mirage_state.journal_of(proto), journal)
+        proto.lineReceived(b"rmdir /tmp/kept\n")
+        self.assertGreater(journal.seq, seq)  # the second channel's change follows the first's
+        self.assertEqual((journal.sent, journal.spent), (seq, 42))
+        # And the gate is told what the login's answers have used, whichever channel asks.
+        self.assertEqual(self.gate.requests[-1]["respond_spent"], 42)
