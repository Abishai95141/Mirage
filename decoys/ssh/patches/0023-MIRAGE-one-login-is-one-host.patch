diff --git a/src/cowrie/mirage_gate.py b/src/cowrie/mirage_gate.py
index 1f18bdf..e066946 100644
--- a/src/cowrie/mirage_gate.py
+++ b/src/cowrie/mirage_gate.py
@@ -392,7 +392,7 @@ def gate_then_run(shell: HoneyPotShell, cmdAndArgs: list[str]) -> Any:
         "supports": supports,
         # What the session's generated answers have used so far (mirage_respond counts
         # it): the policy's budget is tokens spent, and it calls nothing to learn them.
-        "respond_spent": int(getattr(proto, "mirage_respond_spent", 0)),
+        "respond_spent": int(getattr(getattr(proto, "mirage_journal", None), "spent", 0)),
         "interactive": bool(shell.interactive),
