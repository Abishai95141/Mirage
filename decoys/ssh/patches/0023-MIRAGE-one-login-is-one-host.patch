@@ -439,8 +439,7 @@ class Answer(HoneyPotCommand):
         used = rec.get("output_tokens")
         if isinstance(used, int) and not isinstance(used, bool) and used > 0:
             # Told to the gate with every later request of the session (mirage_gate).
-            spent = getattr(self.protocol, "mirage_respond_spent", 0)
-            self.protocol.mirage_respond_spent = spent + used
