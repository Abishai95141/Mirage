+        self.clock.advance(0.039)
+        self.assertNotIn(b"ALPHA", self.tr.value())
+        self.clock.advance(0.002)
+        self.assertIn(b"ALPHA", self.tr.value())
+
+    def test_typed_ahead_input_waits_behind_the_answer(self) -> None:
+        self.proto.lineReceived(b"mirage-report -a")
+        self.proto.lineReceived(b"echo NEXT")
+        self.assertNotIn(b"NEXT", self.tr.value())
+        self.clock.advance(0.05)
+        out = self.tr.value()
+        self.assertLess(out.index(b"ALPHA"), out.index(b"NEXT"))
+
+    def test_ctrl_c_stops_the_answer(self) -> None:
+        self.proto.lineReceived(b"mirage-report -a")
+        self.proto.handle_CTRL_C()
+        self.clock.advance(1.0)
+        self.assertNotIn(b"ALPHA", self.tr.value())
+        self.assertEqual(self.proto.cmdstack[0].last_exit_code, 130)
