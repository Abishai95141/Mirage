+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: Tests the MIRAGE render library: recorded answers for commands the emulator
+# ABOUTME: lacks, served only when the shell would really run that program, and /proc files.
+
+from __future__ import annotations
+
+import copy
+import os
+import tempfile
+import unittest
+from typing import Any
+from unittest import mock
+
+from twisted.internet import task
+
+from cowrie import mirage_gate, mirage_render
+from cowrie.shell.protocol import HoneyPotInteractiveProtocol
+from cowrie.test.eventcapture import capture_eventlog
+from cowrie.test.fake_server import FakeAvatar, FakeServer
+from cowrie.test.fake_transport import FakeTransport
+from cowrie.test.test_mirage_gate import FakeGate, allow
+
+os.environ["COWRIE_HONEYPOT_DATA_PATH"] = "data"
+os.environ["COWRIE_HONEYPOT_DOWNLOAD_PATH"] = tempfile.gettempdir()
+os.environ["COWRIE_SHELL_FILESYSTEM"] = "src/cowrie/data/fs.pickle"
+
+PROMPT = "root@unitTest:~# "
+STAT = """cpu  200 0 300 5000 100 0 20 0 0 0
+cpu0 120 0 140 2400 60 0 12 0 0 0
+cpu1 80 0 160 2600 40 0 8 0 0 0
+intr 4000 10 0 30
+ctxt 9000
+btime 1700000000
+processes 480
+procs_running 1
+procs_blocked 0
+softirq 2000 0 700 5
+"""
+
+
+def entry(argv: list[str], program: str, **more: Any) -> dict[str, Any]:
+    base = {"argv": argv, "program": program, "who": "any", "exit_code": 0, "ms": [40]}
+    return {**base, "stdout": "", "stderr": "", **more}
+
+
+DOC = {
+    "version": "test-1",
+    "entries": [
+        entry(["mirage-report", "-a"], "/usr/bin/mirage-report", stdout="ALPHA\n"),
+        entry(
+            ["mirage-report", "-e"],
+            "/usr/bin/mirage-report",
+            stderr="mirage-report: no\n",
+            exit_code=3,
+        ),
+        entry(["mirage-admin", "-t"], "/usr/sbin/mirage-admin", who="root", stdout="ROOT ONLY\n"),
+        entry(["uname", "-a"], "/usr/bin/uname", stdout="NOT THE EMULATOR\n"),
+    ],
+    "proc": {"recorded_uptime_s": 30.0, "loadavg": "0.31 0.09 0.03 2/109 479\n", "stat": STAT},
+}
+
+
+class RenderTestBase(unittest.TestCase):
+    delay = False
+
+    def setUp(self) -> None:
+        self.library = mirage_render.Library(copy.deepcopy(DOC))
+        self.library.delay = self.delay
+        mirage_render.reset_for_tests(self.library)
+        mirage_gate.reset_for_tests(None)
+        self.proto = HoneyPotInteractiveProtocol(FakeAvatar(FakeServer()))
+        self.tr = FakeTransport("", "31337")
+        self.proto.makeConnection(self.tr)
+        self.proto.events, self.events = capture_eventlog()
+        for path in ("/usr/bin/mirage-report", "/usr/sbin/mirage-admin"):
+            self.proto.fs.mkfile(path, 0, 0, 4096, 0o100755)
+        self.tr.clear()
+
+    def tearDown(self) -> None:
+        self.proto.connectionLost()
+        mirage_render.reset_for_tests()
+        mirage_gate.reset_for_tests()
+
+    def run_line(self, line: str) -> str:
+        self.tr.clear()
+        self.proto.lineReceived(line.encode())
+        return self.tr.value().decode().replace(PROMPT, "")
+
+
+class AnswerTests(RenderTestBase):
+    def test_exact_argv_is_answered_from_the_library(self) -> None:
+        self.assertEqual(self.run_line("mirage-report -a"), "ALPHA\n")
+
+    def test_stderr_and_exit_code_are_the_recorded_ones(self) -> None:
+        self.assertEqual(self.run_line("mirage-report -e; echo $?"), "mirage-report: no\n3\n")
+        self.assertEqual(self.run_line("mirage-report -e 2>/dev/null; echo $?"), "3\n")
+
+    def test_and_or_lists_follow_the_recorded_status(self) -> None:
