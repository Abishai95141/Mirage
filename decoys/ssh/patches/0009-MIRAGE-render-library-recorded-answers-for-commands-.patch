--- /dev/null
+++ b/src/cowrie/mirage_render.py
@@ -0,0 +1,300 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE render library. Answers commands the emulator lacks from this
+# ABOUTME: deployment's recorded answers, and the /proc files that change by the second.
+
+"""MIRAGE render library for the Cowrie shell.
+
+``[mirage] render_library`` names a JSON file written when the deployment's
+profile is rendered. It holds what a real host of this deployment's kind printed
+for a few commands the emulator lacks: the text, the stream, the exit code and
+the time it took. ``HoneyPotShell._run_expanded`` asks :func:`command_for`
+before its own lookup. With no file configured it returns None every time:
+stock behaviour.
+
+An entry answers a command only when all of this holds:
+
+* the emulator has no command class of that name (the emulator wins);
+* the word typed resolves, through PATH or as a path, to the entry's program,
+  and that file is still the one the image came with: not removed, not
+  overwritten, still executable;
+* the arguments are exactly the entry's;
+* the caller is someone the entry answers (some answers are root's alone).
+
+Anything else falls through to the stock lookup, so a command this file does
+not know is answered exactly as it was before.
+
+The same file carries the hardware class's record of /proc/stat and
+/proc/loadavg. Those change by the second on a real machine, so they are
+generated on each read (:func:`register_proc`), in step with the uptime the
+emulator already reports.
+"""
+
+from __future__ import annotations
+
+import json
+import random
+import stat
+from typing import TYPE_CHECKING, Any
+
+from twisted.logger import Logger
+
+from cowrie.core.config import CowrieConfig
+from cowrie.shell import fs as cfs
+from cowrie.shell.command import HoneyPotCommand
+
+if TYPE_CHECKING:
+    from cowrie.shell.honeypot import HoneyPotShell
+
+log = Logger()
+
+USER_HZ = 100  # the unit of the CPU times in /proc/stat
+# What an idle server's processors do after boot, as shares of their time. The
+# class's record covers the boot itself; these carry it forward. They are a
+# model of a quiet machine, not a record of one.
+IDLE_USER, IDLE_SYSTEM, IDLE_IOWAIT, IDLE_SOFTIRQ = 0.004, 0.003, 0.0005, 0.0005
+# After boot, interrupts and context switches come at this share of the rate
+# they came at during the recorded boot.
+QUIET_RATE = 0.05
+MAX_OUTPUT_BYTES = 256 * 1024
+
+
+def _merged(path: str) -> str:
+    """Debian's merged /usr: /bin and /sbin are /usr/bin and /usr/sbin."""
+    for top in ("/bin/", "/sbin/"):
+        if path.startswith(top):
+            return "/usr" + path
+    return path
+
+
+class Library:
+    def __init__(self, doc: dict[str, Any]) -> None:
+        self.version: str = str(doc.get("version", ""))
+        self.entries: dict[tuple[str, tuple[str, ...]], dict[str, Any]] = {}
+        for entry in doc.get("entries") or []:
+            argv = [str(a) for a in entry["argv"]]
+            program = _merged(str(entry["program"]))
+            if program.rsplit("/", 1)[-1] != argv[0]:
+                continue  # an entry must be for the program it names
+            self.entries[(program, tuple(argv[1:]))] = entry
+        self.programs = {program for program, _ in self.entries}
+        self.proc: dict[str, Any] = doc.get("proc") or {}
+        self.delay: bool = CowrieConfig.getboolean("mirage", "render_delay", fallback=True)
+
+    @classmethod
+    def from_config(cls) -> Library | None:
+        path = CowrieConfig.get("mirage", "render_library", fallback="")
+        if not path:
+            return None
+        try:
+            with open(path, encoding="utf-8") as fh:
+                library = cls(json.load(fh))
+        except (OSError, ValueError, KeyError, TypeError) as e:
+            # A missing or broken file must never stop the decoy: it answers
+            # as stock Cowrie does.
+            log.warn("render library not loaded from {path}: {err!r}", path=path, err=e)
+            return None
+        log.info(
+            "render library {version}: {n} entries",
+            version=library.version,
+            n=len(library.entries),
+        )
+        return library
+
+
+_UNSET = object()
+_library: Any = _UNSET
+
+
+def get_library() -> Library | None:
+    global _library
+    if _library is _UNSET:
+        _library = Library.from_config()
+    return _library
+
+
+def reset_for_tests(library: Library | None | object = _UNSET) -> None:
+    global _library
+    _library = library
+
+
+def _program(shell: HoneyPotShell, cmd: str, paths: list[str]) -> str | None:
+    """The file ``cmd`` names, as the shell would find it: as a path when it has
+    a slash, through PATH otherwise."""
+    fs = shell.protocol.fs
+    if "/" in cmd:
+        path = fs.resolve_path(cmd, shell.cwd)
+        return path if fs.exists(path) else None
+    for directory in paths:
+        if not directory:
+            continue
+        candidate = f"{fs.resolve_path(directory, shell.cwd)}/{cmd}"
+        if fs.exists(candidate):
+            return candidate
+    return None
+
+
+def _as_installed(shell: HoneyPotShell, path: str) -> bool:
+    """Whether ``path`` is still the program the image came with: a regular,
+    executable file with no contents written in this session."""
+    node = shell.protocol.fs.getfile(path)
+    if node is None or node[cfs.A_TYPE] != cfs.T_FILE:
+        return False
+    if node[cfs.A_REALFILE] or isinstance(node[cfs.A_CONTENTS], bytes):
+        return False
+    return bool(node[cfs.A_MODE] & (stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH))
+
+
+def find(
+    shell: HoneyPotShell, cmd: str, args: list[str], environ: dict[str, str]
+) -> dict[str, Any] | None:
+    """The library's entry for this command as this shell would run it, or None."""
+    library = get_library()
+    if library is None or not cmd.strip():
+        return None
+    commands = shell.protocol.commands
+    if cmd in commands or cmd.rsplit("/", 1)[-1] in commands:
+        return None  # the emulator implements it
+    found = _program(shell, cmd, environ.get("PATH", "").split(":"))
+    if found is None or found in commands:
+        return None
+    program = _merged(found)
+    if program not in library.programs:
+        return None
+    entry = library.entries.get((program, tuple(args)))
+    if entry is None:
+        return None
+    if entry.get("who") == "root" and shell.user.get("uid") != 0:
+        return None
+    if not _as_installed(shell, found):
+        return None
+    return entry
+
+
+def command_for(
+    shell: HoneyPotShell, cmd: str, args: list[str], environ: dict[str, str]
+) -> type[HoneyPotCommand] | None:
+    """A command class that prints the library's answer, or None when the
+    library has none and the stock lookup should run."""
+    entry = find(shell, cmd, args, environ)
+    if entry is None:
+        return None
+    library = get_library()
+    assert library is not None
+    out = str(entry.get("stdout") or "").encode("utf8")[:MAX_OUTPUT_BYTES]
+    err = str(entry.get("stderr") or "").encode("utf8")[:MAX_OUTPUT_BYTES]
+    code = int(entry.get("exit_code", 0))
+    times = [int(t) for t in entry.get("ms") or [] if int(t) > 0]
+    version = library.version
+    line = " ".join([cmd, *args])
+
+    class Command_rendered(HoneyPotCommand):
+        def start(self) -> None:
+            self.protocol.events.dispatch(
+                "cowrie.render.served",
+                "Rendered: %(input)s",
+                input=line,
+                library=version,
+                exit_code=code,
+            )
+            # The time the real command took, one of the times measured: the
+            # prompt comes back as fast as it would on the machine recorded.
+            delay = random.choice(times) / 1000.0 if times and library.delay else 0.0
+            if delay > 0:
+                self.callLater(delay, self.answer)
+            else:
+                self.answer()
+
+        def answer(self) -> None:
+            if out:
+                self.writeBytes(out)
+            if err:
+                self.errorWritefn(err)
+            self.exit(code)
+
+    return Command_rendered
+
+
+def tier(shell: HoneyPotShell, argv: list[str]) -> str:
+    """What the decoy would answer this simple command with if allowed:
+    ``emulated`` (a command the emulator has), ``rendered`` (the library) or
+    ``none`` (nothing of its own)."""
+    words = list(argv)
+    args, _ops = shell.parser.parse_redirections(words)
+    if not args or args[0] in shell.functions:
+        return "emulated"
+    if find(shell, args[0], args[1:], shell.environ) is not None:
+        return "rendered"
+    paths = shell.environ.get("PATH", "").split(":")
+    known = shell.protocol.getCommand(args[0], paths, shell.cwd) is not None
+    return "emulated" if known else "none"
+
+
+# ------------------------------------------------------------------- /proc
+
+
+def proc_loadavg(protocol: Any, library: Library) -> bytes:
+    """/proc/loadavg in step with what ``uptime`` prints here (a load of zero):
+    one task running, the reader; as many tasks as the class recorded; and the
+    newest process ID of this session."""
+    fields = str(library.proc.get("loadavg", "")).split()
+    tasks = fields[3].split("/")[-1] if len(fields) > 3 and "/" in fields[3] else "100"
+    return f"0.00 0.00 0.00 1/{tasks} {protocol.last_pid}\n".encode()
+
+
+def proc_stat(protocol: Any, library: Library) -> bytes:
+    """/proc/stat for an idle machine that has been up as long as this one says
+    it has: the class's record of the counters at the end of its boot, carried
+    forward to now. Since boot each processor's time has gone to idle but for a
+    trace; interrupts and context switches have come at a quiet machine's rate;
+    the boot time is the emulator's own and the fork count keeps ahead of the
+    session's process IDs. Two reads a moment apart differ as they would."""
+    recorded = float(library.proc.get("recorded_uptime_s") or 0.0)
+    extra = max(0.0, float(protocol.uptime()) - recorded)
+    growth = 1.0 + (QUIET_RATE * extra / recorded if recorded > 0 else 0.0)
+    ticks = int(extra * USER_HZ)
+    busy = {
+        0: int(ticks * IDLE_USER),
+        2: int(ticks * IDLE_SYSTEM),
+        4: int(ticks * IDLE_IOWAIT),
+        6: int(ticks * IDLE_SOFTIRQ),
+    }
+    lines: list[tuple[str, list[int]]] = []
+    for raw in str(library.proc.get("stat", "")).splitlines():
+        name, *rest = raw.split()
+        try:
+            values = [int(v) for v in rest]
+        except ValueError:
+            return b""  # not a record this can carry forward: say nothing
+        if name.startswith("cpu") and name != "cpu" and len(values) >= 7:
+            for column, more in busy.items():
+                values[column] += more
+            values[3] += ticks - sum(busy.values())
+        elif name in ("intr", "ctxt", "softirq"):
+            values = [int(v * growth) for v in values]
+        elif name == "btime":
+            values = [int(protocol.boot_time())]
+        elif name == "processes" and values:
+            values = [max(values[0], int(protocol.last_pid) + 1)]
+        lines.append((name, values))
+    cores = [values for name, values in lines if name.startswith("cpu") and name != "cpu"]
+    out = []
+    for name, values in lines:
+        if name == "cpu" and cores:
+            # The first line is the sum of the processors' own lines.
+            values = [sum(column) for column in zip(*cores, strict=False)]
+            out.append("cpu  " + " ".join(map(str, values)))
+        else:
+            out.append(" ".join([name, *map(str, values)]))
+    return ("\n".join(out) + "\n").encode() if out else b""
+
+
+def register_proc(protocol: Any) -> None:
+    """Have this session's filesystem generate the /proc files the class
+    recorded and a file cannot serve."""
+    library = get_library()
+    if library is None or not library.proc:
+        return
+    if library.proc.get("loadavg"):
+        protocol.fs.generated_files["/proc/loadavg"] = lambda: proc_loadavg(protocol, library)
+    if library.proc.get("stat"):
+        protocol.fs.generated_files["/proc/stat"] = lambda: proc_stat(protocol, library)
