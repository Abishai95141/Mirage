+class ProcTests(RenderTestBase):
+    def stat(self) -> dict[str, list[int]]:
+        text = mirage_render.proc_stat(self.proto, self.library).decode()
+        return {ln.split()[0]: [int(v) for v in ln.split()[1:]] for ln in text.splitlines()}
+
+    def test_the_files_are_generated_for_the_session(self) -> None:
+        generated = self.proto.fs.generated_files
+        mirage_render.register_proc(self.proto)
+        self.assertIn("/proc/loadavg", generated)
+        self.assertIn("/proc/stat", generated)
+        self.assertEqual(generated["/proc/stat"](), mirage_render.proc_stat(self.proto, self.library))
+
+    def test_loadavg_agrees_with_uptime_and_the_sessions_pids(self) -> None:
+        out = mirage_render.proc_loadavg(self.proto, self.library).decode()
+        self.assertEqual(out, f"0.00 0.00 0.00 1/109 {self.proto.last_pid}\n")
+        self.assertIn("load average: 0.00, 0.00, 0.00", self.run_line("uptime"))
+
+    def test_stat_is_carried_forward_from_the_record(self) -> None:
+        with mock.patch.object(self.proto, "uptime", return_value=30.0 + 1000.0):
+            now = self.stat()
+        # 1000 s more at 100 ticks a second, nearly all of it idle, on each processor.
+        self.assertEqual(sum(now["cpu0"]) - (120 + 140 + 2400 + 60 + 12), 100000)
+        self.assertGreater(now["cpu0"][3] - 2400, 99000)
+        self.assertEqual(now["cpu"], [a + b for a, b in zip(now["cpu0"], now["cpu1"], strict=True)])
+        self.assertEqual(now["btime"], [int(self.proto.boot_time())])
+        self.assertGreater(now["processes"][0], self.proto.last_pid)
+        self.assertGreater(now["ctxt"][0], 9000)
+        self.assertEqual(now["procs_running"], [1])
+
+    def test_stat_moves_between_two_reads(self) -> None:
+        with mock.patch.object(self.proto, "uptime", return_value=5000.0):
+            first = self.stat()
+        with mock.patch.object(self.proto, "uptime", return_value=5002.0):
+            second = self.stat()
+        self.assertEqual(sum(second["cpu1"]) - sum(first["cpu1"]), 200)
+        self.assertGreaterEqual(second["intr"][0], first["intr"][0])
+
+    def test_a_machine_younger_than_the_record_shows_the_record(self) -> None:
+        with mock.patch.object(self.proto, "uptime", return_value=10.0):
+            now = self.stat()
+        self.assertEqual(now["cpu0"], [120, 0, 140, 2400, 60, 0, 12, 0, 0, 0])
+        self.assertEqual(now["ctxt"], [9000])
