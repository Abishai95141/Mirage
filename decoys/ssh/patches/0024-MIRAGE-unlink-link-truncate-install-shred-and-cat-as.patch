@@ -0,0 +1,149 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: Tests of unlink, link, truncate, install and shred that the recorded
+# ABOUTME: lines cannot make here: contents, sizes, owners, and what is declined.
+
+from __future__ import annotations
+
+from cowrie.commands import mirage_filemore
+from cowrie.shell import fs as cfs
+from cowrie.test.test_mirage_gate import PROMPT, GateTestBase
+
+
+class Base(GateTestBase):
+    def text(self, line: str) -> str:
+        return self.run_line(line).decode()[: -len(PROMPT.decode())]
+
+    def held(self, path: str) -> bytes:
+        return bytes(self.proto.fs.file_contents(path))
+
+
+class TruncateTests(Base):
+    def test_a_longer_file_is_filled_with_nul_bytes_and_a_shorter_one_is_cut(
+        self,
+    ) -> None:
+        # The recorded lines look at this with od, which the emulator does not have.
+        self.text("truncate -s 10 /tmp/t1")
+        self.assertEqual(self.held("/tmp/t1"), b"\0" * 10)
+        self.text("echo hello world > /tmp/t2; truncate -s 5 /tmp/t2")
+        self.assertEqual(self.held("/tmp/t2"), b"hello")
+        self.text("truncate -s +3 /tmp/t2")
+        self.assertEqual(self.held("/tmp/t2"), b"hello\0\0\0")
+        self.assertEqual(self.text("wc -c /tmp/t2"), "8 /tmp/t2\n")
+
+    def test_a_size_as_truncate_reads_it(self) -> None:
+        size = mirage_filemore.size_of
+        self.assertEqual(size("10"), ("=", 10))
+        self.assertEqual(size("+3"), ("+", 3))
+        self.assertEqual(size("-6"), ("-", 6))
+        self.assertEqual(size("<100"), ("<", 100))
+        self.assertEqual(size("%700"), ("%", 700))
+        self.assertEqual(
+            (size("1K"), size("1KB"), size("2k")),
+            (("=", 1024), ("=", 1000), ("=", 2048)),
+        )
+        self.assertEqual(size("1M"), ("=", 1048576))
+        self.assertEqual((size("abc"), size("10x"), size("")), (None, None, None))
+
+    def test_a_reference_file_gives_the_size(self) -> None:
+        self.text("printf 123456 > /tmp/ref; truncate -r /tmp/ref /tmp/t3")
+        self.assertEqual(self.text("wc -c < /tmp/t3"), "6\n")
+        self.text("truncate -r /tmp/ref -s +5 /tmp/t3")
+        self.assertEqual(self.text("wc -c < /tmp/t3"), "11\n")
+
+    def test_a_file_too_large_to_hold_has_its_size_and_no_bytes(self) -> None:
+        self.text("truncate -s 1G /tmp/big")
+        self.assertEqual(self.proto.fs.getfile("/tmp/big")[cfs.A_SIZE], 1024**3)
+        self.assertEqual(self.held("/tmp/big"), b"")
+
+
+class InstallTests(Base):
+    def test_the_copy_holds_the_source_s_bytes_and_is_the_installer_s(self) -> None:
+        self.text("printf 'secret\\n' > /tmp/src; chmod 644 /tmp/src")
+        self.assertEqual(self.text("install -m 600 /tmp/src /tmp/dst; echo $?"), "0\n")
+        self.assertEqual(self.held("/tmp/dst"), b"secret\n")
+        self.assertEqual(
+            self.text("stat -c '%a %U %G %s' /tmp/dst"), "600 root root 7\n"
+        )
+        # A destination that is there is replaced: it takes the new mode.
+        self.text("install /tmp/src /tmp/dst")
+        self.assertEqual(self.text("stat -c '%a' /tmp/dst"), "755\n")
+
+    def test_an_owner_and_group_by_name_or_number(self) -> None:
+        self.text(
+            "printf x > /tmp/src; install -o 1000 -g 1000 -m 640 /tmp/src /tmp/owned"
+        )
+        node = self.proto.fs.getfile("/tmp/owned")
+        self.assertEqual((node[cfs.A_UID], node[cfs.A_GID]), (1000, 1000))
+        self.assertEqual(
+            self.text("install -o nosuchuser /tmp/src /tmp/x; echo $?"),
+            "install: invalid user 'nosuchuser'\n1\n",
+        )
+
+    def test_what_install_does_not_do_is_declined(self) -> None:
+        declines = mirage_filemore.Command_install.mirage_declines
+        for args in (
+            ["-b", "a", "b"],
+            ["--backup", "a", "b"],
+            ["-s", "a", "b"],
+            ["-C", "a", "b"],
+        ):
+            self.assertTrue(declines(args), args)
+        for args in (["-m", "600", "a", "b"], ["-d", "x"], ["--nosuch"], ["-x"]):
+            self.assertFalse(declines(args), args)
+
+
+class ShredTests(Base):
+    def test_the_file_is_left_at_a_whole_block_holding_other_bytes(self) -> None:
+        self.text("echo secret > /tmp/s1; shred /tmp/s1")
+        left = self.held("/tmp/s1")
+        self.assertEqual(len(left), 4096)
+        self.assertNotIn(b"secret", left)
+        self.text("echo secret > /tmp/s2; shred -n 1 -z /tmp/s2")
+        self.assertEqual(self.held("/tmp/s2"), b"\0" * 4096)
+        self.text("echo secret > /tmp/s3; shred -x /tmp/s3")
+        self.assertEqual(len(self.held("/tmp/s3")), 7)
+
+    def test_the_name_is_worn_down_one_character_at_a_time(self) -> None:
+        self.text("echo x > /tmp/abcd")
+        said = self.text("shred -u -v -n 0 /tmp/abcd")
+        self.assertEqual(
+            said,
+            "shred: /tmp/abcd: removing\n"
+            "shred: /tmp/abcd: renamed to /tmp/0000\n"
+            "shred: /tmp/0000: renamed to /tmp/000\n"
+            "shred: /tmp/000: renamed to /tmp/00\n"
+            "shred: /tmp/00: renamed to /tmp/0\n"
+            "shred: /tmp/abcd: removed\n",
+        )
+        self.assertFalse(self.proto.fs.exists("/tmp/abcd"))
+
+    def test_named_patterns_are_declined(self) -> None:
+        declines = mirage_filemore.Command_shred.mirage_declines
+        self.assertTrue(declines(["-v", "-n", "5", "f"]))
+        self.assertTrue(declines(["--random-source=/dev/zero", "f"]))
+        self.assertFalse(declines(["-n", "5", "f"]))
+        self.assertFalse(declines(["-v", "-u", "f"]))
+
+
+class LinkTests(Base):
+    def test_the_new_name_holds_what_the_file_held(self) -> None:
+        self.text("echo linked > /tmp/l1; link /tmp/l1 /tmp/l2")
+        self.assertEqual(self.text("cat /tmp/l2"), "linked\n")
+        self.text("unlink /tmp/l1")
+        self.assertEqual(
+            self.text("cat /tmp/l2; ls /tmp/l1 2>&1"),
+            "linked\nls: cannot access '/tmp/l1': No such file or directory\n",
+        )
+
+
+class CatTests(Base):
+    def test_a_file_with_no_newline_at_its_end_is_given_none(self) -> None:
+        self.assertEqual(self.text("printf abc > /tmp/c; cat /tmp/c | wc -c"), "3\n")
+        self.assertEqual(self.text("cat /tmp/c /tmp/c; echo ."), "abcabc.\n")
+
+    def test_someone_who_may_not_read_a_file_is_told_so(self) -> None:
+        self.text("printf secret > /tmp/mine; chmod 600 /tmp/mine")
+        shell = self.proto.cmdstack[0]
+        shell.user = {**shell.user, "username": "www-data", "uid": 33, "gid": 33}
+        said = self.run_line("cat /tmp/mine; echo $?").decode()
+        self.assertTrue(said.startswith("cat: /tmp/mine: Permission denied\n1\n"), said)
