+
+
+class Command_install(_TreeCommand):
+    """coreutils 9.1's install: copy files and set what they are, or make
+    directories. A destination that is there is replaced, not written over, so
+    it becomes the installer's. Backups, comparing and stripping are declined."""
+
+    name, program = "install", "/usr/bin/install"
+    short = "cdDg:m:o:pt:Tv"
+    long = (
+        "directory", "group=", "mode=", "owner=", "preserve-timestamps",
+        "target-directory=", "no-target-directory", "verbose", "help", "version",
+    )  # fmt: skip
+    declined: ClassVar[tuple[str, ...]] = (
+        "b", "C", "s", "S", "Z", "backup", "compare", "strip", "strip-program", "suffix",
+        "context", "preserve-context", "debug",
+    )  # fmt: skip
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        try:
+            cls._parse(args)
+        except getopt.GetoptError as err:
+            return any(
+                str(err.opt) == d or d.startswith(str(err.opt)) for d in cls.declined
+            )
+        return False
+
+    def call(self) -> None:
+        got = self.setup()
+        if got is None:
+            return
+        opts, operands = got
+        if _texts(self, opts, INSTALL_HELP, INSTALL_VERSION):
+            return
+        self.verbose = "-v" in opts or "--verbose" in opts
+        self.keep_times = "-p" in opts or "--preserve-timestamps" in opts
+        directories = "-d" in opts or "--directory" in opts
+        self.mode = 0o755
+        given = opts.get("-m", opts.get("--mode"))
+        if given is not None:
+            mode = _octal(given)
+            if mode is None:
+                mode = _apply_symbolic(given, 0, directories, 0)
+            if mode is None:
+                self.fail(f"invalid mode '{given}'")
+                return
+            self.mode = mode
+        users = Users()
+        self.uid, self.gid = int(self.user["uid"]), int(self.user["gid"])
+        owner = opts.get("-o", opts.get("--owner"))
+        if owner is not None:
+            entry = users.entry(owner)
+            if entry is None and not owner.isdigit():
+                self.fail(f"invalid user '{owner}'")
+                return
+            self.uid = int(entry["pw_uid"]) if entry else int(owner)
+        group = opts.get("-g", opts.get("--group"))
+        if group is not None:
+            found = [g for g in users.group if g["gr_name"] == group]
+            if not found and not group.isdigit():
+                self.fail(f"invalid group '{group}'")
+                return
+            self.gid = int(found[0]["gr_gid"]) if found else int(group)
+        if (self.uid, self.gid) != (
+            int(self.user["uid"]),
+            int(self.user["gid"]),
+        ) and int(self.user["uid"]):
+            # Only root gives files away; what a user is told depends on the kernel's
+            # answer for each file, which is not modelled here.
+            self.not_emulated()
+            return
+        if directories:
+            if not operands:
+                self.missing_file()
+                return
+            for shown in operands:
+                self.directory(shown, self.mode)
+            return
+        parents = "-D" in opts
+        into = opts.get("-t", opts.get("--target-directory"))
+        if into is not None and parents and operands:
+            if not self.directory(into, 0o755, keep=True):
+                return
+        placed = self.destination(opts, operands)
+        if placed is None:
+            return
+        sources, dest, inside = placed
+        for shown in sources:
+            target = posixpath.join(dest, _base(shown)) if inside else dest
+            if parents and not inside:
+                above = posixpath.dirname(target)
+                if (
+                    above
+                    and not self.is_dir(above)
+                    and not self.directory(above, 0o755, True)
+                ):
+                    continue
+            self.one(shown, target)
+
+    def destination(
+        self, opts: dict[str, str], operands: list[str]
+    ) -> tuple[list[str], str, bool] | None:
+        into = opts.get("-t", opts.get("--target-directory"))
+        if into is not None and operands and not self.is_dir(into):
+            code = 20 if self.node(self.resolved(into)) is not None else 2
+            self.fail(f"failed to access '{into}': {os.strerror(code)}")
+            return None
+        return super().destination(opts, operands)
+
+    def directory(self, shown: str, mode: int, keep: bool = False) -> bool:
+        """Make the directory and every missing one above it. The last takes the
+        mode and the owner asked for; one that was there takes them too, unless
+        it is only on the way to a file (``keep``)."""
+        pieces = [p for p in shown.split("/") if p]
+        walked = "/" if shown.startswith("/") else ""
+        for index, piece in enumerate(pieces):
+            walked += piece if walked in ("", "/") else f"/{piece}"
+            last = index == len(pieces) - 1
+            path = self.resolved(walked)
+            node = self.node(path)
+            if node is not None:
+                if node[cfs.A_TYPE] != cfs.T_DIR:
+                    self.fail(f"cannot create directory '{walked}': File exists")
+                    return False
+                if last and not keep:
+                    self.fs.chmod(path, stat.S_IFDIR | mode)
+                    self.fs.chown(path, self.uid, self.gid)
+                continue
+            code = self.code_of(self.access.may_create, path)
+            if code:
+                self.fail(f"cannot create directory '{walked}': {os.strerror(code)}")
+                return False
+            made = stat.S_IFDIR | (mode if last else 0o755)
+            self.fs.mkdir(
+                path, self.uid if last else self.user["uid"], self.gid, 4096, made
+            )
+            if self.verbose:
+                self.write(f"install: creating directory '{walked}'\n")
+        return True
+
+    def one(self, shown: str, target: str) -> None:
+        path, to = self.resolved(shown), self.resolved(target)
+        node = self.node(path)
+        if node is None:
+            self.fail(f"cannot stat '{shown}': No such file or directory")
+            return
+        if node[cfs.A_TYPE] == cfs.T_DIR:
+            self.fail(f"omitting directory '{shown}'")
+            return
+        if self.code_of(self.access.may_read, path):
+            self.fail(f"cannot open '{shown}' for reading: Permission denied")
+            return
+        there = self.node(to, False)
+        if there is not None and there[cfs.A_TYPE] == cfs.T_DIR:
+            self.fail(f"cannot overwrite directory '{target}' with non-directory")
+            return
+        if to == path:
+            self.fail(f"'{shown}' and '{target}' are the same file")
+            return
+        code = self.code_of(
+            self.access.may_unlink if there is not None else self.access.may_create, to
+        )
+        if code:
+            what = "remove" if there is not None else "create regular file"
+            self.fail(f"cannot {what} '{target}': {os.strerror(code)}")
+            return
+        if there is not None:
+            self.fs.remove(to)
+        size = int(node[cfs.A_SIZE])
+        self.fs.mkfile(to, self.uid, self.gid, size, stat.S_IFREG | self.mode)
+        made = self.fs.getfile(to)
+        made[cfs.A_CONTENTS] = (
+            node[cfs.A_CONTENTS] if node[cfs.A_TYPE] == cfs.T_FILE else []
+        )
+        made[cfs.A_REALFILE] = node[cfs.A_REALFILE]
+        made[cfs.A_SIZE] = size
+        if self.keep_times:
+            made[cfs.A_CTIME] = node[cfs.A_CTIME]
+        if self.verbose:
+            self.write(f"'{shown}' -> '{target}'\n")
+
