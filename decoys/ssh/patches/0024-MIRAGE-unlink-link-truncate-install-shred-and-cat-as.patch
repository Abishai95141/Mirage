+class Command_unlink(_TreeCommand):
+    """coreutils 9.1's unlink: one name, removed with the system call."""
+
+    name, program = "unlink", "/usr/bin/unlink"
+    long = ("help", "version")
+    declined: ClassVar[tuple[str, ...]] = ()
+
+    def call(self) -> None:
+        got = self.setup()
+        if got is None:
+            return
+        opts, operands = got
+        if _texts(self, opts, UNLINK_HELP, UNLINK_VERSION):
+            return
+        if not operands:
+            self.missing()
+            return
+        if len(operands) > 1:
+            self.errorWrite(
+                f"unlink: extra operand '{operands[1]}'\n"
+                "Try 'unlink --help' for more information.\n"
+            )
+            self.exit_code = 1
+            return
+        shown = operands[0]
+        path = self.resolved(shown)
+        node = self.node(path, False)
+        code = 0
+        if node is None:
+            code = errno.ENOENT
+        elif node[cfs.A_TYPE] == cfs.T_DIR:
+            code = errno.EISDIR
+        else:
+            code = self.code_of(self.access.may_unlink, path)
+        if code:
+            self.fail(f"cannot unlink '{shown}': {os.strerror(code)}")
+            return
+        self.fs.remove(path)
+
+
+# -------------------------------------------------------------------- link
+
+
+class Command_link(_TreeCommand):
+    """coreutils 9.1's link: a second name for a file, made with the system call."""
+
+    name, program = "link", "/usr/bin/link"
+    long = ("help", "version")
+    declined: ClassVar[tuple[str, ...]] = ()
+
+    def call(self) -> None:
+        got = self.setup()
+        if got is None:
+            return
+        opts, operands = got
+        if _texts(self, opts, LINK_HELP, LINK_VERSION):
+            return
+        if len(operands) < 2:
+            self.missing(operands[0] if operands else None)
+            return
+        if len(operands) > 2:
+            self.errorWrite(
+                f"link: extra operand '{operands[2]}'\nTry 'link --help' for more information.\n"
+            )
+            self.exit_code = 1
+            return
+        target, shown = operands
+        source, to = self.resolved(target), self.resolved(shown)
+        node = self.node(source, False)
+        if node is None:
+            code = errno.ENOENT
+        elif node[cfs.A_TYPE] == cfs.T_DIR:
+            code = errno.EPERM
+        elif self.node(to, False) is not None:
+            code = errno.EEXIST
+        else:
+            code = self.code_of(self.access.may_create, to)
+        if code:
+            self.fail(
+                f"cannot create link '{shown}' to '{target}': {os.strerror(code)}"
+            )
+            return
+        self.fs.hardlink(source, to)
