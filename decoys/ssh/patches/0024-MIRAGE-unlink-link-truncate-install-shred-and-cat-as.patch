+def _texts(command: Any, opts: dict[str, str], help_text: str, version: str) -> bool:
+    """Print the help or the version if asked for; True if that was all."""
+    if "--help" in opts:
+        command.write(help_text)
+        return True
+    if "--version" in opts:
+        command.write(version)
+        return True
+    return False
+
+
+def _contents(command: Any, path: str) -> bytes:
+    try:
+        return bytes(command.fs.file_contents(path))
+    except Exception:
+        return b""
+
+
+def _hold(command: Any, path: str, data: bytes | None, size: int) -> None:
+    """Give the file at ``path`` this size, and these bytes where they are held."""
+    command.fs.update_size(path, size)
+    node = command.fs.getfile(path)
+    node[cfs.A_CONTENTS] = data if data is not None else b""
+    node[cfs.A_REALFILE] = None
+    node[cfs.A_SIZE] = size
+
+
+# ------------------------------------------------------------------ unlink
