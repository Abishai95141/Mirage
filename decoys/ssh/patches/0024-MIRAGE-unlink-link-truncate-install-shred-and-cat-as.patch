+# ------------------------------------------------------------------- shred
+
+
+class Command_shred(_TreeCommand):
+    """coreutils 9.1's shred. The passes are not made: the file is left holding
+    what the last one would have written (random bytes, or zeros with -z), at
+    the size shred leaves it. More than three random passes use patterns that
+    -v names, and are declined."""
+
+    name, program = "shred", "/usr/bin/shred"
+    short = "fn:s:uvxz"
+    long = ("force", "iterations=", "size=", "remove", "remove=", "verbose", "exact", "zero",
+            "help", "version")  # fmt: skip
+    declined: ClassVar[tuple[str, ...]] = ("random-source",)
+
+    @classmethod
+    def _parse(cls, args: list[str]) -> tuple[list[tuple[str, str]], list[str]]:
+        # --remove takes its value only when it is attached (--remove=wipe).
+        long = [
+            n
+            for n in cls.long
+            if n
+            != ("remove" if any(a.startswith("--remove=") for a in args) else "remove=")
+        ]
+        return getopt.gnu_getopt(args, cls.short, long)
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        try:
+            opts, _ = cls._parse(args)
+        except getopt.GetoptError as err:
+            return str(err.opt).startswith("random")
+        found = dict(opts)
+        passes = found.get("-n", found.get("--iterations", "3"))
+        verbose = "-v" in found or "--verbose" in found
+        return verbose and passes.isdigit() and int(passes) > 3
+
+    def call(self) -> None:
+        got = self.setup()
+        if got is None:
+            return
+        opts, operands = got
+        if _texts(self, opts, SHRED_HELP, SHRED_VERSION):
+            return
+        given = opts.get("-n", opts.get("--iterations"))
+        if given is not None and not given.isdigit():
+            self.fail(f"invalid number of passes: '{given}'")
+            return
+        passes = 3 if given is None else int(given)
+        exact_size: int | None = None
+        sized = opts.get("-s", opts.get("--size"))
+        if sized is not None:
+            parsed = size_of(sized)
+            if parsed is None or parsed[0] != "=":
+                self.fail(f"invalid file size: '{sized}'")
+                return
+            exact_size = parsed[1]
+        how = opts.get("--remove")
+        if how not in (None, "", "unlink", "wipe", "wipesync"):
+            self.errorWrite(
+                f"shred: invalid argument '{how}' for '--remove'\n"
+                "Valid arguments are:\n  - 'unlink'\n  - 'wipe'\n  - 'wipesync'\n"
+                "Try 'shred --help' for more information.\n"
+            )
+            self.exit_code = 1
+            return
+        remove = "-u" in opts or how is not None
+        if not operands:
+            self.missing_file()
+            return
+        self.verbose = "-v" in opts or "--verbose" in opts
+        zero = "-z" in opts or "--zero" in opts
+        exact = "-x" in opts or "--exact" in opts
+        for shown in operands:
+            self.one(shown, passes, zero, exact, exact_size, remove, how or "wipesync")
+
+    def say(self, shown: str, text: str) -> None:
+        if self.verbose:
+            self.errorWrite(f"shred: {shown}: {text}\n")
+
+    def one(
+        self,
+        shown: str,
+        passes: int,
+        zero: bool,
+        exact: bool,
+        exact_size: int | None,
+        remove: bool,
+        how: str,
+    ) -> None:
+        path = self.resolved(shown)
+        node = self.node(path)
+        code = (
+            errno.ENOENT if node is None else self.code_of(self.access.may_write, path)
+        )
+        if code:
+            self.fail_on(shown, f"failed to open for writing: {os.strerror(code)}")
+            return
+        size = int(node[cfs.A_SIZE])
+        if exact_size is not None:
+            size = exact_size
+        elif not exact and size % BLOCK:
+            size += BLOCK - size % BLOCK
+        total = passes + (1 if zero else 0)
+        for index in range(1, total + 1):
+            kind = "000000" if zero and index == total else "random"
+            self.say(shown, f"pass {index}/{total} ({kind})...")
+        if total:
+            data: bytes | None = None
+            if size <= HELD_MAX:
+                data = b"\0" * size if zero else os.urandom(size)
+            _hold(self, path, data, size)
+        if not remove:
+            return
+        code = self.code_of(self.access.may_unlink, path)
+        if code:
+            self.fail_on(shown, f"failed to remove: {os.strerror(code)}")
+            return
+        self.say(shown, "removing")
+        if how != "unlink":
+            # The name is worn down before the file goes: zeros, one fewer each time.
+            head = shown[: len(shown) - len(_base(shown))]
+            last = shown
+            for length in range(len(_base(shown)), 0, -1):
+                name = head + "0" * length
+                self.say(last, f"renamed to {name}")
+                last = name
+        self.fs.remove(path)
+        self.say(shown, "removed")
+
+    def fail_on(self, shown: str, text: str) -> None:
+        self.errorWrite(f"shred: {shown}: {text}\n")
+        self.exit_code = 1
+
+
+# --------------------------------------------------------------------- cat
+
+_CAT_LONG = [
+    "number-nonblank", "number", "squeeze-blank", "show-nonprinting", "show-ends",
+    "show-tabs", "show-all", "help", "version",
+]  # fmt: skip
+_CAT_FLAGS = {
+    "-A": "vET", "--show-all": "vET", "-b": "b", "--number-nonblank": "b", "-e": "vE",
+    "-E": "E", "--show-ends": "E", "-n": "n", "--number": "n", "-s": "s",
+    "--squeeze-blank": "s", "-t": "vT", "-T": "T", "--show-tabs": "T", "-u": "",
+    "-v": "v", "--show-nonprinting": "v",
+}  # fmt: skip
+
+
+class Command_cat(StockCat):
+    """coreutils 9.1's cat. Stock Cowrie's ended every file with a newline
+    whether it had one or not (``printf abc > f; cat f | wc -c`` said 4), took
+    -A, -b, -E, -s, -T and -v and did nothing for them, numbered lines with two
+    spaces where cat puts a tab, and read any file for anyone."""
+
+    def start(self) -> None:
+        try:
+            optlist, args = getopt.gnu_getopt(self.args, "AbeEnstTuv", _CAT_LONG)
+        except getopt.GetoptError as err:
+            if "not a unique prefix" in err.msg:
+                some = " ".join(
+                    f"'--{n}'" for n in _CAT_LONG if n.startswith(str(err.opt))
+                )
+                self.errorWrite(
+                    f"cat: option '--{err.opt}' is ambiguous; possibilities: {some}\n"
+                )
+            else:
+                self.errorWrite(option_error("cat", err))
+            self.errorWrite("Try 'cat --help' for more information.\n")
+            self.exit_code = 1
+            self.exit()
+            return
+        flags = ""
+        for option, _ in optlist:
+            if option in ("--help", "--version"):
+                self.write(CAT_HELP if option == "--help" else CAT_VERSION)
+                self.exit()
+                return
+            flags += _CAT_FLAGS[option]
+        self.nonblank = "b" in flags
+        self.every = "n" in flags and not self.nonblank
+        self.squeeze, self.ends = "s" in flags, "E" in flags
+        self.tabs, self.nonprinting = "T" in flags, "v" in flags
+        self.plain = not flags
+        self.number = not self.plain  # what the stock class asks when input ends
+        self.linenumber = 1
+        self.line_start, self.blank_before = True, False
+        if args:
+            access = mirage_state.Access(self.shell)
+            for arg in args:
+                if arg == "-":
+                    self.output(self.input_data)
+                    continue
+                path = self.fs.resolve_path(arg, self.cwd)
+                if self.fs.isdir(path):
+                    self.errorWrite(f"cat: {arg}: Is a directory\n")
+                    self.exit_code = 1
+                    continue
+                try:
+                    access.may_read(path)
+                    self.output(self.fs.file_contents(path))
+                except mirage_state.Rejected as e:
+                    self.errorWrite(
+                        f"cat: {arg}: {os.strerror(e.code or errno.EACCES)}\n"
+                    )
+                    self.exit_code = 1
+                except cfs.FileNotFound:
+                    self.errorWrite(f"cat: {arg}: No such file or directory\n")
+                    self.exit_code = 1
+            self.exit()
+        elif self.input_data is not None:
+            self.output(self.input_data)
+            self.exit()
+
+    def output(self, inb: bytes | None) -> None:
+        if not inb:
+            return
+        if self.plain:
+            self.writeBytes(bytes(inb))
+            return
+        out = bytearray()
+        pieces = bytes(inb).split(b"\n")
+        for index, body in enumerate(pieces):
+            ended = index < len(pieces) - 1
+            if not ended and not body:
+                break
+            blank = self.line_start and not body and ended
+            if blank and self.squeeze and self.blank_before:
+                continue
+            self.blank_before = blank
+            if self.line_start and (self.every or (self.nonblank and not blank)):
+                out += f"{self.linenumber:>6}\t".encode()
+                self.linenumber += 1
+            if ended and self.ends and not self.nonprinting and body.endswith(b"\r"):
+                body = body[:-1] + b"^M"
+            out += self._shown(body)
+            if ended:
+                out += b"$\n" if self.ends else b"\n"
+            self.line_start = ended
+        self.writeBytes(bytes(out))
+
+    def _shown(self, body: bytes) -> bytes:
+        if not (self.tabs or self.nonprinting):
+            return body
+        out = bytearray()
+        for b in body:
+            if b == 9:
+                out += b"^I" if self.tabs else b"\t"
+            elif not self.nonprinting or 32 <= b < 127:
+                out.append(b)
+            elif b < 32:
+                out += b"^" + bytes([b + 64])
+            elif b == 127:
+                out += b"^?"
+            else:
+                low = b - 128
+                out += b"M-"
+                if low < 32:
+                    out += b"^" + bytes([low + 64])
+                elif low == 127:
+                    out += b"^?"
+                else:
+                    out.append(low)
+        return bytes(out)
+
+    def lineReceived(self, line: str) -> None:
+        self.protocol.events.dispatch(
+            "cowrie.session.input",
+            "INPUT (%(realm)s): %(input)s",
+            realm="cat",
+            input=line,
+        )
+        self.output(line.rstrip("\n").encode("utf-8") + b"\n")
+
+
+for _path in ("cat", "/bin/cat", "/usr/bin/cat"):
+    commands[_path] = Command_cat
+
+
+for _name, _class in (
+    ("unlink", Command_unlink),
+    ("link", Command_link),
+    ("truncate", Command_truncate),
+    ("install", Command_install),
+    ("shred", Command_shred),
+):
+    for _path in (_name, f"/usr/bin/{_name}", f"/bin/{_name}"):
+        commands[_path] = _class
