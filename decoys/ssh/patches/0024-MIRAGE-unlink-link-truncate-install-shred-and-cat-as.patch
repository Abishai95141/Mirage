+# ---------------------------------------------------------------- truncate
+
+BLOCK = 4096
+HELD_MAX = 16 * 1024 * 1024  # bytes of a file's contents kept in memory
+_UNITS = {"": 1, "B": 1}
+for _power, _letter in enumerate("KMGTPE", start=1):
+    _UNITS[_letter] = _UNITS[f"{_letter}iB"] = 1024**_power
+    _UNITS[f"{_letter}B"] = 1000**_power
+_UNITS["k"], _UNITS["kB"] = 1024, 1000
+
+
+def size_of(text: str) -> tuple[str, int] | None:
+    """A SIZE as truncate reads it: (how it is applied, the number). How is one of
+    ``=`` (set), ``+`` and ``-`` (by), ``<`` (at most), ``>`` (at least), ``/`` (round
+    down to a multiple) and ``%`` (round up to one). None for what is no size."""
+    rest = text.lstrip(" ")
+    how = "="
+    if rest[:1] in ("<", ">", "/", "%"):
+        how, rest = rest[0], rest[1:].lstrip(" ")
+    sign = 1
+    if rest[:1] in ("+", "-"):
+        if how == "=":
+            how = rest[0]
+        elif rest[0] == "-":
+            sign = -1
+        rest = rest[1:]
+    digits = len(rest) - len(rest.lstrip("0123456789"))
+    if not digits or rest[digits:] not in _UNITS:
+        return None
+    return how, sign * int(rest[:digits]) * _UNITS[rest[digits:]]
+
+
+class Command_truncate(_TreeCommand):
+    """coreutils 9.1's truncate. A file made longer is filled with NUL bytes,
+    which are held as long as the file is no larger than HELD_MAX."""
+
+    name, program = "truncate", "/usr/bin/truncate"
+    short = "cor:s:"
+    long = ("no-create", "io-blocks", "reference=", "size=", "help", "version")
+    declined: ClassVar[tuple[str, ...]] = ()
+
+    def call(self) -> None:
+        got = self.setup()
+        if got is None:
+            return
+        opts, operands = got
+        if _texts(self, opts, TRUNCATE_HELP, TRUNCATE_VERSION):
+            return
+        given = opts.get("-s", opts.get("--size"))
+        reference = opts.get("-r", opts.get("--reference"))
+        blocks = "-o" in opts or "--io-blocks" in opts
+        tried = "Try 'truncate --help' for more information.\n"
+        if given is None and reference is None:
+            self.errorWrite(
+                f"truncate: you must specify either '--size' or '--reference'\n{tried}"
+            )
+            self.exit_code = 1
+            return
+        how, number = "=", 0
+        if given is not None:
+            parsed = size_of(given)
+            if parsed is None:
+                self.fail(f"Invalid number: '{given}'")
+                return
+            how, number = parsed
+            if how in "/%" and number == 0:
+                self.fail("division by zero")
+                return
+        if reference is not None and given is not None and how == "=":
+            self.errorWrite(
+                f"truncate: you must specify a relative '--size' with '--reference'\n{tried}"
+            )
+            self.exit_code = 1
+            return
+        if blocks and given is None:
+            self.errorWrite(
+                f"truncate: '--io-blocks' was specified but '--size' was not\n{tried}"
+            )
+            self.exit_code = 1
+            return
+        if not operands:
+            self.missing_file()
+            return
+        base: int | None = None
+        if reference is not None:
+            node = self.node(self.resolved(reference))
+            if node is None:
+                self.fail(f"cannot stat '{reference}': No such file or directory")
+                return
+            base = int(node[cfs.A_SIZE])
+        if blocks:
+            number *= BLOCK
+        no_create = "-c" in opts or "--no-create" in opts
+        for shown in operands:
+            self.one(shown, how, number, base, no_create, given is not None)
+
+    def one(
+        self,
+        shown: str,
+        how: str,
+        number: int,
+        base: int | None,
+        no_create: bool,
+        sized: bool,
+    ) -> None:
+        path = self.resolved(shown)
+        node = self.node(path)
+        if node is None and no_create:
+            return
+        code = self.code_of(self.access.may_write, path)
+        if code:
+            self.fail(f"cannot open '{shown}' for writing: {os.strerror(code)}")
+            return
+        if node is None:
+            self.fs.mkfile(
+                path, self.user["uid"], self.user["gid"], 0, stat.S_IFREG | 0o644
+            )
+            node = self.fs.getfile(path)
+        now = int(node[cfs.A_SIZE])
+        start = now if base is None else base
+        if not sized:
+            new = start
+        elif how == "=":
+            new = number
+        elif how == "+":
+            new = start + number
+        elif how == "-":
+            new = max(0, start - number)
+        elif how == "<":
+            new = min(start, number)
+        elif how == ">":
+            new = max(start, number)
+        elif how == "/":
+            new = start - start % number
+        else:
+            new = start + (-start) % number
+        new = max(0, new)
+        if new == now:
+            return
+        data: bytes | None = None
+        if new <= HELD_MAX:
+            held = _contents(self, path)[:new]
+            data = held + b"\0" * (new - len(held))
+        _hold(self, path, data, new)
+
+
