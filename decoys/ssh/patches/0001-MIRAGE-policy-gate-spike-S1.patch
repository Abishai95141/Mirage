@@ -0,0 +1,258 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: Tests the MIRAGE policy gate: every simple command is decided by an
+# ABOUTME: external policy before it runs, without changing shell semantics.
+
+from __future__ import annotations
+
+import os
+import tempfile
+import time
+import unittest
+from typing import Any
+from unittest import mock
+
+from twisted.internet import defer
+
+from cowrie import mirage_gate
+from cowrie.shell.protocol import HoneyPotInteractiveProtocol
+from cowrie.test.eventcapture import capture_eventlog
+from cowrie.test.fake_server import FakeAvatar, FakeServer
+from cowrie.test.fake_transport import FakeTransport
+from cowrie.test.reactorpump import pump
+
+os.environ["COWRIE_HONEYPOT_DATA_PATH"] = "data"
+os.environ["COWRIE_HONEYPOT_DOWNLOAD_PATH"] = tempfile.gettempdir()
+os.environ["COWRIE_SHELL_FILESYSTEM"] = "src/cowrie/data/fs.pickle"
+
+PROMPT = b"root@unitTest:~# "
+
+
+class FakeGate:
+    """In-process stand-in for the policy service.
+
+    ``rule(request)`` returns the decision. With ``manual`` the decision is
+    held until ``release()``, as a slow network reply would be.
+    """
+
+    def __init__(self, rule: Any, manual: bool = False) -> None:
+        self.rule = rule
+        self.manual = manual
+        self.requests: list[dict[str, Any]] = []
+        self.held: list[tuple[defer.Deferred, dict[str, Any]]] = []
+
+    def decide(self, request: dict[str, Any]) -> defer.Deferred:
+        self.requests.append(request)
+        if not self.manual:
+            return defer.succeed(self.rule(request))
+        d: defer.Deferred = defer.Deferred()
+        self.held.append((d, request))
+        return d
+
+    def release(self) -> None:
+        d, request = self.held.pop(0)
+        d.callback(self.rule(request))
+
+    def argvs(self) -> list[list[str]]:
+        return [r["argv"] for r in self.requests]
+
+
+def allow(_request: dict[str, Any]) -> dict[str, Any]:
+    return {"action": "allow", "decision_id": "d", "propensity": 1.0}
+
+
+def fake_unknown(request: dict[str, Any]) -> dict[str, Any]:
+    """Answer commands the emulator lacks; allow everything else."""
+    if not request["known"]:
+        return {"action": "fake_success", "output": "ok\n", "decision_id": "d"}
+    return allow(request)
+
+
+class GateTestBase(unittest.TestCase):
+    rule: Any = staticmethod(allow)
+    manual = False
+
+    def setUp(self) -> None:
+        self.gate = FakeGate(self.rule, self.manual)
+        mirage_gate.reset_for_tests(self.gate)
+        self.proto = HoneyPotInteractiveProtocol(FakeAvatar(FakeServer()))
+        self.tr = FakeTransport("", "31337")
+        self.proto.makeConnection(self.tr)
+        self.proto.events, self.events = capture_eventlog()
+        self.tr.clear()
+
+    def tearDown(self) -> None:
+        self.proto.connectionLost()
+        mirage_gate.reset_for_tests()
+
+    def run_line(self, line: str) -> bytes:
+        self.tr.clear()
+        self.proto.lineReceived(line.encode() + b"\n")
+        return self.tr.value()
+
+    def decisions(self) -> list[dict[str, Any]]:
+        return [e for e in self.events if e["eventid"] == "cowrie.policy.decision"]
+
+
+class AllowTests(GateTestBase):
+    def test_allowed_command_runs_unchanged(self) -> None:
+        self.assertEqual(self.run_line("echo hi"), b"hi\n" + PROMPT)
+        self.assertEqual(self.gate.argvs(), [["echo", "hi"]])
+        self.assertTrue(self.gate.requests[0]["known"])
+        self.assertEqual(self.gate.requests[0]["session_id"], "test0000")
+
+    def test_every_pipeline_stage_is_gated(self) -> None:
+        self.assertEqual(self.run_line("echo abc | grep b"), b"abc\n" + PROMPT)
+        self.assertEqual(self.gate.argvs(), [["echo", "abc"], ["grep", "b"]])
+
+    def test_list_and_loop_bodies_are_gated(self) -> None:
+        self.run_line("for i in 1 2; do echo $i; done; true")
+        self.assertEqual(self.gate.argvs(), [["echo", "1"], ["echo", "2"], ["true"]])
+
+    def test_expansion_happens_before_the_gate(self) -> None:
+        self.run_line("x=/etc; ls $x/passwd")
+        self.assertIn(["ls", "/etc/passwd"], self.gate.argvs())
+
+    def test_unknown_command_reports_known_false(self) -> None:
+        out = self.run_line("frobnicate --now")
+        self.assertIn(b"command not found", out)
+        self.assertFalse(self.gate.requests[0]["known"])
+
+    def test_decision_event_emitted(self) -> None:
+        self.run_line("echo hi")
+        (event,) = self.decisions()
+        self.assertEqual(event["action"], "allow")
+        self.assertFalse(event["fallback"])
+        self.assertEqual(event["input"], "echo hi")
+        self.assertIn("latency_ms", event)
+
+    def test_sudo_and_busybox_inner_commands_are_not_gated_separately(self) -> None:
+        # Known limit, documented in the spike result: wrapper commands resolve
+        # their inner command directly, so the gate sees the whole argv once.
+        self.run_line("sudo id")
+        self.run_line("busybox id")
+        self.assertEqual(self.gate.argvs(), [["sudo", "id"], ["busybox", "id"]])
+
+
+class FakeResponseTests(GateTestBase):
+    rule = staticmethod(fake_unknown)
+
+    def test_unknown_command_answered_instead_of_not_found(self) -> None:
+        self.assertEqual(self.run_line("frobnicate"), b"ok\n" + PROMPT)
+        self.assertEqual(self.run_line("echo $?"), b"0\n" + PROMPT)
+
+    def test_fake_output_inside_substitution(self) -> None:
+        self.assertEqual(self.run_line("x=$(frobnicate); echo [$x]"), b"[ok]\n" + PROMPT)
+
+    def test_fake_output_into_pipeline(self) -> None:
+        self.assertEqual(self.run_line("frobnicate | tr a-z A-Z"), b"OK\n" + PROMPT)
+
+    def test_fake_output_honours_redirection(self) -> None:
+        self.assertEqual(self.run_line("frobnicate > /tmp/f"), PROMPT)
+        self.assertEqual(self.run_line("cat /tmp/f"), b"ok\n" + PROMPT)
+
+    def test_real_commands_still_run(self) -> None:
+        self.assertEqual(self.run_line("echo real"), b"real\n" + PROMPT)
+
+
+def deny_shadow(request: dict[str, Any]) -> dict[str, Any]:
+    if "/etc/shadow" in request["argv"]:
+        return {"action": "fake_error", "output": "cat: /etc/shadow: Permission denied\n"}
+    return allow(request)
+
+
+class FakeErrorTests(GateTestBase):
+    rule = staticmethod(deny_shadow)
+
+    def test_fake_error_sets_status_and_short_circuits(self) -> None:
+        out = self.run_line("cat /etc/shadow && echo yes || echo no")
+        self.assertEqual(out, b"cat: /etc/shadow: Permission denied\nno\n" + PROMPT)
+        self.assertEqual(self.run_line("cat /etc/shadow; echo $?"), b"cat: /etc/shadow: Permission denied\n1\n" + PROMPT)
+
+    def test_fake_error_goes_to_stderr(self) -> None:
+        self.assertEqual(self.run_line("cat /etc/shadow 2>/dev/null"), PROMPT)
+
+
+class FallbackTests(GateTestBase):
+    rule = staticmethod(lambda _r: None)  # service unreachable or timed out
+
+    def test_no_decision_means_stock_behaviour(self) -> None:
+        self.assertIn(b"command not found", self.run_line("frobnicate"))
+        self.assertEqual(self.run_line("echo hi"), b"hi\n" + PROMPT)
+        self.assertTrue(all(e["fallback"] for e in self.decisions()))
+
+    def test_malformed_decision_means_allow(self) -> None:
+        self.gate.rule = lambda _r: {"action": "rm -rf"}
+        self.assertEqual(self.run_line("echo hi"), b"hi\n" + PROMPT)
+
+
+class AsyncDecisionTests(GateTestBase):
+    manual = True
+
+    def test_nothing_runs_until_the_decision(self) -> None:
+        self.assertEqual(self.run_line("echo first"), b"")
+        self.gate.release()
+        self.assertEqual(self.tr.value(), b"first\n" + PROMPT)
+
+    def test_typed_ahead_line_waits_its_turn(self) -> None:
+        self.proto.lineReceived(b"echo first\n")
+        self.proto.lineReceived(b"echo second\n")
+        self.assertEqual(self.tr.value(), b"")
+        self.assertEqual(len(self.gate.held), 1, "second line must not be gated yet")
+        self.gate.release()
+        self.gate.release()
+        self.assertEqual(self.tr.value(), b"first\nsecond\n" + PROMPT)
+
+    def test_ctrl_c_cancels_pending_command(self) -> None:
+        self.proto.lineReceived(b"echo never\n")
+        self.proto.cmdstack[-1].handle_CTRL_C()
+        self.gate.release()
+        self.assertNotIn(b"never", self.tr.value())
+        self.assertTrue(self.tr.value().endswith(PROMPT))
+        self.gate.manual = False  # answer the next command at once
+        self.assertEqual(self.run_line("echo $?"), b"130\n" + PROMPT)
+
+    def test_connection_lost_while_pending(self) -> None:
+        self.proto.lineReceived(b"echo late\n")
+        self.proto.connectionLost()
+        self.gate.release()  # must not raise
+        self.proto = HoneyPotInteractiveProtocol(FakeAvatar(FakeServer()))
+        self.proto.makeConnection(FakeTransport("", "31337"))
+
+    def test_async_decisions_in_a_pipeline(self) -> None:
+        self.proto.lineReceived(b"echo abc | grep b\n")
+        self.gate.release()
+        self.gate.release()
+        self.assertEqual(self.tr.value(), b"abc\n" + PROMPT)
+
+
+class DelayTests(GateTestBase):
+    rule = staticmethod(lambda r: {"action": "delay", "delay_ms": 200} if r["argv"][0] == "echo" else allow(r))
+
+    def test_delay_then_run(self) -> None:
+        start = time.monotonic()
+        self.assertEqual(self.run_line("echo slow"), b"")
+        self.assertTrue(pump(lambda: self.tr.value().endswith(PROMPT), timeout=3))
+        self.assertGreaterEqual(time.monotonic() - start, 0.19)
+        self.assertEqual(self.tr.value(), b"slow\n" + PROMPT)
+
+
+class TerminateTests(GateTestBase):
+    rule = staticmethod(lambda r: {"action": "terminate"} if r["argv"][0] == "rm" else allow(r))
+
+    def test_terminate_ends_session(self) -> None:
+        with mock.patch.object(self.proto, "end_process", wraps=self.proto.end_process) as end:
+            self.run_line("rm -rf /")
+            end.assert_called_once_with(0)
+
