+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE policy gate. Before the shell runs a simple command, ask an
+# ABOUTME: external policy service how to answer it; fail open to stock behaviour.
+
+"""MIRAGE policy gate for the Cowrie shell.
+
+``HoneyPotShell.runCommand`` expands a simple command and hands its argv to
+:func:`gate_then_run` instead of ``_run_expanded``. With the gate disabled
+(the default) that is a direct call to ``_run_expanded``: stock behaviour.
+
+With it enabled, the argv goes to the policy service, and the reply decides:
+
+``allow``         run the command as Cowrie would.
+``delay``         wait ``delay_ms`` (capped), then run it.
+``fake_success``  print ``output`` on stdout, exit 0, do not run the command.
+``fake_error``    print ``output`` on stderr, exit ``exit_code`` (default 1).
+``terminate``     end the session.
+
+Any failure to get a decision in time (service down, slow, malformed reply)
+means ``allow``: the decoy must never hang on, or reveal, the policy service.
+
+While the decision is pending a placeholder command sits on the cmdstack, so
+lines typed meanwhile are queued for after the command (as they are while any
+command runs) and Ctrl-C cancels the pending command as it would a process.
+"""
+
+from __future__ import annotations
+
+import re
+import time
+import uuid
+from typing import TYPE_CHECKING, Any
+
+import treq
+from twisted.internet import defer, reactor
+from twisted.logger import Logger
+
+from cowrie.core.config import CowrieConfig
+from cowrie.shell.command import HoneyPotCommand
+
+if TYPE_CHECKING:
+    from cowrie.shell.honeypot import HoneyPotShell
+
+log = Logger()
+
+ASSIGNMENT_WORD = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
+MAX_DELAY_MS = 10_000
+MAX_OUTPUT_BYTES = 64 * 1024
+ACTIONS = {"allow", "delay", "fake_success", "fake_error", "terminate"}
+
+
+class PolicyGate:
+    """HTTP client for the policy service.
+
+    Connections are kept alive (a TCP handshake per command would dominate the
+    latency budget). Two measured pitfalls shape this (spike S1):
+
+    * A server closing an idle keep-alive connection races the next request,
+      which then fails with ResponseNeverReceived; Twisted does not retry a
+      POST. So idle connections are dropped client-side *before* the server's
+      keep-alive timeout (``idle_s``), and a request that fails on a reused
+      connection is retried once while the deadline allows.
+    * On dual-stack Docker networks the name resolves to IPv6 first; a service
+      listening on IPv4 only costs Twisted's 300 ms happy-eyeballs delay on
+      every new connection. The policy service must listen on both.
+    """
+
+    def __init__(self, url: str, timeout_s: float, idle_s: float = 2.0) -> None:
+        from twisted.web.client import Agent, HTTPConnectionPool
+
+        self.url = url
+        self.timeout_s = timeout_s
+        pool = HTTPConnectionPool(reactor, persistent=True)
+        pool.maxPersistentPerHost = 8
+        pool.cachedConnectionTimeout = idle_s
+        pool.retryAutomatically = False
+        self._http = treq.client.HTTPClient(Agent(reactor, pool=pool))
+
+    @classmethod
+    def from_config(cls) -> PolicyGate | None:
+        if not CowrieConfig.getboolean("mirage", "policy_enabled", fallback=False):
+            return None
+        url = CowrieConfig.get("mirage", "policy_url", fallback="http://policy:8000/v1/decide")
+        timeout_ms = CowrieConfig.getint("mirage", "policy_timeout_ms", fallback=50)
+        idle_ms = CowrieConfig.getint("mirage", "policy_idle_ms", fallback=2000)
+        return cls(url, timeout_ms / 1000.0, idle_ms / 1000.0)
+
+    def decide(self, request: dict[str, Any]) -> defer.Deferred[dict[str, Any] | None]:
+        deadline = time.monotonic() + self.timeout_s
+
+        def attempt() -> defer.Deferred:
+            d = self._http.post(self.url, json=request)
+            d.addCallback(_json_or_none)
+            return d
+
+        def retry_stale(failure: Any) -> Any:
+            from twisted.web._newclient import ResponseNeverReceived
+
+            if failure.check(ResponseNeverReceived) and time.monotonic() < deadline:
+                return attempt()
+            return failure
+
+        d = attempt()
+        d.addErrback(retry_stale)
+        d.addTimeout(self.timeout_s, reactor)
+        d.addErrback(_none, self.url)
+        return d
+
+
+def set_tcp_nodelay(ssh_transport: Any) -> None:
+    """Disable Nagle on the attacker's TCP connection, as OpenSSH does for an
+    interactive (pty) session.
+
+    Without it, output written in a later reactor turn than the echoed input
+    (anything answered asynchronously, such as a gated command) waits for the
+    client's delayed ACK: about 40 ms per command, measured in spike S1. The
+    connection may sit behind a PROXY-protocol wrapper, so walk down to the
+    real TCP transport.
+    """
+    t = getattr(ssh_transport, "transport", None)
+    while t is not None and not hasattr(t, "setTcpNoDelay"):
+        t = getattr(t, "transport", None)
+    if t is not None:
+        try:
+            t.setTcpNoDelay(True)
+        except OSError:
+            pass
+
+
+def _json_or_none(response: Any) -> Any:
+    if response.code != 200:
+        return None
+    return treq.json_content(response)
+
+
+def _none(failure: Any, url: str) -> None:
+    log.info("policy gate fell back to allow ({err})", err=failure.getErrorMessage())
+    return None
+
+
+_UNSET = object()
+_gate: Any = _UNSET
+
+
+def _get_gate() -> PolicyGate | None:
+    global _gate
+    if _gate is _UNSET:
+        _gate = PolicyGate.from_config()
+    return _gate
+
+
+def reset_for_tests(gate: PolicyGate | None | object = _UNSET) -> None:
+    global _gate
+    _gate = gate
+
+
+class _AwaitingDecision(HoneyPotCommand):
+    """Stands in for the command while its decision is pending."""
+
+    def start(self) -> None:  # never started; it only occupies the cmdstack
+        pass
+
+
+def _session_id(shell: HoneyPotShell) -> str | None:
+    events = getattr(shell.protocol, "events", None)
+    return getattr(events, "identity", {}).get("session")
+
+
+def _is_known(shell: HoneyPotShell, argv: list[str]) -> bool:
+    words = [w for w in argv if not ASSIGNMENT_WORD.match(w)]
+    if not words:
+        return True
+    if words[0] in shell.functions:
+        return True
+    paths = shell.environ.get("PATH", "").split(":")
+    return shell.protocol.getCommand(words[0], paths, shell.cwd) is not None
+
+
+def gate_then_run(shell: HoneyPotShell, cmdAndArgs: list[str]) -> Any:
+    gate = _get_gate()
+    if gate is None:
+        return shell._run_expanded(cmdAndArgs)
+
+    argv = list(cmdAndArgs)
+    request = {
+        "request_id": str(uuid.uuid4()),
+        "session_id": _session_id(shell),
+        "protocol": "ssh",
+        "argv": argv,
+        "cwd": shell.cwd,
+        "known": _is_known(shell, argv),
+        "interactive": bool(shell.interactive),
+        "user": shell.user.get("username") if isinstance(shell.user, dict) else None,
+    }
+
+    # The placeholder needs a pipe to construct; it never writes to it.
+    shell.protocol.pp = shell._make_pipe(None, [], None, None)
+    waiting = _AwaitingDecision(shell.protocol)
+    shell.protocol.cmdstack.append(waiting)
+    started = time.monotonic()
+
+    d = gate.decide(request)
+    d.addCallback(_apply, shell, waiting, cmdAndArgs, request, started)
+    return d
+
+
+def _release(shell: HoneyPotShell, waiting: _AwaitingDecision) -> bool:
+    """Take the placeholder off the cmdstack. False if the command no longer
+    should run: Ctrl-C cancelled it, or the session went away meanwhile."""
+    if waiting.exited:
+        return False
+    stack = shell.protocol.cmdstack
+    if waiting not in stack:
+        return False
+    stack.remove(waiting)
+    return True
+
+
+def _apply(
+    decision: dict[str, Any] | None,
+    shell: HoneyPotShell,
+    waiting: _AwaitingDecision,
+    cmdAndArgs: list[str],
+    request: dict[str, Any],
+    started: float,
+) -> Any:
+    latency_ms = round((time.monotonic() - started) * 1000, 1)
+    fallback = not isinstance(decision, dict) or decision.get("action") not in ACTIONS
+    action = "allow" if fallback else decision["action"]
+    shell.protocol.events.dispatch(
+        "cowrie.policy.decision",
+        "Policy %(action)s for %(input)s",
+        input=" ".join(request["argv"]),
+        action=action,
+        fallback=fallback,
+        known=request["known"],
+        decision_id=None if fallback else decision.get("decision_id"),
+        propensity=None if fallback else decision.get("propensity"),
+        latency_ms=latency_ms,
+        request_id=request["request_id"],
+    )
+
+    if action == "delay":
+        delay_ms = min(max(int(decision.get("delay_ms", 0)), 0), MAX_DELAY_MS)
+        # The placeholder stays on the stack through the delay, so Ctrl-C and
+        # type-ahead behave as they would while a slow command runs.
+        waiting.callLater(delay_ms / 1000.0, _run_if_released, shell, waiting, cmdAndArgs)
+        return None
+
+    if not _release(shell, waiting):
+        return None
+
+    if action == "allow":
+        return shell._run_expanded(cmdAndArgs)
+
+    if action == "terminate":
+        shell.protocol.end_process(0)
+        return None
+
+    output = str(decision.get("output", "")).encode("utf8")[:MAX_OUTPUT_BYTES]
+    _, ops = shell.parser.parse_redirections(list(cmdAndArgs))
+    pp = shell._make_pipe(None, [], None, ops)
+    for real_path, virtual_path in pp.redirect_real_files:
+        shell.protocol.terminal.redirFiles.add((real_path, virtual_path))
+    if pp.has_redirection_error:
+        shell.last_exit_code = 1
+    elif action == "fake_success":
+        pp.outReceived(output)
+        shell.last_exit_code = 0
+    else:  # fake_error
+        pp.errReceived(output)
+        shell.last_exit_code = int(decision.get("exit_code", 1))
+    shell._advance()
+    return None
+
+
+def _run_if_released(shell: HoneyPotShell, waiting: _AwaitingDecision, cmdAndArgs: list[str]) -> None:
+    if _release(shell, waiting):
+        shell._run_expanded(cmdAndArgs)
