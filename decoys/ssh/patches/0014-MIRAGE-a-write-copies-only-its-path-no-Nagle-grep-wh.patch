+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE: grep (with egrep and fgrep) and which, written against a real
+# ABOUTME: Debian 12 host's answers. Stock grep ignored -c, -v, -n, -l and file names.
+
+"""GNU grep 3.8 and debianutils' which, for the options they are most used with.
+See ``mirage_coreutils`` for how these were written and what declining means."""
+
+from __future__ import annotations
+
+import getopt
+import posixpath
+import re
+from typing import Any, ClassVar
+
+from cowrie.commands.mirage_coreutils import Declining, paths_of
+from cowrie.shell import fs
+from cowrie.shell.command import HoneyPotCommand
+
+commands: dict[str, Any] = {}
+
+
+class Command_which(HoneyPotCommand):
+    """The first place along PATH for each name; every place with -a."""
+
+    def call(self) -> None:
+        every = "-a" in self.args
+        for name in [a for a in self.args if a not in ("-a", "-s")]:
+            found = paths_of(self, name)
+            if not found:
+                self.exit_code = 1
+                continue
+            self.write("".join(f"{p}\n" for p in (found if every else found[:1])))
+
+
+commands["/usr/bin/which"] = Command_which
+commands["which"] = Command_which
+
+
+def basic_to_extended(pattern: str) -> str:
+    """A POSIX basic regular expression in Python's syntax. In a basic
+    expression a backslash makes ``( ) { } | + ?`` operators, and bare they are
+    themselves; Python has it the other way round."""
+    out, i = "", 0
+    while i < len(pattern):
+        c = pattern[i]
+        if c == "\\" and i + 1 < len(pattern):
+            nxt = pattern[i + 1]
+            out += nxt if nxt in "(){}|+?" else c + nxt
+            i += 2
+            continue
+        if c == "[":  # a bracket expression is copied whole
+            end = pattern.find("]", i + 2)
+            if end != -1:
+                out += pattern[i : end + 1]
+                i = end + 1
+                continue
+        out += "\\" + c if c in "(){}|+?" else c
+        i += 1
+    return out
+
+
+class Command_grep(Declining):
+    name, program = "grep", "/usr/bin/grep"
+    consumes_stdin = True
+    mode: ClassVar[str] = "G"
+    SHORT = "EFGHRchilnoqrsvwxe:m:"
+    NAMES: ClassVar[dict[str, str]] = {
+        "--extended-regexp": "E",
+        "--fixed-strings": "F",
+        "--basic-regexp": "G",
+        "--ignore-case": "i",
+        "--invert-match": "v",
+        "--count": "c",
+        "--line-number": "n",
+        "--files-with-matches": "l",
+        "--quiet": "q",
+        "--silent": "q",
+        "--recursive": "r",
+        "--no-messages": "s",
+        "--only-matching": "o",
+        "--word-regexp": "w",
+        "--line-regexp": "x",
+        "--with-filename": "H",
+        "--no-filename": "h",
+    }
+    LONG: ClassVar[list[str]] = [
+        *[n[2:] for n in NAMES],
+        "regexp=",
+        "max-count=",
+        "color",
+        "color=",
+        "colour",
+        "colour=",
+    ]
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        if not args:
+            return False  # grep's own usage error
+        try:
+            opts, rest = getopt.gnu_getopt(args, cls.SHORT, cls.LONG)
+        except getopt.GetoptError:
+            return True  # context lines, Perl expressions, pattern files, includes
+        return not rest and not any(o in ("-e", "--regexp") for o, _ in opts)
+
+    def start(self) -> None:
+        if not self.args:
+            self.errorWrite(
+                f"Usage: {self.name} [OPTION]... PATTERNS [FILE]...\n"
+                f"Try '{self.name} --help' for more information.\n"
+            )
+            self.exit(2)
+            return
+        if self.mirage_declines(self.args):
+            self.not_emulated()
+            self.exit()
+            return
+        opts, rest = getopt.gnu_getopt(self.args, self.SHORT, self.LONG)
+        self.flags = {self.NAMES.get(o, o.lstrip("-")) for o, _ in opts}
+        if "R" in self.flags:
+            self.flags.add("r")
+        patterns = [a for o, a in opts if o in ("-e", "--regexp")]
+        self.limit: int | None = None
+        for option, value in opts:
+            if option in ("-m", "--max-count"):
+                try:
+                    self.limit = int(value)
+                except ValueError:
+                    self.errorWrite(f"{self.name}: invalid max count\n")
+                    self.exit(2)
+                    return
+        if not patterns:
+            patterns, rest = [rest[0]], rest[1:]
+        kind = "E" if "E" in self.flags else "F" if "F" in self.flags else self.mode
+        parts = []
+        for pattern in "\n".join(patterns).split("\n"):
+            if kind == "F":
+                parts.append(re.escape(pattern))
+            elif kind == "E":
+                parts.append(pattern)
+            else:
+                parts.append(basic_to_extended(pattern))
+        source = "|".join(f"(?:{part})" for part in parts)
+        if "w" in self.flags:
+            source = rf"(?<!\w)(?:{source})(?!\w)"
+        if "x" in self.flags:
+            source = rf"^(?:{source})$"
+        try:
+            self.matcher = re.compile(source.encode(), re.I if "i" in self.flags else 0)
+        except re.error:
+            self.errorWrite(f"{self.name}: Unmatched [, [^, [:, [., or [=\n")
+            self.exit(2)
+            return
+        self.operands = rest
+        self.matched = self.failed = False
+        waits = not rest and "r" not in self.flags and self.input_data is None
+        if waits and not getattr(self.pp, "stdin_from_pipe", False):
+            return  # reads the terminal until end of file
+        self.finish()
+
+    def lineReceived(self, line: str) -> None:
+        self.input_data = (self.input_data or b"") + line.encode("utf8") + b"\n"
+
+    def handle_CTRL_D(self) -> None:
+        self.finish()
+
+    def eofReceived(self) -> None:
+        if not self.exited:
+            self.finish()
+
+    def _complain(self, message: str) -> None:
+        self.failed = True
+        if "s" not in self.flags:
+            self.errorWrite(message)
+
+    def _read(self, path: str) -> bytes:
+        try:
+            return bytes(self.fs.file_contents(path))
+        except Exception:
+            return b""
+
+    def _files(self) -> list[tuple[str, bytes]]:
+        """(name as printed, contents) for each input that can be read."""
+        if not self.operands and "r" not in self.flags:
+            return [("(standard input)", self.input_data or b"")]
+        out: list[tuple[str, bytes]] = []
+        for operand in self.operands or ["."]:
+            if operand == "-":
+                out.append(("(standard input)", self.input_data or b""))
+                continue
+            path = self.fs.resolve_path(operand, self.cwd)
+            if not self.fs.exists(path):
+                self._complain(f"{self.name}: {operand}: No such file or directory\n")
+            elif self.fs.isdir(path):
+                if "r" in self.flags:
+                    out.extend(self._walk(operand if self.operands else "", path))
+                else:
+                    self._complain(f"{self.name}: {operand}: Is a directory\n")
+            else:
+                out.append((operand, self._read(path)))
+        return out
+
+    def _walk(self, shown: str, path: str, depth: int = 0) -> list[tuple[str, bytes]]:
+        out: list[tuple[str, bytes]] = []
+        if depth > 12:
+            return out
+        try:
+            children = sorted(self.fs.get_path(path), key=lambda n: n[fs.A_NAME].encode())
+        except Exception:
+            return out
+        for node in children:
+            name = node[fs.A_NAME]
+            shown_child = f"{shown.rstrip('/')}/{name}" if shown else name
+            full = posixpath.join(path, name)
+            if node[fs.A_TYPE] == fs.T_DIR:
+                out.extend(self._walk(shown_child, full, depth + 1))
+            elif node[fs.A_TYPE] == fs.T_FILE and node[fs.A_SIZE] < 1_000_000:
+                out.append((shown_child, self._read(full)))
+            if len(out) > 5000:
+                break
+        return out
+
+    def finish(self) -> None:
+        files = self._files()
+        several = len(self.operands) > 1 or "r" in self.flags
+        named = "H" in self.flags or ("h" not in self.flags and several)
+        silent = bool(self.flags & {"c", "l", "q"})
+        out = bytearray()
+        for name, data in files:
+            prefix = f"{name}:".encode() if named else b""
+            if b"\0" in data[:4096] and not silent:
+                if self.matcher.search(data):
+                    self.matched = True
+                    out += f"{self.name}: {name}: binary file matches\n".encode()
+                continue
+            count = 0
+            lines = data.split(b"\n")
+            if lines and lines[-1] == b"":
+                lines.pop()
+            for number, line in enumerate(lines, 1):
+                hits = list(self.matcher.finditer(line))
+                if bool(hits) == ("v" in self.flags):
+                    continue
+                count += 1
+                if not silent:
+                    lead = prefix + (f"{number}:".encode() if "n" in self.flags else b"")
+                    if "o" in self.flags and "v" not in self.flags:
+                        out += b"".join(lead + h.group(0) + b"\n" for h in hits if h.group(0))
+                    else:
+                        out += lead + line + b"\n"
+                if self.limit is not None and count >= self.limit:
+                    break
+            if count:
+                self.matched = True
+            if "q" in self.flags:
+                continue
+            if "l" in self.flags:
+                if count:
+                    out += f"{name}\n".encode()
+            elif "c" in self.flags:
+                out += prefix + f"{count}\n".encode()
+        self.writeBytes(bytes(out))
+        if self.matched and "q" in self.flags:
+            self.exit(0)
+        elif self.failed:
+            self.exit(2)
+        else:
+            self.exit(0 if self.matched else 1)
+
+
+class Command_egrep(Command_grep):
+    name, program, mode = "egrep", "/usr/bin/egrep", "E"
+
+
+class Command_fgrep(Command_grep):
+    name, program, mode = "fgrep", "/usr/bin/fgrep", "F"
+
+
+for _name in ("/bin/grep", "/usr/bin/grep", "grep"):
+    commands[_name] = Command_grep
+for _name in ("/bin/egrep", "/usr/bin/egrep", "egrep"):
+    commands[_name] = Command_egrep
+for _name in ("/bin/fgrep", "/usr/bin/fgrep", "fgrep"):
+    commands[_name] = Command_fgrep
