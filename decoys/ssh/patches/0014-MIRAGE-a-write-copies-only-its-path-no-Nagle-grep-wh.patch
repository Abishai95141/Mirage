+class GrepTests(Base):
+    def setUp(self) -> None:
+        super().setUp()
+        self.out("printf 'alpha one\\nBeta two\\nalpha three\\ngamma\\n' > /tmp/g")
+        self.out("printf 'alpha in sub\\n' > /tmp/t/sub/h")
+
+    def test_matching_lines_and_the_exit_status(self) -> None:
+        self.assertEqual(self.out("grep alpha /tmp/g"), "alpha one\nalpha three\n")
+        self.assertEqual(self.out("grep alpha /tmp/g; echo $?").splitlines()[-1], "0")
+        self.assertEqual(self.out("grep nothing /tmp/g; echo $?"), "1\n")
+        self.assertEqual(
+            self.out("grep alpha /nonexistent-x; echo $?"),
+            "grep: /nonexistent-x: No such file or directory\n2\n",
+        )
+
+    def test_count_invert_number_and_case(self) -> None:
+        self.assertEqual(self.out("grep -c alpha /tmp/g"), "2\n")
+        self.assertEqual(self.out("grep -v alpha /tmp/g"), "Beta two\ngamma\n")
+        self.assertEqual(self.out("grep -n gamma /tmp/g"), "4:gamma\n")
+        self.assertEqual(self.out("grep -i beta /tmp/g"), "Beta two\n")
+        self.assertEqual(self.out("grep -ci ALPHA /tmp/g"), "2\n")
+        self.assertEqual(self.out("grep -m 1 alpha /tmp/g"), "alpha one\n")
+
+    def test_several_files_are_named_and_l_lists_them(self) -> None:
+        self.assertEqual(
+            self.out("grep alpha /tmp/g /tmp/t/sub/h"),
+            "/tmp/g:alpha one\n/tmp/g:alpha three\n/tmp/t/sub/h:alpha in sub\n",
+        )
+        self.assertEqual(self.out("grep -c alpha /tmp/g /tmp/t/sub/h"), "/tmp/g:2\n/tmp/t/sub/h:1\n")
+        self.assertEqual(self.out("grep -l alpha /tmp/g /tmp/t/c.txt"), "/tmp/g\n")
+        self.assertEqual(self.out("grep -h alpha /tmp/g /tmp/t/sub/h").splitlines()[0], "alpha one")
+
+    def test_recursion_names_every_file_under_the_directory(self) -> None:
+        self.assertEqual(self.out("grep -r alpha /tmp/t"), "/tmp/t/sub/h:alpha in sub\n")
+        self.assertEqual(self.out("grep alpha /tmp/t; echo $?"), "grep: /tmp/t: Is a directory\n2\n")
+
+    def test_standard_input_and_quiet(self) -> None:
+        self.assertEqual(self.out("cat /tmp/g | grep two"), "Beta two\n")
+        self.assertEqual(self.out("cat /tmp/g | grep -c a"), "4\n")
+        self.assertEqual(self.out("grep -q alpha /tmp/g && echo found"), "found\n")
+        self.assertEqual(self.out("grep -q nothing /tmp/g || echo absent"), "absent\n")
+
