+# ---------------------------------------------------------------------- sort
+
+
+class Command_sort(Declining):
+    name, program = "sort", "/usr/bin/sort"
+    consumes_stdin = True
+    SHORT = "rnufbk:t:o:"
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        try:
+            getopt.gnu_getopt(args, cls.SHORT, ["reverse", "numeric-sort", "unique"])
+        except getopt.GetoptError:
+            return True
+        return False
+
+    def start(self) -> None:
+        if self.mirage_declines(self.args):
+            self.not_emulated()
+            self.exit()
+            return
+        opts, self.operands = getopt.gnu_getopt(
+            self.args, self.SHORT, ["reverse", "numeric-sort", "unique"]
+        )
+        long_names = {"--reverse": "r", "--numeric-sort": "n", "--unique": "u"}
+        self.flags = {long_names.get(o, o.lstrip("-")) for o, _ in opts}
+        self.key = next((a for o, a in opts if o == "-k"), None)
+        self.separator = next((a for o, a in opts if o == "-t"), None)
+        self.output = next((a for o, a in opts if o == "-o"), None)
+        if not self.operands and self.input_data is None and not getattr(
+            self.pp, "stdin_from_pipe", False
+        ):
+            return
+        self.finish()
+
+    def lineReceived(self, line: str) -> None:
+        self.input_data = (self.input_data or b"") + line.encode("utf8") + b"\n"
+
+    def handle_CTRL_D(self) -> None:
+        self.finish()
+
+    def eofReceived(self) -> None:
+        if not self.exited:
+            self.finish()
+
+    def _field(self, line: bytes) -> bytes:
+        if self.key is None:
+            return line
+        spec = re.match(r"(\d+)(?:\.\d+)?[a-zA-Z]*(?:,(\d+))?", self.key)
+        if not spec:
+            return line
+        first, last = int(spec.group(1)), int(spec.group(2)) if spec.group(2) else None
+        if self.separator is not None:
+            fields = line.split(self.separator.encode())
+            joiner = self.separator.encode()
+        else:
+            fields = re.findall(rb"\s*\S+", line)
+            joiner = b""
+        return joiner.join(fields[first - 1 : last])
+
+    def _order(self, line: bytes) -> Any:
+        key = self._field(line)
+        if "b" in self.flags:
+            key = key.lstrip()
+        if "n" in self.flags:
+            number = re.match(rb"\s*(-?\d*\.?\d*)", key)
+            text = number.group(1) if number else b""
+            try:
+                return (float(text) if text not in (b"", b"-", b".") else 0.0, line)
+            except ValueError:
+                return (0.0, line)
+        if "f" in self.flags:
+            return (key.upper(), line)
+        return (key, line)
+
+    def finish(self) -> None:
+        data = b""
+        if not self.operands:
+            data = self.input_data or b""
+        for operand in self.operands:
+            if operand == "-":
+                data += self.input_data or b""
+                continue
+            path = self.fs.resolve_path(operand, self.cwd)
+            if not self.fs.exists(path):
+                self.errorWrite(f"sort: cannot read: {operand}: No such file or directory\n")
+                self.exit_code = 2
+                self.exit()
+                return
+            if self.fs.isdir(path):
+                self.errorWrite(f"sort: read failed: {operand}: Is a directory\n")
+                self.exit_code = 2
+                self.exit()
+                return
+            try:
+                piece = self.fs.file_contents(path)
+            except Exception:
+                piece = b""
+            data += piece if not piece or piece.endswith(b"\n") else piece + b"\n"
+        lines = data.split(b"\n")
+        if lines and lines[-1] == b"":
+            lines.pop()
+        lines.sort(key=self._order, reverse="r" in self.flags)
+        if "u" in self.flags:
+            seen: set[Any] = set()
+            unique = []
+            for line in lines:
+                key = self._order(line)[0]
+                if key not in seen:
+                    seen.add(key)
+                    unique.append(line)
+            lines = unique
+        out = b"".join(line + b"\n" for line in lines)
+        if self.output:
+            path = self.fs.resolve_path(self.output, self.cwd)
+            self.fs.mkfile(path, self.user["uid"], self.user.get("gid", 0), len(out), 0o100644)
+            node = self.fs.getfile(path)
+            if node is not None:
+                node[fs.A_CONTENTS] = out
+        else:
+            self.writeBytes(out)
+        self.exit()
+
+
+for _name in ("/usr/bin/sort", "/bin/sort", "sort"):
+    commands[_name] = Command_sort
+
