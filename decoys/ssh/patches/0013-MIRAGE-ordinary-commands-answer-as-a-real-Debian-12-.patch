diff --git a/src/cowrie/shell/mirage_glob.py b/src/cowrie/shell/mirage_glob.py
new file mode 100644
index 0000000..8b9a9a3
--- /dev/null
+++ b/src/cowrie/shell/mirage_glob.py
@@ -0,0 +1,109 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE: pathname expansion against the emulated filesystem, as bash
+# ABOUTME: does it before a command runs: *, ? and [...] in unquoted words.
+
+"""Upstream leaves ``*`` to each command, so ``echo /etc/host*`` printed the
+pattern and ``ls /etc/*.conf`` found nothing. Here the shell expands it.
+
+A word reaches this module with every *quoted* metacharacter preceded by
+``MARK``, so that ``"*"`` and ``\\*`` stay themselves. A pattern that matches
+nothing is left as typed, which is bash's default.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Any
+
+MARK = "\x00"
+_META = "*?["
+_ACTIVE = re.compile(rf"(?<!{MARK})[*?]|(?<!{MARK})\[[^\]/]+\]")
+
+
+def protect(text: str) -> str:
+    """Quoted text: its metacharacters are not patterns."""
+    return "".join(MARK + c if c in _META else c for c in text.replace(MARK, ""))
+
+
+def unprotect(text: str) -> str:
+    return text.replace(MARK, "")
+
+
+def has_pattern(word: str) -> bool:
+    return _ACTIVE.search(word) is not None
+
+
+def _component(component: str) -> re.Pattern[str]:
+    """One path component of a pattern, as a regular expression."""
+    out, i = "", 0
+    while i < len(component):
+        c = component[i]
+        if c == MARK and i + 1 < len(component):
+            out += re.escape(component[i + 1])
+            i += 2
+            continue
+        if c == "*":
+            out += "[^/]*"
+        elif c == "?":
+            out += "[^/]"
+        elif c == "[":
+            end = component.find("]", i + 2)
+            if end == -1:
+                out += re.escape(c)
+            else:
+                body = component[i + 1 : end].replace(MARK, "")
+                negate = body[:1] in "!^"
+                body = body[1:] if negate else body
+                out += "[" + ("^" if negate else "") + body.replace("\\", "\\\\") + "]"
+                i = end
+        else:
+            out += re.escape(c)
+        i += 1
+    return re.compile(out + r"\Z", re.S)
+
+
+def expand(filesystem: Any, cwd: str, word: str) -> list[str]:
+    """The paths ``word`` matches, sorted as bash sorts them in the C locale;
+    empty when it matches nothing."""
+    absolute = word.startswith("/")
+    parts = word.split("/")
+    dirs_only = len(parts) > 1 and parts[-1] == ""
+    components = [p for p in parts if p != ""]
+    found = ["/" if absolute else ""]
+    for index, component in enumerate(components):
+        last = index == len(components) - 1
+        step: list[str] = []
+        for base in found:
+            real = filesystem.resolve_path(base or ".", cwd)
+            if not has_pattern(component):
+                name = unprotect(component)
+                candidate = base + name
+                if filesystem.lexists(filesystem.resolve_path(candidate, cwd)) or name in (
+                    ".",
+                    "..",
+                ):
+                    step.append(candidate)
+                continue
+            try:
+                if not filesystem.isdir(real):
+                    continue
+                names = [node[0] for node in filesystem.get_path(real)]
+            except Exception:
+                continue
+            pattern = _component(component)
+            hidden = component.startswith(".")
+            for name in names:
+                if name.startswith(".") and not hidden:
+                    continue
+                if pattern.match(name):
+                    step.append(base + name)
+        if not last:
+            step = [
+                s + "/" for s in step if filesystem.isdir(filesystem.resolve_path(s, cwd))
+            ]
+        found = step
+        if not found:
+            return []
+    if dirs_only:
+        found = [f + "/" for f in found if filesystem.isdir(filesystem.resolve_path(f, cwd))]
+    return sorted(found, key=str.encode)
