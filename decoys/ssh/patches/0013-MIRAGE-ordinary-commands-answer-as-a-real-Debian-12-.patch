+            return
+        values = {k: v for k, v in self.environ.items() if k in self.exported}
+        values["PWD"] = self.cwd
+        names = [n for n in ENV_ORDER if n in values]
+        names += [n for n in values if n not in ENV_ORDER]
+        self.write("".join(f"{n}={values[n]}\n" for n in names) + "_=/usr/bin/env\n")
+
+
+commands["/usr/bin/env"] = Command_env
+commands["env"] = Command_env
