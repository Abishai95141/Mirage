+# ---------------------------------------------------------------------- wc
+
+
+class Command_wc(HoneyPotCommand):
+    consumes_stdin = True
+    ORDER = "lwmcL"
+
+    def start(self) -> None:
+        try:
+            opts, operands = getopt.gnu_getopt(
+                self.args, "clmwL", ["bytes", "chars", "lines", "words", "max-line-length"]
+            )
+        except getopt.GetoptError as err:
+            self.errorWrite(f"wc: invalid option -- '{err.opt}'\n")
+            self.errorWrite("Try 'wc --help' for more information.\n")
+            self.exit_code = 1
+            self.exit()
+            return
+        long_names = {
+            "--bytes": "c",
+            "--chars": "m",
+            "--lines": "l",
+            "--words": "w",
+            "--max-line-length": "L",
+        }
+        chosen = {long_names.get(o, o.lstrip("-")) for o, _ in opts} or set("lwc")
+        self.fields = [f for f in self.ORDER if f in chosen]
+        self.operands = operands
+        if not operands and self.input_data is None and not getattr(
+            self.pp, "stdin_from_pipe", False
+        ):
+            return  # reads the terminal until end of file
+        self.finish()
+
+    def lineReceived(self, line: str) -> None:
+        self.input_data = (self.input_data or b"") + line.encode("utf8") + b"\n"
+
+    def handle_CTRL_D(self) -> None:
+        self.finish()
+
+    def eofReceived(self) -> None:
+        if not self.exited:
+            self.finish()
+
+    @staticmethod
+    def count(data: bytes) -> dict[str, int]:
+        text = data.decode("utf8", errors="replace")
+        return {
+            "l": data.count(b"\n"),
+            "w": len(data.split()),
+            "m": len(text),
+            "c": len(data),
+            "L": max((len(line) for line in text.split("\n")), default=0),
+        }
+
+    def finish(self) -> None:
+        rows: list[tuple[dict[str, int], str | None]] = []
+        width, regular = 1, True
+        if not self.operands:
+            rows.append((self.count(self.input_data or b""), None))
+            regular = False
+        for operand in self.operands:
+            path = self.fs.resolve_path(operand, self.cwd)
+            if not self.fs.exists(path):
+                self.errorWrite(f"wc: {operand}: No such file or directory\n")
+                self.exit_code = 1
+                continue
+            if self.fs.isdir(path):
+                rows.append((dict.fromkeys(self.ORDER, 0), operand))
+                self.errorWrite(f"wc: {operand}: Is a directory\n")
+                self.exit_code = 1
+                regular = False
+                continue
+            try:
+                data = self.fs.file_contents(path)
+            except Exception:
+                data = b""
+            rows.append((self.count(data), operand))
+        if len(self.operands) > 1:
+            total = {f: sum(r[0][f] for r in rows) for f in self.ORDER}
+            rows.append((total, "total"))
+        # GNU wc: as wide as the largest byte count is long; seven where an
+        # input is not a regular file; nothing to align for one number alone.
+        if len(rows) == 1 and len(self.fields) == 1:
+            width = 1
+        elif not regular:
+            width = 7
+        else:
+            width = max(len(str(max(r[0]["c"] for r in rows))) if rows else 1, 1)
+        for counts, name in rows:
+            line = " ".join(str(counts[f]).rjust(width) for f in self.fields)
+            self.write(line + (f" {name}" if name else "") + "\n")
+        self.exit()
+
+
+for _name in ("/usr/bin/wc", "/bin/wc", "wc"):
+    commands[_name] = Command_wc
+
