+
+def _logged_in(command: HoneyPotCommand) -> bool:
+    """A login is recorded for a session with a terminal; an exec request has none."""
+    return hasattr(command.protocol.user, "windowSize")
+
+
+class Command_who(HoneyPotCommand):
+    def call(self) -> None:
+        if not _logged_in(self):
+            return
+        login = time.localtime(self.protocol.logintime)
+        self.write(
+            f"{self.user['username']:8s} pts/0        "
+            f"{time.strftime('%Y-%m-%d %H:%M', login)} ({self.protocol.clientIP})\n"
+        )
+
+
+class Command_w(HoneyPotCommand):
+    def call(self) -> None:
+        users = 1 if _logged_in(self) else 0
+        self.write(
+            f" {time.strftime('%H:%M:%S')} up {utils.uptime(self.protocol.uptime())},  "
+            f"{users} user,  load average: 0.00, 0.00, 0.00\n"
+        )
+        self.write("USER     TTY      FROM             LOGIN@   IDLE   JCPU   PCPU WHAT\n")
+        if users:
+            login = time.strftime("%H:%M", time.localtime(self.protocol.logintime))
+            self.write(
+                f"{self.user['username']:8s} pts/0    {self.protocol.clientIP[:16]:16s} "
+                f"{login}    0.00s  0.00s  0.00s w\n"
+            )
+
+
+commands["/usr/bin/who"] = Command_who
+commands["who"] = Command_who
+commands["/usr/bin/w"] = Command_w
+commands["w"] = Command_w
