+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: Tests the commands MIRAGE rewrote or added against a real Debian 12
+# ABOUTME: host's answers: ls, id, wc, who, sort, stat, type, command, env, globs.
+
+from __future__ import annotations
+
+import re
+from typing import Any
+
+from cowrie import mirage_render
+from cowrie.shell import fs, mirage_glob
+from cowrie.test.test_mirage_gate import PROMPT, GateTestBase
+
+
+class Base(GateTestBase):
+    def out(self, line: str) -> str:
+        """What a line prints, without the prompt that follows it."""
+        text = self.run_line(line).decode()
+        prompt = PROMPT.decode()
+        if text.endswith(prompt):
+            return text[: -len(prompt)]
+        # The prompt names the working directory, which a test may have changed.
+        return re.sub(r"root@unitTest:[^#]*# \Z", "", text)
+
+    def no_terminal(self) -> None:
+        """Make the session look like an exec request: no pty was asked for."""
+        if hasattr(self.proto.user, "windowSize"):
+            del self.proto.user.windowSize
+
+    def setUp(self) -> None:
+        super().setUp()
+        self.proto.user.windowSize = [24, 80]
+        self.out("mkdir /tmp/t /tmp/t/sub /tmp/e")
+        self.out("touch /tmp/t/a.conf /tmp/t/b.conf /tmp/t/.hidden")
+        self.out("echo hello > /tmp/t/c.txt")
+
+
+class LsTests(Base):
+    def test_without_a_terminal_names_come_one_to_a_line(self) -> None:
+        self.no_terminal()
+        self.assertEqual(self.out("ls /tmp/t"), "a.conf\nb.conf\nc.txt\nsub\n")
+
+    def test_on_a_terminal_names_are_in_columns(self) -> None:
+        # GNU ls pads with a tab wherever the gap passes a tab stop.
+        self.assertEqual(self.out("ls /tmp/t"), "a.conf\tb.conf\tc.txt  sub\n")
+
+    def test_through_a_pipe_names_come_one_to_a_line(self) -> None:
+        self.assertEqual(self.out("ls /tmp/t | cat"), "a.conf\nb.conf\nc.txt\nsub\n")
+
+    def test_columns_fill_downwards_and_pad_with_tabs(self) -> None:
+        self.out("mkdir /tmp/w")
+        names = [f"name-{i:02d}-{'x' * (i % 5)}" for i in range(30)]
+        self.out("touch " + " ".join(f"/tmp/w/{n}" for n in names))
+        lines = self.out("ls /tmp/w").splitlines()
+        self.assertGreater(len(lines), 1)
+        self.assertTrue(all(len(line.expandtabs(8)) <= 80 for line in lines))
+        first_column = [line.split()[0] for line in lines]
+        self.assertEqual(first_column, sorted(names)[: len(lines)])
+        self.assertIn("\t", "".join(lines))
+
+    def test_hidden_files_need_a_and_a_adds_the_two_dots(self) -> None:
+        self.no_terminal()
+        self.assertEqual(self.out("ls -A /tmp/t").splitlines()[0], ".hidden")
+        self.assertEqual(self.out("ls -a /tmp/t").splitlines()[:3], [".", "..", ".hidden"])
+
+    def test_several_operands_files_first_then_each_directory_under_its_name(self) -> None:
+        self.no_terminal()
+        self.assertEqual(
+            self.out("ls /tmp/t /tmp/e /tmp/t/c.txt"),
+            "/tmp/t/c.txt\n\n/tmp/e:\n\n/tmp/t:\na.conf\nb.conf\nc.txt\nsub\n",
+        )
+
+    def test_a_missing_operand_is_an_error_and_status_2(self) -> None:
+        self.no_terminal()
+        text = self.out("ls /tmp/e /nonexistent-x; echo status=$?")
+        self.assertIn("ls: cannot access '/nonexistent-x': No such file or directory\n", text)
+        self.assertIn("/tmp/e:\n", text)
+        self.assertTrue(text.endswith("status=2\n"))
+
+    def test_the_long_format_has_a_total_and_gnu_s_columns(self) -> None:
+        lines = self.out("ls -la /tmp/t").splitlines()
+        self.assertEqual(lines[0], "total 16")  # ., .., sub and the one file with bytes
