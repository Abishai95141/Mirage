+# ---------------------------------------------------------------------- stat
+
+KIND_WORDS = {
+    fs.T_LINK: "symbolic link",
+    fs.T_DIR: "directory",
+    fs.T_BLK: "block special file",
+    fs.T_CHR: "character special file",
+    fs.T_SOCK: "socket",
+    fs.T_FIFO: "fifo",
+}
+KIND_BITS = {
+    fs.T_LINK: statmod.S_IFLNK,
+    fs.T_DIR: statmod.S_IFDIR,
+    fs.T_FILE: statmod.S_IFREG,
+    fs.T_BLK: statmod.S_IFBLK,
+    fs.T_CHR: statmod.S_IFCHR,
+    fs.T_SOCK: statmod.S_IFSOCK,
+    fs.T_FIFO: statmod.S_IFIFO,
+}
+
+
+class Command_stat(Declining):
+    name, program = "stat", "/usr/bin/stat"
+    SHORT = "Lc:t"
+    LONG: ClassVar[list[str]] = ["dereference", "format=", "printf=", "terse"]
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        try:
+            opts, _ = getopt.gnu_getopt(args, cls.SHORT, cls.LONG)
+        except getopt.GetoptError:
+            return True  # -f (a file system's own numbers) among them
+        for option, value in opts:
+            if option in ("-c", "--format", "--printf"):
+                if set(re.findall(r"%[-+ 0#]*\d*(.)", value)) - set(cls.DIRECTIVES):
+                    return True
+        return False
+
+    DIRECTIVES = "aAbBdDfFgGhHiLnNosStTuUwWxXyYzZ%"
+
+    def call(self) -> None:
+        if self.mirage_declines(self.args):
+            self.not_emulated()
+            return
+        opts, operands = getopt.gnu_getopt(self.args, self.SHORT, self.LONG)
+        follow = any(o in ("-L", "--dereference") for o, _ in opts)
+        template, newline = None, True
+        terse = any(o in ("-t", "--terse") for o, _ in opts)
+        for option, value in opts:
+            if option in ("-c", "--format"):
+                template = value
+            elif option == "--printf":
+                template, newline = value.encode().decode("unicode_escape"), False
+        if not operands:
+            self.errorWrite("stat: missing operand\nTry 'stat --help' for more information.\n")
+            self.exit_code = 1
+            return
+        self.users = Users()
+        for operand in operands:
+            path = self.fs.resolve_path(operand, self.cwd)
+            node = None
+            try:
+                if path == "/":
+                    node = ["/", fs.T_DIR, 0, 0, 4096, 0o755, self.fs.fs[fs.A_CTIME], [], None, None]
+                else:
+                    node = self.fs.getfile(path, follow_symlinks=follow)
+            except Exception:
+                node = None
+            if node is None:
+                self.errorWrite(f"stat: cannot statx '{operand}': No such file or directory\n")
+                self.exit_code = 1
+                continue
+            values = self._values(operand, path, node)
+            if template is not None:
+                self.write(self._format(template, values) + ("\n" if newline else ""))
+            elif terse:
+                self.write(self._format("%n %s %b %f %u %g %D %i %h %t %T %X %Y %Z %W %o", values) + "\n")
+            else:
+                self.write(self._default(values, node))
+
+    def _values(self, operand: str, path: str, node: list[Any]) -> dict[str, str]:
+        kind = node[fs.A_TYPE]
+        perms = node[fs.A_MODE] & 0o7777
+        size = len(node[fs.A_TARGET] or "") if kind == fs.T_LINK else int(node[fs.A_SIZE])
+        blocks = 0
+        if kind == fs.T_DIR:
+            blocks = 8 if size >= 4096 else 0
+        elif kind == fs.T_FILE and size:
+            blocks = 8 * math.ceil(size / 4096)
+        links = 1
+        if kind == fs.T_DIR:
+            links = 2 + sum(1 for c in node[fs.A_CONTENTS] if c[fs.A_TYPE] == fs.T_DIR)
+        stamp = float(node[fs.A_CTIME])
+        whole = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(stamp))
+        nanos = int((stamp % 1) * 1_000_000_000) or zlib.crc32(path.encode()) % 1_000_000_000
+        zone = time.strftime("%z", time.localtime(stamp))
+        shown = f"{whole}.{nanos:09d} {zone}"
+        major, minor = device_numbers(node[fs.A_NAME]) if kind in (fs.T_CHR, fs.T_BLK) else (0, 0)
+        quoted = f"'{operand}'"
+        if kind == fs.T_LINK:
+            quoted += f" -> '{node[fs.A_TARGET]}'"
+        word = KIND_WORDS.get(kind, "regular empty file" if size == 0 else "regular file")
+        return {
+            "a": f"{perms:o}",
+            "A": TYPE_CHAR[kind] + statmod.filemode(statmod.S_IFREG | perms)[1:],
+            "b": str(blocks),
+            "B": "512",
+            "d": "2049",
+            "D": "801",
+            "f": f"{KIND_BITS[kind] | perms:x}",
+            "F": word,
+            "g": str(node[fs.A_GID]),
+            "G": self.users.group_name(node[fs.A_GID]),
+            "h": str(links),
+            "H": "8",
+            "i": str(inode_of(path)),
+            "L": "1",
+            "n": operand,
+            "N": quoted,
+            "o": "4096",
+            "s": str(size),
+            "S": "4096",
+            "t": f"{major:x}",
+            "T": f"{minor:x}",
+            "u": str(node[fs.A_UID]),
+            "U": self.users.name(node[fs.A_UID]),
+            "w": shown,
+            "W": str(int(stamp)),
+            "x": shown,
+            "X": str(int(stamp)),
+            "y": shown,
+            "Y": str(int(stamp)),
+            "z": shown,
+            "Z": str(int(stamp)),
+            "%": "%",
+            "_target": str(node[fs.A_TARGET] or ""),
+            "_device": f"{major},{minor}",
+        }
+
+    @staticmethod
+    def _format(template: str, values: dict[str, str]) -> str:
+        def put(match: re.Match[str]) -> str:
+            flags, width, letter = match.group(1), match.group(2), match.group(3)
+            text = values.get(letter, match.group(0))
+            if width:
+                text = text.ljust(int(width)) if "-" in flags else text.rjust(int(width))
+            return text
+
+        return re.sub(r"%([-+ 0#]*)(\d*)(.)", put, template)
+
+    def _default(self, v: dict[str, str], node: list[Any]) -> str:
+        kind = node[fs.A_TYPE]
+        name = v["n"] + (f" -> {v['_target']}" if kind == fs.T_LINK else "")
+        device = f"     Device type: {v['_device']}" if kind in (fs.T_CHR, fs.T_BLK) else ""
+        return (
+            f"  File: {name}\n"
+            f"  Size: {v['s']:<10}\tBlocks: {v['b']:<10} IO Block: {v['o']:<6} {v['F']}\n"
+            f"Device: 8,1\tInode: {v['i']:<11} Links: {v['h']}{device}\n"
+            f"Access: ({int(v['a'], 8):04o}/{v['A']})  Uid: ({v['u']:>5}/{v['U']:>8})   "
+            f"Gid: ({v['g']:>5}/{v['G']:>8})\n"
+            f"Access: {v['x']}\nModify: {v['y']}\nChange: {v['z']}\n Birth: {v['w']}\n"
+        )
+
+
+for _name in ("/usr/bin/stat", "/bin/stat", "stat"):
+    commands[_name] = Command_stat
+
+
+# ---------------------------------------------------------------------- type, command
+
+BUILTINS = frozenset(
+    ". : [ alias bg bind break builtin caller cd command compgen complete compopt continue "
+    "declare dirs disown echo enable eval exec exit export false fc fg getopts hash help "
+    "history jobs kill let local logout mapfile popd printf pushd pwd read readarray "
+    "readonly return set shift shopt source suspend test times trap true type typeset "
+    "ulimit umask unalias unset wait".split()
+)
+KEYWORDS = frozenset(
+    "if then else elif fi case esac for select while until do done in function time { } ! "
+    "[[ ]] coproc".split()
+)
+
+
+def paths_of(command: HoneyPotCommand, word: str) -> list[str]:
+    """Every place ``word`` is found as a file: itself if it names a path,
+    otherwise each directory of PATH that has it, in PATH's order."""
+    if "/" in word:
+        return [word] if command.fs.isfile(command.fs.resolve_path(word, command.cwd)) else []
+    found = []
+    for directory in command.environ.get("PATH", "").split(":"):
+        if not directory:
+            continue
+        path = f"{command.fs.resolve_path(directory, command.cwd)}/{word}"
+        if command.fs.isfile(path):
+            found.append(f"{directory.rstrip('/')}/{word}")
+    return found
+
+
+def classify(command: HoneyPotCommand, word: str) -> tuple[str, list[str]]:
+    """What bash would run for ``word``: its kind and, for a file, every path it
+    is found at along PATH."""
+    if word in KEYWORDS:
+        return "keyword", []
+    if word in command.shell.functions:
+        return "function", []
+    if word in BUILTINS:
+        return "builtin", []
+    found = paths_of(command, word)
+    return ("file" if found else "none"), found
+
+
+def describe(kind: str, word: str, paths: list[str]) -> str:
+    if kind == "keyword":
+        return f"{word} is a shell keyword"
+    if kind == "builtin":
+        return f"{word} is a shell builtin"
+    if kind == "function":
+        return f"{word} is a function"
+    return f"{word} is {paths[0]}"
+
+
+class Command_type(HoneyPotCommand):
+    def call(self) -> None:
+        try:
+            opts, words = getopt.getopt(self.args, "atpPf")
+        except getopt.GetoptError as err:
+            prefix = self.shell.error_prefix()
+            self.errorWrite(f"{prefix}type: -{err.opt}: invalid option\n")
+            self.errorWrite("type: usage: type [-afptP] name [name ...]\n")
+            self.exit_code = 2
+            return
+        flags = {o.lstrip("-") for o, _ in opts}
+        for word in words:
+            kind, paths = classify(self, word)
+            if "P" in flags:  # a file along PATH, whatever else the name is
+                paths = paths_of(self, word)
+                kind = "file" if paths else "none"
+            if kind == "none":
+                if not flags & {"t", "p", "P"}:
+                    self.errorWrite(f"{self.shell.error_prefix()}type: {word}: not found\n")
+                self.exit_code = 1
+                continue
+            if "t" in flags:
+                self.write(f"{kind}\n")
+            elif flags & {"p", "P"}:
+                if kind == "file":
+                    self.write(f"{paths[0]}\n")
+            elif "a" in flags and kind == "file":
+                self.write("".join(f"{word} is {p}\n" for p in paths))
+            else:
+                self.write(describe(kind, word, paths) + "\n")
+
+
+class Command_command(Declining):
+    name = "command"
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        # `command NAME ...` runs NAME; only -v and -V are answered here.
+        return not args or args[0] not in ("-v", "-V")
+
+    def call(self) -> None:
+        if self.mirage_declines(self.args):
+            self.not_emulated()
+            return
+        verbose = self.args[0] == "-V"
+        for word in self.args[1:]:
+            kind, paths = classify(self, word)
+            if kind == "none":
+                if verbose:
+                    self.errorWrite(f"{self.shell.error_prefix()}command: {word}: not found\n")
+                self.exit_code = 1
+            elif verbose:
+                self.write(describe(kind, word, paths) + "\n")
+            else:
+                self.write((paths[0] if kind == "file" else word) + "\n")
+
+
+commands["type"] = Command_type
+commands["command"] = Command_command
+
