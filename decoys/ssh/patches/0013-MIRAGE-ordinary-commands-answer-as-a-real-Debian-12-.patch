+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE: commands rewritten or added after the fingerprint suite held the
+# ABOUTME: emulator against a real Debian 12 host: ls, id, wc, who, w, sort, stat, type, command.
+
+"""Each command here prints what GNU coreutils 9.1, procps 4 and bash 5.2 print on
+Debian 12, for the options it takes. It was written against a record of a real
+host's answers (the fingerprint suite's reference host), not from memory.
+
+A command that is given an option it does not implement *declines*: the gate
+then reports that the emulator has no answer (tier ``none``), so that another
+rung can answer, instead of printing something a real host would not.
+"""
+
+from __future__ import annotations
+
+import getopt
+import math
+import posixpath
+import re
+import stat as statmod
+import time
+import zlib
+from typing import Any, ClassVar
+
+from cowrie.core import utils
+from cowrie.shell import fs
+from cowrie.shell.command import HoneyPotCommand
+from cowrie.shell.pipe import FD_TERMINAL
+from cowrie.shell.pwd import Group, Passwd
+
+commands: dict[str, Any] = {}
+
+TYPE_CHAR = {
+    fs.T_LINK: "l",
+    fs.T_DIR: "d",
+    fs.T_FILE: "-",
+    fs.T_BLK: "b",
+    fs.T_CHR: "c",
+    fs.T_SOCK: "s",
+    fs.T_FIFO: "p",
+}
+# Device numbers the kernel fixes (Documentation/admin-guide/devices.txt). The
+# filesystem tree does not record them.
+DEVICE_NUMBERS: dict[str, tuple[int, int]] = {
+    "mem": (1, 1),
+    "null": (1, 3),
+    "port": (1, 4),
+    "zero": (1, 5),
+    "full": (1, 7),
+    "random": (1, 8),
+    "urandom": (1, 9),
+    "kmsg": (1, 11),
+    "tty": (5, 0),
+    "console": (5, 1),
+    "ptmx": (5, 2),
+    "ttyS0": (4, 64),
+    "ttyS1": (4, 65),
+    "ttyS2": (4, 66),
+    "ttyS3": (4, 67),
+    "rtc0": (251, 0),
+    "hpet": (10, 228),
+    "fuse": (10, 229),
+    "loop-control": (10, 237),
+    "vga_arbiter": (10, 127),
+    "cpu_dma_latency": (10, 126),
+    "snapshot": (10, 231),
+    "autofs": (10, 235),
+    "btrfs-control": (10, 234),
+    "hwrng": (10, 183),
+}
+_DISK = re.compile(r"^(sd|vd|xvd)([a-z])(\d*)$")
+_NUMBERED = re.compile(r"^(tty|loop|sr|sg|vcs|vcsa|vcsu)(\d+)$")
+_MAJOR = {"sd": 8, "vd": 254, "xvd": 202, "tty": 4, "loop": 7, "sr": 11, "sg": 21, "vcs": 7}
+
+
+def device_numbers(name: str) -> tuple[int, int]:
+    if name in DEVICE_NUMBERS:
+        return DEVICE_NUMBERS[name]
+    disk = _DISK.match(name)
+    if disk:
+        letter = ord(disk.group(2)) - ord("a")
+        return _MAJOR[disk.group(1)], letter * 16 + int(disk.group(3) or 0)
+    numbered = _NUMBERED.match(name)
+    if numbered:
+        kind, n = numbered.group(1), int(numbered.group(2))
+        if kind == "vcsa":
+            return 7, 128 + n
+        if kind == "vcsu":
+            return 7, 64 + n
+        return _MAJOR[kind], n
+    return 0, 0
+
+
+def on_terminal(command: HoneyPotCommand) -> bool:
+    """Whether the command's standard output is the session's terminal: a pty,
+    and neither a pipe nor a file. An exec request without a pty has none."""
+    targets = getattr(command.pp, "targets", None)
+    target = targets.get(1) if isinstance(targets, dict) else None
+    if target is not None and target[0] != FD_TERMINAL:
+        return False
+    return hasattr(command.protocol.user, "windowSize")
+
+
+def terminal_width(command: HoneyPotCommand) -> int:
+    try:
+        return int(command.protocol.user.windowSize[1]) or 80
+    except (AttributeError, IndexError, TypeError, ValueError):
+        return 80
+
+
+class Users:
+    """The deployment's /etc/passwd and /etc/group, read once for a command."""
+
+    def __init__(self) -> None:
+        self.passwd = Passwd().passwd
+        self.group = Group().group
+
+    def name(self, uid: int) -> str:
+        return next((e["pw_name"] for e in self.passwd if e["pw_uid"] == uid), str(uid))
+
+    def group_name(self, gid: int) -> str:
+        return next((e["gr_name"] for e in self.group if e["gr_gid"] == gid), str(gid))
+
+    def entry(self, name: str) -> dict[str, Any] | None:
+        return next((e for e in self.passwd if e["pw_name"] == name), None)
+
+    def groups_of(self, name: str, gid: int) -> list[int]:
+        """The user's group IDs: the primary one, then each group listing the user."""
+        out = [gid]
+        for e in self.group:
+            members = [m for m in str(e["gr_mem"]).split(",") if m]
+            if name in members and e["gr_gid"] not in out:
+                out.append(int(e["gr_gid"]))
+        return out
+
+
+def human(size: int) -> str:
+    """A size as ``ls -h`` and ``du -h`` write it: powers of 1024, rounded up,
+    one decimal below ten."""
+    if size < 1024:
+        return str(size)
+    value = float(size)
+    for unit in "KMGTPE":
+        value /= 1024
+        if value < 1024 or unit == "E":
+            if value < 10:
+                return f"{math.ceil(value * 10) / 10:.1f}{unit}"
+            return f"{math.ceil(value)}{unit}"
+    return str(size)
+
+
+def inode_of(path: str) -> int:
+    """A stable inode number for a path: the tree keeps none."""
+    return 131073 + zlib.crc32(path.encode()) % 1_900_000
+
+
+class Declining(HoneyPotCommand):
+    """A command that implements some of its program's options. With any other
+    it declines: the gate reports tier ``none``, and if it is run all the same
+    it answers as the emulator answers any program it does not have."""
+
+    name: ClassVar[str] = ""
+    program: ClassVar[str] = ""
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        return False
+
+    def not_emulated(self) -> None:
+        prefix = self.shell.error_prefix()
+        if self.program:
+            self.errorWrite(
+                f"{prefix}{self.program}: cannot execute binary file: Exec format error\n"
+            )
+            self.exit_code = 126
+        else:
+            self.errorWrite(f"{prefix}{self.name}: not supported\n")
+            self.exit_code = 2
+
+
+# ---------------------------------------------------------------------- ls
+
+
+class Command_ls(Declining):
+    name, program = "ls", "/usr/bin/ls"
+    SHORT = "1aAdlhtrSRinFpsgoCxUL"
+    LONG: ClassVar[list[str]] = [
+        "all",
+        "almost-all",
+        "directory",
+        "human-readable",
+        "reverse",
+        "recursive",
+        "inode",
+        "numeric-uid-gid",
+        "classify",
+        "size",
+        "dereference",
+        "color",
+        "color=",
+        "help",
+    ]
+
+    @classmethod
+    def _parse(cls, args: list[str]) -> tuple[list[tuple[str, str]], list[str]]:
+        return getopt.gnu_getopt(args, cls.SHORT, cls.LONG)
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        # An option GNU ls has and this does not: decline, not "invalid option".
+        try:
+            opts, _ = cls._parse(args)
+        except getopt.GetoptError as err:
+            return len(err.opt) != 1 or err.opt in "bBcDfGHIkmNqQTuvwXZ"
+        return any(o == "--help" for o, _ in opts)
+
+    def call(self) -> None:
+        try:
+            opts, operands = self._parse(self.args)
+        except getopt.GetoptError as err:
+            if self.mirage_declines(self.args):
+                self.not_emulated()
+                return
+            if len(err.opt) == 1:
+                self.errorWrite(f"ls: invalid option -- '{err.opt}'\n")
+            else:
+                self.errorWrite(f"ls: unrecognized option '--{err.opt}'\n")
+            self.errorWrite("Try 'ls --help' for more information.\n")
+            self.exit_code = 2
+            return
+        if self.mirage_declines(self.args):
+            self.not_emulated()
+            return
+        flags = {o.lstrip("-")[:1] if not o.startswith("--") else o for o, _ in opts}
+        long_names = {
+            "--all": "a",
+            "--almost-all": "A",
+            "--directory": "d",
+            "--human-readable": "h",
+            "--reverse": "r",
+            "--recursive": "R",
+            "--inode": "i",
+            "--numeric-uid-gid": "n",
+            "--classify": "F",
+            "--size": "s",
+            "--dereference": "L",
+        }
+        self.flags = {long_names.get(f, f) for f in flags}
+        self.long = bool(self.flags & {"l", "n", "g", "o"})
+        self.users = Users()
+        self.now = time.time()
+        self.one_per_line = "1" in self.flags or not on_terminal(self)
+        self.first_block = True
+
+        files: list[tuple[str, list[Any], str]] = []
+        dirs: list[tuple[str, str]] = []
+        for operand in operands or ["."]:
+            path = self.fs.resolve_path(operand, self.cwd)
+            node = self._node(path, follow=False)
+            if node is None:
+                self.errorWrite(f"ls: cannot access '{operand}': No such file or directory\n")
+                self.exit_code = 2
+                continue
+            keep_link = self.long or bool(self.flags & {"d", "F"})
+            if node[fs.A_TYPE] == fs.T_LINK and not keep_link or "L" in self.flags:
+                followed = self._node(path, follow=True)
+                if followed is not None:
+                    node = followed
+            if node[fs.A_TYPE] == fs.T_DIR and "d" not in self.flags:
+                dirs.append((operand, path))
+            else:
+                files.append((operand, node, path))
+
+        if files:
+            self._show(self._sorted(files), total=False)
+            self.first_block = False
+        headers = len(operands) > 1 or "R" in self.flags
+        for operand, path in sorted(dirs, key=lambda d: d[0].encode()):
+            self._list_dir(operand, path, headers)
+
+    def _node(self, path: str, follow: bool) -> list[Any] | None:
+        if path == "/":
+            return ["/", fs.T_DIR, 0, 0, 4096, 0o40755, self.fs.fs[fs.A_CTIME], [], None, None]
+        try:
+            return self.fs.getfile(path, follow_symlinks=follow)
+        except Exception:
+            return None
+
+    def _list_dir(self, shown: str, path: str, header: bool) -> None:
+        try:
+            children = list(self.fs.get_path(path))
+        except Exception:
+            self.errorWrite(f"ls: cannot open directory '{shown}': Permission denied\n")
+            self.exit_code = 2
+            return
+        entries = [
+            (c[fs.A_NAME], c, posixpath.join(path, c[fs.A_NAME]))
+            for c in children
+            if "a" in self.flags or "A" in self.flags or not c[fs.A_NAME].startswith(".")
+        ]
+        if "a" in self.flags:
+            here = self._node(path, follow=True)
+            parent = self._node(posixpath.dirname(path.rstrip("/")) or "/", follow=True)
+            if here is not None:
+                entries.append((".", here, path))
+                entries.append(("..", parent or here, posixpath.dirname(path) or "/"))
+        if not self.first_block:
+            self.write("\n")
+        self.first_block = False
+        if header:
+            self.write(f"{shown}:\n")
+        entries = self._sorted(entries)
+        self._show(entries, total=self.long or "s" in self.flags)
+        if "R" in self.flags:
+            for name, node, full in entries:
+                if node[fs.A_TYPE] == fs.T_DIR and name not in (".", ".."):
+                    self._list_dir(posixpath.join(shown, name), full, True)
+
+    def _sorted(self, entries: list[tuple[str, list[Any], str]]) -> list[Any]:
+        if "U" in self.flags:
+            return entries
+        if "t" in self.flags:
+            entries = sorted(entries, key=lambda e: (-e[1][fs.A_CTIME], e[0].encode()))
+        elif "S" in self.flags:
+            entries = sorted(entries, key=lambda e: (-self._size(e[1]), e[0].encode()))
+        else:
+            entries = sorted(entries, key=lambda e: e[0].encode())
+        return entries[::-1] if "r" in self.flags else entries
+
+    @staticmethod
+    def _size(node: list[Any]) -> int:
+        if node[fs.A_TYPE] == fs.T_LINK:
+            return len(node[fs.A_TARGET] or "")
+        return int(node[fs.A_SIZE])
+
+    def _blocks(self, node: list[Any]) -> int:
+        """Kilobytes on disk, as ``ls -s`` and the total count them."""
+        kind = node[fs.A_TYPE]
+        if kind == fs.T_DIR:
+            return 4 if node[fs.A_SIZE] >= 4096 else 0
+        if kind != fs.T_FILE or node[fs.A_SIZE] == 0:
+            return 0
+        return 4 * math.ceil(node[fs.A_SIZE] / 4096)
+
+    def _mark(self, node: list[Any]) -> str:
+        kind = node[fs.A_TYPE]
+        if not self.flags & {"F", "p"}:
+            return ""
+        if kind == fs.T_DIR:
+            return "/"
+        if "p" in self.flags and "F" not in self.flags:
+            return ""
+        if kind == fs.T_LINK:
+            return "" if self.long else "@"
+        if kind == fs.T_FIFO:
+            return "|"
+        if kind == fs.T_SOCK:
+            return "="
+        if kind == fs.T_FILE and node[fs.A_MODE] & 0o111:
+            return "*"
+        return ""
+
+    def _show(self, entries: list[tuple[str, list[Any], str]], total: bool) -> None:
+        if total:
+            blocks = sum(self._blocks(n) for _, n, _ in entries)
+            shown = human(blocks * 1024) if "h" in self.flags else str(blocks)
+            self.write(f"total {shown}\n")
+        if not entries:
+            return
+        if self.long:
+            self._show_long(entries)
+            return
+        cells = []
+        for name, node, full in entries:
+            lead = ""
+            if "i" in self.flags:
+                lead += f"{inode_of(full)} "
+            if "s" in self.flags:
+                lead += f"{self._blocks(node)} "
+            cells.append((lead, name + self._mark(node)))
+        if "i" in self.flags or "s" in self.flags:
+            width = max(len(lead) for lead, _ in cells)
+            texts = [lead.rjust(width) + text for lead, text in cells]
+        else:
+            texts = [text for _, text in cells]
+        if self.one_per_line:
+            self.write("".join(t + "\n" for t in texts))
+        else:
+            self._columns(texts)
+
+    def _columns(self, names: list[str]) -> None:
+        """Columns filled downwards, as GNU ls lays them out on a terminal,
+        padded with tabs where a tab stop is passed."""
+        width, count = terminal_width(self), len(names)
+        best_cols, best_widths = 1, [max(len(n) for n in names)]
+        for cols in range(min(count, max(1, width // 3)), 0, -1):
+            rows = math.ceil(count / cols)
+            widths = [0] * cols
+            for i, name in enumerate(names):
+                col = i // rows
+                widths[col] = max(widths[col], len(name) + (0 if col == cols - 1 else 2))
+            if sum(widths) < width and math.ceil(count / rows) == cols:
+                best_cols, best_widths = cols, widths
+                break
+        rows = math.ceil(count / best_cols)
+        out = []
+        for row in range(rows):
+            position, line = 0, ""
+            for col in range(best_cols):
+                i = col * rows + row
+                if i >= count:
+                    break
+                line += names[i]
+                end = position + best_widths[col]
+                if i + rows < count:
+                    line += self._indent(position + len(names[i]), end)
+                position = end
+            out.append(line + "\n")
+        self.write("".join(out))
+
+    @staticmethod
+    def _indent(start: int, end: int) -> str:
+        out = ""
+        while start < end:
+            if end // 8 > (start + 1) // 8:
+                out += "\t"
+                start += 8 - start % 8
+            else:
+                out += " "
+                start += 1
+        return out
+
+    def _when(self, stamp: float) -> str:
+        t = time.localtime(stamp)
+        month, day = time.strftime("%b", t), f"{t.tm_mday:2d}"
+        recent = self.now - 15778476 < stamp <= self.now  # GNU ls: half a year
+        tail = time.strftime("%H:%M", t) if recent else f" {t.tm_year}"
+        return f"{month} {day} {tail}"
+
+    def _show_long(self, entries: list[tuple[str, list[Any], str]]) -> None:
+        rows = []
+        for name, node, _full in entries:
+            kind = node[fs.A_TYPE]
+            perms = statmod.filemode(statmod.S_IFREG | (node[fs.A_MODE] & 0o7777))[1:]
+            links = 1
+            if kind == fs.T_DIR:
+                links = 2 + sum(1 for c in node[fs.A_CONTENTS] if c[fs.A_TYPE] == fs.T_DIR)
+            numeric = "n" in self.flags
+            owner = str(node[fs.A_UID]) if numeric else self.users.name(node[fs.A_UID])
+            group = str(node[fs.A_GID]) if numeric else self.users.group_name(node[fs.A_GID])
+            if kind in (fs.T_CHR, fs.T_BLK):
+                major, minor = device_numbers(name.rsplit("/", 1)[-1])
+                size = f"{major}, {minor}"
+            elif "h" in self.flags:
+                size = human(self._size(node))
+            else:
+                size = str(self._size(node))
+            shown = name + self._mark(node)
+            if kind == fs.T_LINK:
+                shown += f" -> {node[fs.A_TARGET]}"
+            rows.append(
+                (TYPE_CHAR[kind] + perms, str(links), owner, group, size, node[fs.A_CTIME], shown)
+            )
+        w = [max(len(r[i]) for r in rows) for i in range(5)]
+        out = []
+        for mode, links, owner, group, size, stamp, shown in rows:
+            parts = [mode, links.rjust(w[1])]
+            if "g" not in self.flags:
+                parts.append(owner.ljust(w[2]))
+            if "o" not in self.flags:
+                parts.append(group.ljust(w[3]))
+            parts += [size.rjust(w[4]), self._when(stamp), shown]
+            out.append(" ".join(parts) + "\n")
+        self.write("".join(out))
+
+
+for _name in ("/bin/ls", "/usr/bin/ls", "ls"):
+    commands[_name] = Command_ls
+
+
+# ---------------------------------------------------------------------- id
+
+
+class Command_id(HoneyPotCommand):
+    def call(self) -> None:
+        try:
+            opts, operands = getopt.gnu_getopt(
+                self.args, "ugGnrz", ["user", "group", "groups", "name", "real", "zero"]
+            )
+        except getopt.GetoptError as err:
+            self.errorWrite(f"id: invalid option -- '{err.opt}'\n")
+            self.errorWrite("Try 'id --help' for more information.\n")
+            self.exit_code = 1
+            return
+        long_names = {"--user": "u", "--group": "g", "--groups": "G", "--name": "n"}
+        flags = {long_names.get(o, o.lstrip("-")) for o, _ in opts}
+        users = Users()
+        if operands:
+            entry = users.entry(operands[0])
+            if entry is None:
+                self.errorWrite(f"id: ‘{operands[0]}’: no such user\n")
+                self.exit_code = 1
+                return
+            name, uid, gid = entry["pw_name"], int(entry["pw_uid"]), int(entry["pw_gid"])
+        else:
+            name, uid = str(self.user["username"]), int(self.user["uid"])
+            gid = int(self.user.get("gid", uid))
+        groups = users.groups_of(name, gid)
+        which = flags & {"u", "g", "G"}
+        if len(which) > 1:
+            self.errorWrite("id: cannot print \"only\" of more than one choice\n")
+            self.exit_code = 1
+            return
+        if not which:
+            if flags & {"z", "zero"}:
+                self.errorWrite("id: option --zero not permitted in default format\n")
+                self.exit_code = 1
+                return
+            if flags & {"n", "r", "real"}:
+                self.errorWrite("id: cannot print only names or real IDs in default format\n")
+                self.exit_code = 1
+                return
+            listed = ",".join(f"{g}({users.group_name(g)})" for g in groups)
+            self.write(f"uid={uid}({name}) gid={gid}({users.group_name(gid)}) groups={listed}\n")
+            return
+        named = "n" in flags
+        if "u" in which:
+            self.write(f"{name if named else uid}\n")
+        elif "g" in which:
+            self.write(f"{users.group_name(gid) if named else gid}\n")
+        else:
+            self.write(" ".join(users.group_name(g) if named else str(g) for g in groups) + "\n")
+
+
+commands["/usr/bin/id"] = Command_id
+commands["id"] = Command_id
+
