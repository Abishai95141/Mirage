@@ -159,6 +159,24 @@ class HoneyPotFilesystem:
             except Exception as e:
                 self._log.info("Failed to load honeyfs {error!r}", error=e)
 
+    def _mirage_change(self, op: str, path: str, **fields: Any) -> None:
+        """MIRAGE: report a change to the emulated filesystem (``cowrie.fs.change``).
+
+        The filesystem has no change hook of its own, so the mutators call this.
+        ``events`` is bound once the session's protocol starts; changes made
+        before that (Cowrie setting up the session) are not attacker actions.
+        """
+        events = getattr(self, "events", None)
+        if events is None:
+            return
+        events.dispatch(
+            "cowrie.fs.change",
+            "Filesystem %(op)s %(path)s",
+            op=op,
+            path=path,
+            **{k: v for k, v in fields.items() if v is not None},
+        )
+
     def _ensure_private_fs(self) -> None:
         """Copy the shared base tree the first time this session mutates it.
 
@@ -381,6 +399,7 @@ class HoneyPotFilesystem:
             _dir.remove(next(x for x in _dir if x[A_NAME] == outfile))
         _dir.append([outfile, T_FILE, uid, gid, size, mode, ctime, [], None, None])
         self.newcount += 1
+        self._mirage_change("create", path, mode=mode, size=size, uid=uid)
         return True
 
     def mkdir(
@@ -418,6 +437,7 @@ class HoneyPotFilesystem:
             ]
         )
         self.newcount += 1
+        self._mirage_change("mkdir", path, mode=mode, uid=uid)
 
     def is_executable(self, path: str, uid: int, gid: int) -> bool:
