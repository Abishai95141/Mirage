         self.events.dispatch(
             "cowrie.session.file_upload",
             'SFTP Uploaded file "%(filename)s" to %(outfile)s',
@@ -584,6 +605,7 @@ class HoneyPotFilesystem:
         for i in pdir[:]:
             if i[A_NAME] == name:
                 pdir.remove(i)
+                self._mirage_change("rmdir", p)
                 return True
         return False
 
@@ -600,6 +622,7 @@ class HoneyPotFilesystem:
         if not p:
             raise OSError(errno.ENOENT, os.strerror(errno.ENOENT))
         p[A_MODE] = stat.S_IFMT(p[A_MODE]) | perm
+        self._mirage_change("chmod", path, mode=perm)
 
     def chown(self, path: str, uid: int, gid: int) -> None:
         self._ensure_private_fs()
@@ -610,6 +633,7 @@ class HoneyPotFilesystem:
             p[A_UID] = uid
         if gid != -1:
             p[A_GID] = gid
+        self._mirage_change("chown", path, uid=uid, gid=gid)
 
     def remove(self, path: str) -> None:
         self._ensure_private_fs()
@@ -617,6 +641,7 @@ class HoneyPotFilesystem:
         if not p:
             raise OSError(errno.ENOENT, os.strerror(errno.ENOENT))
         self.unlink_entry(p, posixpath.dirname(path))
+        self._mirage_change("remove", path)
 
     def readlink(self, path: str) -> str:
         p: Node | None = self.getfile(path, follow_symlinks=False)
@@ -640,6 +665,7 @@ class HoneyPotFilesystem:
         self.unlink_entry(old, posixpath.dirname(oldpath))
         old[A_NAME] = posixpath.basename(newpath)
         self.link_entry(old, posixpath.dirname(newpath))
+        self._mirage_change("rename", oldpath, new_path=newpath)
 
     def listdir(self, path: str) -> list[str]:
