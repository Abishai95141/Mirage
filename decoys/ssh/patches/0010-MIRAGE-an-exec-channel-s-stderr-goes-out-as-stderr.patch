         # Defer reading stdin until all redirections are processed, so that
         # when an output redirection truncates the file also used for input
@@ -284,7 +289,7 @@ class PipeProtocol:
         """Send a redirection-related error to the terminal and flag failure."""
         self.redirection_error = True
         try:
-            self.protocol.terminal.write(message.encode("utf8"))
+            self._write_to_terminal(message.encode("utf8"), stderr=True)
         except Exception:
             self._log.info("{msg}", msg=message)
 
@@ -321,9 +326,15 @@ class PipeProtocol:
             status=reason.value.exitCode,
         )
 
-    def _write_to_terminal(self, data: bytes) -> None:
+    def _write_to_terminal(self, data: bytes, stderr: bool = False) -> None:
         if self.protocol is not None and self.protocol.terminal is not None:
-            self.protocol.terminal.write(data)
+            # MIRAGE: stderr goes out as stderr where the session has such a
+            # stream (see LoggingServerProtocol.writeStderr).
+            write_stderr = getattr(self.protocol.terminal, "writeStderr", None)
+            if stderr and write_stderr is not None:
+                write_stderr(data)
+            else:
+                self.protocol.terminal.write(data)
         elif not self.terminal_lost:
             self.terminal_lost = True
             self._log.info("Connection was probably lost. Could not write to terminal")
@@ -343,7 +354,7 @@ class PipeProtocol:
         t_type, t_val = target
 
         if t_type == FD_TERMINAL:
-            self._write_to_terminal(data)
+            self._write_to_terminal(data, stderr=t_val == TERMINAL_STDERR)
         elif t_type == FD_CAPTURE:
             # The sink is a bytearray shared by every command writing to this
             # fd (a capture subshell, or a pipeline stage feeding the next).
diff --git a/src/cowrie/test/test_mirage_stderr.py b/src/cowrie/test/test_mirage_stderr.py
new file mode 100644
index 0000000..426077e
--- /dev/null
+++ b/src/cowrie/test/test_mirage_stderr.py
@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: Tests that a command's stderr leaves an exec channel as SSH stderr, as sshd
+# ABOUTME: sends it, and stays in the one stream of a session that has a pty.
+
+from __future__ import annotations
+
+import os
+import tempfile
+import unittest
+
+from cowrie.insults import insults
+from cowrie.shell import protocol
+from cowrie.test.eventcapture import CaptureSink, make_exec_transport
+from cowrie.test.fake_server import FakeAvatar, FakeServer
+from cowrie.test.fake_transport import FakeTransport
+
+os.environ["COWRIE_HONEYPOT_DATA_PATH"] = "data"
+os.environ["COWRIE_HONEYPOT_DOWNLOAD_PATH"] = tempfile.gettempdir()
+os.environ["COWRIE_SHELL_FILESYSTEM"] = "src/cowrie/data/fs.pickle"
+
+PROMPT = b"root@unitTest:~# "
+
+
+def run_exec(cmd: bytes, pty: bool = False, stderr_stream: bool = True) -> tuple[bytes, bytes]:
+    """Run ``cmd`` on a fake SSH exec channel; what went out as stdout and as stderr."""
+    out, err = bytearray(), bytearray()
+    transport = make_exec_transport(CaptureSink())
+    transport.write = out.extend
+    if stderr_stream:
+        transport.errReceived = err.extend
+    avatar = FakeAvatar(FakeServer())
+    if not pty:
+        # The fake avatar always has a window size; a session has one only
+        # once the client asked for a pty.
+        del avatar.windowSize
+    lsp = insults.LoggingServerProtocol(protocol.HoneyPotExecProtocol, avatar, cmd)
+    lsp.makeConnection(transport)
+    return bytes(out), bytes(err)
+
+
+class ExecStderrTests(unittest.TestCase):
+    def test_an_error_goes_out_as_stderr(self) -> None:
+        out, err = run_exec(b"nosuchcommand")
+        self.assertEqual(out, b"")
+        self.assertIn(b"nosuchcommand: command not found", err)
+
+    def test_stdout_and_stderr_are_two_streams(self) -> None:
+        out, err = run_exec(b"echo good; ls /nonexistent-dir; echo after")
+        self.assertEqual(out, b"good\nafter\n")
+        self.assertIn(b"/nonexistent-dir", err)
+        self.assertNotIn(b"good", err)
+
+    def test_a_redirect_to_stdout_joins_them(self) -> None:
+        out, err = run_exec(b"ls /nonexistent-dir 2>&1")
+        self.assertIn(b"/nonexistent-dir", out)
+        self.assertEqual(err, b"")
+
+    def test_a_redirect_to_stderr_moves_stdout(self) -> None:
+        out, err = run_exec(b"echo warning >&2; echo fine")
+        self.assertEqual((out, err), (b"fine\n", b"warning\n"))
+
+    def test_stderr_sent_to_dev_null_is_gone(self) -> None:
+        out, err = run_exec(b"ls /nonexistent-dir 2>/dev/null; echo done")
+        self.assertEqual((out, err), (b"done\n", b""))
+
+    def test_a_pipe_carries_stdout_and_leaves_stderr_out(self) -> None:
+        out, err = run_exec(b"ls /nonexistent-dir | cat; echo end")
+        self.assertEqual(out, b"end\n")
+        self.assertIn(b"/nonexistent-dir", err)
+
+    def test_a_group_redirect_covers_its_errors(self) -> None:
+        out, err = run_exec(b"{ nosuchcommand; echo in; } 2>/dev/null")
+        self.assertEqual((out, err), (b"in\n", b""))
+
+    def test_a_bad_redirection_is_reported_on_stderr(self) -> None:
+        out, err = run_exec(b"echo x > /nonexistent-dir/file")
+        self.assertEqual(out, b"")
+        self.assertIn(b"No such file or directory", err)
+
+    def test_with_a_pty_there_is_one_stream(self) -> None:
+        out, err = run_exec(b"nosuchcommand", pty=True)
+        self.assertIn(b"command not found", out)
+        self.assertEqual(err, b"")
+
+    def test_a_transport_with_one_stream_gets_everything(self) -> None:
+        out, err = run_exec(b"nosuchcommand", stderr_stream=False)
+        self.assertIn(b"command not found", out)
+
+
+class InteractiveTests(unittest.TestCase):
+    def test_an_interactive_shell_shows_errors_in_its_one_stream(self) -> None:
+        proto = protocol.HoneyPotInteractiveProtocol(FakeAvatar(FakeServer()))
+        tr = FakeTransport("", "31337")
+        proto.makeConnection(tr)
+        tr.clear()
+        proto.lineReceived(b"nosuchcommand")
+        self.assertIn(b"nosuchcommand: command not found", tr.value())
+        proto.connectionLost()
