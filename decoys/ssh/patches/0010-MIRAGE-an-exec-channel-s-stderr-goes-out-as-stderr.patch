From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MIRAGE <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 03:30:07 +0530
Subject: [PATCH 10/10] MIRAGE: an exec channel's stderr goes out as stderr

On an exec channel with no pty, sshd sends a command's stderr as SSH extended
data: 'ssh host cmd 2>/dev/null' hides an error and '2>&1' is needed to
capture it. Cowrie wrote both streams as ordinary data, so every error of
every command arrived on stdout, which no real server does and one command
shows. A terminal target now says which stream it is, and the session writes
stderr through the channel's own stderr where there is one. With a pty, on
telnet and in an interactive shell there is one stream, as before.
---
 src/cowrie/insults/insults.py         | 19 ++++++
 src/cowrie/shell/honeypot.py          |  9 ++-
 src/cowrie/shell/pipe.py              | 23 +++++--
 src/cowrie/test/test_mirage_stderr.py | 98 +++++++++++++++++++++++++++
 4 files changed, 141 insertions(+), 8 deletions(-)
 create mode 100644 src/cowrie/test/test_mirage_stderr.py

diff --git a/src/cowrie/insults/insults.py b/src/cowrie/insults/insults.py
index 8317ceb..85a1ffc 100644
--- a/src/cowrie/insults/insults.py
+++ b/src/cowrie/insults/insults.py
@@ -186,6 +186,25 @@ class LoggingServerProtocol(insults.ServerProtocol):
         self.ttylogWritten = written
         return len(data)
 
+    def writeStderr(self, data: bytes) -> None:
+        """MIRAGE: write what a command sent to its stderr.
+
+        On an exec channel with no pty, sshd sends a command's stderr as SSH
+        extended data, so `ssh host cmd 2>/dev/null` hides it and `2>&1` is
+        needed to capture it. Writing it as ordinary data, as write() does,
+        shows every error on stdout: something no real server does. With a pty,
+        or on a transport that has no second stream, there is one stream and
+        this is write().
+        """
+        send = getattr(self.transport, "errReceived", None)
+        has_pty = hasattr(getattr(self.terminalProtocol, "user", None), "windowSize")
+        if self.type != "e" or has_pty or send is None:
+            self.write(data)
+            return
+        self.bytesSent += len(data)
+        self.ttylogSize += self.ttylogWrite(ttylog.TYPE_OUTPUT, data)
+        send(data)
+
     def write(self, data: bytes) -> None:
         self.bytesSent += len(data)
         self.ttylogSize += self.ttylogWrite(ttylog.TYPE_OUTPUT, data)
