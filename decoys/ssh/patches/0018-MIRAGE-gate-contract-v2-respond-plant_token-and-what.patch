     reason = None
     if fallback:
         reason = decision.get("_fallback", "malformed") if isinstance(decision, dict) else "malformed"
+        if chosen in V2_ACTIONS:
+            reason = "unsupported"  # an action this request did not offer
     action = "allow" if fallback else decision["action"]
     shell.protocol.events.dispatch(
         "cowrie.policy.decision",
@@ -358,6 +462,13 @@ def _apply(
     if not _release(shell, waiting):
         return None
 
+    if action == "plant_token":
+        _plant(shell, decision, request)
+        return shell._run_expanded(cmdAndArgs)
+
+    if action == "respond":
