+class HealthTests(unittest.TestCase):
+    def test_health_follows_the_service(self) -> None:
+        client = mirage_respond.Responder("http://198.51.100.9:8100/v1/respond", "t" * 32)
+        asked: list[str] = []
+        answers = iter([200, 503, None, 200])
+
+        class Http:
+            def get(self, url: str, **_kw: Any) -> defer.Deferred:
+                asked.append(url)
+                code = next(answers)
+                if code is None:
+                    return defer.fail(ConnectionRefusedError("down"))
+                return defer.succeed(type("Response", (), {"code": code})())
+
+        client._http = Http()  # type: ignore[assignment]
+        self.assertFalse(client.healthy)  # not until a check has passed
+        seen = []
+        for _ in range(4):
+            client.check()
+            seen.append(client.healthy)
+        self.assertEqual(seen, [True, False, False, True])
+        self.assertEqual(asked[0], "http://198.51.100.9:8100/healthz")
