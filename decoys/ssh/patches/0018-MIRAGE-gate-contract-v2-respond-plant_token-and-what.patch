+class PendingTests(RespondTestBase):
+    manual_reply = True
+
+    def test_typed_ahead_input_waits_for_the_answer(self) -> None:
+        self.responder.script = [out("slow answer"), end()]
+        self.assertEqual(self.run_line(ASKED), b"")  # nothing yet, and no prompt
+        self.proto.lineReceived(b"echo next\n")
+        self.assertNotIn(b"next", self.tr.value())
+        self.responder.held.pop(0)()
+        # The queued line runs when the answer is over, as it does behind any command.
+        self.assertEqual(self.tr.value(), b"slow answer\nnext\n" + PROMPT)
+
+    def test_lines_reach_the_terminal_before_the_answer_is_over(self) -> None:
+        self.responder.script = [out("first"), out("second"), end()]
+        self.run_line(ASKED)
+        reply = self.responder.held.pop(0)
+        reply(1)  # the first record only; on_done fires, so this reply is over
+        self.assertTrue(self.tr.value().startswith(b"first\n"))
+
+    def test_ctrl_c_stops_the_answer_and_tells_the_responder(self) -> None:
+        self.responder.script = [out("never shown"), end()]
+        self.run_line(ASKED)
+        self.proto.handle_CTRL_C()
+        self.assertEqual(self.tr.value(), b"^C\n" + PROMPT)
+        self.assertEqual(self.responder.cancelled, ["done"])  # the connection was closed
+        self.responder.held.pop(0)()  # what arrives afterwards is nobody's
+        self.assertEqual(self.tr.value(), b"^C\n" + PROMPT)
+        self.assertEqual(self.reports()[-1]["outcome"], "cancelled")
+        self.assertEqual(self.run_line("echo $?"), b"130\n" + PROMPT)
+
+    def test_a_session_that_goes_away_closes_the_request(self) -> None:
