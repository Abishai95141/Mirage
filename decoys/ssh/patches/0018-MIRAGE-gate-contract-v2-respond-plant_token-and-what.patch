+class ResyncTests(RespondTestBase):
+    def test_a_restarted_responder_is_sent_the_whole_journal_once(self) -> None:
+        self.run_line("mkdir /tmp/a")
+        self.ask([end()])
+        self.run_line("mkdir /tmp/b")
+        replies = iter([[{"type": "resync", "have": 0}], [out("ok"), end()]])
