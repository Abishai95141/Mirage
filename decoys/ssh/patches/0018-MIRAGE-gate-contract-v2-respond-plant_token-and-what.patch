+        self.assertEqual((whole["journal_from"], [e["path"] for e in whole["journal"]]), (1, ["/tmp/a", "/tmp/b"]))
+        self.assertEqual(whole["request_id"], gap["request_id"])
+        self.assertEqual(len(self.reports()), 2)  # one answer each, not one a request
