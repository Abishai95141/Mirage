+++ b/src/cowrie/test/test_mirage_respond.py
@@ -0,0 +1,538 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: Tests gate contract v2 in the shell: the respond action and its client,
+# ABOUTME: plant_token, what the decoy says it supports, and every way an answer ends.
+
+from __future__ import annotations
+
+import json
+import unittest
+from typing import Any
+
+from twisted.internet import defer
+
+from cowrie import mirage_gate, mirage_respond, mirage_state
+from cowrie.shell import fs as cfs
+from cowrie.test.test_mirage_gate import PROMPT, GateTestBase, allow
+
+BUDGET = {"max_tokens": 400, "deadline_ms": 5000}
+# A command the emulator has, with an option it declines: tier ``none``.
+ASKED = "stat -f /"
+FALLBACK = b"cannot execute binary file"
+
+
+def respond(request: dict[str, Any]) -> dict[str, Any]:
+    """The policy of these tests: respond where the decoy has nothing."""
+    if request["tier"] == "none" and "respond" in request["supports"]:
+        return {"action": "respond", "decision_id": "d", "propensity": 1.0, "budget": BUDGET}
+    return allow(request)
+
+
+def end(**fields: Any) -> dict[str, Any]:
+    return {"type": "end", "stderr": "", "exit_code": 0, "ops": [], "rung": "model", **fields}
+
+
+def out(line: str, **fields: Any) -> dict[str, Any]:
+    return {"type": "out", "line": line, **fields}
+
+
+class FakeResponder:
+    """In-process stand-in for the responder service. ``script(body)`` gives
+    the reply's records; with ``manual`` they are held until ``release()``."""
+
+    def __init__(self, script: Any, manual: bool = False) -> None:
+        self.script, self.manual = script, manual
+        self.healthy = True
+        self.requests: list[dict[str, Any]] = []
+        self.held: list[Any] = []
+        self.cancelled: list[str] = []
+        self.failure: str | None = None
+
+    def respond(self, body: dict[str, Any], on_record: Any, on_done: Any, deadline_s: float) -> Any:
+        self.requests.append(json.loads(json.dumps(body)))  # as it would travel
+        state = {"over": False}
+
+        def cancel(reason: str = "cancelled") -> None:
+            if not state["over"]:
+                state["over"] = True
+                self.cancelled.append(reason)
+                on_done(reason)
+
+        def deliver(records: list[dict[str, Any]], reason: str | None = None) -> None:
+            for record in records:
+                if state["over"]:
+                    return
+                on_record(record)
+            if not state["over"]:
+                state["over"] = True
+                on_done(reason)
+
+        records = self.script(body) if callable(self.script) else self.script
+        if self.manual:
+            self.held.append(lambda upto=None, reason=None: deliver(records[:upto], reason))
+        else:
+            deliver(list(records), self.failure)
+        return cancel
+
+
+class RespondTestBase(GateTestBase):
+    rule = staticmethod(respond)
+    script: Any = (end(stdout="answered\n"),)
+    manual_reply = False
+
+    def setUp(self) -> None:
+        self.responder = FakeResponder(list(self.script), self.manual_reply)
+        mirage_respond.reset_for_tests(self.responder)
+        super().setUp()
+        self.proto.fs.events = self.proto.events
+        self.shell = self.proto.cmdstack[0]
+
+    def tearDown(self) -> None:
+        super().tearDown()
+        mirage_respond.reset_for_tests()
+
+    def reports(self) -> list[dict[str, Any]]:
+        return [e for e in self.events if e["eventid"] == "cowrie.mirage.respond"]
+
+    def ask(self, records: list[dict[str, Any]], line: str = ASKED) -> bytes:
+        self.responder.script = records
+        return self.run_line(line)
+
+
+# ------------------------------------------------------------------- what is offered
+
+
+class SupportsTests(RespondTestBase):
+    def supports(self, line: str = "echo hi") -> list[str]:
+        self.run_line(line)
+        return list(self.gate.requests[-1]["supports"])
+
+    def test_respond_is_offered_while_the_responder_is_healthy(self) -> None:
+        self.assertEqual(self.supports(), ["respond", "plant_token"])
+        self.responder.healthy = False
+        self.assertEqual(self.supports(), ["plant_token"])
+        mirage_respond.reset_for_tests(None)
+        self.assertEqual(self.supports(), ["plant_token"])
+
+    def test_nothing_is_offered_once_the_journal_has_holes(self) -> None:
+        journal = mirage_state.journal_of(self.proto)
+        journal.full = True
+        self.assertEqual(self.supports(), [])
+        # And so the command is the emulator's, whatever the policy would like.
+        self.assertIn(FALLBACK, self.run_line(ASKED))
+        self.assertEqual(self.responder.requests, [])
+
+    def test_a_program_that_is_not_there_is_absent_not_unanswered(self) -> None:
+        output = self.run_line("no-such-program --now")
+        request = self.gate.requests[-1]
+        self.assertEqual((request["tier"], request["known"]), ("absent", False))
+        self.assertIn(b"command not found", output)
+        self.assertEqual(self.responder.requests, [])
+
+    def test_an_action_that_was_not_offered_is_not_taken(self) -> None:
+        self.gate.rule = lambda r: {"action": "respond", "decision_id": "d", "budget": BUDGET}
+        self.responder.healthy = False
+        self.assertIn(FALLBACK, self.run_line(ASKED))
+        self.gate.rule = lambda r: {"action": "escalate", "decision_id": "d", "sandbox": "s"}
+        self.assertEqual(self.run_line("echo hi"), b"hi\n" + PROMPT)
+        decisions = self.decisions()
+        self.assertEqual([d["action"] for d in decisions], ["allow", "allow"])
+        self.assertEqual([d["fallback_reason"] for d in decisions], ["unsupported", "unsupported"])
+        self.assertEqual(self.responder.requests, [])
+
+    def test_respond_is_for_what_the_emulator_cannot_answer(self) -> None:
+        self.gate.rule = lambda r: {"action": "respond", "decision_id": "d", "budget": BUDGET}
+        self.assertEqual(self.run_line("echo hi"), b"hi\n" + PROMPT)
+        self.assertEqual(self.reports()[-1]["reason"], "tier:emulated")
+        self.gate.rule = lambda r: {"action": "respond", "decision_id": "d"}
+        self.assertIn(FALLBACK, self.run_line(ASKED))
+        self.assertEqual(self.reports()[-1]["reason"], "no_budget")
+        self.assertEqual(self.responder.requests, [])
+
+    def test_a_budget_is_two_positive_numbers_within_the_contract(self) -> None:
+        good = mirage_respond.budget_of({"budget": {"max_tokens": 9000, "deadline_ms": 99999}})
+        self.assertEqual(good, {"max_tokens": 400, "deadline_ms": 10000})
+        for bad in (None, {}, {"max_tokens": 0, "deadline_ms": 1}, {"max_tokens": "9", "deadline_ms": 1},
+                    {"max_tokens": True, "deadline_ms": 1}, {"max_tokens": 5}):  # fmt: skip
+            self.assertIsNone(mirage_respond.budget_of({"budget": bad}), bad)
+
+
+# ------------------------------------------------------------------- an answer
+
+
+class AnswerTests(RespondTestBase):
+    def test_lines_are_shown_as_they_come_and_the_status_is_the_answers(self) -> None:
+        output = self.ask([out("one"), out("two"), out("three", newline=False), end(exit_code=3)])
+        self.assertEqual(output, b"one\ntwo\nthree" + PROMPT)
+        self.assertEqual(self.run_line("echo $?"), b"3\n" + PROMPT)
+        (report,) = self.reports()
+        self.assertEqual((report["outcome"], report["lines"], report["rung"]), ("answered", 3, "model"))
+        self.assertEqual(report["request_id"], self.gate.requests[0]["request_id"])
+        self.assertIsNotNone(report["first_ms"])
+
+    def test_the_request_says_who_where_and_what_is_there(self) -> None:
+        self.run_line("cd /tmp; export APP=1; mkdir /tmp/seen")
+        self.ask([end()], "stat -f /tmp/seen missing")
+        (body,) = self.responder.requests
+        self.assertEqual(body["request_id"], self.gate.requests[-1]["request_id"])
+        self.assertEqual(body["session_id"], "test0000")
+        self.assertEqual((body["user"], body["uid"], body["cwd"]), ("root", 0, "/tmp"))
+        self.assertEqual(body["argv"], ["stat", "-f", "/tmp/seen", "missing"])
+        self.assertEqual(body["input"], "stat -f /tmp/seen missing")
+        self.assertEqual(body["budget"], BUDGET)
+        self.assertEqual(body["env"], {"APP": "1"})
+        self.assertEqual((body["journal_from"], body["journal_to"]), (1, len(body["journal"])))
+        self.assertEqual(
+            [(e["op"], e.get("path") or e.get("name")) for e in body["journal"]],
+            # In the order they happened: the directory was left before the other was made.
+            [("cd", "/tmp"), ("setenv", "APP"), ("mkdir", "/tmp/seen")],
+        )
+        seen = {e["path"]: e["type"] for e in body["slice"]}
+        self.assertEqual(seen["/tmp/seen"], "dir")
+        self.assertEqual(seen["/tmp/missing"], "missing")
+
+    def test_only_what_is_new_is_sent_the_next_time(self) -> None:
+        self.run_line("mkdir /tmp/a")
+        self.ask([end()])
+        self.run_line("mkdir /tmp/b")
+        self.ask([end()])
+        first, second = self.responder.requests
+        self.assertEqual((first["journal_from"], [e["path"] for e in first["journal"]]), (1, ["/tmp/a"]))
+        self.assertEqual((second["journal_from"], [e["path"] for e in second["journal"]]), (2, ["/tmp/b"]))
+
+    def test_an_aborted_answer_leaves_its_journal_to_be_sent_again(self) -> None:
+        self.run_line("mkdir /tmp/a")
+        self.ask([{"type": "abort", "reason": "busy"}])
+        self.ask([end()])
+        self.assertEqual([r["journal_from"] for r in self.responder.requests], [1, 1])
+
+    def test_output_goes_where_the_command_s_output_goes(self) -> None:
+        self.assertEqual(self.ask([out("a"), out("b"), end()], f"{ASKED} > /tmp/kept"), PROMPT)
+        self.assertEqual(self.run_line("cat /tmp/kept"), b"a\nb\n" + PROMPT)
+        self.assertEqual(self.ask([out("a"), out("b"), end()], f"{ASKED} | wc -l"), b"2\n" + PROMPT)
+        self.assertEqual(
+            self.ask([end(stdout="", stderr="stat: cannot read\n", exit_code=1)], f"{ASKED} 2>/dev/null"),
+            PROMPT,
+        )
+
+    def test_a_held_answer_applies_its_operations_before_it_shows_a_line(self) -> None:
+        ops = [
+            {"op": "mkdir", "path": "/tmp/build"},
+            {"op": "write", "path": "/tmp/build/out.log", "content": "built\n"},
+        ]
+        seen: list[bool] = []
+        write = self.tr.write
+
+        def watching(data: bytes) -> None:
+            if b"done" in data:
+                seen.append(self.proto.fs.exists("/tmp/build/out.log"))
+            write(data)
+
+        self.tr.write = watching  # type: ignore[method-assign]
+        output = self.ask([end(stdout="done\n", ops=ops)])
+        self.tr.write = write  # type: ignore[method-assign]
+        self.assertEqual(output, b"done\n" + PROMPT)
