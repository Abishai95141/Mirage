     return mirage_render.tier(shell, words)
 
 
+def _supports(shell: HoneyPotShell) -> list[str]:
+    """The v2 actions this decoy can carry out for this session now."""
+    from cowrie import mirage_respond, mirage_state
+
+    journal = mirage_state.journal_of(shell.protocol)
+    journal.sync(shell)
+    if journal.full:
+        # Its journal has holes: nothing outside the emulator may act on it.
+        return []
+    supports = ["plant_token"]
+    responder = mirage_respond.get()
+    if responder is not None and getattr(responder, "healthy", False):
+        supports.insert(0, "respond")
+    return supports
+
+
+def _plant(shell: HoneyPotShell, decision: dict[str, Any], request: dict[str, Any]) -> None:
+    """Apply a ``plant_token`` decision's operations: all of them or none."""
+    from cowrie import mirage_state
+
+    proto = shell.protocol
+    paths: list[str] = []
+    reason = None
+    try:
+        ops = mirage_state.apply(shell, decision.get("ops"), limited=False)
+        paths = [op["path"] for op in ops if op["op"] == "write"]
+        if not paths:
+            reason = "no_file"
+    except mirage_state.Rejected as e:
+        reason = str(e)[:200]
+    if paths:
+        # From here on these are files no answer may touch or be shown.
+        proto.mirage_token_paths = set(getattr(proto, "mirage_token_paths", ())) | set(paths)
+    proto.events.dispatch(
+        "cowrie.mirage.plant",
+        "Planted %(planted)s",
+        planted=bool(paths),
+        paths=paths,
+        reason=reason,
+        decision_id=decision.get("decision_id"),
+        request_id=request["request_id"],
+        seq=request["seq"],
+    )
+
+
+def _respond(
+    shell: HoneyPotShell,
+    decision: dict[str, Any],
+    cmdAndArgs: list[str],
+    request: dict[str, Any],
+) -> Any:
+    """Run the command with its output asked of the responder, or as the
+    emulator would if this decision cannot be carried out."""
+    from cowrie import mirage_respond
+
+    budget = mirage_respond.budget_of(decision)
+    reason = None
+    if request["tier"] != "none":
+        reason = f"tier:{request['tier']}"  # the emulator has an answer of its own
+    elif budget is None:
+        reason = "no_budget"
+    if reason is None:
+        assert budget is not None
+        mirage_respond.arm(shell, request, budget)
+        result = shell._run_expanded(cmdAndArgs)
+        if not mirage_respond.disarm(shell):
+            return result
+        reason = "not_a_command"  # an assignment, a function: nothing was looked up
+        cmdAndArgs = []
+    shell.protocol.events.dispatch(
+        "cowrie.mirage.respond",
+        "Responder %(outcome)s for %(input)s",
+        input=" ".join(request["argv"]),
+        outcome="fallback",
+        reason=reason,
+        request_id=request["request_id"],
+        seq=request["seq"],
+        lines=0,
+    )
+    return shell._run_expanded(cmdAndArgs) if cmdAndArgs else None
+
+
 def gate_then_run(shell: HoneyPotShell, cmdAndArgs: list[str]) -> Any:
     gate = _get_gate()
     if gate is None:
@@ -274,6 +373,7 @@ def gate_then_run(shell: HoneyPotShell, cmdAndArgs: list[str]) -> Any:
