+class LinesTests(unittest.TestCase):
+    def reader(self) -> tuple[Any, list[dict[str, Any]], list[str]]:
+        got: list[dict[str, Any]] = []
+        stopped: list[str] = []
+        done: defer.Deferred = defer.Deferred()
+        lines = mirage_respond._Lines(got.append, done)
+
+        class Transport:
+            def stopProducing(self) -> None:
+                stopped.append("stopped")
+
+        lines.transport = Transport()  # type: ignore[assignment]
+        return lines, got, stopped
+
+    def test_records_are_handed_on_as_their_lines_complete(self) -> None:
+        lines, got, _ = self.reader()
+        lines.dataReceived(b'{"type":"out","li')
+        self.assertEqual(got, [])
+        lines.dataReceived(b'ne":"a"}\n{"type":"out","line":"b"}\n\n{"type":"e')
+        self.assertEqual([r["line"] for r in got], ["a", "b"])
+        lines.dataReceived(b'nd"}\n')
+        self.assertEqual(got[-1], {"type": "end"})
+
+    def test_what_is_not_a_record_ends_the_reading(self) -> None:
+        for junk in (b"not json\n", b"[1, 2]\n", b'"text"\n'):
+            lines, got, stopped = self.reader()
+            lines.dataReceived(junk)
+            self.assertEqual((got, stopped), ([], ["stopped"]))
+
+    def test_a_reply_without_end_is_bounded(self) -> None:
+        lines, _got, stopped = self.reader()
+        chunk = b'{"type":"out","line":"' + b"x" * 1000 + b'"}\n'
+        for _ in range(mirage_respond.MAX_REPLY_BYTES // len(chunk) + 2):
+            lines.dataReceived(chunk)
+        self.assertEqual(stopped, ["stopped"])
+
