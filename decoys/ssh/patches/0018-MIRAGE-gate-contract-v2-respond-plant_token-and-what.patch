diff --git a/src/cowrie/mirage_respond.py b/src/cowrie/mirage_respond.py
new file mode 100644
index 0000000..4aff583
--- /dev/null
+++ b/src/cowrie/mirage_respond.py
@@ -0,0 +1,512 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE responder client. When the policy answers "respond", ask the
+# ABOUTME: responder service for the command's output and show it as it arrives.
+
+"""MIRAGE responder client for the Cowrie shell.
+
+The policy may answer a command the emulator has nothing for with
+``respond``. The command then runs as :class:`Answer`, an ordinary command
+on the cmdstack: lines typed meanwhile queue behind it, Ctrl-C ends it, its
+output goes through the same pipes and redirections as any command's.
+
+``Answer`` sends the responder what it needs to answer in keeping with this
+session (who, where, what the session has changed, what is at the paths the
+command names) and reads the reply as it comes, one JSON record a line:
+
+``out``     a line of output: shown at once.
+``end``     the rest: operations to apply, held output, stderr, the status.
+``abort``   no answer, or no more of one.
+``resync``  the responder does not hold this session's journal (it was
+            restarted): the request is sent once more with all of it.
+
+The decoy is the only owner of the session. An answer's operations are
+checked again here, against this session's own filesystem, and applied all
+or none (:func:`cowrie.mirage_state.apply`) *before* any held output is
+shown. Whatever goes wrong before a line has been shown (the responder is
+down, slow, refuses, or its operations are rejected), the command falls back
+to what the emulator would have run, and the session sees nothing of it.
+"""
+
+from __future__ import annotations
+
+import json
+import time
+from typing import TYPE_CHECKING, Any
+
+from twisted.internet import defer, protocol, reactor
+from twisted.logger import Logger
+
+from cowrie import mirage_state
+from cowrie.core.config import CowrieConfig
+from cowrie.mirage_gate import PolicyGate
+from cowrie.shell.command import HoneyPotCommand
+
+if TYPE_CHECKING:
+    from collections.abc import Callable
+
+    from cowrie.shell.honeypot import HoneyPotShell
+
+log = Logger()
+
+MAX_INPUT_BYTES = 1024
+MAX_OUTPUT_TOKENS = 400
+MAX_DEADLINE_MS = 10_000
+MAX_REPLY_BYTES = 256 * 1024
+GRACE_S = 0.5  # past the deadline the responder was given, before giving up on it
+
+
+class _Lines(protocol.Protocol):
+    """The reply's body: newline-delimited JSON, handed on record by record."""
+
+    def __init__(self, on_record: Callable[[dict[str, Any]], None], done: defer.Deferred) -> None:
+        self.on_record, self.done = on_record, done
+        self.buffer = b""
+        self.taken = 0
+        self.stopped = False
+
+    def stop(self) -> None:
+        if not self.stopped:
+            self.stopped = True
+            self.transport.stopProducing()  # closes the connection
+
+    def dataReceived(self, data: bytes) -> None:
+        if self.stopped:
+            return
+        self.taken += len(data)
+        if self.taken > MAX_REPLY_BYTES:
+            self.stop()
+            return
+        self.buffer += data
+        while b"\n" in self.buffer:
+            line, self.buffer = self.buffer.split(b"\n", 1)
+            if not line.strip():
+                continue
+            try:
+                record = json.loads(line)
+            except ValueError:
+                record = None
+            if not isinstance(record, dict):
+                self.stop()
+                return
+            self.on_record(record)
+            if self.stopped:
+                return
+
+    def connectionLost(self, reason: Any = None) -> None:
+        if not self.done.called:
+            self.done.callback(None)
+
+
+class Responder(PolicyGate):
+    """HTTP client for the responder service: the policy gate's connection
+    handling (kept-alive connections, the address resolved in the background)
+    with a reply that is read as it arrives, and a health check."""
+
+    def __init__(self, url: str, token: str = "", health_s: float = 5.0) -> None:
+        super().__init__(url, timeout_s=MAX_DEADLINE_MS / 1000.0, idle_s=60.0, token=token)
+        self.health_s = health_s
+        self.healthy = False
+        self._health_loop: Any = None
+
+    @classmethod
+    def from_config(cls) -> Responder | None:
+        if not CowrieConfig.getboolean("mirage", "responder_enabled", fallback=False):
+            return None
+        url = CowrieConfig.get(
+            "mirage", "responder_url", fallback="http://responder:8100/v1/respond"
+        )
+        # The token comes from the environment (COWRIE_MIRAGE_RESPONDER_TOKEN).
+        token = CowrieConfig.get("mirage", "responder_token", fallback="")
+        health_ms = CowrieConfig.getint("mirage", "responder_health_ms", fallback=5000)
+        return cls(url, token, health_ms / 1000.0)
+
+    # ---------------------------------------------------------------- health
+
+    def start(self) -> None:
+        """Begin checking the responder's health in the background. The gate
+        lists ``respond`` among what this decoy supports only while the last
+        check passed, so the policy learns availability without calling
+        anything itself."""
+        if self._health_loop is not None:
+            return
+        from twisted.internet.task import LoopingCall
+
+        self.start_resolving()
+        self._health_loop = LoopingCall(self.check)
+        self._health_loop.clock = reactor
+        self._health_loop.start(self.health_s, now=True)
+
+    def check(self) -> defer.Deferred:
+        url, headers = self.target()
+        health = url.rsplit("/v1/", 1)[0] + "/healthz"
+
+        def passed(response: Any) -> None:
+            self.healthy = response.code == 200
+
+        def failed(failure: Any) -> None:
+            self.healthy = False
+            self.resolve()
+
+        d = self._http.get(health, headers=headers, timeout=min(2.0, self.health_s))
+        d.addCallbacks(passed, failed)
+        return d
+
+    # ---------------------------------------------------------------- respond
+
+    def respond(
+        self,
+        body: dict[str, Any],
+        on_record: Callable[[dict[str, Any]], None],
+        on_done: Callable[[str | None], None],
+        deadline_s: float,
+    ) -> Callable[[], None]:
+        """Send one request. ``on_record`` gets each record of the reply as it
+        arrives; ``on_done`` is called once, with None when the reply ended
+        or a reason when it could not be had. Returns what cancels it."""
+        url, headers = self.target()
+        state: dict[str, Any] = {"over": False, "body": None, "timer": None}
+
+        def finish(reason: str | None) -> None:
+            if state["over"]:
+                return
+            state["over"] = True
+            if state["timer"] is not None and state["timer"].active():
+                state["timer"].cancel()
+            on_done(reason)
+
+        def cancel(reason: str = "cancelled") -> None:
+            if state["over"]:
+                return
+            reader = state["body"]
+            if reader is not None and reader.transport is not None:
+                reader.stop()
+            else:
+                d.cancel()
+            finish(reason)
+
+        def got(response: Any) -> Any:
+            if state["over"]:
+                return None
+            if response.code != 200:
+                finish(f"status:{response.code}")
+                return None
+            ended: defer.Deferred = defer.Deferred()
+            state["body"] = _Lines(lambda r: None if state["over"] else on_record(r), ended)
+            response.original.deliverBody(state["body"])
+            ended.addCallback(lambda _: finish(None))
+            return None
+
+        def failed(failure: Any) -> None:
+            if failure.check(defer.CancelledError):
+                return
+            self.healthy = False
+            self.resolve()
+            finish(f"error:{failure.type.__name__}")
+
+        d = self._http.post(url, json=body, headers=headers)
+        d.addCallbacks(got, failed)
+        state["timer"] = reactor.callLater(deadline_s + GRACE_S, cancel, "timeout")
+        return cancel
+
+
+_UNSET = object()
+_responder: Any = _UNSET
+
+
+def get() -> Responder | None:
+    global _responder
+    if _responder is _UNSET:
+        _responder = Responder.from_config()
+    if _responder is not None and hasattr(_responder, "start"):
+        _responder.start()
+    return _responder  # type: ignore[no-any-return]
+
+
+def reset_for_tests(responder: Any = _UNSET) -> None:
+    global _responder
+    _responder = responder
+
+
+def token_paths(proto: Any) -> set[str]:
+    """Paths that hold a planted token: the deployment's, and any the policy
+    planted in this session. No answer may touch them, and their contents are
+    not shown to the responder."""
+    configured = CowrieConfig.get("mirage", "token_paths", fallback="")
+    paths = {p.strip() for p in configured.split(",") if p.strip()}
+    return paths | set(getattr(proto, "mirage_token_paths", ()))
+
+
+def budget_of(decision: dict[str, Any]) -> dict[str, int] | None:
+    """The budget a ``respond`` decision carries, or None if it carries none
+    that can be used."""
+    budget = decision.get("budget")
+    if not isinstance(budget, dict):
+        return None
+    tokens, deadline = budget.get("max_tokens"), budget.get("deadline_ms")
+    for value in (tokens, deadline):
+        if isinstance(value, bool) or not isinstance(value, int) or value < 1:
+            return None
+    return {
+        "max_tokens": min(tokens, MAX_OUTPUT_TOKENS),
+        "deadline_ms": min(deadline, MAX_DEADLINE_MS),
+    }
+
+
+def arm(shell: HoneyPotShell, request: dict[str, Any], budget: dict[str, int]) -> None:
+    """The next command this shell looks up is answered by the responder."""
+    shell._mirage_answer = (request, budget)
+
+
+def disarm(shell: HoneyPotShell) -> bool:
+    """Forget an answer that was armed and not taken. True if there was one."""
+    return shell.__dict__.pop("_mirage_answer", None) is not None
+
+
+def take(
+    shell: HoneyPotShell, cmd: str, args: list[str], environ: dict[str, str]
+) -> type[HoneyPotCommand] | None:
+    """Called by ``HoneyPotShell._run_expanded`` before its own lookup: the
+    :class:`Answer` for this command if one is armed, else None."""
+    armed = shell.__dict__.pop("_mirage_answer", None)
+    if armed is None:
+        return None
+    request, budget = armed
+    # What the emulator would have run: the fallback, should no answer come.
+    from cowrie import mirage_render
+
+    fallback = mirage_render.command_for(shell, cmd, args, environ)
+    if fallback is None:
+        fallback = shell.protocol.getCommand(cmd, environ.get("PATH", "").split(":"), shell.cwd)
+
+    class Command_answer(Answer):
+        mirage_request = request
+        mirage_budget = budget
+        mirage_fallback = fallback
+        mirage_argv = (cmd, *args)
+
+    return Command_answer
+
+
+class Answer(HoneyPotCommand):
+    """A command whose output comes from the responder."""
+
+    mirage_request: dict[str, Any]
+    mirage_budget: dict[str, int]
+    mirage_fallback: Any = None
+    mirage_argv: tuple[str, ...] = ()
+
+    def start(self) -> None:
+        self.began = time.monotonic()
+        self.shown = 0  # lines of output the session has seen
+        self.resynced = False
+        self.attempt = 0
+        self.over = False
+        self.cancel: Callable[..., None] | None = None
+        self.first_ms: float | None = None
+        self.responder = get()
+        self.journal = mirage_state.journal_of(self.protocol)
+        line = " ".join(self.mirage_argv)
+        if self.responder is None:
+            self.fall_back("unavailable")
+        elif len(line.encode("utf8", "replace")) > MAX_INPUT_BYTES:
+            self.fall_back("input_too_long")
+        elif self.journal.full:
+            self.fall_back("journal_full")
+        else:
+            self.send(whole=False)
+
+    # ---------------------------------------------------------------- the request
+
+    def body(self, whole: bool) -> dict[str, Any]:
+        request = self.mirage_request
+        sent = 0 if whole else int(getattr(self.protocol, "mirage_journal_sent", 0))
+        self.journal.sync(self.shell)
+        self.journal_to = self.journal.seq
+        hidden = token_paths(self.protocol)
+        return {
+            "request_id": request["request_id"],
+            "session_id": request.get("session_id") or "unknown",
+            "deployment_id": request.get("deployment_id") or "unknown",
+            "seq": request.get("seq"),
+            "src": request.get("src") or {},
+            "user": str(self.user.get("username") or "root"),
+            "uid": int(self.user.get("uid", 0)),
+            "gid": int(self.user.get("gid", 0)),
+            "cwd": self.cwd,
+            "argv": list(self.mirage_argv),
+            "input": " ".join(self.mirage_argv),
+            "interactive": bool(request.get("interactive", True)),
+            "env": self.journal.changed_env(self.shell),
+            "journal_from": sent + 1,
+            "journal_to": self.journal_to,
+            "journal": self.journal.since(sent),
+            "slice": mirage_state.view(self.shell, list(self.mirage_argv), hidden),
+            "budget": dict(self.mirage_budget),
+        }
+
+    def send(self, whole: bool) -> None:
+        assert self.responder is not None
+        # A request's callbacks count only while it is the one in flight: one
+        # that was stopped (the answer is complete, or is being asked again)
+        # has nothing more to say to this command.
+        self.attempt += 1
+        mine = self.attempt
+        self.cancel = self.responder.respond(
+            self.body(whole),
+            lambda rec: self.record(rec) if mine == self.attempt else None,
+            lambda why: self.reply_over(why) if mine == self.attempt else None,
+            self.mirage_budget["deadline_ms"] / 1000.0,
+        )
+
+    # ---------------------------------------------------------------- the reply
+
+    def record(self, rec: dict[str, Any]) -> None:
+        if self.over or self.exited:
+            return
+        kind = rec.get("type")
+        if kind == "out":
+            self.out(rec)
+        elif kind == "end":
+            self.end(rec)
+        elif kind == "abort":
+            reason = str(rec.get("reason") or "abort")[:120]
+            self.stop_reading()
+            if self.shown:
+                self.finish(1, "cut", reason)
+            else:
+                self.fall_back(reason)
+        elif kind == "resync":
+            self.stop_reading()
+            if self.resynced or self.shown:
+                self.fall_back("resync")
+            else:
+                # The responder was restarted: it gets the whole journal, once.
+                self.resynced = True
+                self.send(whole=True)
+        else:
+            self.stop_reading()
+            self.broken("malformed")
+
+    def out(self, rec: dict[str, Any]) -> None:
+        line = rec.get("line")
+        if not isinstance(line, str):
+            self.stop_reading()
+            self.broken("malformed")
+            return
+        if self.first_ms is None:
+            self.first_ms = round((time.monotonic() - self.began) * 1000, 1)
+        self.shown += 1
+        self.write(line + ("" if rec.get("newline") is False else "\n"))
+
+    def end(self, rec: dict[str, Any]) -> None:
+        self.stop_reading()
+        stdout, stderr = rec.get("stdout", ""), rec.get("stderr", "")
+        code, ops = rec.get("exit_code", 0), rec.get("ops") or []
+        well_formed = (
+            isinstance(stdout, str)
+            and isinstance(stderr, str)
+            and isinstance(code, int)
+            and not isinstance(code, bool)
+            and 0 <= code <= 255
+            and isinstance(ops, list)
+        )
+        if not well_formed:
+            self.broken("malformed")
+            return
+        applied = 0
+        if ops:
+            if self.shown:
+                # Lines were shown before the operations came: the responder
+                # broke the contract. Nothing is applied; the answer stops.
+                self.finish(1, "cut", "ops_after_output")
+                return
+            try:
+                applied = len(
+                    mirage_state.apply(self.shell, ops, protected_paths=token_paths(self.protocol))
+                )
+            except mirage_state.Rejected as e:
+                self.fall_back("ops:rejected", detail=str(e)[:200])
+                return
+        # The responder folded the journal it was sent before it answered.
+        self.protocol.mirage_journal_sent = self.journal_to
+        if stdout:
+            if self.first_ms is None:
+                self.first_ms = round((time.monotonic() - self.began) * 1000, 1)
+            self.shown += stdout.count("\n") + (0 if stdout.endswith("\n") else 1)
+            self.write(stdout)
+        if stderr:
+            self.errorWrite(stderr)
+        self.finish(
+            code,
+            "answered",
+            None,
+            rung=str(rec.get("rung") or "")[:16],
+            ops_applied=applied,
+            output_tokens=rec.get("output_tokens"),
+        )
+
+    def reply_over(self, reason: str | None) -> None:
+        """The reply ended without an ``end`` or ``abort`` record, or could
+        not be had at all."""
+        if self.over or self.exited:
+            return
+        self.broken(reason or "truncated")
+
+    def broken(self, reason: str) -> None:
+        if self.shown:
+            self.finish(1, "cut", reason)
+        else:
+            self.fall_back(reason)
+
+    def stop_reading(self) -> None:
+        self.attempt += 1
+        cancel, self.cancel = self.cancel, None
+        if cancel is not None:
+            cancel("done")
+
+    # ---------------------------------------------------------------- endings
+
+    def report(self, outcome: str, reason: str | None, **fields: Any) -> None:
+        self.protocol.events.dispatch(
+            "cowrie.mirage.respond",
+            "Responder %(outcome)s for %(input)s",
+            input=" ".join(self.mirage_argv),
+            outcome=outcome,
+            reason=reason,
+            request_id=self.mirage_request["request_id"],
+            seq=self.mirage_request.get("seq"),
+            lines=self.shown,
+            first_ms=self.first_ms,
+            total_ms=round((time.monotonic() - self.began) * 1000, 1),
+            **{k: v for k, v in fields.items() if v is not None},
+        )
+
+    def finish(self, code: int, outcome: str, reason: str | None, **fields: Any) -> None:
+        if self.over:
+            return
+        self.over = True
+        self.report(outcome, reason, exit_code=code, **fields)
+        self.exit(code)
+
+    def fall_back(self, reason: str, **fields: Any) -> None:
+        """No answer, and nothing shown: run what the emulator would have."""
+        if self.over:
+            return
+        self.over = True
+        self.report("fallback", reason, **fields)
+        if self.mirage_fallback is not None:
+            self.exec_command(self.pp, self.mirage_fallback, *self.args)
+            return
+        self.errorWrite(self.shell.command_not_found_message(self.mirage_argv[0]))
+        self.exit(127)
+
+    def handle_CTRL_C(self) -> None:
+        # Closing the connection is how the responder learns: it stops the
+        # model and writes the answer down as cancelled.
+        self.stop_reading()
+        self.write("^C\n")
+        self.finish(130, "cancelled", None)
+
+    def connectionLost(self) -> None:
+        self.stop_reading()
+        super().connectionLost()
