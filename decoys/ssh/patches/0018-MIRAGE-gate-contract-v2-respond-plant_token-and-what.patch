+def plant(request: dict[str, Any]) -> dict[str, Any]:
+    if request["argv"][0] == "ls" and "plant_token" in request["supports"]:
+        ops = [{"op": "write", "path": "/root/.my.cnf", "content": "[client]\nuser=dbbackup\n", "mode": 0o600}]
+        return {"action": "plant_token", "decision_id": "d-plant", "ops": ops}
+    return respond(request)
