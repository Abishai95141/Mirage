+++ b/src/cowrie/commands/mirage_accounts.py
@@ -0,0 +1,297 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE: passwd and chpasswd as Debian 12's shadow 4.13 runs them, with
+# ABOUTME: a change that is remembered for the source that made it.
+
+"""passwd and chpasswd.
+
+Stock Cowrie's ``passwd`` asked in the words of an older release ("Enter new
+UNIX password:"), accepted a name that is no account, and changed nothing;
+its ``chpasswd`` logged the attempt and said nothing either way. Both answer
+here as the reference host does, and a change that is told as done is kept
+(``cowrie.mirage_credentials``): the same source can log in with what it set.
+"""
+
+from __future__ import annotations
+
+import getopt
+import random
+import time
+from typing import Any
+
+from cowrie import mirage_credentials
+from cowrie.commands.mirage_coreutils import Declining, Users
+from cowrie.shell import fs as cfs
+
+commands = {}
+
+FAILED = "passwd: Authentication token manipulation error\npasswd: password unchanged\n"
+CHPASSWD_USAGE = """Usage: chpasswd [options]
+
+Options:
+  -c, --crypt-method METHOD     the crypt method (one of NONE DES MD5 SHA256 SHA512 YESCRYPT)
+  -e, --encrypted               supplied passwords are encrypted
+  -h, --help                    display this help message and exit
+  -m, --md5                     encrypt the clear text password using
+                                the MD5 algorithm
+  -R, --root CHROOT_DIR         directory to chroot into
+  -s, --sha-rounds              number of rounds for the SHA, BCRYPT
+                                or YESCRYPT crypt algorithms
+
+"""
+_HASH_LETTERS = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
+
+
+def note_in_shadow(command: Any, username: str) -> None:
+    """Give the account a new entry in this session's /etc/shadow, as a
+    change does: another hash, and today as the day it was changed. The hash
+    has yescrypt's form and is not one: nothing here could check it, and the
+    file is root's to read."""
+    fs = command.fs
+    try:
+        lines = fs.file_contents("/etc/shadow").decode("utf8", "replace").split("\n")
+    except Exception:
+        return
+    salt = "".join(random.choice(_HASH_LETTERS) for _ in range(22))
+    body = "".join(random.choice(_HASH_LETTERS) for _ in range(43))
+    for index, line in enumerate(lines):
+        fields = line.split(":")
+        if len(fields) >= 3 and fields[0] == username:
+            fields[1] = f"$y$j9T${salt}${body}"
+            fields[2] = str(int(time.time() // 86400))
+            lines[index] = ":".join(fields)
+            break
+    else:
+        return
+    content = "\n".join(lines).encode("utf8")
+    try:
+        fs.update_size("/etc/shadow", len(content))
+        node = fs.getfile("/etc/shadow")
+        node[cfs.A_CONTENTS] = content
+        node[cfs.A_REALFILE] = None
+    except Exception:
+        return
+
+
+class _Account(Declining):
+    def may_change(self, username: str) -> bool:
+        return int(self.user["uid"]) == 0 or str(self.user["username"]) == username
+
+    def keep(self, username: str, password: str) -> None:
+        """The change is done: for this source, and in this session's shadow."""
+        source = getattr(self.protocol, "realClientIP", None)
+        mirage_credentials.changed(source, username, password)
+        note_in_shadow(self, username)
+        self.protocol.events.dispatch(
+            "cowrie.mirage.credential",
+            "Password of %(username)s changed",
+            username=username,
+            password=password,
+            realm=self.name,
+        )
+
+
+class Command_passwd(_Account):
+    name = "passwd"
+    program = "/usr/bin/passwd"
+    consumes_stdin = True
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        # Status, locking, expiry and the rest are the real program's.
+        return any(a.startswith("-") for a in args) or len(args) > 1
+
+    def start(self) -> None:
+        self.asking: str | None = None
+        self.tries = 0
+        self.first = ""
+        if self.mirage_declines(self.args):
+            self.not_emulated()
+            self.exit()
+            return
+        me = str(self.user["username"])
+        self.login = self.args[0] if self.args else me
+        if Users().entry(self.login) is None:
+            self.errorWrite(f"passwd: user '{self.login}' does not exist\n")
+            self.exit(1)
+            return
+        if not self.may_change(self.login):
+            self.errorWrite(
+                f"passwd: You may not view or modify password information for {self.login}.\n"
+            )
+            self.exit(1)
+            return
+        # Lines already waiting on a pipe, or the terminal, one at a time.
+        self.waiting = None
+        if self.input_data is not None or getattr(self.pp, "stdin_from_pipe", False):
+            self.waiting = (self.input_data or b"").decode("utf8", "replace").split("\n")
+            if self.waiting and self.waiting[-1] == "":
+                self.waiting.pop()
+        if int(self.user["uid"]) != 0:
+            self.write(f"Changing password for {self.login}.\n")
+            self.ask("current", "Current password: ")
+        else:
+            self.ask("new", "New password: ")
+        self.drain()
+
+    def ask(self, what: str, prompt: str) -> None:
+        self.asking = what
+        self.errorWrite(prompt)
+        if self.waiting is None:
+            self.protocol.password_input = True  # typed, not echoed
+
+    def drain(self) -> None:
+        """Answer the prompts from piped input, as far as it goes."""
+        while self.waiting is not None and not self.exited:
+            if not self.waiting:
+                self.ended()
+                return
+            self.answer(self.waiting.pop(0))
+
+    def lineReceived(self, line: str) -> None:
+        typed = line.rstrip("\n")
+        self.protocol.events.dispatch(
+            "cowrie.command.input", "INPUT (%(realm)s): %(input)s", realm="passwd", input=typed
+        )
+        if self.waiting is None:
+            self.errorWrite("\n")  # the newline the terminal did not echo
+        self.answer(typed)
+
+    def answer(self, typed: str) -> None:
+        if self.asking == "current":
+            self.ask("new", "New password: ")
+        elif self.asking == "new":
+            self.first = typed
+            self.ask("again", "Retype new password: ")
+        elif self.asking == "again":
+            if typed != self.first:
+                self.errorWrite("Sorry, passwords do not match.\n" + FAILED)
+                self.done(10)
+            elif not typed:
+                self.errorWrite("No password has been supplied.\n")
+                self.tries += 1
+                if self.tries >= 3:
+                    self.errorWrite(FAILED)
+                    self.done(10)
+                else:
+                    self.ask("new", "New password: ")
+            else:
+                self.keep(self.login, typed)
+                self.errorWrite("passwd: password updated successfully\n")
+                self.done(0)
+
+    def ended(self) -> None:
+        """The input ran out before the prompts did."""
+        if self.exited:
+            return
+        if self.asking == "new" and self.tries:
+            self.errorWrite("Password change has been aborted.\n")
+        self.errorWrite(FAILED)
+        self.done(10)
+
+    def done(self, code: int) -> None:
+        self.protocol.password_input = False
+        self.exit(code)
+
+    def eofReceived(self) -> None:
+        self.ended()
+
+    def handle_CTRL_D(self) -> None:
+        self.ended()
+
+    def handle_CTRL_C(self) -> None:
+        self.protocol.password_input = False
+        self.errorWrite("\n")
+        self.exit(130)
+
+
+class Command_chpasswd(_Account):
+    name = "chpasswd"
+    program = "/usr/sbin/chpasswd"
+    consumes_stdin = True
+    SHORT = "c:ehmR:s:"
+    LONG = ("crypt-method=", "encrypted", "help", "md5", "root=", "sha-rounds=")
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        try:
+            opts, _ = getopt.getopt(args, cls.SHORT, list(cls.LONG))
+        except getopt.GetoptError:
+            return False  # the usage error is answered here
+        # A password given already hashed cannot be checked at the next login,
+        # and a chroot is another filesystem.
+        return any(o in ("-e", "--encrypted", "-R", "--root", "-h", "--help") for o, _ in opts)
+
+    def start(self) -> None:
+        self.line = 0
+        self.failed = False
+        if self.mirage_declines(self.args):
+            self.not_emulated()
+            self.exit()
+            return
+        try:
+            getopt.getopt(self.args, self.SHORT, list(self.LONG))
+        except getopt.GetoptError as err:
+            from cowrie.commands.mirage_fileutils import option_error
+
+            self.errorWrite(option_error("chpasswd", err) + CHPASSWD_USAGE)
+            self.exit(2)
+            return
+        self.users = Users()
+        if self.input_data is not None or getattr(self.pp, "stdin_from_pipe", False):
+            for line in (self.input_data or b"").decode("utf8", "replace").splitlines():
+                self.take(line)
+            self.finish()
+
+    def lineReceived(self, line: str) -> None:
+        typed = line.rstrip("\n")
+        self.protocol.events.dispatch(
+            "cowrie.command.input", "INPUT (%(realm)s): %(input)s", realm="chpasswd", input=typed
+        )
+        self.take(typed)
+
+    def take(self, line: str) -> None:
+        self.line += 1
+        if not line:
+            return
+        username, sep, password = line.partition(":")
+        if not sep:
+            self.errorWrite(f"chpasswd: line {self.line}: missing new password\n")
+            self.failed = True
+            return
+        self.protocol.events.dispatch(
+            "cowrie.command.chpasswd",
+            "Password change attempt for %(username)s",
+            realm="chpasswd",
+            username=username,
+        )
+        known = self.users.entry(username) is not None
+        if known and self.may_change(username) and not password:
+            self.errorWrite("No password has been supplied.\n" * 3)
+        if not known or not password or not self.may_change(username):
+            self.errorWrite(
+                f"chpasswd: (user {username}) pam_chauthtok() failed, error:\n"
+                "Authentication token manipulation error\n"
+                f"chpasswd: (line {self.line}, user {username}) password not changed\n"
+            )
+            self.failed = True
+            return
+        self.keep(username, password)
+
+    def finish(self) -> None:
+        if not self.exited:
+            self.exit(1 if self.failed else 0)
+
+    def eofReceived(self) -> None:
+        self.finish()
+
+    def handle_CTRL_D(self) -> None:
+        self.finish()
+
+
+commands["passwd"] = Command_passwd
+commands["/usr/bin/passwd"] = Command_passwd
+commands["/bin/passwd"] = Command_passwd
+commands["chpasswd"] = Command_chpasswd
+commands["/usr/sbin/chpasswd"] = Command_chpasswd
+commands["/sbin/chpasswd"] = Command_chpasswd
+
