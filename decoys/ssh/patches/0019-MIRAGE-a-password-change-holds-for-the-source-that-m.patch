+class LoginTests(Base):
+    """A credential change holds for its source, and only for its source."""
+
+    def login(self, source: str, user: str, password: str) -> bool:
+        checker = checkers.HoneypotPasswordChecker()
+        return bool(checker.checkUserPass(user.encode(), password.encode(), source, None))
+
+    def change(self, source: str, line: str) -> None:
+        proto = HoneyPotInteractiveProtocol(FakeAvatar(FakeServer()))
+        tr = FakeTransport("", "40000")
+        proto.makeConnection(tr)
+        proto.realClientIP = source  # the fake transport's peer is always the same
+        proto.lineReceived(line.encode() + b"\n")
+        proto.connectionLost()
+
+    def test_the_new_password_works_and_the_old_does_not(self) -> None:
+        old = "an-old-password"  # whether the deployment's list lets it in or not
+        self.change("203.0.113.9", "echo 'root:Rotated-2026!' | chpasswd")
+        self.assertTrue(self.login("203.0.113.9", "root", "Rotated-2026!"))
+        self.assertFalse(self.login("203.0.113.9", "root", old))
+        self.assertFalse(self.login("203.0.113.9", "root", "Rotated-2026"))
+
