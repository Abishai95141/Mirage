@@ -0,0 +1,218 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: Tests MIRAGE's passwd and chpasswd against what Debian 12 prints, and that
+# ABOUTME: a password change holds at the next login for the source that made it.
+
+from __future__ import annotations
+
+import os
+import tempfile
+import unittest
+from typing import Any
+
+from cowrie import mirage_credentials, mirage_gate
+from cowrie.core import checkers
+from cowrie.shell.protocol import HoneyPotInteractiveProtocol
+from cowrie.test.eventcapture import capture_eventlog
+from cowrie.test.fake_server import FakeAvatar, FakeServer
+from cowrie.test.fake_transport import FakeTransport
+from cowrie.test.test_mirage_stderr import run_exec
+
+os.environ["COWRIE_HONEYPOT_DATA_PATH"] = "data"
+os.environ["COWRIE_HONEYPOT_DOWNLOAD_PATH"] = tempfile.gettempdir()
+os.environ["COWRIE_SHELL_FILESYSTEM"] = "src/cowrie/data/fs.pickle"
+
+PROMPT = b"root@unitTest:~# "
+FAILED = "passwd: Authentication token manipulation error\npasswd: password unchanged\n"
+PAM = (
+    "chpasswd: (user {u}) pam_chauthtok() failed, error:\n"
+    "Authentication token manipulation error\n"
+    "chpasswd: (line {n}, user {u}) password not changed\n"
+)
+
+
+def run(cmd: str) -> tuple[str, str]:
+    out, err = run_exec(cmd.encode())
+    return out.decode(), err.decode()
+
+
+class Base(unittest.TestCase):
+    def setUp(self) -> None:
+        mirage_gate.reset_for_tests(None)
+        mirage_credentials.reset_for_tests()
+
+    def tearDown(self) -> None:
+        mirage_gate.reset_for_tests()
+        mirage_credentials.reset_for_tests()
+
+
+class PiperTests(Base):
+    """The lines the reference host printed for the same command lines (an
+    exec request, the prompts answered from a pipe)."""
+
+    def test_passwd_changes_and_says_so(self) -> None:
+        self.assertEqual(
+            run("printf 'x1Y2z3!!aa\\nx1Y2z3!!aa\\n' | passwd root; echo $?"),
+            ("0\n", "New password: Retype new password: passwd: password updated successfully\n"),
+        )
+
+    def test_passwd_refuses_what_does_not_match_or_is_empty(self) -> None:
+        self.assertEqual(
+            run("printf 'x1Y2z3!!aa\\ndifferent99\\n' | passwd root; echo $?"),
+            ("10\n", "New password: Retype new password: Sorry, passwords do not match.\n" + FAILED),
+        )
+        self.assertEqual(
+            run("printf '\\n\\n' | passwd root; echo $?"),
+            (
+                "10\n",
+                "New password: Retype new password: No password has been supplied.\n"
+                "New password: Password change has been aborted.\n" + FAILED,
+            ),
+        )
+
+    def test_passwd_for_no_such_account(self) -> None:
+        self.assertEqual(
+            run("passwd nosuchuser; echo $?"), ("1\n", "passwd: user 'nosuchuser' does not exist\n")
+        )
+
+    def test_chpasswd(self) -> None:
+        self.assertEqual(run("echo 'root:n3wPass-word' | chpasswd; echo $?"), ("0\n", ""))
+        self.assertEqual(run("chpasswd < /dev/null; echo $?"), ("0\n", ""))
+        self.assertEqual(
