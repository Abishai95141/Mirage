diff --git a/src/cowrie/mirage_credentials.py b/src/cowrie/mirage_credentials.py
new file mode 100644
index 0000000..fa16c9e
--- /dev/null
+++ b/src/cowrie/mirage_credentials.py
@@ -0,0 +1,75 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE: a password change holds for the source that made it. Remembers
+# ABOUTME: what each source set, so that its next login is judged by that.
+
+"""A password an intruder sets is the password they come back with.
+
+Stock Cowrie says "password updated successfully" and forgets it: the next
+login with the new password is judged by the same static list as any other,
+and usually refused. Anyone who changes a password and logs in again to check
+(the first thing a person does, and what every credential-rotation script
+does) sees a host that said one thing and did another.
+
+Here a change that was answered as done is remembered for the address it
+came from. That source's later logins to that account succeed with the new
+password and with nothing else. Every other source is judged as before: the
+change is not a way to open the account to the world, and a stranger who
+tries the new password is refused as they would have been.
+
+Held in memory, in this process: for as long as the decoy runs, for the most
+recent sources. The password itself is not kept, only a digest of it.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+import os
+import time
+from collections import OrderedDict
+
+MAX_HELD = 4096
+HELD_FOR_S = 30 * 86400
+
+_key = os.urandom(32)  # the digests mean nothing outside this process
+_held: OrderedDict[tuple[str, str], tuple[bytes, float]] = OrderedDict()
+
+
+def _digest(password: bytes) -> bytes:
+    return hmac.new(_key, password, hashlib.sha256).digest()
+
+
+def _bytes(value: str | bytes) -> bytes:
+    return value if isinstance(value, bytes) else value.encode("utf8", "surrogateescape")
+
+
+def changed(src_ip: str | None, username: str | bytes, password: str | bytes) -> None:
+    """``src_ip`` set ``username``'s password, and was told it was done."""
+    if not src_ip:
+        return
+    key = (src_ip, _bytes(username).decode("utf8", "replace"))
+    _held.pop(key, None)
+    _held[key] = (_digest(_bytes(password)), time.time())
+    while len(_held) > MAX_HELD:
+        _held.popitem(last=False)
+
+
+def verdict(src_ip: str | None, username: str | bytes, password: str | bytes) -> bool | None:
+    """Whether this login succeeds, if this source changed this account's
+    password: True for the password it set, False for any other. None if it
+    changed nothing, and the ordinary rules decide."""
+    if not src_ip:
+        return None
+    key = (src_ip, _bytes(username).decode("utf8", "replace"))
+    held = _held.get(key)
+    if held is None:
+        return None
+    digest, when = held
+    if time.time() - when > HELD_FOR_S:
+        del _held[key]
+        return None
+    return hmac.compare_digest(digest, _digest(_bytes(password)))
+
+
+def reset_for_tests() -> None:
+    _held.clear()
