+class SsSessionTests(NetBase):
+    def setUp(self) -> None:
+        super().setUp()
+        mirage_ps.reset_for_tests(with_sockets(LISTENING), True)
+        self.no_terminal()
+        self.proto.kippoIP = "10.2.117.32"
+        self.proto.clientIP = "203.0.113.9"
+        self.proto.realClientPort = 40022
+
+    def test_the_processes_named_are_the_ones_ps_shows(self) -> None:
+        shown = self.text("ss -tlnp")
+        named = {
+            (m[0], int(m[1])) for m in re.findall(r'\("([^"]+)",pid=(\d+),', shown)
+        }
+        running = {(p["comm"], p["pid"]) for p in TABLE["processes"]}
+        self.assertTrue(named)
+        self.assertLessEqual(named - {("nginx", 396)}, running)
+
+    def test_a_socket_s_holders_are_listed_newest_first(self) -> None:
+        self.assertIn(
+            'users:(("nginx",pid=397,fd=5),("nginx",pid=396,fd=5))',
+            self.text("ss -tlnp"),
+        )
+
+    def test_the_session_s_own_connection_is_there_and_ps_agrees(self) -> None:
+        line = self.text("ss -Htnp")
+        self.assertRegex(
+            line,
+            r'^ESTAB 0 +0 +10\.2\.117\.32:22 +203\.0\.113\.9:40022 +users:\(\("sshd",pid=\d+,fd=4\)\)\n$',
+        )
+        pid = re.search(r"pid=(\d+)", line).group(1)  # type: ignore[union-attr]
+        own = [
+            row for row in self.text("ps -ef").splitlines() if "sshd: root@notty" in row
+        ]
+        self.assertEqual([row.split()[1] for row in own], [pid])
+
+    def test_someone_who_is_not_root_is_shown_only_their_own_processes(self) -> None:
+        shell = self.proto.cmdstack[0]
+        shell.user = {**shell.user, "username": "www-data", "uid": 33}
+        listening = self.text("ss -tlnp")
+        self.assertRegex(
+            listening,
+            r'0\.0\.0\.0:80 +0\.0\.0\.0:\* +users:\(\("nginx",pid=397,fd=5\)\)\n',
+        )
+        self.assertNotIn("mariadbd", listening)
+        self.assertNotIn('"sshd"', listening)
+        # Their connection is held by their own sshd and by root's: they see their own.
+        own = re.findall(r"pid=(\d+)", self.text("ss -Htnp"))
+        self.assertEqual(len(own), 1)
+
+    def test_all_states_put_the_connection_after_the_listeners_of_its_family(
+        self,
+    ) -> None:
+        states = [line.split()[0] for line in self.text("ss -Htan").splitlines()]
+        self.assertEqual(states, ["LISTEN", "LISTEN", "LISTEN", "ESTAB", "LISTEN"])
+
+    def test_one_state_asked_for_by_name_drops_the_state_column(self) -> None:
+        self.assertTrue(
+            self.text("ss -tn state established").startswith("Recv-Q Send-Q ")
+        )
+        self.assertTrue(
+            self.text("ss -tan state listening").startswith("Recv-Q Send-Q ")
+        )
+        self.assertTrue(
+            self.text("ss -tan state connected").startswith("State Recv-Q ")
+        )
+
+    def test_the_summary_counts_the_table_s_sockets_and_the_connection(self) -> None:
+        self.assertEqual(
+            self.text("ss -s"),
+            "Total: 99\n"
+            "TCP:   5 (estab 1, closed 0, orphaned 0, timewait 0)\n"
+            "\n"
+            "Transport Total     IP        IPv6\n"
+            "RAW\t  1         0         1        \n"
+            "UDP\t  1         1         0        \n"
+            "TCP\t  5         4         1        \n"
+            "INET\t  7         5         2        \n"
+            "FRAG\t  0         0         0        \n"
+            "\n",
+        )
+
+    def test_the_summary_has_the_guest_s_form(self) -> None:
+        guest = RECORDED["guest"]["summary"]
+        mine = self.text("ss -s")
+        self.assertEqual(re.sub(r"\d+ *", "N ", mine), re.sub(r"\d+ *", "N ", guest))
+
+    def test_help_version_and_what_ss_refuses(self) -> None:
+        self.assertEqual(self.text("ss -V"), "ss utility, iproute2-6.1.0\n")
+        self.assertTrue(self.text("ss -h; echo $?").endswith("listening|closing}\n0\n"))
+        said = self.text("ss -q; echo $?")
+        self.assertTrue(
+            said.startswith("ss: invalid option -- 'q'\nUsage: ss [ OPTIONS ]\n")
+        )
+        self.assertTrue(said.endswith("\n255\n"))
+        self.assertTrue(
+            self.text("ss --nosuch").startswith("ss: unrecognized option '--nosuch'\n")
+        )
+        self.assertEqual(
+            self.text("ss -tn state nosuch; echo $?"),
+            "ss: wrong state name: nosuch\n255\n",
+        )
+
+    def test_what_is_not_emulated_is_declined_and_says_so_if_run(self) -> None:
+        for args in (
+            ["-x", "-l"],
+            ["-tlne"],
+            ["-ln"],
+            [],
+            ["-tli"],
+            ["-tln", "dev", "eth0"],
+        ):
+            self.assertTrue(mirage_netutils.Command_ss.mirage_declines(args), args)
+        for args in (
+            ["-tlnp"],
+            ["-tuln"],
+            ["-s"],
+            ["-tan", "state", "listening"],
+            ["-q"],
+        ):
+            self.assertFalse(mirage_netutils.Command_ss.mirage_declines(args), args)
+        self.assertEqual(
+            self.text("ss -x; echo $?"),
+            "-bash: /usr/bin/ss: cannot execute binary file: Exec format error\n126\n",
+        )
+
+    def test_without_a_socket_record_ss_is_not_emulated(self) -> None:
+        mirage_ps.reset_for_tests(TABLE, True)
+        self.assertTrue(mirage_netutils.Command_ss.mirage_declines(["-tlnp"]))
+
