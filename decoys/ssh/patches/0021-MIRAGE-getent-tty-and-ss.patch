+# ABOUTME: MIRAGE: getent, tty and ss, which stock Cowrie does not have: the
+# ABOUTME: accounts and names of the session's own files, and what listens here.
+
+"""``getent`` (glibc 2.36), ``tty`` (coreutils 9.1) and ``ss`` (iproute2 6.1) as
+Debian 12 runs them.
+
+All three are among the first things typed on a host that has just been
+entered, and stock Cowrie has none of them. Each answers from what the session
+can already see some other way, so that the answers agree: ``getent`` from the
+files ``cat`` shows, ``ss`` from the processes ``ps`` shows, ``tty`` from
+whether the session has a terminal.
+
+The texts and the table's layout were recorded on the reference host and on a
+real guest (the fixtures of ``test_mirage_netutils``).
+"""
+
+from __future__ import annotations
+
+import getopt
+import ipaddress
+from typing import Any
+
+from cowrie.commands import mirage_ps
+from cowrie.commands.mirage_coreutils import Declining, on_terminal, terminal_width
+from cowrie.core.config import CowrieConfig
+from cowrie.shell.command import HoneyPotCommand
+
+commands: dict[str, Any] = {}
+
