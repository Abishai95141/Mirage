+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: Tests MIRAGE's getent, tty and ss against what the reference host and
+# ABOUTME: a real guest printed, and that ss names the processes ps shows.
+
+from __future__ import annotations
+
+import copy
+import json
+import re
+from pathlib import Path
+from typing import Any
+
+from cowrie.commands import mirage_netutils, mirage_ps
+from cowrie.test.test_mirage_gate import PROMPT
+from cowrie.test.test_mirage_ps import TABLE, Base
+
+RECORDED = json.loads((Path(__file__).parent / "mirage_ss_reference.json").read_text())
+HOSTS = (
+    "127.0.0.1\\tlocalhost\\n::1\\tlocalhost ip6-localhost ip6-loopback\\n"
+    "fe00::\\tip6-localnet\\nff00::\\tip6-mcastprefix\\nff02::1\\tip6-allnodes\\n"
+    "ff02::2\\tip6-allrouters\\n172.26.0.1\\tweb01\\n"
+)
+
+
+def with_sockets(listening: list[dict[str, Any]], **more: Any) -> dict[str, Any]:
+    doc = copy.deepcopy(TABLE)
+    doc["sockets"] = {"listening": listening, "total": 98, "raw": [1, 0, 1], **more}
+    return doc
+
+
+class NetBase(Base):
+    def text(self, line: str) -> str:
+        return self.run_line(line).decode()[: -len(PROMPT.decode())]
+
+
+class SsRecordedTests(NetBase):
+    """Each recorded command line, with the sockets the host had when it was recorded."""
+
+    def test_piped_output_is_the_reference_host_s_byte_for_byte(self) -> None:
+        self.no_terminal()
+        for case in RECORDED["cases"]:
+            if case["width"]:
+                continue
+            with self.subTest(cmd=case["cmd"], sockets=case["set"]):
+                mirage_ps.reset_for_tests(
+                    with_sockets(RECORDED["sets"][case["set"]]), True
+                )
+                self.assertEqual(
+                    self.text(case["cmd"]), case["stdout"] + case["stderr"]
+                )
+
+    def test_on_a_terminal_the_columns_spread_as_the_reference_host_s_do(self) -> None:
+        for case in RECORDED["cases"]:
+            if not case["width"]:
+                continue
+            with self.subTest(cmd=case["cmd"], width=case["width"]):
+                mirage_ps.reset_for_tests(
+                    with_sockets(RECORDED["sets"][case["set"]]), True
+                )
+                self.proto.user.windowSize = [24, case["width"]]
+                self.assertEqual(self.text(case["cmd"]), case["stdout"])
+
+    def test_a_real_guest_s_sockets_print_as_the_guest_printed_them(self) -> None:
+        self.no_terminal()
+        guest = RECORDED["guest"]
+        mirage_ps.reset_for_tests(with_sockets(guest["sockets"]), True)
+        for case in guest["cases"]:
+            with self.subTest(cmd=case["cmd"]):
+                self.assertEqual(self.text(case["cmd"]), case["stdout"])
+
+
+LISTENING = [
+    {"netid": "udp", "state": "UNCONN", "recv_q": 0, "send_q": 0, "local": "10.2.117.32%ens3",
+     "port": 68, "peer": "0.0.0.0", "v6": False, "comm": "systemd-network", "fd": 18,
+     "pids": [263]},
+    {"netid": "tcp", "state": "LISTEN", "recv_q": 0, "send_q": 80, "local": "0.0.0.0",
+     "port": 3306, "peer": "0.0.0.0", "v6": False, "comm": "mariadbd", "fd": 20, "pids": [393]},
+    {"netid": "tcp", "state": "LISTEN", "recv_q": 0, "send_q": 128, "local": "0.0.0.0",
+     "port": 22, "peer": "0.0.0.0", "v6": False, "comm": "sshd", "fd": 3, "pids": [382]},
+    {"netid": "tcp", "state": "LISTEN", "recv_q": 0, "send_q": 511, "local": "0.0.0.0",
+     "port": 80, "peer": "0.0.0.0", "v6": False, "comm": "nginx", "fd": 5, "pids": [396, 397]},
+    {"netid": "tcp", "state": "LISTEN", "recv_q": 0, "send_q": 128, "local": "[::]",
+     "port": 22, "peer": "[::]", "v6": True, "comm": "sshd", "fd": 4, "pids": [382]},
+]  # fmt: skip
