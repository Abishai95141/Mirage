diff --git a/src/cowrie/commands/mirage_ps.py b/src/cowrie/commands/mirage_ps.py
new file mode 100644
index 0000000..053503f
--- /dev/null
+++ b/src/cowrie/commands/mirage_ps.py
@@ -0,0 +1,397 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE: ps from the deployment's own process list, in procps-ng 4's
+# ABOUTME: formats. Stock ps printed one fixed list, with headers no real ps has.
+
+"""``ps`` as procps-ng 4.0 prints it on Debian 12, for the forms people type:
+``ps``, ``ps -e``, ``ps -ef``, ``ps aux``, ``ps ax``, ``ps x``, and selection by
+``-p``, ``-u`` and ``-C``.
+
+The processes are the deployment's (``[mirage] processes``, a file the profile
+generator writes from the hardware class's own record and the profile's
+services), plus this session's: its sshd, its shell when it has a terminal,
+and the ps itself. Without that file the stock command answers, as before.
+
+Processor time is a model, as /proc/stat is: a machine that has been idle since
+boot, with a small steady rate for the daemons that tick.
+"""
+
+from __future__ import annotations
+
+import json
+import time
+from typing import Any, ClassVar
+
+from cowrie.commands.base import Command_ps as StockPs
+from cowrie.commands.mirage_coreutils import on_terminal, terminal_width
+from cowrie.core.config import CowrieConfig
+from cowrie.shell.pwd import Passwd
+
+commands: dict[str, Any] = {}
+
+# Processor seconds a day, for the daemons that are never quite idle.
+CPU_SECONDS_A_DAY = {
+    "systemd": 1.5,
+    "systemd-journal": 0.4,
+    "mariadbd": 35.0,
+    "redis-server": 80.0,
+}
+
+_table: dict[str, Any] | None = None
+_loaded = False
+
+
+def table() -> dict[str, Any] | None:
+    """The deployment's process list, read once; None when there is none."""
+    global _table, _loaded
+    if not _loaded:
+        _loaded = True
+        path = CowrieConfig.get("mirage", "processes", fallback="")
+        if path:
+            try:
+                with open(path, encoding="utf-8") as f:
+                    doc = json.load(f)
+                if doc.get("version") == 1 and doc.get("processes"):
+                    _table = doc
+            except (OSError, ValueError):
+                _table = None
+    return _table
+
+
+def reset_for_tests(doc: dict[str, Any] | None = None, loaded: bool = False) -> None:
+    global _table, _loaded
+    _table, _loaded = doc, loaded
+
+
+class Selection:
+    """What a ps command line asks for. ``unknown`` holds what this does not take."""
+
+    def __init__(self, args: list[str]) -> None:
+        self.everyone = False  # -e, -A, or BSD a with x
+        self.with_tty = False  # BSD a
+        self.own_any_tty = False  # BSD x
+        self.full = False  # -f
+        self.user_format = False  # BSD u
+        self.bsd = False
+        self.header = True
+        self.wide = 0
+        self.pids: list[int] | None = None
+        self.users: list[str] | None = None
+        self.names: list[str] | None = None
+        self.unknown: list[str] = []
+        rest = list(args)
+        while rest:
+            arg = rest.pop(0)
+            if arg.startswith("--"):
+                name, _, value = arg[2:].partition("=")
+                if name in ("no-headers", "no-heading"):
+                    self.header = False
+                elif name in ("pid", "user", "User") and (value or rest):
+                    self._select("p" if name == "pid" else "u", value or rest.pop(0))
+                else:
+                    self.unknown.append(arg)
+            elif arg.startswith("-") and "x" in arg and set(arg[1:]) <= set("auxw"):
+                # `ps -aux`: with no user called x, procps reads it as `ps aux`.
+                self._bsd(arg[1:])
+            elif arg.startswith("-") and len(arg) > 1:
+                letters = arg[1:]
+                while letters:
+                    letter, letters = letters[0], letters[1:]
+                    if letter in "eA":
+                        self.everyone = True
+                    elif letter == "a":
+                        self.with_tty = True
+                    elif letter == "f":
+                        self.full = True
+                    elif letter == "w":
+                        self.wide += 1
+                    elif letter in "puUC":
+                        value = letters or (rest.pop(0) if rest else "")
+                        letters = ""
+                        if not value:
+                            self.unknown.append(arg)
+                        else:
+                            self._select(letter, value)
+                    else:
+                        self.unknown.append(arg)
+                        letters = ""
+            elif set(arg) <= set("auxwh"):
+                self._bsd(arg)
+            else:
+                self.unknown.append(arg)
+
+    def _bsd(self, letters: str) -> None:
+        self.bsd = True
+        for letter in letters:
+            if letter == "a":
+                self.with_tty = True
+            elif letter == "x":
+                self.own_any_tty = True
+            elif letter == "u":
+                self.user_format = True
+            elif letter == "w":
+                self.wide += 1
+            elif letter == "h":
+                self.header = False
+
+    def _select(self, kind: str, value: str) -> None:
+        items = [v for v in value.replace(",", " ").split() if v]
+        if kind == "p":
+            if not all(i.isdigit() for i in items):
+                self.unknown.append(value)
+                return
+            self.pids = (self.pids or []) + [int(i) for i in items]
+        elif kind in "uU":
+            self.users = (self.users or []) + items
+        else:
+            self.names = (self.names or []) + items
+
+
+def clock(seconds: float) -> str:
+    """Processor time as the UNIX formats show it: [DD-]HH:MM:SS."""
+    total = int(seconds)
+    days, rest = divmod(total, 86400)
+    text = f"{rest // 3600:02d}:{rest % 3600 // 60:02d}:{rest % 60:02d}"
+    return f"{days}-{text}" if days else text
+
+
+def bsd_clock(seconds: float) -> str:
+    """Processor time as the BSD formats show it: minutes and seconds."""
+    total = int(seconds)
+    return f"{total // 60}:{total % 60:02d}"
+
+
+def started(when: float, now: float) -> str:
+    """When a process started: the time within a day, the date within the year, else the year."""
+    then, today = time.localtime(when), time.localtime(now)
+    if now - when < 86400:
+        return time.strftime("%H:%M", then)
+    if then.tm_year == today.tm_year:
+        return time.strftime("%b%d", then)
+    return str(then.tm_year)
+
+
+def row(cells: list[tuple[str, int, str]]) -> str:
+    """One line of columns. A value wider than its column takes the room back
+    from the padding of the columns after it, as procps does."""
+    out, debt = [], 0
+    for text, width, align in cells:
+        if width <= 0:
+            out.append(text)
+            continue
+        pad = width - len(text)
+        if pad < 0:
+            debt += -pad
+            pad = 0
+        elif debt:
+            give = min(debt, pad)
+            pad, debt = pad - give, debt - give
+        out.append(" " * pad + text if align == ">" else text + " " * pad)
+    return " ".join(out).rstrip()
+
+
+class Command_ps(StockPs):
+    name: ClassVar[str] = "ps"
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        return table() is not None and bool(Selection(args).unknown)
+
+    def call(self) -> None:
+        doc = table()
+        if doc is None:
+            StockPs.call(self)
+            return
+        chosen = Selection(self.args)
+        if chosen.unknown:
+            self.errorWrite(
+                f"{self.shell.error_prefix()}/usr/bin/ps: cannot execute binary file: "
+                "Exec format error\n"
+            )
+            self.exit_code = 126
+            return
+        now = time.time()
+        boot = float(self.protocol.boot_time())
+        me = str(self.user["username"])
+        tty = "pts/0" if hasattr(self.protocol.user, "windowSize") else "?"
+        processes = self._everything(doc, boot, now, me, tty)
+        shown = [p for p in processes if self._wanted(p, chosen, me, tty)]
+        lines = [self._header(chosen)] if chosen.header else []
+        lines += [self._line(p, chosen, doc, now) for p in shown]
+        if on_terminal(self) and chosen.wide < 2:
+            limit = 132 if chosen.wide else terminal_width(self)
+            lines = [line[:limit] for line in lines]
+        self.write("".join(line + "\n" for line in lines))
+        if not shown:
+            self.exit_code = 1
+
+    def _everything(
+        self, doc: dict[str, Any], boot: float, now: float, me: str, tty: str
+    ) -> list[dict[str, Any]]:
+        out = []
+        up_days = max(0.0, now - boot) / 86400
+        for p in doc["processes"]:
+            out.append(
+                {
+                    **p,
+                    "began": boot + p["start"],
+                    "cpu_s": CPU_SECONDS_A_DAY.get(p["comm"], 0.0) * up_days,
+                }
+            )
+        login = float(getattr(self.protocol, "logintime", now))
+        shell_pid = int(self.protocol.cmdstack[0].pid) if self.protocol.cmdstack else 0
+        if not shell_pid:
+            shell_pid = self.protocol.next_pid()
+        sshd_pid = shell_pid - 2
+        where = "pts/0" if tty != "?" else "notty"
+        parent = doc["listener_pid"]
+        if me != "root":
+            # A login that is not root's is served by two: one keeps root's rights.
+            out.append(
+                self._own(
+                    "root", sshd_pid - 1, parent, "sshd", f"sshd: {me} [priv]", "?", "Ss", login
+                )
+            )
+            parent = sshd_pid - 1
+        own_stat = "Ss" if me == "root" else "S"
+        out.append(
+            self._own(me, sshd_pid, parent, "sshd", f"sshd: {me}@{where}", "?", own_stat, login)
+        )
+        parent = sshd_pid
+        if tty != "?":
+            out.append(self._own(me, shell_pid, sshd_pid, "bash", "-bash", tty, "Ss", login))
+            parent = shell_pid
+        typed = " ".join(["ps", *self.args])
+        state = "R+" if tty != "?" else "Rs"
+        out.append(self._own(me, self.protocol.next_pid(), parent, "ps", typed, tty, state, now))
+        return sorted(out, key=lambda p: p["pid"])
+
+    def _own(
+        self,
+        user: str,
+        pid: int,
+        ppid: int,
+        comm: str,
+        args: str,
+        tty: str,
+        stat: str,
+        began: float,
+    ) -> dict[str, Any]:
+        # What a session's own processes hold, as the deployment's file records it.
+        vsz, rss = (table() or {}).get("session", {}).get(comm, (0, 0))
+        return {
+            "user": user,
+            "pid": pid,
+            "ppid": ppid,
+            "vsz": vsz,
+            "rss": rss,
+            "tty": tty,
+            "stat": stat,
+            "args": args,
+            "comm": comm,
+            "began": began,
+            "cpu_s": 0.0,
+        }
+
+    def _wanted(self, p: dict[str, Any], chosen: Selection, me: str, tty: str) -> bool:
+        picked = chosen.pids is not None or chosen.users is not None or chosen.names is not None
+        if picked:
+            users = set(chosen.users or [])
+            if chosen.users:
+                # A user may be named by number.
+                for entry in Passwd().passwd:
+                    if str(entry["pw_uid"]) in users:
+                        users.add(entry["pw_name"])
+            return (
+                (chosen.pids is not None and p["pid"] in chosen.pids)
+                or (chosen.users is not None and self._full_user(p["user"]) in users)
+                or (chosen.names is not None and p["comm"] in chosen.names)
+            )
+        if chosen.everyone or (chosen.with_tty and chosen.own_any_tty):
+            return True
+        mine = self._full_user(p["user"]) == me
+        if chosen.own_any_tty:
+            return mine
+        if chosen.with_tty:
+            return p["tty"] != "?"
+        return mine and p["tty"] == tty
+
+    @staticmethod
+    def _full_user(shown: str) -> str:
+        """The account behind a name ps cut short (``systemd+``)."""
+        if not shown.endswith("+"):
+            return shown
+        stem = shown[:-1]
+        for entry in Passwd().passwd:
+            if entry["pw_name"].startswith(stem):
+                return str(entry["pw_name"])
+        return shown
+
+    @staticmethod
+    def _short_user(name: str) -> str:
+        return name if len(name) <= 8 else name[:7] + "+"
+
+    def _header(self, chosen: Selection) -> str:
+        if chosen.user_format:
+            return "USER         PID %CPU %MEM    VSZ   RSS TTY      STAT START   TIME COMMAND"
+        if chosen.bsd:
+            return "    PID TTY      STAT   TIME COMMAND"
+        if chosen.full:
+            return "UID          PID    PPID  C STIME TTY          TIME CMD"
+        return "    PID TTY          TIME CMD"
+
+    def _line(self, p: dict[str, Any], chosen: Selection, doc: dict[str, Any], now: float) -> str:
+        user = self._short_user(p["user"])
+        age = max(1.0, now - p["began"])
+        percent = 100.0 * p["cpu_s"] / age
+        if chosen.user_format:
+            memory = 100.0 * p["rss"] / max(1, int(doc["memory_kb"]))
+            return row(
+                [
+                    (user, 8, "<"),
+                    (str(p["pid"]), 7, ">"),
+                    (f"{percent:.1f}", 4, ">"),
+                    (f"{memory:.1f}", 4, ">"),
+                    (str(p["vsz"]), 6, ">"),
+                    (str(p["rss"]), 5, ">"),
+                    (p["tty"], 8, "<"),
+                    (p["stat"], 4, "<"),
+                    (started(p["began"], now), 5, ">"),
+                    (bsd_clock(p["cpu_s"]), 6, ">"),
+                    (p["args"], 0, "<"),
+                ]
+            )
+        if chosen.bsd:
+            return row(
+                [
+                    (str(p["pid"]), 7, ">"),
+                    (p["tty"], 8, "<"),
+                    (p["stat"], 4, "<"),
+                    (bsd_clock(p["cpu_s"]), 6, ">"),
+                    (p["args"], 0, "<"),
+                ]
+            )
+        if chosen.full:
+            return row(
+                [
+                    (user, 8, "<"),
+                    (str(p["pid"]), 7, ">"),
+                    (str(p["ppid"]), 7, ">"),
+                    (str(int(percent)), 2, ">"),
+                    (started(p["began"], now), 5, ">"),
+                    (p["tty"], 8, "<"),
+                    (clock(p["cpu_s"]), 8, ">"),
+                    (p["args"], 0, "<"),
+                ]
+            )
+        return row(
+            [
+                (str(p["pid"]), 7, ">"),
+                (p["tty"], 8, "<"),
+                (clock(p["cpu_s"]), 8, ">"),
+                (p["comm"], 0, "<"),
+            ]
+        )
+
+
+for _name in ("/bin/ps", "/usr/bin/ps", "ps"):
+    commands[_name] = Command_ps
diff --git a/src/cowrie/commands/mirage_textutils.py b/src/cowrie/commands/mirage_textutils.py
index 48df771..c5b0d26 100644
--- a/src/cowrie/commands/mirage_textutils.py
+++ b/src/cowrie/commands/mirage_textutils.py
@@ -147,25 +147,63 @@ class Command_grep(Declining):
             source = rf"^(?:{source})$"
         try:
             self.matcher = re.compile(source.encode(), re.I if "i" in self.flags else 0)
-        except re.error:
-            self.errorWrite(f"{self.name}: Unmatched [, [^, [:, [., or [=\n")
+        except re.error as err:
+            what = "( or \\(" if "parenthes" in str(err) else "[, [^, [:, [., or [="
+            self.errorWrite(f"{self.name}: Unmatched {what}\n")
             self.exit(2)
             return
         self.operands = rest
         self.matched = self.failed = False
+        self.typed = 0  # lines read from the terminal, and how many of them matched
+        self.typed_hits = 0
         waits = not rest and "r" not in self.flags and self.input_data is None
-        if waits and not getattr(self.pp, "stdin_from_pipe", False):
-            return  # reads the terminal until end of file
+        self.live = waits and not getattr(self.pp, "stdin_from_pipe", False)
+        if self.live:
+            return  # reads the terminal, answering line by line, until end of file
         self.finish()
 
     def lineReceived(self, line: str) -> None:
-        self.input_data = (self.input_data or b"") + line.encode("utf8") + b"\n"
+        """A line typed at the terminal: grep answers it at once."""
+        if not getattr(self, "live", False):
+            return
+        if self.limit is not None and self.typed_hits >= self.limit:
+            return
+        self.typed += 1
+        data = line.rstrip("\n").encode("utf8")
+        hits = list(self.matcher.finditer(data))
+        if bool(hits) == ("v" in self.flags):
+            return
+        self.typed_hits += 1
+        self.matched = True
+        if self.flags & {"c", "l", "q"}:
+            return
+        lead = f"{self.typed}:".encode() if "n" in self.flags else b""
+        if "H" in self.flags:
+            lead = b"(standard input):" + lead
+        if "o" in self.flags and "v" not in self.flags:
+            self.writeBytes(b"".join(lead + h.group(0) + b"\n" for h in hits if h.group(0)))
+        else:
+            self.writeBytes(lead + data + b"\n")
+
+    def _end_of_typing(self) -> None:
+        if "c" in self.flags and "q" not in self.flags:
+            self.write(f"{self.typed_hits}\n")
+        elif "l" in self.flags and self.typed_hits and "q" not in self.flags:
+            self.write("(standard input)\n")
+        self.exit(0 if self.matched else 1)
 
     def handle_CTRL_D(self) -> None:
-        self.finish()
+        if getattr(self, "live", False):
+            self._end_of_typing()
+        else:
+            self.finish()
 
     def eofReceived(self) -> None:
-        if not self.exited:
+        if self.exited:
+            return
+        if getattr(self, "live", False):
+            self._end_of_typing()
+        else:
             self.finish()
 
     def _complain(self, message: str) -> None:
