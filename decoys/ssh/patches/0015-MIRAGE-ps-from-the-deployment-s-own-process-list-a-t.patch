@@ -0,0 +1,210 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: Tests MIRAGE's ps: the deployment's own process list in procps-ng's
+# ABOUTME: formats, the session's own rows, and what it declines.
+
+from __future__ import annotations
+
+import time
+from typing import Any
+from unittest import mock
+
+from cowrie.commands import mirage_ps
+from cowrie.test.test_mirage_gate import PROMPT, GateTestBase
+
+TABLE: dict[str, Any] = {
+    "version": 1,
+    "memory_kb": 4009140,
+    "listener_pid": 382,
+    "session": {"sshd": [16188, 10540], "bash": [3940, 3064], "ps": [8116, 4344]},
+    "processes": [
+        {"user": "root", "pid": 1, "ppid": 0, "vsz": 101956, "rss": 12032, "tty": "?",
+         "stat": "Ss", "start": 0, "args": "/sbin/init", "comm": "systemd"},
+        {"user": "root", "pid": 2, "ppid": 0, "vsz": 0, "rss": 0, "tty": "?",
+         "stat": "S", "start": 0, "args": "[kthreadd]", "comm": "kthreadd"},
+        {"user": "systemd+", "pid": 263, "ppid": 1, "vsz": 18064, "rss": 8668, "tty": "?",
+         "stat": "Ss", "start": 0, "args": "/lib/systemd/systemd-networkd",
+         "comm": "systemd-network"},
+        {"user": "root", "pid": 382, "ppid": 1, "vsz": 15460, "rss": 8784, "tty": "?",
+         "stat": "Ss", "start": 0,
+         "args": "sshd: /usr/sbin/sshd -D [listener] 0 of 10-100 startups", "comm": "sshd"},
+        {"user": "root", "pid": 384, "ppid": 1, "vsz": 2900, "rss": 1032, "tty": "tty1",
+         "stat": "Ss+", "start": 0, "args": "/sbin/agetty -o -p -- \\u --noclear - linux",
+         "comm": "agetty"},
+        {"user": "mysql", "pid": 393, "ppid": 1, "vsz": 8591143976, "rss": 101696, "tty": "?",
+         "stat": "Ssl", "start": 6, "args": "/usr/sbin/mariadbd", "comm": "mariadbd"},
+        {"user": "www-data", "pid": 397, "ppid": 396, "vsz": 10736, "rss": 2804, "tty": "?",
+         "stat": "S", "start": 3, "args": "nginx: worker process", "comm": "nginx"},
+    ],
+}  # fmt: skip
+
+
+class Base(GateTestBase):
+    def setUp(self) -> None:
+        super().setUp()
+        mirage_ps.reset_for_tests(TABLE, loaded=True)
+        self.proto.user.windowSize = [24, 200]
+        # The machine booted two hours ago: starts show as times, and no daemon
+        # has used a whole second of processor yet.
+        booted = time.time() - 7200
+        self.proto.boot_time = lambda: booted
+
+    def tearDown(self) -> None:
+        mirage_ps.reset_for_tests()
+        super().tearDown()
+
+    def lines(self, line: str) -> list[str]:
+        text = self.run_line(line).decode()
+        return text[: -len(PROMPT.decode())].splitlines()
+
+    def no_terminal(self) -> None:
+        del self.proto.user.windowSize
+
+
+class FormatTests(Base):
+    def test_every_process_in_the_short_format(self) -> None:
+        lines = self.lines("ps -e")
+        self.assertEqual(lines[0], "    PID TTY          TIME CMD")
+        self.assertEqual(lines[1], "      1 ?        00:00:00 systemd")
+        self.assertEqual(lines[2], "      2 ?        00:00:00 kthreadd")
+        self.assertIn("    384 tty1     00:00:00 agetty", lines)
+        self.assertEqual(lines[1:], self.lines("ps -A")[1:-1] + [lines[-1]])
+
+    def test_the_full_format(self) -> None:
+        lines = self.lines("ps -ef")
+        self.assertEqual(lines[0], "UID          PID    PPID  C STIME TTY          TIME CMD")
+        self.assertRegex(lines[1], r"^root           1       0  0 \S{5} \?        00:00:00 /sbin/init$")
+        self.assertRegex(lines[3], r"^systemd\+     263       1  0 \S{5} \?        00:0\d:\d\d /lib/systemd/systemd-networkd$")
+        self.assertRegex(lines[2], r" \[kthreadd\]$")
+
+    def test_the_user_format_and_a_column_that_overflows(self) -> None:
+        lines = self.lines("ps aux")
+        self.assertEqual(
+            lines[0], "USER         PID %CPU %MEM    VSZ   RSS TTY      STAT START   TIME COMMAND"
+        )
+        self.assertRegex(lines[1], r"^root           1  0\.0  0\.3 101956 12032 \?        Ss   \S{5} +\d+:\d\d /sbin/init$")
+        maria = next(line for line in lines if line.endswith("/usr/sbin/mariadbd"))
+        # The two numbers too wide for their columns take the room back from the next one.
+        self.assertRegex(maria, r"^mysql        393  0\.\d  2\.5 8591143976 101696 \?   Ssl  \S{5} +\d+:\d\d /usr/sbin/mariadbd$")
+        self.assertEqual(self.lines("ps -aux")[0], lines[0])
+        self.assertEqual(len(self.lines("ps auxww")), len(lines))
+
+    def test_the_bsd_format_without_u(self) -> None:
+        lines = self.lines("ps ax")
+        self.assertEqual(lines[0], "    PID TTY      STAT   TIME COMMAND")
+        self.assertEqual(lines[1], "      1 ?        Ss     0:00 /sbin/init")
+
+    def test_a_line_is_cut_to_the_terminal_and_not_without_one(self) -> None:
+        self.proto.user.windowSize = [24, 60]
+        self.assertTrue(all(len(line) <= 60 for line in self.lines("ps -ef")))
+        self.assertTrue(any(len(line) > 60 for line in self.lines("ps -efww")))
+        self.assertTrue(any(len(line) > 60 for line in self.lines("ps -ef | cat")))
+
+
+class SessionTests(Base):
+    def test_with_a_terminal_the_session_is_its_sshd_its_shell_and_the_ps(self) -> None:
+        lines = self.lines("ps")
+        self.assertEqual(lines[0], "    PID TTY          TIME CMD")
+        self.assertEqual([line.split()[-1] for line in lines[1:]], ["bash", "ps"])
+        self.assertTrue(all(" pts/0 " in line for line in lines[1:]))
+        full = self.lines("ps -ef")
+        own = [line for line in full if "sshd: root@pts/0" in line or line.endswith(" -bash")]
+        self.assertEqual(len(own), 2)
+        sshd_pid, sshd_parent = own[0].split()[1:3]
+        self.assertEqual(sshd_parent, "382")  # the listener's child
+        self.assertEqual(own[1].split()[2], sshd_pid)  # the shell's parent
+        self.assertRegex(full[-1], r" pts/0    00:00:00 ps -ef$")
+
+    def test_without_a_terminal_there_is_no_shell_and_ps_shows_the_user_s_own(self) -> None:
+        self.no_terminal()
+        lines = self.lines("ps")
+        shown = [line.split()[-1] for line in lines[1:]]
+        self.assertEqual(shown, ["systemd", "kthreadd", "sshd", "sshd", "ps"])
+        self.assertTrue(all(line.split()[1] == "?" for line in lines[1:]))
+        full = self.lines("ps -ef")
+        self.assertTrue(any("sshd: root@notty" in line for line in full))
+        self.assertFalse(any(line.endswith(" -bash") for line in full))
+
+    def test_each_ps_is_a_new_process_and_the_shell_keeps_its_number(self) -> None:
+        first, second = self.lines("ps"), self.lines("ps")
+        self.assertEqual(first[1].split()[0], second[1].split()[0])
+        self.assertLess(int(first[2].split()[0]), int(second[2].split()[0]))
+
+
+class SelectionTests(Base):
+    def test_by_process_id_user_and_name(self) -> None:
+        self.assertEqual(self.lines("ps -p 1")[1:], ["      1 ?        00:00:00 systemd"])
+        self.assertEqual(len(self.lines("ps -p 1,393")), 3)
+        self.assertEqual([x.split()[-1] for x in self.lines("ps -u mysql")[1:]], ["mariadbd"])
+        self.assertEqual([x.split()[-1] for x in self.lines("ps -C nginx")[1:]], ["nginx"])
+        self.assertRegex(self.lines("ps -fp 393")[1], r"^mysql        393       1 ")
+
+    def test_a_name_ps_cut_short_still_belongs_to_its_account(self) -> None:
+        accounts = mock.Mock(passwd=[{"pw_name": "systemd-network", "pw_uid": 998}])
+        with mock.patch.object(mirage_ps, "Passwd", return_value=accounts):
+            self.assertEqual(mirage_ps.Command_ps._full_user("systemd+"), "systemd-network")
+            self.assertEqual(len(self.lines("ps -u systemd-network")), 2)
+            self.assertEqual(len(self.lines("ps -u 998")), 2)
+        self.assertEqual(mirage_ps.Command_ps._full_user("root"), "root")
+
+    def test_nothing_selected_is_the_header_and_status_1(self) -> None:
+        text = self.run_line("ps -p 99999; echo status=$?").decode()
+        self.assertEqual(text[: -len(PROMPT.decode())], "    PID TTY          TIME CMD\nstatus=1\n")
+
+    def test_x_is_the_user_s_own_and_a_is_what_has_a_terminal(self) -> None:
+        own = [line.split()[-1] for line in self.lines("ps x")[1:]]
+        self.assertIn("/sbin/init", own)
+        self.assertNotIn("/usr/sbin/mariadbd", own)
+        with_tty = self.lines("ps a")[1:]
+        self.assertTrue(all(line.split()[1] != "?" for line in with_tty))
+        self.assertTrue(any("agetty" in line for line in with_tty))
+
+    def test_no_header_when_asked(self) -> None:
+        self.assertEqual(self.lines("ps --no-headers -p 1"), ["      1 ?        00:00:00 systemd"])
+
+
+class DeclineTests(Base):
+    def tier(self, line: str) -> str:
+        self.gate.requests.clear()
+        self.run_line(line)
+        return self.gate.requests[-1]["tier"]
+
+    def test_a_form_it_does_not_take_is_declined(self) -> None:
+        self.assertEqual(self.tier("ps -ef"), "emulated")
+        self.assertEqual(self.tier("ps aux"), "emulated")
+        self.assertEqual(self.tier("ps -eo pid,comm"), "none")
+        self.assertEqual(self.tier("ps --forest"), "none")
+        self.assertEqual(self.tier("ps -elf"), "none")
+
+    def test_without_a_table_the_stock_command_answers(self) -> None:
+        mirage_ps.reset_for_tests(None, loaded=True)
+        self.assertEqual(self.tier("ps -eo pid,comm"), "emulated")
+        self.assertIn("COMMAND", self.lines("ps aux")[0])
+
+
+class HelperTests(Base):
+    def test_processor_time_in_both_forms(self) -> None:
+        self.assertEqual(mirage_ps.clock(0), "00:00:00")
+        self.assertEqual(mirage_ps.clock(3725), "01:02:05")
+        self.assertEqual(mirage_ps.clock(90000), "1-01:00:00")
+        self.assertEqual(mirage_ps.bsd_clock(125), "2:05")
+        self.assertEqual(mirage_ps.bsd_clock(7325), "122:05")
+
+    def test_a_start_is_a_time_then_a_date_then_a_year(self) -> None:
+        now = 1_794_900_000.0
+        self.assertRegex(mirage_ps.started(now - 3600, now), r"^\d\d:\d\d$")
+        self.assertRegex(mirage_ps.started(now - 5 * 86400, now), r"^[A-Z][a-z]{2}\d\d$")
+        self.assertRegex(mirage_ps.started(now - 800 * 86400, now), r"^\d{4}$")
+
+
+class LongUptimeTests(Base):
+    def test_after_weeks_starts_are_dates_and_the_daemons_have_used_some_processor(self) -> None:
+        booted = time.time() - 40 * 86400
+        self.proto.boot_time = lambda: booted
+        lines = self.lines("ps aux")
+        init = lines[1].split()
+        self.assertRegex(init[8], r"^([A-Z][a-z]{2}\d\d|\d{4})$")
+        self.assertEqual(init[9], "1:00")  # a second and a half a day
+        maria = next(line for line in lines if line.endswith("/usr/sbin/mariadbd")).split()
+        self.assertEqual(maria[9], "23:20")
+        own = next(line for line in lines if "sshd: root@pts/0" in line).split()
+        self.assertRegex(own[8], r"^\d\d:\d\d$")  # the login was just now
