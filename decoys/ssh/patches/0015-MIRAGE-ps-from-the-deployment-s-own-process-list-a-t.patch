+def _links_verbatim() -> bool:
+    """Whether the tree's symbolic links hold their own text (a deployment
+    built by MIRAGE) or createfs's resolved path from the root (the default)."""
+    return CowrieConfig.get("shell", "link_targets", fallback="") == "verbatim"
+
+
 class HoneyPotFilesystem:
     _log = Logger()
 
@@ -351,13 +357,18 @@ class HoneyPotFilesystem:
                             # Empty target (e.g. a /proc/<pid>/cwd link
                             # captured with no destination): a broken link.
                             return None
-                        # MIRAGE: a relative link is read from the directory
-                        # that holds it. Upstream read every one from the
-                        # root, which is right only for a link in the root.
+                        # MIRAGE: createfs records where a link ends up, as a
+                        # path from the root without its slash, and upstream
+                        # reads every relative target from the root. A tree
+                        # that keeps each link's own text ([shell]
+                        # link_targets = verbatim) has real relative targets,
+                        # which are read from the directory holding the link.
                         if x[A_TARGET][0] == "/":
                             cwd = posixpath.normpath(x[A_TARGET])
-                        else:
+                        elif _links_verbatim():
                             cwd = posixpath.normpath(f"{cwd}/{x[A_TARGET]}")
+                        else:
+                            cwd = posixpath.normpath(f"/{x[A_TARGET]}")
                         depth = getattr(self, "_link_depth", 0)
                         if depth >= 40:  # ELOOP, as the kernel has it
                             return None
