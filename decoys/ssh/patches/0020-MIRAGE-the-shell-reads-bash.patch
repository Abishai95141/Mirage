+class LoginShellTests(GateTestBase):
+    def test_background_jobs_are_announced_and_reported(self) -> None:
+        self.assertRegex(self.text("echo hi &"), r"^\[1\] \d+\nhi\n$")
+        # Reported before the prompt, once another line has run.
+        self.assertEqual(self.text("true"), "[1]+  Done                    echo hi\n")
+        self.assertEqual(self.text("true"), "")
+        self.text("false &")
+        self.assertEqual(self.text("true"), "[1]+  Exit 1                  false\n")
+        self.assertRegex(
+            self.text("echo a & echo b & wait"),
+            r"^\[1\] \d+\na\n\[2\] \d+\nb\n"
+            r"\[1\]-  Done                    echo a\n\[2\]\+  Done                    echo b\n$",
+        )
+        self.text("( echo sub ) > /dev/null &")
+        self.assertEqual(self.text("true"), "[1]+  Done                    ( echo sub ) > /dev/null\n")
+
+    def text(self, line: str) -> str:
+        shown = self.run_line(line).decode("utf8", "replace").replace("\r", "")
+        return shown.removesuffix("root@unitTest:~# ")
+
+    def test_it_has_the_functions_its_profile_defines(self) -> None:
+        # /etc/profile sources /etc/profile.d/*.sh; what they define is there
+        # to call, and set lists it, as on the host the decoy was made from.
+        self.run_line("mkdir -p /etc/profile.d")
+        self.run_line("echo 'greet() { echo hello $1; }' > /etc/profile.d/x.sh")
+        self.run_line("echo 'other() { :; }' > /etc/profile.d/not-read.csh")
+        self.assertEqual(self.text("greet you"), "hello you\n")
+        self.assertEqual(self.text("type greet"), "greet is a function\ngreet () \n{ \n    echo hello $1\n}\n")
+        self.assertTrue(self.text("set").endswith("greet () \n{ \n    echo hello $1\n}\n"))
+        self.assertIn("other: command not found", self.text("other"))
+
+    def test_what_a_login_shell_alone_has(self) -> None:
+        listed = self.text("set")
+        for line in ("BASH=/bin/bash", "HISTSIZE=500", "MAILCHECK=60", "PS2='> '"):
+            self.assertIn(line + "\n", listed)
+        self.assertNotIn("BASH_EXECUTION_STRING", listed)
+        self.assertIn("expand_aliases", self.text("echo $BASHOPTS"))
+        self.assertEqual(self.text("echo $-"), "himBHs\n")
+        # It says what it could not read, runs nothing of that line, and goes on.
+        self.assertEqual(
+            self.text("echo before; [[ a == ]]"),
+            "-bash: unexpected argument `]]' to conditional binary operator\n",
+        )
+        self.assertEqual(self.text("echo ${V/}; echo after"), "\nafter\n")
+        self.assertEqual(self.text("echo ${}; echo after"), "-bash: ${}: bad substitution\n")
+        self.assertEqual(self.text("echo next"), "next\n")
