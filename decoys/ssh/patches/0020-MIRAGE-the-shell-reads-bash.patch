+        if offset < 0:
+            offset = max(0, len(value) + offset)
+        if length is None:
+            return value[offset:]
+        if length < 0:
+            end = len(value) + length
+            if end < offset:
+                raise ExpansionError(f"{length_text.strip()}: substring expression < 0")
+            return value[offset:end]
+        return value[offset : offset + length]
+    raise bad
+
+
+# ------------------------------------------------------------------- $'...'
+
+
+def ansi_c(body: str) -> str:
+    """The text of ``$'body'``: backslash escapes as C has them."""
+    out, i = [], 0
+    while i < len(body):
+        c = body[i]
+        if c != "\\" or i + 1 >= len(body):
+            out.append(c)
+            i += 1
+            continue
+        nxt = body[i + 1]
+        if nxt in _ESCAPES:
+            out.append(_ESCAPES[nxt])
+            i += 2
+        elif nxt == "x" and (m := re.match(r"[0-9a-fA-F]{1,2}", body[i + 2 :])):
+            out.append(chr(int(m.group(), 16)))
+            i += 2 + m.end()
+        elif nxt in "01234567" and (m := re.match(r"[0-7]{1,3}", body[i + 1 :])):
+            out.append(chr(int(m.group(), 8) & 0xFF))
+            i += 1 + m.end()
+        elif nxt == "u" and (m := re.match(r"[0-9a-fA-F]{1,4}", body[i + 2 :])):
+            out.append(chr(int(m.group(), 16)))
+            i += 2 + m.end()
+        elif nxt == "c" and i + 2 < len(body):
+            out.append(chr(ord(body[i + 2].upper()) ^ 0x40))
+            i += 3
+        else:
+            out.append("\\" + nxt)
+            i += 2
+    return "".join(out)
+
+
+# ------------------------------------------------------------------- {a,b} and {1..5}
+
+_SEQUENCE = re.compile(r"(-?\d+)\.\.(-?\d+)(?:\.\.(-?\d+))?|([A-Za-z])\.\.([A-Za-z])(?:\.\.(-?\d+))?")
+_MAX_BRACE_WORDS = 4096
+
+
+def _closing(text: str, start: int) -> int:
+    """Where the brace opened at ``start`` closes, or -1. Quotes, escapes and
+    ``${...}`` / ``$(...)`` inside it are skipped whole."""
+    depth, i = 0, start
+    while i < len(text):
+        c = text[i]
+        if c == "\\":
+            i += 2
+            continue
+        if c in "'\"`":
+            end = text.find(c, i + 1)
+            if end < 0:
+                return -1
+            i = end + 1
+            continue
+        if c == "$" and text[i + 1 : i + 2] in ("{", "("):
+            opener = text[i + 1]
+            closer = "}" if opener == "{" else ")"
+            level, j = 0, i + 1
+            while j < len(text):
+                if text[j] == opener:
+                    level += 1
+                elif text[j] == closer:
+                    level -= 1
+                    if level == 0:
+                        break
+                j += 1
+            if j >= len(text):
+                return -1
+            i = j + 1
+            continue
+        if c == "{":
+            depth += 1
+        elif c == "}":
+            depth -= 1
+            if depth == 0:
+                return i
+        elif c in " \t\n" and depth:
+            return -1  # a brace expansion holds no unquoted blank
+        i += 1
+    return -1
+
+
+def _alternatives(body: str) -> list[str] | None:
+    """The parts of ``a,b,c`` cut at the commas of its own level, or the
+    members of a sequence ``1..5``; None if the braces are not an expansion."""
+    match = _SEQUENCE.fullmatch(body)
+    if match:
+        if match[1] is not None:
+            first, last, step = int(match[1]), int(match[2]), abs(int(match[3] or 1)) or 1
+            width = 0
+            for text in (match[1], match[2]):
+                if len(text.lstrip("-")) > 1 and text.lstrip("-").startswith("0"):
+                    width = max(width, len(match[1]), len(match[2]))
+            count = abs(last - first) // step + 1
+            if count > _MAX_BRACE_WORDS:
+                return None
+            sign = 1 if last >= first else -1
+            return [str(first + sign * n * step).zfill(width) for n in range(count)]
+        first, last, step = ord(match[4]), ord(match[5]), abs(int(match[6] or 1)) or 1
+        sign = 1 if last >= first else -1
+        return [chr(first + sign * n * step) for n in range(abs(last - first) // step + 1)]
+    parts, depth, current, i = [], 0, [], 0
+    while i < len(body):
+        c = body[i]
+        if c == "\\" and i + 1 < len(body):
+            current.append(body[i : i + 2])
+            i += 2
+            continue
+        if c in "'\"`":
+            end = body.find(c, i + 1)
+            end = len(body) - 1 if end < 0 else end
+            current.append(body[i : end + 1])
+            i = end + 1
+            continue
+        if c == "{":
+            depth += 1
+        elif c == "}":
+            depth -= 1
+        if c == "," and depth == 0:
+            parts.append("".join(current))
+            current = []
+        else:
+            current.append(c)
+        i += 1
+    parts.append("".join(current))
+    return parts if len(parts) > 1 else None
+
+
+def brace_expand(word: str) -> list[str]:
+    """The words a word's braces expand to, in order; the word itself if it
+    has none. ``${...}`` is never one, nor is ``{}`` or a lone ``{x}``."""
+    i = 0
+    while i < len(word):
+        c = word[i]
+        if c == "\\":
+            i += 2
+            continue
+        if c in "'\"`":
+            end = word.find(c, i + 1)
+            if end < 0:
+                return [word]
+            i = end + 1
+            continue
+        if c == "$" and word[i + 1 : i + 2] in ("{", "("):
+            opener = word[i + 1]
+            closer = "}" if opener == "{" else ")"
+            level, j = 0, i + 1
+            while j < len(word):
+                if word[j] == opener:
+                    level += 1
+                elif word[j] == closer:
+                    level -= 1
+                    if level == 0:
+                        break
+                j += 1
+            i = j + 1
+            continue
+        if c == "{":
+            end = _closing(word, i)
+            parts = _alternatives(word[i + 1 : end]) if end > i else None
+            if parts is not None:
+                out: list[str] = []
+                for part in parts:
+                    for head in brace_expand(part) if "{" in part else [part]:
+                        for tail in brace_expand(word[end + 1 :]):
+                            out.append(word[:i] + head + tail)
+                            if len(out) > _MAX_BRACE_WORDS:
+                                return [word]
+                return out
+        i += 1
+    return [word]
