+++ b/src/cowrie/shell/mirage_syntax.py
@@ -0,0 +1,442 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE: [[ ... ]], (( ... )), for ((;;)) and "!" for the Cowrie shell, by
+# ABOUTME: rewriting each into a command the grammar already reads.
+
+"""Four constructs of bash the shell's grammar has no rule for.
+
+Inside ``[[ ]]`` and ``(( ))`` the characters ``<``, ``>``, ``&&``, ``||``
+and ``(`` mean something else than they do in a command, so the grammar,
+which reads them as redirections, separators and subshells, cannot be asked
+to parse them. Instead each construct is rewritten, before parsing, into an
+ordinary command whose one argument is the construct's text in single
+quotes; a builtin of that name (``cowrie.commands.mirage_builtins``) then
+evaluates the text when the command runs, with the shell's variables as they
+are at that moment:
+
+    [[ EXPR ]]                  ->  COND 'EXPR'
+    (( EXPR ))                  ->  ARITH 'EXPR'
+    for (( A; B; C ))           ->  ARITH -r N 'A'; while CFOR N 'B' 'C'
+    ! PIPELINE                  ->  { PIPELINE; NOT; }
+
+The rewriting is done only where bash would see the construct: at the start
+of a command, never inside quotes, a comment, ``$(( ))`` or a here-document's
+body. The names are not commands a session can run: the shell refuses them
+when typed.
+
+bash reads ``[[ ]]`` with a grammar of its own and refuses a malformed one
+when it parses the line, before any command on that line has run. So the
+check is made here too: :func:`rewrite` raises :class:`Malformed` with bash's
+message.
+"""
+
+from __future__ import annotations
+
+import itertools
+import re
+import secrets
+
+# The builtins' names. They carry a few random characters, new each time the
+# decoy starts: a session cannot type one, and none ever appears in output.
+_TAG = "__" + secrets.token_hex(4)
+COND, ARITH, CFOR, NOT = (f"{_TAG}{kind}" for kind in ("c", "a", "f", "n"))
+INTERNAL = (COND, ARITH, CFOR, NOT)
+# After these words a command begins.
+_OPENERS = frozenset({"then", "do", "else", "elif", "if", "while", "until", "time", "{", "!"})
+_HEREDOC = re.compile(r"<<(-?)\s*(['\"]?)([A-Za-z_0-9.!+-]+)\2")
+_counter = itertools.count(1)
+# The operators of [[ ]] (bash's test_unop and test_binop).
+UNARY = frozenset(
+    "-a -b -c -d -e -f -g -h -k -n -o -p -r -s -t -u -v -w -x -z -G -L -N -O -R -S".split()
+)
+BINARY = frozenset("== = != =~ < > -eq -ne -lt -le -gt -ge -nt -ot -ef".split())
+_NOT_WORDS = frozenset({"&&", "||", "(", ")", "]]"})
+
+
+class Malformed(Exception):
+    """A construct bash refuses when it reads the line. ``said`` is its
+    message (empty where bash says nothing and only stops), ``offset`` where
+    in the text the construct ends."""
+
+    def __init__(self, said: str, offset: int) -> None:
+        super().__init__(said)
+        self.said = said
+        self.offset = offset
+
+
+def quote(text: str) -> str:
+    return "'" + text.replace("'", "'\\''") + "'"
+
+
+def needs(text: str) -> bool:
+    return "[[" in text or "((" in text or "!" in text
+
+
+def _skip_quoted(text: str, i: int) -> int:
+    """The index after the quoted string, substitution or escape at ``i``."""
+    c = text[i]
+    if c == "\\":
+        return min(len(text), i + 2)
+    if c == "'":
+        end = text.find("'", i + 1)
+        return len(text) if end < 0 else end + 1
+    if c == '"':
+        j = i + 1
+        while j < len(text) and text[j] != '"':
+            if text[j] == "\\":
+                j += 1
+            elif text[j] == "$" and text[j + 1 : j + 2] in ("(", "{"):
+                j = _skip_quoted(text, j) - 1
+            elif text[j] == "`":
+                j = _skip_quoted(text, j) - 1
+            j += 1
+        return min(len(text), j + 1)
+    if c == "`":
+        end = text.find("`", i + 1)
+        return len(text) if end < 0 else end + 1
+    if c == "$" and text[i + 1 : i + 2] == "'":
+        # $'...': a backslash escapes the quote.
+        j = i + 2
+        while j < len(text) and text[j] != "'":
+            j += 2 if text[j] == "\\" else 1
+        return min(len(text), j + 1)
+    if c == "$" and text[i + 1 : i + 2] in ("(", "{"):
+        opener = text[i + 1]
+        closer = ")" if opener == "(" else "}"
+        depth, j = 0, i + 1
+        while j < len(text):
+            ch = text[j]
+            if ch in "'\"`\\":
+                j = _skip_quoted(text, j)
+                continue
+            if ch == opener:
+                depth += 1
+            elif ch == closer:
+                depth -= 1
+                if depth == 0:
+                    return j + 1
+            j += 1
+        return len(text)
+    return i + 1
+
+
+def _matching(text: str, i: int) -> int:
+    """For ``((`` at ``i``: the index of its closing ``))``, or -1."""
+    depth, j = 0, i
+    while j < len(text):
+        c = text[j]
+        if c in "'\"`\\" or (c == "$" and text[j + 1 : j + 2] in ("{", "'")):
+            j = _skip_quoted(text, j)
+            continue
+        if c == "(":
+            depth += 1
+        elif c == ")":
+            depth -= 1
+            if depth == 1 and text[j + 1 : j + 2] == ")":
+                return j
+            if depth <= 0:
+                return -1
+        elif c == "\n" and depth < 2:
+            return -1
+        j += 1
+    return -1
+
+
+def _cond_end(text: str, i: int) -> int:
+    """For ``[[`` at ``i``: the index of its closing ``]]``, or -1."""
+    j = i + 2
+    while j < len(text):
+        c = text[j]
+        if c in "'\"`\\" or (c == "$" and text[j + 1 : j + 2] in ("(", "{", "'")):
+            j = _skip_quoted(text, j)
+            continue
+        if text.startswith("]]", j) and text[j - 1] in " \t\n" and (
+            j + 2 == len(text) or text[j + 2] in " \t\n;&|)"
+        ):
+            return j
+        j += 1
+    return -1
+
+
+def cond_tokens(text: str) -> list[str]:
+    """The words and operators of a conditional expression. A word keeps its
+    quotes and expansions as written; they are expanded when it is tested."""
+    out: list[str] = []
+    i, n = 0, len(text)
+    while i < n:
+        c = text[i]
+        if c in " \t\n":
+            i += 1
+            continue
+        if text.startswith("&&", i) or text.startswith("||", i):
+            out.append(text[i : i + 2])
+            i += 2
+            continue
+        if c in "()" or (c in "<>" and text[i + 1 : i + 2] in (" ", "\t", "\n", "")):
+            out.append(c)
+            i += 1
+            continue
+        j = i
+        regex = bool(out) and out[-1] == "=~"
+        depth = 0
+        while j < n:
+            ch = text[j]
+            if ch in "'\"`\\" or (ch == "$" and text[j + 1 : j + 2] in ("(", "{", "'")):
+                j = _skip_quoted(text, j)
+                continue
+            if regex:
+                # A regular expression has parentheses and bars of its own.
+                if ch == "(":
+                    depth += 1
+                elif ch == ")":
+                    if depth == 0:
+                        break
+                    depth -= 1
+                elif ch in " \t\n" and depth == 0:
+                    break
+            elif ch in " \t\n()" or text.startswith("&&", j) or text.startswith("||", j):
+                break
+            j += 1
+        out.append(text[i:j])
+        i = j
+    return out
+
+
+def cond_error(tokens: list[str]) -> str | None:
+    """What bash 5.2 says of a conditional expression it cannot read: None
+    when it can read it, and an empty string where it stops without a word
+    (``[[ ]]``). The grammar is bash's (parse.y, cond_term): a unary operator
+    takes the word after it; a word is followed by a binary operator and a
+    word, or stands alone."""
+    toks = [*tokens, "]]"]
+    pos = 0
+
+    def term() -> str | None:
+        nonlocal pos
+        tok = toks[pos]
+        if tok == "(":
+            pos += 1
+            error = either()
+            if error is not None:
+                return error
+            if toks[pos] != ")":
+                return f"unexpected token `{toks[pos]}', expected `)'"
+            pos += 1
+            return None
+        if tok == "!":
+            pos += 1
+            return term()
+        if tok in _NOT_WORDS or tok in ("<", ">"):
+            return "" if tok == "]]" else f"unexpected token `{tok}' in conditional command"
+        pos += 1
+        following = toks[pos]
+        if tok in UNARY:
+            if following in _NOT_WORDS:
+                return f"unexpected argument `{following}' to conditional unary operator"
+            pos += 1
+            return None
+        if following in BINARY:
+            pos += 1
+            if toks[pos] in _NOT_WORDS:
+                return f"unexpected argument `{toks[pos]}' to conditional binary operator"
+            pos += 1
+            return None
+        if following in ("]]", "&&", "||", ")"):
+            return None  # a word alone: true if it is not empty
+        if following == "(":
+            return "unexpected token `(', conditional binary operator expected"
+        return "conditional binary operator expected"
+
+    def both() -> str | None:
+        nonlocal pos
+        error = term()
+        while error is None and toks[pos] == "&&":
+            pos += 1
+            error = term()
+        return error
+
+    def either() -> str | None:
+        nonlocal pos
+        error = both()
+        while error is None and toks[pos] == "||":
+            pos += 1
+            error = both()
+        return error
+
+    error = either()
+    if error is None and toks[pos] != "]]":
+        return "syntax error in conditional expression"
+    return error
+
+
+def _pipeline_end(text: str, i: int) -> int:
+    """Where the pipeline that starts at ``i`` ends: before the ``;``, ``&``,
+    ``&&``, ``||``, newline or closing bracket that follows it."""
+    depth, j = 0, i
+    while j < len(text):
+        c = text[j]
+        if c in "'\"`\\" or (c == "$" and text[j + 1 : j + 2] in ("(", "{", "'")):
+            j = _skip_quoted(text, j)
+            continue
+        if c == "(":
+            depth += 1
+        elif c == ")":
+            if depth == 0:
+                return j
+            depth -= 1
+        elif depth == 0:
+            if c in ";\n&":
+                return j
+            if c == "|" and text[j + 1 : j + 2] == "|":
+                return j
+            if c == "}" and text[j - 1 : j] in " \t;" and (j + 1 == len(text) or text[j + 1] in " \t\n;&|)"):
+                return j
+        j += 1
+    return len(text)
+
+
+def rewrite(text: str, base: int = 0) -> str:
+    """``text`` with each construct replaced, where there is one. Raises
+    :class:`Malformed` for a ``[[ ]]`` bash would refuse; ``base`` is where
+    ``text`` starts in the whole input, for that error's offset."""
+    if not needs(text):
+        return text
+    out: list[str] = []
+    i, n = 0, len(text)
+    at_command = True
+    heredocs: list[tuple[bool, str]] = []
+    word_start = True
+    # After "name()" a [[ ]] or (( )) is the function's whole body; the
+    # grammar wants a group there.
+    func_body = False
+    while i < n:
+        c = text[i]
+        func_here = func_body
+        if c not in " \t\n":
+            func_body = False
+        if c == "\n":
+            out.append(c)
+            i += 1
+            # The bodies of the here-documents opened on this line: as they are.
+            while heredocs:
+                strip_tabs, delimiter = heredocs.pop(0)
+                while i < n:
+                    end = text.find("\n", i)
+                    end = n if end < 0 else end
+                    line = text[i:end]
+                    out.append(text[i : min(n, end + 1)])
+                    i = min(n, end + 1)
+                    if (line.lstrip("\t") if strip_tabs else line) == delimiter:
+                        break
+            at_command = word_start = True
+            continue
+        if c in " \t":
+            out.append(c)
+            i += 1
+            word_start = True
+            continue
+        if c == "#" and word_start:
+            end = text.find("\n", i)
+            end = n if end < 0 else end
+            out.append(text[i:end])
+            i = end
+            continue
+        if text.startswith("$((", i):
+            end = _matching(text, i + 1)
+            end = n if end < 0 else end + 2
+            out.append(text[i:end])
+            i, at_command, word_start = end, False, False
+            continue
+        if c in "'\"`\\" or (c == "$" and text[i + 1 : i + 2] in ("{", "'")):
+            end = _skip_quoted(text, i)
+            out.append(text[i:end])
+            i, at_command, word_start = end, False, False
+            continue
+        if c == "$" and text[i + 1 : i + 2] == "(":
+            # A command substitution holds commands of its own.
+            end = _skip_quoted(text, i)
+            out.append(
+                "$(" + rewrite(text[i + 2 : end - 1], base + i + 2) + ")"
+                if text[end - 1 : end] == ")"
+                else text[i:end]
+            )
+            i, at_command, word_start = end, False, False
+            continue
+        if c == "<" and (match := _HEREDOC.match(text, i)) and not text.startswith("<<<", i):
+            heredocs.append((match[1] == "-", match[3]))
+            out.append(match[0])
+            i, word_start = match.end(), False
+            continue
+
+        if at_command:
+            if text.startswith("[[", i) and text[i + 2 : i + 3] in (" ", "\t", "\n"):
+                end = _cond_end(text, i)
+                if end > 0:
+                    inner = text[i + 2 : end].strip()
+                    said = cond_error(cond_tokens(inner))
+                    if said is not None:
+                        raise Malformed(said, base + end)
+                    made = COND + " " + quote(inner)
+                    out.append("{ " + made + "; }" if func_here else made)
+                    i, at_command, word_start = end + 2, False, False
+                    continue
+            if text.startswith("((", i):
+                end = _matching(text, i)
+                if end > 0:
+                    # As written, blanks and all: bash quotes it so in an error.
+                    made = ARITH + " " + quote(text[i + 2 : end])
+                    out.append("{ " + made + "; }" if func_here else made)
+                    i, at_command, word_start = end + 2, False, False
+                    continue
+            if c == "!" and text[i + 1 : i + 2] in (" ", "\t"):
+                start = i + 1
+                end = _pipeline_end(text, start)
+                inner = text[start:end].strip()
+                if inner:
+                    lead = len(text[start:end]) - len(text[start:end].lstrip())
+                    out.append("{ " + rewrite(inner, base + start + lead) + "; " + NOT + "; }")
+                    i, at_command, word_start = end, False, False
+                    continue
+            if (match := re.match(r"for[ \t]*\(\(", text[i:])) and (i == 0 or text[i - 1] in " \t\n;&|({"):
+                open_at = i + match.end() - 2
+                end = _matching(text, open_at)
+                parts = text[open_at + 2 : end].split(";") if end > 0 else []
+                if len(parts) == 3:
+                    loop = next(_counter)
+                    init, cond, step = (p.strip() for p in parts)
+                    out.append(
+                        f"{ARITH} -r {loop} {quote(init)}; "
+                        f"while {CFOR} {loop} {quote(cond)} {quote(step)}"
+                    )
+                    # "for ((...)) do": bash needs no separator before the do.
+                    if re.match(r"[ \t]*do\b", text[end + 2 :]):
+                        out.append(";")
+                    i, at_command, word_start = end + 2, False, False
+                    continue
+
+        if c in ";&|(":
+            out.append(c)
+            i += 1
+            at_command = word_start = True
+            continue
+        if c == ")":
+            # The end of a group, of a case pattern or of "name()": after
+            # each of the last two a command begins.
+            func_body = "".join(out[-3:]).rstrip(" \t").endswith("(")
+            out.append(c)
+            i += 1
+            at_command = word_start = True
+            continue
+        # An ordinary word.
+        j = i
+        while j < n and text[j] not in " \t\n;&|()<>'\"`\\$":
+            j += 1
+        if j == i:
+            j = i + 1
+        word = text[i:j]
+        out.append(word)
+        i = j
+        at_command = at_command and (word in _OPENERS or bool(re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", word)))
+        if word in _OPENERS and (j >= n or text[j] in " \t\n;"):
+            at_command = True
+        word_start = False
+    return "".join(out)
diff --git a/src/cowrie/shell/mirage_vars.py b/src/cowrie/shell/mirage_vars.py
new file mode 100644
index 0000000..1e472ee
--- /dev/null
+++ b/src/cowrie/shell/mirage_vars.py
@@ -0,0 +1,293 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE: the variables and options bash 5.2 keeps for itself, and how set,
+# ABOUTME: declare -p, export -p, readonly and shopt print them.
+
+"""What a bash 5.2 on Debian 12 has besides the environment.
+
+Stock Cowrie's ``set`` printed the environment and nothing else: seven lines
+where bash prints thirty-nine, without ``BASH_VERSION``, ``IFS``, ``PPID`` or
+``UID``. ``set`` is a command people run to look around.
+
+The table here was read off the reference host (``set``, ``declare -p``,
+``readonly``, ``shopt`` and ``set -o``, once through an exec request and once
+in a login shell): which variables exist, with which attributes, which of
+them have a value, and the two forms a value is printed in.
+"""
+
+from __future__ import annotations
+
+import random
+import time
+from dataclasses import dataclass
+from typing import Any
+
+BASH_VERSION = "5.2.15(1)-release"
+MACHINE = "x86_64"
+_VERSINFO = f'([0]="5" [1]="2" [2]="15" [3]="1" [4]="release" [5]="{MACHINE}-pc-linux-gnu")'
+_LOADABLES = (
+    "/usr/local/lib/bash:/usr/lib/bash:/opt/local/lib/bash:/usr/pkg/lib/bash:/opt/pkg/lib/bash:."
+)
+_PS1 = "${debian_chroot:+($debian_chroot)}\\u@\\h:\\w\\$ "
+# The variables bash will not let anyone assign or unset.
+READONLY = frozenset({"BASHOPTS", "BASH_VERSINFO", "EUID", "PPID", "SHELLOPTS", "UID"})
+
+# shopt's options, in the order shopt lists them.
+SHOPTS = (
+    "autocd assoc_expand_once cdable_vars cdspell checkhash checkjobs checkwinsize cmdhist "
+    "compat31 compat32 compat40 compat41 compat42 compat43 compat44 complete_fullquote "
+    "direxpand dirspell dotglob execfail expand_aliases extdebug extglob extquote failglob "
+    "force_fignore globasciiranges globskipdots globstar gnu_errfmt histappend histreedit "
+    "histverify hostcomplete huponexit inherit_errexit interactive_comments lastpipe lithist "
+    "localvar_inherit localvar_unset login_shell mailwarn no_empty_cmd_completion nocaseglob "
+    "nocasematch noexpand_translation nullglob patsub_replacement progcomp progcomp_alias "
+    "promptvars restricted_shell shift_verbose sourcepath varredir_close xpg_echo"
+).split()
+_SHOPTS_ON = frozenset(
+    "checkwinsize cmdhist complete_fullquote extquote force_fignore globasciiranges "
+    "globskipdots hostcomplete interactive_comments patsub_replacement progcomp promptvars "
+    "sourcepath".split()
+)
+# set -o's options, likewise.
+OPTIONS = (
+    "allexport braceexpand emacs errexit errtrace functrace hashall histexpand history "
+    "ignoreeof interactive-comments keyword monitor noclobber noexec noglob nolog notify "
+    "nounset onecmd physical pipefail posix privileged verbose vi xtrace"
+).split()
+_OPTIONS_ON = frozenset({"braceexpand", "hashall", "interactive-comments"})
+# The single letters of set (set -e, set +x) and the options they stand for.
+LETTERS = {
+    "a": "allexport", "B": "braceexpand", "e": "errexit", "E": "errtrace", "T": "functrace",
+    "h": "hashall", "H": "histexpand", "k": "keyword", "m": "monitor", "C": "noclobber",
+    "n": "noexec", "f": "noglob", "b": "notify", "u": "nounset", "t": "onecmd",
+    "P": "physical", "p": "privileged", "v": "verbose", "x": "xtrace",
+}  # fmt: skip
+# The characters that make set print a value in quotes (bash's
+# sh_contains_shell_metas).
+_METAS = frozenset(" \t\n'\"\\|&;()<>!{}*[?]^$`")
+_ESCAPES = {
+    "\a": "\\a", "\b": "\\b", "\x1b": "\\E", "\f": "\\f", "\n": "\\n", "\r": "\\r",
+    "\t": "\\t", "\v": "\\v", "\\": "\\\\", "'": "\\'",
+}  # fmt: skip
+# The order declare prints a variable's attributes in.
+_FLAG_ORDER = "aAfinrtxclu"
+
+
+def default_shopts(interactive: bool) -> set[str]:
+    return set(_SHOPTS_ON | ({"expand_aliases", "login_shell"} if interactive else set()))
+
+
+def default_options(interactive: bool) -> set[str]:
+    extra = {"emacs", "histexpand", "history", "monitor"} if interactive else set()
+    return set(_OPTIONS_ON | extra)
+
+
+@dataclass(frozen=True)
+class Var:
+    """One variable: ``flags`` are declare's letters; a scalar has ``value``,
+    an array ``literal`` (as bash prints it), and one that is declared but
+    not set has neither."""
+
+    name: str
+    flags: str = ""
+    value: str | None = None
+    literal: str | None = None
+
+    @property
+    def shown(self) -> str | None:
+        return self.literal if self.literal is not None else self.value
+
+
+def _control(value: str) -> bool:
+    return any(ord(c) < 32 or ord(c) == 127 for c in value)
+
+
+def ansi(value: str) -> str:
+    """``$'...'``, the form bash uses for a value with a control character."""
+    body = "".join(
+        _ESCAPES.get(c, f"\\{ord(c):03o}" if ord(c) < 32 or ord(c) == 127 else c) for c in value
+    )
+    return f"$'{body}'"
+
+
+def set_form(value: str) -> str:
+    """A value as ``set`` prints it: bare when nothing in it needs quoting."""
+    if _control(value):
+        return ansi(value)
+    needs = any(c in _METAS for c in value) or value[:1] == "#"
+    needs = needs or any(
+        c == "~" and (i == 0 or value[i - 1] in "=:") for i, c in enumerate(value)
+    )
+    if not needs:
+        return value
+    return "'" + value.replace("'", "'\\''") + "'"
+
+
+def declare_form(value: str) -> str:
+    """A value as ``declare -p`` prints it: in double quotes."""
+    if _control(value):
+        return ansi(value)
+    return '"' + "".join("\\" + c if c in '\\"$`' else c for c in value) + '"'
+
+
+def flags_of(shell: Any, name: str) -> str:
+    letters = set(shell.attributes.get(name, ""))
+    if name in shell.readonly:
+        letters.add("r")
+    if name in shell.exported:
+        letters.add("x")
+    return "".join(c for c in _FLAG_ORDER if c in letters)
+
+
+def _assoc(pairs: dict[str, str]) -> str:
+    if not pairs:
+        return "()"
+    return "(" + " ".join(f'[{key}]="{value}"' for key, value in pairs.items()) + " )"
+
+
+def variables(shell: Any) -> list[Var]:
+    """Every variable the shell has, bash's own and the session's, by name."""
+    interactive = bool(shell.interactive)
+    uid = str(shell.user.get("uid", 0))
+    environ = shell.environ
+    found: dict[str, Var] = {}
+
+    def add(name: str, flags: str = "", value: str | None = None, literal: str | None = None) -> None:
+        found[name] = Var(name, flags, value, literal)
+
+    add("BASH", value="/bin/bash" if interactive else "/usr/bin/bash")
+    add("BASHOPTS", "r", ":".join(sorted(shell.shopts)))
+    add("BASHPID", "i")
+    add("BASH_ALIASES", "A", literal=_assoc(dict(sorted(shell.aliases.items()))))
+    add("BASH_ARGC", "a", literal='([0]="0")')
+    add("BASH_ARGV", "a", literal="()")
+    add("BASH_ARGV0")
+    add("BASH_CMDS", "A", literal=_assoc({p.rsplit("/", 1)[-1]: p for p in shell.hashed}))
+    add("BASH_COMMAND")
+    if shell.execution_string is not None:
+        add("BASH_EXECUTION_STRING", value=shell.execution_string)
+    add("BASH_LINENO", "a", literal="()")
+    add("BASH_LOADABLES_PATH", value=_LOADABLES)
+    add("BASH_SOURCE", "a", literal="()")
+    add("BASH_SUBSHELL")
+    add("BASH_VERSINFO", "ar", literal=_VERSINFO)
+    add("BASH_VERSION", value=BASH_VERSION)
+    add("COMP_WORDBREAKS")
+    add("DIRSTACK", "a", literal="()")
+    add("EPOCHREALTIME")
+    add("EPOCHSECONDS")
+    add("EUID", "ir", uid)
+    add("FUNCNAME", "a")
+    add("GROUPS", "a", literal="()")
+    add("HISTCMD", "i")
+    add("HOSTNAME", value=str(shell.protocol.hostname))
+    add("HOSTTYPE", value=MACHINE)
+    add("IFS", value=" \t\n")
+    add("LINENO")
+    add("MACHTYPE", value=f"{MACHINE}-pc-linux-gnu")
+    add("OLDPWD", "x")
+    add("OPTERR", value="1")
+    add("OPTIND", "i", "1")
+    add("OSTYPE", value="linux-gnu")
+    add("PIPESTATUS", "a", literal=f'([0]="{shell.last_exit_code}")')
+    add("PPID", "ir", str(max(1, int(shell.pid) - 2)))
+    add("PS4", value="+ ")
+    add("PWD", "x", shell.cwd)
+    add("RANDOM", "i")
+    add("SECONDS")
+    add("SHELLOPTS", "r", ":".join(sorted(shell.options)))
+    add("SRANDOM", "i")
+    add("TERM", value="dumb")
+    add("UID", "ir", uid)
+    add("_", value=shell.last_arg)
+    if interactive:
+        size = getattr(shell.protocol.user, "windowSize", None) or (24, 80)
+        add("COLUMNS", value=str(size[1]))
+        add("LINES", value=str(size[0]))
+        home = environ.get("HOME") or "/"
+        add("HISTFILE", value=f"{home.rstrip('/')}/.bash_history")
+        add("HISTFILESIZE", value="500")
+        add("HISTSIZE", value="500")
+        add("MAILCHECK", "i", "60")
+        add("PS1", value=_PS1)
+        add("PS2", value="> ")
+
+    names = set(environ) | set(shell.attributes) | set(shell.exported) | set(shell.readonly)
+    for name in names:
+        if not name.replace("_", "a").isalnum() or name[:1].isdigit() or name in READONLY:
+            continue
+        if name == "PWD":
+            continue
+        flags = flags_of(shell, name)
+        value = environ.get(name)
+        if value is None and name in found and not flags.strip("x"):
+            continue  # exported, not set: bash's own entry stands (OLDPWD)
+        if "a" in flags or "A" in flags:
+            found[name] = Var(name, flags, None, None if value is None else f'([0]="{value}")')
+        else:
+            found[name] = Var(name, flags, value)
+    return [found[name] for name in sorted(found)]
+
+
+def set_lines(shell: Any) -> list[str]:
+    """``set`` with no arguments: every variable that has a value."""
+    out = []
+    for var in variables(shell):
+        if var.literal is not None:
+            out.append(f"{var.name}={var.literal}")
+        elif var.value is not None:
+            out.append(f"{var.name}={set_form(var.value)}")
+    return out
+
+
+def declare_line(var: Var) -> str:
+    """One line of ``declare -p``."""
+    head = f"declare -{var.flags or '-'} {var.name}"
+    if var.literal is not None:
+        return f"{head}={var.literal}"
+    if var.value is not None:
+        return f"{head}={declare_form(var.value)}"
+    return head
+
+
+def lookup(shell: Any, name: str) -> Var | None:
+    return next((v for v in variables(shell) if v.name == name), None)
+
+
+def dynamic(shell: Any, name: str) -> str | None:
+    """The value of one of bash's own variables, for an expansion."""
+    if name == "RANDOM":
+        return str(random.randint(0, 32767))
+    if name == "SRANDOM":
+        return str(random.getrandbits(32))
+    if name == "SECONDS":
+        return str(int(time.time() - getattr(shell.protocol, "logintime", time.time())))
+    if name == "EPOCHSECONDS":
+        return str(int(time.time()))
+    if name == "EPOCHREALTIME":
+        return f"{time.time():.6f}"
+    if name == "LINENO":
+        return str(shell.current_line)
+    if name == "BASHPID":
+        return str(shell.pid)
+    if name == "0":
+        return str(shell.name)
+    if name == "!":
+        return None if shell.background_pid is None else str(shell.background_pid)
+    if name == "-":
+        return "himBHs" if shell.interactive else "hBc"
+    if name in ("BASH_SUBSHELL", "GROUPS"):
+        return "0" if name == "BASH_SUBSHELL" else str(shell.user.get("gid", 0))
+    if name == "HISTCMD":
+        return "1"
+    if name == "PIPESTATUS":
+        return str(shell.last_exit_code)
+    if name == "DIRSTACK":
+        return str(shell.cwd)
+    if name == "BASH_VERSINFO":
+        return "5"
+    if name == "BASH_ARGC":
+        return "0"
+    if name == "SHELL":
+        return "/bin/bash"
+    var = lookup(shell, name)
+    return var.value if var is not None else None
