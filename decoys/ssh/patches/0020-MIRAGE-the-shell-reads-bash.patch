+class ParameterExpansionTests(Base):
+    def test_defaults_and_alternatives(self) -> None:
+        self.assertEqual(self.out('echo "${U:-fallback}" "${U-f2}" "[${U:+set}]"'), "fallback f2 []\n")
+        self.assertEqual(self.out('E=; echo "[${E:-d}]" "[${E-d}]" "[${E:+s}]" "[${E+s}]"'), "[d] [] [] [s]\n")
+        self.assertEqual(self.out('echo "${U:=made}" "$U"'), "made made\n")
+        # The word is expanded only when it is used, and may hold expansions of its own.
+        self.assertEqual(self.out('H=/h; echo "${U:-$H/x}" "${U:-$(echo sub)}" "${U:-${H}y}"'), "/h/x sub /hy\n")
+        self.assertEqual(self.out('echo ${U:-a b} | wc -w'), "2\n")
+        # Inside double quotes a single quote in the word is a character;
+        # outside them it quotes, and what it holds is not split.
+        self.assertEqual(self.out("echo \"${U:-'quoted words'}\""), "'quoted words'\n")
+        self.assertEqual(self.out("printf '<%s>' ${U:-'a  b' c}"), "<a  b><c>")
+        self.assertEqual(self.out('printf "<%s>" ${U:-"a  b"} "${U:-"a  b"}"'), "<a  b><a  b>")
+
+    def test_an_unset_parameter_that_must_be_set_ends_the_shell(self) -> None:
+        self.assertEqual(sh('echo "${U:?is needed}"; echo after'), ("", "bash: line 1: U: is needed\n"))
+        self.assertEqual(sh('echo "${U:?}"; echo after'), ("", "bash: line 1: U: parameter null or not set\n"))
+        self.assertEqual(self.out('U=x; echo "${U:?no}"; echo after'), "x\nafter\n")
+
+    def test_removing_and_replacing(self) -> None:
+        self.assertEqual(self.out('F=archive.tar.gz; echo ${F%.*} ${F%%.*} ${F#*.} ${F##*.}'), "archive.tar archive tar.gz gz\n")
+        self.assertEqual(self.out('P=/usr/local/bin; echo ${P##*/} ${P%/*} ${P/local/share} ${P//\\//:}'), "bin /usr/local /usr/share/bin :usr:local:bin\n")
+        self.assertEqual(self.out('S="a b a"; echo "${S/a/X}" "${S//a/X}" "${S/#a/X}" "${S/%a/X}" "${S/b}"'), "X b a X b X X b a a b X a  a\n")
+        self.assertEqual(self.out('V=hello; echo ${#V} ${V:1} ${V:1:3} ${V: -2} ${V^} ${V^^} ${V:0:-1}'), "5 ello ell lo Hello HELLO hell\n")
+        self.assertEqual(self.out('n=2; V=hello; echo ${V:n} ${V:n+1:1}'), "llo l\n")
+
+    def test_indirection_and_special_parameters(self) -> None:
+        self.assertEqual(self.out('A=B; B=value; echo ${!A}'), "value\n")
+        self.assertEqual(self.out('set -- a b c; echo ${#} ${1:-x} ${4:-none} ${#1}'), "3 a none 1\n")
+        self.assertEqual(self.out('echo "${HOME}" ${HOME%oot}'), "/root /r\n")
+
+    def test_what_is_not_an_expansion_is_said_so(self) -> None:
+        # bash says so and drops the rest of that line; the next one runs.
+        self.assertEqual(
+            sh("echo ${V!x}; echo after"), ("", "bash: line 1: ${V!x}: bad substitution\n")
+        )
+        self.assertEqual(
+            sh("echo ${V!x}; echo after\necho next $?"),
+            ("next 1\n", "bash: line 1: ${V!x}: bad substitution\n"),
+        )
+        self.assertEqual(sh("echo ${}")[1], "bash: line 1: ${}: bad substitution\n")
+
+    def test_in_a_here_document_and_in_backticks(self) -> None:
+        self.assertEqual(self.out('cat <<EOF\n${U:-from here}\nEOF'), "from here\n")
+        self.assertEqual(self.out('echo `echo ${U:-tick}`'), "tick\n")
