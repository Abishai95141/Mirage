+
+def _slice(params: list[str], zero: str, offset: int, length: int | None) -> list[str] | None:
+    """``${@:offset:length}``: counted from $1, with $0 at offset 0, and from
+    the end when the offset is negative. None when the length is below zero."""
+    seq = [zero, *params]
+    if offset < 0:
+        offset = len(seq) + offset
+        if offset < 0:
+            return []
+    if length is None:
+        return seq[offset:]
+    if length < 0:
+        return None
+    return seq[offset : offset + length]
+
+
+async def at_fields(
+    inner: str, context: Any, expand_word: Callable[[str, str], Awaitable[str]]
+) -> list[str] | None:
+    """For ``${@:offset}`` and ``${@:offset:length}``: the positional
+    parameters it names, each one a field of its own inside double quotes.
+    None for any other expansion."""
+    if not inner.startswith("@:") or inner[2:3] in ("-", "=", "+", "?"):
+        return None
+    offset_text, sep, length_text = inner[2:].partition(":")
+    lookup = context.get_variable
+    try:
+        offset = _number(await expand_word(offset_text, "plain"), lookup)
+        length = _number(await expand_word(length_text, "plain"), lookup) if sep else None
+    except arithmetic.ArithmeticExpansionError:
+        raise ExpansionError("${" + inner + "}: bad substitution") from None
+    fields = _slice(_positional(context), lookup("0") or "", offset, length)
+    if fields is None:
+        raise ExpansionError(f"{length_text.strip()}: substring expression < 0")
+    return fields
+
+
+def _positional(context: Any) -> list[str]:
+    count = context.get_variable("#") or "0"
+    return [context.get_variable(str(i)) or "" for i in range(1, int(count) + 1)] if count.isdigit() else []
+
+
+def _number(text: str, lookup: Any) -> int:
+    return arithmetic.evaluate(text, lookup) if text.strip() else 0
+
+
+def _strip(value: str, pattern: str, suffix: bool, longest: bool) -> str:
+    rx = re.compile(_pattern(pattern), re.S)
+    cuts = range(len(value) + 1)
+    if suffix:
+        order = cuts if longest else reversed(cuts)
+        for i in order:
+            if rx.fullmatch(value[i:]):
+                return value[:i]
+    else:
+        order = reversed(cuts) if longest else cuts
+        for i in order:
+            if rx.fullmatch(value[:i]):
+                return value[i:]
+    return value
+
+
+def _replace(value: str, anchor: str, pattern: str, replacement: str, every: bool) -> str:
+    if not pattern:
+        return value
+    rx = _pattern(pattern)
