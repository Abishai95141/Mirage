+            ("1 0\n", "bash: line 1: unset: UID: cannot unset: readonly variable\n"),
+        )
+        self.assertEqual(self.out("f() { :; }; unset f; type -t f; echo $?"), "1\n")
+        self.assertEqual(self.out("f() { :; }; f=1; unset f; type -t f; unset -f f; type -t f"), "function\n")
+        self.assertEqual(self.out("declare -i n=5; unset n; n=2+2; echo $n"), "2+2\n")
