+    """An expansion bash refuses, with bash's message. ``fatal`` is set where
+    a shell that is not interactive exits (``${x:?}``)."""
+
+    def __init__(self, message: str, fatal: bool = False) -> None:
+        Exception.__init__(self, message)
+        self.fatal = fatal
