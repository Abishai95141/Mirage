+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE: a shell function's body printed back the way bash prints it
+# ABOUTME: (type NAME, declare -f, and the end of set's listing).
+
+"""bash does not keep a function's text: it keeps the parsed commands and
+prints them back in its own layout (print_cmd.c). ``type f`` on a function,
+``declare -f`` and ``set`` all show that layout, four spaces to a level:
+
+    f ()
+    {
+        for i in 1 2;
+        do
+            echo $i;
+        done;
+        if true; then
+            echo y;
+        fi
+    }
+
+The words of a command are printed as they were written. The layout rules
+here were read off the reference host for each kind of command.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from lark import Tree
+
+from cowrie.shell import mirage_syntax
+from cowrie.shell.bashparse import (
+    BraceGroup,
+    CaseClause,
+    Command,
+    ForClause,
+    FunctionDef,
+    IfClause,
+    Pipeline,
+    Subshell,
+    WhileClause,
+)
+from cowrie.shell.prescan import HereDoc
+
+STEP = "    "
+
+
+def _unquote(text: str) -> str:
+    """The text mirage_syntax.quote() put in single quotes."""
+    if len(text) >= 2 and text[0] == "'" and text[-1] == "'":
+        return text[1:-1].replace("'\\''", "'")
+    return text
+
+
+class Printer:
+    def __init__(self, parser: Any) -> None:
+        self.parser = parser
+
+    def function(self, name: str, body: list[Any]) -> str:
+        return f"{name} () \n{{ \n{STEP}{self.block(body, STEP, closed=False)}\n}}"
+
+    # -- lists --------------------------------------------------------------
+
+    def block(self, statements: list[Any], indent: str, closed: bool) -> str:
+        """Statements one to a line. In the body of a loop or an ``if`` the
+        last one ends with a semicolon too (``closed``); in a function, a
+        group or a case it does not."""
+        out = ""
+        items = self._merged(statements, indent)
+        for index, (text, after, _op) in enumerate(items):
+            last = index == len(items) - 1
+            out += text
+            if after == "heredoc":
+                out += "" if last else "\n" + indent
+            elif after == "&":
+                out += " &" if last else " & "
+            elif not last and items[index + 1][2] in ("&&", "||"):
+                out += f" {items[index + 1][2]} "
+            elif last:
+                out += ";" if closed else ""
+            else:
+                out += ";\n" + indent
+        return out
+
+    def inline(self, statements: list[Any], indent: str) -> str:
+        """Statements on one line (a condition, a subshell)."""
+        out = ""
+        items = self._merged(statements, indent)
+        for index, (text, after, _op) in enumerate(items):
+            last = index == len(items) - 1
+            out += text
+            if after == "&":
+                out += " &" if last else " & "
+            elif not last and items[index + 1][2] in ("&&", "||"):
+                out += f" {items[index + 1][2]} "
+            elif not last:
+                out += "; "
+        return out
+
+    def _merged(self, statements: list[Any], indent: str) -> list[tuple[str, str, str | None]]:
+        """Each statement's text, what follows it ("&", "heredoc" or
+        nothing) and its joining operator, with a ``for ((;;))`` that the
+        rewriter split in two put back together."""
+        out: list[tuple[str, str, str | None]] = []
+        skip = False
+        for index, statement in enumerate(statements):
+            if skip:
+                skip = False
+                continue
+            following = statements[index + 1] if index + 1 < len(statements) else None
+            parts = self._cfor(statement, following)
+            if parts is not None and isinstance(following, WhileClause):
+                inner = indent + STEP
+                text = (
+                    f"for (({parts[0]}; {parts[1]}; {parts[2]}))\n{indent}do\n{inner}"
+                    + self.block(following.body, inner, closed=True)
+                    + f"\n{indent}done"
+                )
+                out.append((text + self._redirections(following), "", statement.op))
+                skip = True
+                continue
+            text, after = self.statement(statement, indent)
+            if getattr(statement, "background", False):
+                after = "&"
+            out.append((text, after, getattr(statement, "op", None)))
+        return out
+
+    # -- one statement ------------------------------------------------------
+
+    def statement(self, node: Any, indent: str) -> tuple[str, str]:
+        """A statement's text and what follows it."""
+        inner = indent + STEP
+        if isinstance(node, Command):
+            return self.command(node)
+        if isinstance(node, Pipeline):
+            texts = [self.statement(stage, indent)[0] for stage in node.stages]
+            return " | ".join(texts), ""
+        if isinstance(node, Subshell):
+            text = "( " + self.inline(node.statements, indent) + " )"
+            return text + self._redirections(node), ""
+        if isinstance(node, BraceGroup):
+            negated = self._negated(node)
+            if negated is not None:
+                return "! " + self.inline(negated, indent), ""
+            text = "{ \n" + inner + self.block(node.statements, inner, closed=False)
+            return text + f"\n{indent}}}" + self._redirections(node), ""
+        if isinstance(node, IfClause):
+            return self._if(node.branches, node.else_body, indent) + self._redirections(node), ""
+        if isinstance(node, WhileClause):
+            word = "until" if node.until else "while"
+            text = (
+                f"{word} {self.inline(node.condition, indent)}; do\n{inner}"
+                + self.block(node.body, inner, closed=True)
+                + f"\n{indent}done"
+            )
+            return text + self._redirections(node), ""
+        if isinstance(node, ForClause):
+            words = self._words(node.items) if node.items is not None else []
+            text = (
+                f"for {node.var} in {' '.join(words) if words else chr(34) + '$@' + chr(34)};"
+                f"\n{indent}do\n{inner}"
+                + self.block(node.body, inner, closed=True)
+                + f"\n{indent}done"
+            )
+            return text + self._redirections(node), ""
+        if isinstance(node, CaseClause):
+            word = " ".join(self._words(node.word)) if node.word is not None else ""
+            text = f"case {word} in \n"
+            deeper = inner + STEP
+            for patterns, body in node.items:
+                text += f"{inner}{' | '.join(patterns)})\n"
+                if body:
+                    text += deeper + self.block(body, deeper, closed=False) + "\n"
+                text += f"{inner};;\n"
+            return text + f"{indent}esac" + self._redirections(node), ""
+        if isinstance(node, FunctionDef):
+            text = (
+                f"function {node.name} () \n{indent}{{ \n{inner}"
+                + self.block(node.body, inner, closed=False)
+                + f"\n{indent}}}"
+            )
+            return text, ""
+        return "", ""
+
+    def _if(self, branches: list[Any], else_body: list[Any] | None, indent: str) -> str:
+        inner = indent + STEP
+        condition, body = branches[0]
+        text = (
+            f"if {self.inline(condition, indent)}; then\n{inner}"
+            + self.block(body, inner, closed=True)
+        )
+        if len(branches) > 1:
+            # bash keeps an elif as an if inside the else.
+            text += f"\n{indent}else\n{inner}" + self._if(branches[1:], else_body, inner) + ";"
+        elif else_body is not None:
+            text += f"\n{indent}else\n{inner}" + self.block(else_body, inner, closed=True)
+        return text + f"\n{indent}fi"
+
+    # -- simple commands ----------------------------------------------------
+
+    def _words(self, command: Command) -> list[str]:
+        return [
+            self.parser._word_source(command.line, item)
+            for item in command.items
+            if isinstance(item, Tree)
+        ]
+
+    def command(self, command: Command) -> tuple[str, str]:
+        words = self._words(command)
+        if words[:1] == [mirage_syntax.COND]:
+            return "[[ " + _unquote(words[1] if len(words) > 1 else "") + " ]]", ""
+        if words[:1] == [mirage_syntax.ARITH]:
+            return "(( " + _unquote(words[-1] if len(words) > 1 else "").strip() + " ))", ""
+        out: list[str] = []
+        after = ""
+        heredocs: list[HereDoc] = []
+        items = list(command.items)
+        index = 0
+        while index < len(items):
+            item = items[index]
+            if isinstance(item, HereDoc):
+                heredocs.append(item)
+                fd = str(item.fd) if item.fd else ""
+                delimiter = item.delimiter if item.expand else f"'{item.delimiter}'"
+                out.append(f"{fd}<<{delimiter}")
+            elif isinstance(item, Tree):
+                out.append(self.parser._word_source(command.line, item))
+            else:
+                # A redirection: its target follows, apart from a duplication
+                # ("2>&1"), which bash prints closed up.
+                target = items[index + 1] if index + 1 < len(items) else None
+                if isinstance(target, Tree):
+                    name = self.parser._word_source(command.line, target)
+                    out.append(f"{item}{name}" if str(item).endswith("&") else f"{item} {name}")
+                    index += 1
+                else:
+                    out.append(str(item))
+            index += 1
+        text = " ".join(out)
+        if heredocs:
+            text += "\n" + "".join(f"{h.body}{h.delimiter}\n" for h in heredocs)
+            return text, "heredoc" if not after else after
+        return text, after
+
+    def _redirections(self, node: Any) -> str:
+        extra = getattr(node, "redirections", None)
+        if extra is None:
+            return ""
+        text, _ = self.command(extra)
+        return " " + text if text else ""
+
+    # -- what the rewriter made ---------------------------------------------
+
+    def _negated(self, group: BraceGroup) -> list[Any] | None:
+        """For the group ``! PIPELINE`` was rewritten into: the pipeline."""
+        if not group.statements:
+            return None
+        last = group.statements[-1]
+        if isinstance(last, Command) and self._words(last)[:1] == [mirage_syntax.NOT]:
+            return list(group.statements[:-1])
+        return None
+
+    def _cfor(self, first: Any, second: Any) -> tuple[str, str, str] | None:
+        """For the two statements ``for ((A; B; C))`` was rewritten into: its
+        three expressions."""
+        if not isinstance(first, Command) or not isinstance(second, WhileClause):
+            return None
+        head = self._words(first)
+        if head[:2] != [mirage_syntax.ARITH, "-r"] or len(head) < 4:
+            return None
+        if len(second.condition) != 1 or not isinstance(second.condition[0], Command):
+            return None
+        test = self._words(second.condition[0])
+        if test[:1] != [mirage_syntax.CFOR] or len(test) < 4:
+            return None
+        return _unquote(head[3]), _unquote(test[2]), _unquote(test[3])
+
+
+def function_text(shell: Any, name: str) -> str:
+    """``name () { ... }`` as bash prints it."""
+    return Printer(shell.bashparser).function(name, shell.functions[name])
