+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: Tests the parts of bash MIRAGE added to the Cowrie shell: parameter and brace
+# ABOUTME: expansion, [[ ]], (( )), for ((;;)), "!", and the builtins scripts rely on.
+
+from __future__ import annotations
+
+import unittest
+from typing import Any
+
+from cowrie import mirage_gate
+from cowrie.shell import mirage_param, mirage_syntax, mirage_vars
+from cowrie.test.test_mirage_gate import GateTestBase
+from cowrie.test.test_mirage_stderr import run_exec
+
+
+def sh(line: str) -> tuple[str, str]:
+    out, err = run_exec(line.encode())
+    return out.decode("utf8", "replace"), err.decode("utf8", "replace")
+
+
+class Base(unittest.TestCase):
+    def setUp(self) -> None:
+        mirage_gate.reset_for_tests(None)
+
+    def tearDown(self) -> None:
+        mirage_gate.reset_for_tests()
+
+    def out(self, line: str) -> str:
+        out, err = sh(line)
+        self.assertEqual(err, "", line)
+        return out
