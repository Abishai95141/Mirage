+        # pattern from its replacement.
+        cut, i = None, 0
+        while i < len(body):
+            if body[i] == "\\" and i + 1 < len(body):
+                i += 2
+                continue
+            if body[i] in "'\"":
+                end = body.find(body[i], i + 1)
+                i = len(body) if end < 0 else end + 1
+                continue
+            if body[i] == "/":
+                cut = i
+                break
+            i += 1
