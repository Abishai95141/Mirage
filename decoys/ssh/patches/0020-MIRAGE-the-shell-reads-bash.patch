+            "BASH_EXECUTION_STRING='f() { echo hi; }; x='\\''a b'\\''; set'",
+            'BASH_VERSINFO=([0]="5" [1]="2" [2]="15" [3]="1" [4]="release" [5]="x86_64-pc-linux-gnu")',
+            "BASH_VERSION='5.2.15(1)-release'",
+            "EUID=0",
+            "IFS=$' \\t\\n'",
+            "OPTIND=1",
+            "PS4='+ '",
+            "SHELLOPTS=braceexpand:hashall:interactive-comments",
+            "TERM=dumb",
+            "UID=0",
+            "_=",
+            "x='a b'",
+        ):
+            self.assertIn(line, lines)
+        # What has no value is not listed, and the functions come last.
+        self.assertNotIn("RANDOM", names)
+        self.assertNotIn("OLDPWD", names)
+        self.assertTrue(out.endswith("f () \n{ \n    echo hi\n}\n"))
+
+    def test_the_two_forms_of_a_value(self) -> None:
+        for value, as_set, as_declare in (
+            ("plain/path:1.2-x", "plain/path:1.2-x", '"plain/path:1.2-x"'),
+            ("", "", '""'),
+            ("a b", "'a b'", '"a b"'),
+            ("it's", "'it'\\''s'", '"it\'s"'),
+            ('$d"q', "'$d\"q'", '"\\$d\\"q"'),
+            ("t\tb", "$'t\\tb'", "$'t\\tb'"),
+            ("~user", "'~user'", '"~user"'),
+            ("a:~b", "'a:~b'", '"a:~b"'),
+            ("a~b", "a~b", '"a~b"'),
+            ("#c", "'#c'", '"#c"'),
+            ("a#c", "a#c", '"a#c"'),
+            ("]", "']'", '"]"'),
+        ):
+            self.assertEqual(mirage_vars.set_form(value), as_set, value)
+            self.assertEqual(mirage_vars.declare_form(value), as_declare, value)
+
+    def test_declare_and_export_print_attributes(self) -> None:
+        out = self.out("declare -p UID BASH_VERSINFO OPTIND IFS RANDOM HOME")
+        self.assertEqual(
