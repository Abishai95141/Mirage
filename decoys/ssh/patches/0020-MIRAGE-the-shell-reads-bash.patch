+        value = get(value) if value else None
+    if not rest:
+        return value or ""
+
+    for op in (":-", ":=", ":+", ":?", "-", "=", "+", "?"):
+        if rest.startswith(op):
+            word = rest[len(op) :]
+            colon = op.startswith(":")
+            missing = value is None or (colon and value == "")
+            kind = op[-1]
