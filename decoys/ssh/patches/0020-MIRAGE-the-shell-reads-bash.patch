+        # The longest match from the start, as bash takes it.
+        for end in range(len(value), -1, -1):
+            if re.fullmatch(f"(?s:{rx})", value[:end]):
+                return replacement + value[end:]
+        return value
+    if anchor == "%":
+        for start in range(len(value) + 1):
+            if re.fullmatch(f"(?s:{rx})", value[start:]):
+                return value[:start] + replacement
+        return value
+    out, i, done = [], 0, False
+    while i <= len(value):
+        hit = None
+        if not done or every:
+            for end in range(len(value), i, -1):  # longest at this place
+                if re.fullmatch(f"(?s:{rx})", value[i:end]):
+                    hit = end
+                    break
+        if hit is not None:
+            out.append(replacement)
+            i = hit
+            done = True
+            if not every:
+                out.append(value[i:])
+                break
+        else:
+            if i < len(value):
+                out.append(value[i])
+            i += 1
+    return "".join(out)
+
+
+async def expand(
+    inner: str,
+    context: Any,
+    expand_word: Callable[[str, str], Awaitable[str]],
+) -> str:
+    """The value of ``${inner}``.
+
+    ``expand_word(text, kind)`` expands a word that stands inside the
+    expansion: ``"word"`` for the word of ``-``, ``=``, ``+`` and ``?`` and
+    for a replacement, ``"pattern"`` for a pattern (what is quoted in it
+    comes back marked, and is literal), ``"plain"`` for an offset or length.
+    A ``"word"`` may come back with marks too, where the expansion stands
+    outside double quotes: its quoted parts are not to be split.
+    """
+    lookup = context.get_variable
+
+    def get(name: str) -> str | None:
+        if name == "?":
+            return str(context.get_status())
+        if name == "$":
+            return str(context.get_pid())
+        if name == "#":
