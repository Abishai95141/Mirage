+        return value[:1].upper() + value[1:]
+    if rest == ",":
+        return value[:1].lower() + value[1:]
+    if rest.startswith("@") and len(rest) == 2:
+        how = rest[1]
+        if how == "Q":
+            return shell_quote(value) if get(name) is not None else ""
+        if how == "U":
+            return value.upper()
+        if how == "L":
+            return value.lower()
+        if how == "u":
+            return value[:1].upper() + value[1:]
+        if how == "E":
+            return ansi_c(value)
+        if how == "P":
+            return value
+        if how == "A":
+            return f"{name}={shell_quote(value)}" if get(name) is not None else ""
+        if how in "aKk":
+            return shell_quote(value) if how in "Kk" and get(name) is not None else ""
+        raise bad
+    if rest.startswith(":"):
+        offset_text, sep, length_text = rest[1:].partition(":")
+        try:
+            offset = _number(await expand_word(offset_text, "plain"), lookup)
+            length = _number(await expand_word(length_text, "plain"), lookup) if sep else None
+        except arithmetic.ArithmeticExpansionError:
+            raise bad from None
+        if name in ("@", "*"):
+            fields = _slice(_positional(context), lookup("0") or "", offset, length)
+            if fields is None:
+                raise ExpansionError(f"{length_text.strip()}: substring expression < 0")
