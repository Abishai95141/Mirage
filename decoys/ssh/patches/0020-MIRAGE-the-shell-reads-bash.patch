+        replacement = "" if cut is None else body[cut + 1 :]
+        anchor = pattern[:1] if pattern[:1] in ("#", "%") else ""
+        pattern = await expand_word(pattern[len(anchor) :], "pattern")
+        return _replace(value, anchor, pattern, await expand_word(replacement, "word"), every)
+    for op, change in (("^^", str.upper), (",,", str.lower)):
+        if rest == op:
+            return change(value)
