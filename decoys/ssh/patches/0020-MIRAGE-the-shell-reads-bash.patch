+class BackgroundTests(Base):
+    """``cmd &``. Stock Cowrie gave the "&" to the command as an argument:
+    ``echo hi &`` printed "hi &"."""
+
+    def test_the_command_runs_and_the_line_goes_on(self) -> None:
+        self.assertEqual(self.out("echo hi &"), "hi\n")
+        self.assertEqual(self.out("echo a & wait; echo b"), "a\nb\n")
+        self.assertEqual(self.out("echo a &\necho b"), "a\nb\n")
+        self.assertEqual(
+            sh("ls /nonexistent & echo b"),
+            ("b\n", "ls: cannot access '/nonexistent': No such file or directory\n"),
+        )
+        self.assertEqual(self.out("( echo sub; echo two ) & wait; echo x | cat & wait"), "sub\ntwo\nx\n")
+        self.assertEqual(self.out("for i in 1 2; do echo $i; done & { echo g; } & wait"), "1\n2\ng\n")
+        self.assertEqual(self.out("true && echo yes & false || echo no &"), "yes\nno\n")
+
+    def test_its_status_and_its_process_id(self) -> None:
+        # The line's status is 0 whatever the job did; wait PID has the job's.
+        self.assertEqual(self.out("false & echo $?; wait $!; echo $?"), "0\n1\n")
+        self.assertEqual(sh("ls /nonexistent & wait; echo $?")[0], "0\n")
+        self.assertEqual(self.out('echo "[$!]"'), "[]\n")
+        self.assertRegex(self.out("true & echo $!"), r"^\d+\n$")
+        self.assertEqual(
+            sh("wait 99999; echo $?"),
+            ("127\n", "bash: line 1: wait: pid 99999 is not a child of this shell\n"),
+        )
+
+    def test_what_may_not_follow_it(self) -> None:
+        for line, token in (("echo a &; echo b", ";"), ("echo a & && echo b", "&&"), ("& echo x", "&")):
+            self.assertEqual(
+                sh(line),
+                (
+                    "",
+                    f"bash: -c: line 1: syntax error near unexpected token `{token}'\n"
+                    f"bash: -c: line 1: `{line}'\n",
+                ),
+            )
+
+    def test_a_function_is_printed_with_it(self) -> None:
+        self.assertEqual(
+            self.out("f() { echo fn & wait; }; declare -f f"), "f () \n{ \n    echo fn & wait\n}\n"
+        )
