+            if kind == "=":
+                if not missing:
+                    return value or ""
+                new = await expand_word(word, "word")
+                setter = getattr(context, "set_variable", None)
+                if setter is None or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
+                    raise ExpansionError(f"${name}: cannot assign in this way")
+                setter(name, mirage_glob.unprotect(new))
+                return new
+            if kind == "+":
+                return "" if missing else await expand_word(word, "word")
+            if not missing:  # "?"
+                return value or ""
+            said = mirage_glob.unprotect(await expand_word(word, "word")) if word else ""
+            default = "parameter null or not set" if colon else "parameter not set"
+            raise ExpansionError(f"{name}: {said or default}", fatal=True)
+
+    value = value or ""
+    for op in ("##", "#", "%%", "%"):
+        if rest.startswith(op):
+            pattern = await expand_word(rest[len(op) :], "pattern")
+            return _strip(value, pattern, suffix=op[0] == "%", longest=len(op) == 2)
+    if rest.startswith("/"):
+        every = rest.startswith("//")
+        body = rest[2 if every else 1 :]
