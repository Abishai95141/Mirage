 from __future__ import annotations
 
+import re
 from dataclasses import dataclass, field
 
 # Frames of the context stack, named by the character that closes each
@@ -39,6 +40,11 @@ _PAREN = "("
 _CMDSUB = ")"
 _BRACE = "}"
 
+# MIRAGE: a whole "$((...))" (the grammar's ARITH: parentheses balanced three
+# deep). Inside one, "<<" shifts a number; it opens no here-document.
+_GROUP = r"\((?:[^()]|\((?:[^()]|\((?:[^()])*\))*\))*\)"
+_ARITH = re.compile(r"\$\(\((?:[^()]|" + _GROUP + r")*\)\)")
+
 # Characters a here-document delimiter word ends at (unless quoted).
 _DELIMITER_END = " \t\r\n;|&<>()"
 # After one of these a "#" starts a comment and a digit run can be an fd.
@@ -202,6 +208,8 @@ class _Scanner:
         if c == "\\":
             self.i += 2 if text[self.i + 1 : self.i + 2] in ("$", "`", '"', "\\") else 1
             return
+        if c == "$" and text.startswith("$((", self.i) and self._shift_arithmetic():
+            return
         if c == "$" and text.startswith("$(", self.i):
             self.stack.append((_CMDSUB, self.line))
             self.i += 2
@@ -214,6 +222,18 @@ class _Scanner:
             self.line += 1
         self.i += 1
 
+    def _shift_arithmetic(self) -> bool:
+        """MIRAGE: at a ``$((...))`` that holds ``<<``: step over it whole,
+        so that ``$(( 1 << 4 ))`` is arithmetic and not the start of a
+        here-document delimited by ``4``."""
+        match = _ARITH.match(self.text, self.i)
+        if match is None or "<<" not in match.group():
+            return False
+        self.line += match.group().count("\n")
+        self.i = match.end()
+        self.word_start = False
+        return True
+
     def _in_command(self) -> None:
         """Unquoted text at the top level or inside ``(...)`` / ``$(...)``."""
         text, i, n = self.text, self.i, self.n
@@ -255,6 +275,22 @@ class _Scanner:
                 return
             self._heredoc_operator()
             return
+        if c == "$" and text.startswith("$((", i) and self._shift_arithmetic():
+            return
+        if c == "$" and text.startswith("$'", i):
+            # MIRAGE: $'...' (grammar: ANSI_C), in which a backslash escapes
+            # the quote, so "$'it\'s'" is one string and not an open one.
+            j = i + 2
+            while j < n and text[j] != _SQ:
+                j += 2 if text[j] == "\\" else 1
+            if j >= n:
+                self.stack.append((_SQ, self.line))
+                self.i = n
+                return
+            self.line += text.count("\n", i, j)
+            self.i = j + 1
+            self.word_start = False
+            return
