@@ -0,0 +1,99 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: Holds the emulated shell to what bash 5.2 on a real Debian 12 host printed
+# ABOUTME: for the same lines of ordinary shell syntax.
+
+"""``mirage_shell_reference.jsonl`` is a recording: lines of everyday bash
+(parameter expansion, tests, loops, functions, builtins, quoting, and the
+errors bash reports for what it cannot read) sent as SSH exec requests to the
+reference host, and what came back. Each is run through the emulated shell
+here and must give the same stdout and stderr.
+
+``GAPS`` names the lines that do not, with the reason. A line listed there
+that starts to match fails the test too, so that the list cannot go stale.
+
+The recording was made on 17 November 2026, in six batches. When the first
+(27 lines) was made, stock Cowrie's shell matched 6 of them: ``${x:-y}`` was
+a syntax error, and ``[[``, ``((``, ``local``, ``return``, ``shift``,
+``eval`` and ``source`` were "command not found". The later batches were
+written to find what still differed, and each difference they found was
+fixed: which errors end only the line they are on, how an error inside a
+function or a sourced file is labelled, what ``declare -f`` prints. Lines
+whose answer belongs to the host that gave it (process IDs, ``set`` with its
+SSH_CLIENT) are not in the file; the probe suite compares those live.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import unittest
+from pathlib import Path
+
+from cowrie import mirage_gate
+from cowrie.test.test_mirage_stderr import run_exec
+
+RECORDS = [
+    json.loads(line)
+    for line in (Path(__file__).parent / "mirage_shell_reference.jsonl")
+    .read_text(encoding="utf8")
+    .splitlines()
+]
+
+# A substring of the line -> why the emulated shell does not answer it as bash did.
+GAPS = {
+    "a=(x y z)": "arrays: this shell has none (a known limit)",
+    "exec 3>/tmp/pf1": "file descriptors opened by exec, PIPESTATUS, pipefail and set -x",
+    "echo b & wait": "needs a running reactor (sleep): compared live by the probe suite",
+    "paste -sd+": "the stock test tree has no paste; compared live by the probe suite",
+    "hash 2>/dev/null": "the stock test tree has no /usr/bin/which or /usr/bin/echo to find",
+}
+
+
+_PID = re.compile(r'(PPID="?)\d+')
+
+
+def gap(cmd: str) -> str | None:
+    return next((why for part, why in GAPS.items() if part in cmd), None)
+
+
+class ShellReferenceTests(unittest.TestCase):
+    maxDiff = None
+
+    def setUp(self) -> None:
+        mirage_gate.reset_for_tests(None)
+
+    def tearDown(self) -> None:
+        mirage_gate.reset_for_tests()
+
+    def answer(self, cmd: str) -> tuple[str, str]:
+        out, err = run_exec(cmd.encode())
+        return out.decode("utf8", "replace"), err.decode("utf8", "replace")
+
+    def test_the_recording_is_whole(self) -> None:
+        self.assertEqual(len(RECORDS), 234)
+        self.assertEqual(sum(1 for r in RECORDS if gap(r["cmd"])), len(GAPS))
+
+    def test_every_line_answers_as_bash_did(self) -> None:
+        wrong = []
+        for record in RECORDS:
+            if gap(record["cmd"]):
+                continue
+            got = self.answer(record["cmd"])
+            # A process ID is the host's own.
+            wanted = (_PID.sub(r"\1N", record["stdout"]), record["stderr"])
+            if (_PID.sub(r"\1N", got[0]), got[1]) != wanted:
+                wrong.append(
+                    f"\n$ {record['cmd']}\n  wanted: {(record['stdout'], record['stderr'])!r}"
+                    f"\n  got:    {got!r}"
+                )
+        self.assertEqual(wrong, [], f"{len(wrong)} lines differ:" + "".join(wrong))
+
+    def test_a_listed_gap_is_still_a_gap(self) -> None:
+        closed = [
+            r["cmd"][:60]
+            for r in RECORDS
+            if gap(r["cmd"])
+            and "reactor" not in (gap(r["cmd"]) or "")
+            and self.answer(r["cmd"]) == (r["stdout"], r["stderr"])
+        ]
+        self.assertEqual(closed, [], "these now match: take them off the list")
