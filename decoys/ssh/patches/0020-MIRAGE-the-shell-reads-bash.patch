+class ConditionalTests(Base):
+    def true(self, expression: str) -> bool:
+        out, err = sh(f"[[ {expression} ]]; echo $?")
+        self.assertEqual(err, "", expression)
+        return out == "0\n"
+
+    def test_strings_and_patterns(self) -> None:
+        self.assertTrue(self.true("abc == a*"))
+        self.assertFalse(self.true('abc == "a*"'))  # a quoted pattern is a string
+        self.assertTrue(self.true('"a*" == "a*"'))
+        self.assertTrue(self.true("abc != x*") and self.true("abc = abc") and self.true("a < b"))
+        self.assertTrue(self.true("abc =~ ^a(b|x)c$") and self.true("v1.2.3 =~ [0-9]+\\.[0-9]+"))
+        self.assertTrue(self.true("-z $UNSET") and self.true('-n "x"') and self.true("word"))
+        self.assertFalse(self.true("$UNSET") or self.true('-n ""'))
+        self.assertEqual(sh('V="two words"; [[ $V == "two words" ]] && echo same')[0], "same\n")  # not split
+
+    def test_numbers_files_and_logic(self) -> None:
+        self.assertTrue(self.true("3 -gt 2 && 2 -le 2 && 10 -eq 5+5"))
+        self.assertTrue(self.true("-f /etc/passwd && -d /etc && -e /tmp && ! -e /nope"))
+        self.assertTrue(self.true("( -f /nope || -d /tmp ) && ! ( 1 -gt 2 )"))
+        self.assertTrue(self.true("-r /etc/passwd") and self.true("-v HOME"))
+        self.assertFalse(self.true("-f /etc") or self.true("-L /etc/passwd") or self.true("-v NOPE"))
+        self.assertEqual(sh("touch /tmp/e; [[ -s /tmp/e ]] || echo empty; echo x > /tmp/e; [[ -s /tmp/e ]] && echo full")[0], "empty\nfull\n")
+
+    def test_in_a_condition_and_with_substitutions(self) -> None:
+        line = 'if [[ $(id -u) -eq 0 && -w /etc ]]; then echo root; else echo user; fi'
+        self.assertEqual(self.out(line), "root\n")
+        self.assertEqual(self.out('while [[ ${#s} -lt 3 ]]; do s=${s}x; done; echo $s'), "xxx\n")
+        self.assertEqual(self.out('case x in x) [[ a == a ]] && echo in-case;; esac'), "in-case\n")
+
+    def test_what_is_only_text_stays_text(self) -> None:
+        self.assertEqual(self.out("echo '[[ a ]]' \"(( b ))\" [[ c ]] # [[ d ]]"), "[[ a ]] (( b )) [[ c ]]\n")
+        self.assertEqual(self.out("cat <<EOF\n[[ not a test ]]\n(( nor this ))\nEOF"), "[[ not a test ]]\n(( nor this ))\n")
+        self.assertEqual(self.out("echo $( [[ a == a ]] && echo inside )"), "inside\n")
+
+    def test_a_malformed_test(self) -> None:
+        # bash refuses it when it reads the line: nothing on the line runs.
+        said = "bash: -c: line 1: unexpected argument `]]' to conditional binary operator\n"
+        self.assertEqual(sh("echo before; [[ a == ]]; echo $?"), ("", said))
+        self.assertEqual(
+            sh("echo before\n[[ a b ]]\necho after"),
+            ("before\n", "bash: -c: line 2: conditional binary operator expected\n"),
+        )
+        self.assertEqual(sh("[[ ]]; echo $?"), ("", ""))
