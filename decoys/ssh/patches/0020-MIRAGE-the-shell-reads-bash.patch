diff --git a/src/cowrie/commands/mirage_builtins.py b/src/cowrie/commands/mirage_builtins.py
new file mode 100644
index 0000000..ab98d69
--- /dev/null
+++ b/src/cowrie/commands/mirage_builtins.py
@@ -0,0 +1,1044 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# ABOUTME: MIRAGE: the bash builtins stock Cowrie lacked (local, return, shift, eval,
+# ABOUTME: source, declare, let, pushd ...) and the evaluators behind [[ ]] and (( )).
+
+"""Builtins of bash 5.2 that scripts rely on, and the commands that
+``cowrie.shell.mirage_syntax`` rewrites ``[[ ]]``, ``(( ))``, ``for ((;;))``
+and ``!`` into.
+
+Stock Cowrie answered ``local``, ``return``, ``shift``, ``eval``, ``source``,
+``declare``, ``readonly``, ``let``, ``pushd`` and ``builtin`` with "command
+not found". A function that uses ``local`` or ``return`` is most functions;
+a script that sources a file or shifts its arguments is most scripts.
+
+Each acts on the shell that ran it (``self.shell``): its variables, its
+positional parameters, its queue of statements. The wording of errors is
+bash's own.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Any, ClassVar
+
+from twisted.internet.defer import Deferred
+
+from cowrie import mirage_state
+from cowrie.commands import fs as stock_fs
+from cowrie.commands.mirage_coreutils import Command_command as _TypeCommand
+from cowrie.shell import arithmetic, mirage_glob, mirage_print, mirage_syntax, mirage_vars
+from cowrie.shell import fs as cfs
+from cowrie.shell.command import HoneyPotCommand
+
+commands = {}
+
+_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
+
+
+class Builtin(HoneyPotCommand):
+    name: ClassVar[str] = ""
+
+    def fail(self, text: str, code: int = 1) -> None:
+        self.errorWrite(f"{self.shell.error_prefix()}{self.name}: {text}\n")
+        self.exit_code = code
+
+    def positional(self) -> list[str]:
+        count = int(self.shell.environ.get("#", "0") or 0)
+        return [self.shell.environ.get(str(i), "") for i in range(1, count + 1)]
+
+    def fixed(self, name: str) -> bool:
+        return name in self.shell.readonly or name in mirage_vars.READONLY
+
+    def assign(self, name: str, value: str, append: bool = False, named: bool = True) -> bool:
+        """Set a variable, unless it is read-only. bash names the builtin in
+        that error for ``declare`` and ``local`` and not for ``export`` and
+        ``readonly`` (``named``)."""
+        if self.fixed(name):
+            if named:
+                self.fail(f"{name}: readonly variable")
+            else:
+                self.errorWrite(f"{self.shell.error_prefix()}{name}: readonly variable\n")
+                self.exit_code = 1
+            return False
+        environ = self.shell.environ
+        environ[name] = self.shell.assigned(name, value, append, environ)
+        return True
+
+    def functions_text(self, names: list[str]) -> str:
+        return "".join(mirage_print.function_text(self.shell, name) + "\n" for name in names)
+
+
+class Later(Builtin):
+    """A builtin whose work needs the shell's expansions, which may wait on a
+    command substitution: it exits when the work is done."""
+
+    def start(self) -> None:
+        d = Deferred.fromCoroutine(self.work())
+        d.addCallbacks(self.done, self.failed)
+
+    async def work(self) -> int:
+        raise NotImplementedError
+
+    def done(self, code: int) -> None:
+        self.exit(code)
+
+    def failed(self, failure: Any) -> None:
+        if failure.check(arithmetic.ArithmeticExpansionError):
+            self.errorWrite(f"{self.shell.error_prefix()}{self.shown}{failure.value}\n")
+        else:
+            self._log.failure("a shell construct failed", failure=failure)
+        self.exit(1)
+
+    shown: ClassVar[str] = ""
+
+    async def number(self, text: str) -> int:
+        expression = await self.shell.bashparser._expand_heredoc(text)
+        return arithmetic.evaluate(
+            expression, self.shell.get_variable, self.shell.set_variable
+        )
+
+
+# ------------------------------------------------------------------- (( )) and for ((;;))
+
+
+class Command_arith(Later):
+    """``(( EXPR ))``: status 0 if it is not zero. With ``-r N`` it is the
+    first part of a ``for ((;;))``, which also makes loop N new."""
+
+    shown = "((: "
+
+    async def work(self) -> int:
+        args = list(self.args)
+        loop = None
+        if args[:1] == ["-r"] and len(args) >= 2:
+            loop, args = args[1], args[2:]
+            self.shell.cfor.discard(loop)
+        text = args[0] if args else ""
+        value = await self.number(text) if text.strip() else 0  # "(( ))" is false
+        return 0 if (value != 0 or loop is not None) else 1
+
+
+class Command_cfor(Later):
+    """The condition of a ``for ((A; B; C))`` rewritten as a ``while``: the
+    step C, on every pass but the first, then the test B (true when empty)."""
+
+    shown = "((: "
+
+    async def work(self) -> int:
+        loop, cond, step = (list(self.args) + ["", "", ""])[:3]
+        if loop in self.shell.cfor:
+            if step.strip():
+                await self.number(step)
+        else:
+            self.shell.cfor.add(loop)
+        if not cond.strip() or await self.number(cond) != 0:
+            return 0
+        self.shell.cfor.discard(loop)
+        return 1
+
+
+class Command_not(Builtin):
+    """The end of a ``! PIPELINE``: its status, turned round."""
+
+    def call(self) -> None:
+        self.exit_code = 0 if self.shell.last_exit_code != 0 else 1
+
+
+# ------------------------------------------------------------------- [[ ]]
+
+
+class _CondError(Exception):
+    pass
+
+
+def _pattern(marked: str) -> re.Pattern[str]:
+    """A [[ == ]] pattern, whose quoted characters carry glob's mark, as a
+    regular expression over the whole string."""
+    return re.compile(mirage_glob.pattern(marked), re.S)
+
+
+class Command_cond(Later):
+    """``[[ EXPR ]]``: status 0 if it is true, 1 if not, 2 if it cannot be read."""
+
+    async def work(self) -> int:
+        self.tokens = mirage_syntax.cond_tokens(self.args[0] if self.args else "")
+        self.at = 0
+        try:
+            value = await self.either()
+            if self.at < len(self.tokens):
+                raise _CondError(self.tokens[self.at])
+        except _CondError as bad:
+            prefix = self.shell.error_prefix()
+            token = str(bad) or "]]"
+            self.errorWrite(
+                f"{prefix}conditional binary operator expected\n"
+                f"{prefix}syntax error near `{token}'\n"
+            )
+            return 2
+        return 0 if value else 1
+
+    def peek(self) -> str | None:
+        return self.tokens[self.at] if self.at < len(self.tokens) else None
+
+    def take(self) -> str:
+        if self.at >= len(self.tokens):
+            raise _CondError("")
+        self.at += 1
+        return self.tokens[self.at - 1]
+
+    async def either(self, run: bool = True) -> bool:
+        value = await self.both(run)
+        while self.peek() == "||":
+            self.at += 1
+            right = await self.both(run and not value)
+            value = value or right
+        return value
+
+    async def both(self, run: bool) -> bool:
+        value = await self.negated(run)
+        while self.peek() == "&&":
+            self.at += 1
+            right = await self.negated(run and value)
+            value = value and right
+        return value
+
+    async def negated(self, run: bool) -> bool:
+        if self.peek() == "!":
+            self.at += 1
+            return not await self.negated(run)
+        if self.peek() == "(":
+            self.at += 1
+            value = await self.either(run)
+            if self.take() != ")":
+                raise _CondError(")")
+            return value
+        first = self.take()
+        if first in mirage_syntax.UNARY:
+            operand = self.take()
+            return await self.unary(first, operand) if run else False
+        if self.peek() in mirage_syntax.BINARY:
+            op = self.take()
+            right = self.take()
+            return await self.binary(first, op, right) if run else False
+        return bool(await self.text(first)) if run else False
+
+    async def text(self, word: str, marks: bool = False) -> str:
+        return str(await self.shell.bashparser.expand_text(word, marks=marks))
+
+    async def unary(self, op: str, word: str) -> bool:
+        value = await self.text(word)
+        if op == "-z":
+            return value == ""
+        if op == "-n":
+            return value != ""
+        if op == "-v":
+            return self.shell.environ.get(value) is not None
+        if op == "-t":
+            return value in ("0", "1", "2") and hasattr(self.protocol.user, "windowSize")
+        path = self.fs.resolve_path(value, self.cwd) if value else ""
+        node = self.fs.getfile(path, follow_symlinks=op not in ("-L", "-h")) if path else None
+        if node is None:
+            return False
+        kind = node[cfs.A_TYPE]
+        mode = int(node[cfs.A_MODE])
+        if op in ("-e", "-a"):
+            return True
+        if op in ("-r", "-w", "-x"):
+            access = mirage_state.Access(self.shell)
+            seen = access.at(path, follow=True)
+            bit = {"-r": 4, "-w": 2, "-x": 1}[op]
+            if seen is None:
+                return False
+            if op == "-x" and access.uid == 0:
+                return seen.kind == "dir" or bool(seen.mode & 0o111)
+            return access.may(seen, bit)
+        checks = {
+            "-f": kind == cfs.T_FILE,
+            "-d": kind == cfs.T_DIR,
+            "-L": kind == cfs.T_LINK,
+            "-h": kind == cfs.T_LINK,
+            "-b": kind == cfs.T_BLK,
+            "-c": kind == cfs.T_CHR,
+            "-p": kind == cfs.T_FIFO,
+            "-S": kind == cfs.T_SOCK,
+            "-s": kind != cfs.T_FILE or int(node[cfs.A_SIZE]) > 0,
+            "-u": bool(mode & 0o4000),
+            "-g": bool(mode & 0o2000),
+            "-k": bool(mode & 0o1000),
+            "-O": int(node[cfs.A_UID]) == int(self.user["uid"]),
+            "-G": int(node[cfs.A_GID]) == int(self.user["gid"]),
+            "-N": False,
+        }
+        return checks.get(op, False)
+
+    async def binary(self, left_word: str, op: str, right_word: str) -> bool:
+        left = await self.text(left_word)
+        if op in ("==", "=", "!="):
+            matched = _pattern(await self.text(right_word, marks=True)).fullmatch(left)
+            return (matched is not None) == (op != "!=")
+        right = await self.text(right_word)
+        if op == "=~":
+            try:
+                return re.search(right, left) is not None
+            except re.error:
+                return False
+        if op == "<":
+            return left < right
+        if op == ">":
+            return left > right
+        if op in ("-nt", "-ot", "-ef"):
+            a = self.fs.getfile(self.fs.resolve_path(left, self.cwd)) if left else None
+            b = self.fs.getfile(self.fs.resolve_path(right, self.cwd)) if right else None
+            if op == "-ef":
+                return a is not None and a is b
+            if a is None or b is None:
+                return (a is not None) if op == "-nt" else (b is not None)
+            newer = float(a[cfs.A_CTIME]) > float(b[cfs.A_CTIME])
+            return newer if op == "-nt" else float(a[cfs.A_CTIME]) < float(b[cfs.A_CTIME])
+        a_num = arithmetic.evaluate(left, self.shell.get_variable)
+        b_num = arithmetic.evaluate(right, self.shell.get_variable)
+        return {
+            "-eq": a_num == b_num,
+            "-ne": a_num != b_num,
+            "-lt": a_num < b_num,
+            "-le": a_num <= b_num,
+            "-gt": a_num > b_num,
+            "-ge": a_num >= b_num,
+        }[op]
+
+
+commands[mirage_syntax.COND] = Command_cond
+commands[mirage_syntax.ARITH] = Command_arith
+commands[mirage_syntax.CFOR] = Command_cfor
+commands[mirage_syntax.NOT] = Command_not
+
+
+# ------------------------------------------------------------------- variables
+
+
+class Command_let(Later):
+    name = "let"
+    shown = "let: "
+
+    async def work(self) -> int:
+        if not self.args:
+            self.errorWrite(f"{self.shell.error_prefix()}let: expression expected\n")
+            return 1
+        value = 0
+        for expression in self.args:
+            value = await self.number(expression)
+        return 0 if value != 0 else 1
+
+
+class Command_shift(Builtin):
+    name = "shift"
+
+    def call(self) -> None:
+        text = self.args[0] if self.args else "1"
+        if not text.lstrip("-").isdigit():
+            self.fail(f"{text}: numeric argument required")
+            return
+        count, params = int(text), self.positional()
+        if count < 0:
+            self.fail(f"{text}: shift count out of range")
+        elif count > len(params):
+            self.exit_code = 1
+        else:
+            self.shell.replace_positional_params(params[count:])
+
+
+class Command_return(Builtin):
+    name = "return"
+
+    def call(self) -> None:
+        if not self.shell.frames:
+            self.fail("can only `return' from a function or sourced script", 2)
+            return
+        text = self.args[0] if self.args else str(self.shell.last_exit_code)
+        if not text.lstrip("-").isdigit():
+            self.fail(f"{text}: numeric argument required", 2)
+        else:
+            self.exit_code = int(text) & 0xFF
+        self.shell.returning = True
+
+
+_ATTRIBUTES = "iluaAnt"
+
+
+class Command_declare(Builtin):
+    """``declare`` and ``typeset``: attributes for variables (-i integer, -l
+    and -u case, -x exported, -r read-only; -a and -A are kept as attributes,
+    this shell having no arrays), -p to print them as bash does, -f and -F
+    for functions. In a function it makes the variable local, unless -g."""
+
+    name = "declare"
+    local: ClassVar[bool] = False
+
+    def call(self) -> None:
+        on, off, names = "", "", []
+        for index, arg in enumerate(self.args):
+            if arg == "--":
+                names.extend(self.args[index + 1 :])
+                break
+            if len(arg) > 1 and arg[0] == "-" and not names:
+                on += arg[1:]
+            elif len(arg) > 1 and arg[0] == "+" and not names:
+                off += arg[1:]
+            else:
+                names.append(arg)
+        if self.local and not self.shell.frames:
+            self.fail("can only be used in a function")
+            return
+        if "f" in on or "F" in on:
+            self.functions(names, bodies="F" not in on)
+            return
+        if "p" in on or not names:
+            self.show(names, on.replace("p", "").replace("g", ""), plain=not self.args)
+            return
+        for arg in names:
+            match = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_]*)(?:(\+?)=(.*))?", arg, re.S)
+            if match is None:
+                self.fail(f"`{arg}': not a valid identifier")
+                continue
+            name, value = match[1], match[3]
+            if (self.local or self.shell.frames) and "g" not in on:
+                frame = self.shell.frames[-1]
+                if name not in frame:
+                    # The value it had before, for when the function is over;
+                    # inside it the variable starts unset.
+                    frame[name] = self.shell.environ.get(name)
+                    if value is None and not self.fixed(name):
+                        self.shell.environ.pop(name, None)
+            if "r" in off and self.fixed(name):
+                self.fail(f"{name}: readonly variable")
+                continue
+            held = self.shell.attributes.get(name, "")
+            for letter in on:
+                if letter in _ATTRIBUTES and letter not in held:
+                    held += letter
+                if letter in "lu":
+                    held = held.replace("u" if letter == "l" else "l", "")
+            held = "".join(c for c in held if c not in off)
+            if held:
+                self.shell.attributes[name] = held
+            else:
+                self.shell.attributes.pop(name, None)
+            if value is not None and not self.assign(name, value, append=bool(match[2])):
+                continue
+            if "x" in on:
+                self.shell.exported.add(name)
+            if "x" in off:
+                self.shell.exported.discard(name)
+            if "r" in on:
+                self.shell.readonly.add(name)
+
+    def functions(self, names: list[str], bodies: bool) -> None:
+        self.shell.load_login_functions()
+        defined = self.shell.functions
+        if not names:
+            if bodies:
+                self.write(self.functions_text(sorted(defined)))
+            else:
+                self.write("".join(f"declare -f {name}\n" for name in sorted(defined)))
+            return
+        for name in names:
+            if name not in defined:
+                self.exit_code = 1
+            elif bodies:
+                self.write(self.functions_text([name]))
+            else:
+                self.write(f"{name}\n")
+
+    def show(self, names: list[str], having: str, plain: bool) -> None:
+        if plain:
+            # declare alone prints what set prints.
+            self.shell.load_login_functions()
+            self.write("".join(f"{line}\n" for line in mirage_vars.set_lines(self.shell)))
+            self.write(self.functions_text(sorted(self.shell.functions)))
+            return
+        table = {var.name: var for var in mirage_vars.variables(self.shell)}
+        if names:
+            for name in names:
+                if name in table:
+                    self.write(mirage_vars.declare_line(table[name]) + "\n")
+                else:
+                    self.fail(f"{name}: not found")
+            return
+        for var in table.values():
+            if all(letter in var.flags for letter in having):
+                self.write(mirage_vars.declare_line(var) + "\n")
+
+
+class Command_local(Command_declare):
+    name = "local"
+    local = True
+
+
+class Command_readonly(Builtin):
+    name = "readonly"
+
+    def call(self) -> None:
+        names = [a for a in self.args if not a.startswith("-")]
+        if not names:
+            for var in mirage_vars.variables(self.shell):
+                if "r" in var.flags:
+                    self.write(mirage_vars.declare_line(var) + "\n")
+            return
+        for arg in names:
+            name, sep, value = arg.partition("=")
+            if not _NAME.fullmatch(name):
+                self.fail(f"`{arg}': not a valid identifier")
+                continue
+            if sep and not self.assign(name, value, named=False):
+                continue
+            self.shell.readonly.add(name)
+
+
+class Command_export(Builtin):
+    """``export``: mark variables for the environment of what the shell runs.
+    With no names it lists them, the ones not yet set included."""
+
+    name = "export"
+
+    def call(self) -> None:
+        flags = "".join(a[1:] for a in self.args if a.startswith("-") and len(a) > 1)
+        names = [a for a in self.args if not a.startswith("-")]
+        if not names:
+            for var in mirage_vars.variables(self.shell):
+                if "x" in var.flags:
+                    self.write(mirage_vars.declare_line(var) + "\n")
+            return
+        for arg in names:
+            match = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_]*)(?:(\+?)=(.*))?", arg, re.S)
+            if "f" in flags:
+                if arg not in self.shell.functions:
+                    self.fail(f"{arg}: not a function")
+                continue
+            if match is None:
+                self.fail(f"`{arg}': not a valid identifier")
+                continue
+            name, value = match[1], match[3]
+            if value is not None and not self.assign(
+                name, value, append=bool(match[2]), named=False
+            ):
+                continue
+            if "n" in flags:
+                self.shell.exported.discard(name)
+            else:
+                self.shell.exported.add(name)
+
+
+class Command_unset(Builtin):
+    """``unset``: a variable, or with -f (or when there is no such variable)
+    a function."""
+
+    name = "unset"
+
+    def call(self) -> None:
+        flags = "".join(a[1:] for a in self.args if a.startswith("-") and len(a) > 1)
+        shell = self.shell
+        for name in (a for a in self.args if not a.startswith("-")):
+            if "f" in flags:
+                shell.functions.pop(name, None)
+                continue
+            if self.fixed(name):
+                self.fail(f"{name}: cannot unset: readonly variable")
+                continue
+            known = name in shell.environ or name in shell.attributes or name in shell.exported
+            if not known and "v" not in flags:
+                shell.functions.pop(name, None)
+            shell.environ.pop(name, None)
+            shell.exported.discard(name)
+            shell.attributes.pop(name, None)
+
+
+class Command_set(Builtin):
+    """``set``: with no arguments, every variable and function, as bash
+    lists them; -o and +o show or change the shell's options; anything else
+    after the options becomes the positional parameters."""
+
+    name = "set"
+
+    def call(self) -> None:
+        shell = self.shell
+        if not self.args:
+            shell.load_login_functions()
+            self.write("".join(f"{line}\n" for line in mirage_vars.set_lines(shell)))
+            self.write(self.functions_text(sorted(shell.functions)))
+            return
+        args = list(self.args)
+        while args:
+            arg = args[0]
+            if arg in ("--", "-"):
+                shell.replace_positional_params(args[1:])
+                return
+            if arg[:1] not in ("-", "+") or len(arg) < 2:
+                shell.replace_positional_params(args)
+                return
+            args.pop(0)
+            turn_on = arg[0] == "-"
+            for letter in arg[1:]:
+                if letter == "o":
+                    if not args or args[0][:1] in ("-", "+"):
+                        self.list_options(as_commands=not turn_on)
+                        continue
+                    option = args.pop(0)
+                    if option not in mirage_vars.OPTIONS:
+                        self.fail(f"{option}: invalid option name")
+                        return
+                elif letter in mirage_vars.LETTERS:
+                    option = mirage_vars.LETTERS[letter]
+                else:
+                    self.fail(f"{arg[0]}{letter}: invalid option", 2)
+                    self.errorWrite(
+                        "set: usage: set [-abefhkmnptuvxBCEHPT] [-o option-name] [--] [-] [arg ...]\n"
+                    )
+                    return
+                (shell.options.add if turn_on else shell.options.discard)(option)
+
+    def list_options(self, as_commands: bool) -> None:
+        for option in mirage_vars.OPTIONS:
+            on = option in self.shell.options
+            if as_commands:
+                self.write(f"set {'-' if on else '+'}o {option}\n")
+            else:
+                self.write(f"{option:<15}\t{'on' if on else 'off'}\n")
+
+
+class Command_shopt(Builtin):
+    """``shopt``: the shell's other options. They are kept and shown; the
+    ones this shell acts on are few (it has no history to append to)."""
+
+    name = "shopt"
+
+    def call(self) -> None:
+        flags = "".join(a[1:] for a in self.args if a.startswith("-") and len(a) > 1)
+        names = [a for a in self.args if not a.startswith("-")]
+        shell = self.shell
+        known = mirage_vars.OPTIONS if "o" in flags else mirage_vars.SHOPTS
+        held = shell.options if "o" in flags else shell.shopts
+        for name in names:
+            if name not in known:
+                self.fail(f"{name}: invalid shell option name")
+        wanted = [n for n in names if n in known]
+        if names and ("s" in flags or "u" in flags):
+            for name in wanted:
+                (held.add if "s" in flags else held.discard)(name)
+            return
+        if not names:
+            wanted = [
+                n for n in known
+                if ("s" not in flags or n in held) and ("u" not in flags or n not in held)
+            ]  # fmt: skip
+        for name in wanted:
+            on = name in held
+            if not on and names:
+                self.exit_code = 1
+            if "q" in flags:
+                continue
+            if "p" in flags:
+                switch = ("-o" if on else "+o") if "o" in flags else ("-s" if on else "-u")
+                self.write(f"{'set' if 'o' in flags else 'shopt'} {switch} {name}\n")
+            else:
+                self.write(f"{name:<15}\t{'on' if on else 'off'}\n")
+
+
+# ------------------------------------------------------------------- running other text
+
+
+class Command_eval(Builtin):
+    name = "eval"
+
+    def call(self) -> None:
+        from cowrie.shell.honeypot import _Continuation
+
+        shell = self.shell
+        text = " ".join(self.args)
+        if text.strip():
+            # In this shell, next: its variables are this shell's. bash reads
+            # the text as input of its own: an expansion it refuses in there
+            # drops the rest of that text's line and no more.
+            base = shell.labels[-1][1] if shell.labels else shell.line_base
+            parsed = shell.bashparser.parse(text, first_line=max(1, shell.current_line - base))
+            shell.cmdpending[0:0] = [
+                *shell.by_lines(parsed),
+                _Continuation(shell._advance, is_line_end=True),
+            ]
+        self.exit_code = 0
+
+
+class Command_source(Builtin):
+    name = "source"
+
+    def call(self) -> None:
+        prefix = self.shell.error_prefix()
+        if not self.args:
+            self.errorWrite(
+                f"{prefix}{self.shown_name}: filename argument required\n"
+                f"{self.shown_name}: usage: {self.shown_name} filename [arguments]\n"
+            )
+            self.exit_code = 2
+            return
+        name = self.args[0]
+        path = self.fs.resolve_path(name, self.cwd)
+        if "/" not in name:
+            # A bare name is looked for along PATH first, then here.
+            for directory in self.environ.get("PATH", "").split(":"):
+                candidate = f"{self.fs.resolve_path(directory, self.cwd)}/{name}"
+                if directory and self.fs.isfile(candidate):
+                    path = candidate
+                    break
+        if self.fs.isdir(path):
+            self.errorWrite(f"{prefix}{self.shown_name}: {name}: is a directory\n")
+            self.exit_code = 1
+            return
+        if not self.fs.exists(path):
+            self.errorWrite(f"{prefix}{name}: No such file or directory\n")
+            self.exit_code = 1
+            return
+        try:
+            mirage_state.Access(self.shell).may_read(path)
+            text = self.fs.file_contents(path).decode("utf8", "replace")
+        except mirage_state.Rejected:
+            self.errorWrite(f"{prefix}{name}: Permission denied\n")
+            self.exit_code = 1
+            return
+        except Exception:
+            text = ""
+        self.exit_code = 0
+        statements = self.shell.bashparser.parse(text) if text.strip() else []
+        # As a call in this shell: its variables stay, `return` ends it, and
+        # arguments given after the name are its positional parameters.
+        # In errors the file is named, with its own line numbers, and an
+        # expansion bash refuses in it ends that line of the file only.
+        self.shell.call_frame(
+            self.shell.by_lines(statements),
+            list(self.args[1:]) or None,
+            label=(name, 0),
+            barrier=True,
+        )
+
+    @property
+    def shown_name(self) -> str:
+        return getattr(self.pp, "argv0", None) or self.name
+
+
+class Command_builtin(Builtin):
+    """``builtin NAME ...`` and ``command NAME ...``: run NAME itself, past
+    any function of that name."""
+
+    name = "builtin"
+    only_builtins: ClassVar[bool] = True
+
+    def start(self) -> None:
+        from cowrie.commands.mirage_coreutils import BUILTINS
+
+        args = list(self.args)
+        while args and args[0] in ("-p", "--"):
+            args.pop(0)
+        if not args:
+            self.exit(0)
+            return
+        name = args[0]
+        if self.only_builtins and name not in BUILTINS:
+            self.fail(f"{name}: not a shell builtin")
+            self.exit()
+            return
+        target = self.protocol.getCommand(name, self.environ.get("PATH", "").split(":"), self.cwd)
+        if target is None:
+            self.errorWrite(f"{self.shell.error_prefix()}{name}: command not found\n")
+            self.exit(127)
+            return
+        self.exec_command(self.pp, target, *args[1:])
+
+
+# ------------------------------------------------------------------- directories
+
+
+class Command_cd(stock_fs.Command_cd):
+    """``cd`` that remembers where it was: ``cd -`` goes back and says where."""
+
+    def call(self) -> None:
+        before = self.shell.cwd
+        back = self.args == ["-"]
+        if back:
+            old = self.shell.environ.get("OLDPWD")
+            if old is None:
+                self.errorWrite(f"{self.shell.error_prefix()}cd: OLDPWD not set\n")
+                self.exit_code = 1
+                return
+            self.args = [old]
+        super().call()
+        if self.shell.cwd != before or (back and self.exit_code == 0):
+            self.shell.environ["OLDPWD"] = before
+            self.shell.exported.add("OLDPWD")
+            if back:
+                self.write(self.shell.cwd + "\n")
+
+
+class _Stack(Builtin):
+    def shown(self) -> str:
+        home = self.shell.environ.get("HOME", "")
+
+        def short(path: str) -> str:
+            if home and (path == home or path.startswith(home + "/")):
+                return "~" + path[len(home) :]
+            return path
+
+        return " ".join(short(p) for p in [self.shell.cwd, *self.shell.dirstack]) + "\n"
+
+    def go(self, path: str, shown: str) -> bool:
+        if not self.fs.exists(path):
+            self.fail(f"{shown}: No such file or directory")
+            return False
+        if not self.fs.isdir(path):
+            self.fail(f"{shown}: Not a directory")
+            return False
+        self.shell.environ["OLDPWD"] = self.shell.cwd
+        self.shell.exported.add("OLDPWD")
+        self.shell.cwd = path
+        return True
+
+
+class Command_pushd(_Stack):
+    name = "pushd"
+
+    def call(self) -> None:
+        stack = self.shell.dirstack
+        if not self.args:
+            if not stack:
+                self.fail("no other directory")
+                return
+            here = self.shell.cwd
+            if self.go(stack[0], stack[0]):
+                stack[0] = here
+                self.write(self.shown())
+            return
+        here = self.shell.cwd
+        if self.go(self.fs.resolve_path(self.args[0], self.cwd), self.args[0]):
+            stack.insert(0, here)
+            self.write(self.shown())
+
+
+class Command_popd(_Stack):
+    name = "popd"
+
+    def call(self) -> None:
+        stack = self.shell.dirstack
+        if not stack:
+            self.fail("directory stack empty")
+            return
+        if self.go(stack[0], stack[0]):
+            stack.pop(0)
+            self.write(self.shown())
+
+
+class Command_dirs(_Stack):
+    name = "dirs"
+
+    def call(self) -> None:
+        self.write(self.shown())
+
+
+# ------------------------------------------------------------------- the rest
+
+
+class Command_alias(Builtin):
+    name = "alias"
+
+    def call(self) -> None:
+        names = [a for a in self.args if a != "-p"]
+        if not names:
+            for name, value in sorted(self.shell.aliases.items()):
+                self.write(f"alias {name}='{value}'\n")
+            return
+        for arg in names:
+            name, sep, value = arg.partition("=")
+            if sep:
+                self.shell.aliases[name] = value
+            elif name in self.shell.aliases:
+                self.write(f"alias {name}='{self.shell.aliases[name]}'\n")
+            else:
+                self.fail(f"{name}: not found")
+
+
+class Command_unalias(Builtin):
+    name = "unalias"
+
+    def call(self) -> None:
+        if not self.args:
+            self.errorWrite("unalias: usage: unalias [-a] name [name ...]\n")
+            self.exit_code = 2
+            return
+        for name in self.args:
+            if name == "-a":
+                self.shell.aliases.clear()
+            elif name in self.shell.aliases:
+                del self.shell.aliases[name]
+            else:
+                self.fail(f"{name}: not found")
+
+
+class Command_hash(Builtin):
+    name = "hash"
+
+    def call(self) -> None:
+        if "-r" in self.args:
+            self.shell.hashed.clear()
+            return
+        if not self.shell.hashed:
+            self.write("hash: hash table empty\n")
+            return
+        self.write("hits\tcommand\n")
+        for path, hits in self.shell.hashed.items():
+            self.write(f"{hits:4d}\t{path}\n")
+
+
+_SIGNALS = (
+    "EXIT HUP INT QUIT ILL TRAP ABRT BUS FPE KILL USR1 SEGV USR2 PIPE ALRM TERM STKFLT CHLD "
+    "CONT STOP TSTP TTIN TTOU URG XCPU XFSZ VTALRM PROF WINCH IO PWR SYS"
+).split()
+_SIGNAL_NUMBERS = {
+    **{name: number for number, name in enumerate(_SIGNALS)},
+    **{f"RTMIN+{i}" if i else "RTMIN": 34 + i for i in range(16)},
+    **{f"RTMAX-{i}" if i else "RTMAX": 64 - i for i in range(15)},
+    "ERR": 66, "DEBUG": 65, "RETURN": 67,
+}  # fmt: skip
+_SIGNAL_NAMES = {number: name for name, number in _SIGNAL_NUMBERS.items()}
+
+
+def signal_name(spec: str) -> str | None:
+    """A signal as ``trap`` lists it (EXIT, SIGINT, ERR ...), from a number
+    or a name with or without SIG; None if there is no such signal."""
+    if spec.isdigit():
+        name = _SIGNAL_NAMES.get(int(spec)) if int(spec) <= 64 else None
+    else:
+        name = spec.upper().removeprefix("SIG")
+        name = name if name in _SIGNAL_NUMBERS else None
+    if name is None:
+        return None
+    return name if name in ("EXIT", "ERR", "DEBUG", "RETURN") else f"SIG{name}"
+
+
+class Command_trap(Builtin):
+    """Traps are kept; the one that fires here is EXIT, when the shell ends."""
+
+    name = "trap"
+
+    def call(self) -> None:
+        args = [a for a in self.args if a != "--"]
+        traps = self.shell.traps
+        if not args or args[0] == "-p":
+            wanted = [signal_name(a) for a in args[1:]]
+            ordered = sorted(traps, key=lambda n: _SIGNAL_NUMBERS[n.removeprefix("SIG")])
+            for signal in ordered:
+                if not wanted or signal in wanted:
+                    action = traps[signal].replace("'", "'\\''")
+                    self.write(f"trap -- '{action}' {signal}\n")
+            return
+        if args[0] == "-l":
+            numbers = [n for n in sorted(_SIGNAL_NAMES) if 1 <= n <= 64]
+            cells = [f"{n:2d}) SIG{_SIGNAL_NAMES[n]}" for n in numbers]
+            for start in range(0, len(cells), 5):
+                self.write("\t".join(cells[start : start + 5]) + "\n")
+            return
+        # One argument, or a first that is a signal number: back to default.
+        if len(args) == 1 or args[0].isdigit():
+            action, signals = "-", args
+        else:
+            action, signals = args[0], args[1:]
+        for spec in signals:
+            signal = signal_name(spec)
+            if signal is None:
+                self.fail(f"{spec}: invalid signal specification")
+            elif action == "-":
+                traps.pop(signal, None)
+            else:
+                traps[signal] = action
+
+
+class Command_wait(Builtin):
+    """``wait``: background jobs have run to their end by the time it is
+    reached (see HoneyPotShell._start_background). With a process ID its
+    status is that job's; a login shell reports its finished jobs here."""
+
+    name = "wait"
+
+    def call(self) -> None:
+        shell = self.shell
+        self.exit_code = 0
+        for arg in self.args:
+            if arg.startswith("-"):
+                continue
+            if not arg.isdigit():
+                continue
+            if int(arg) not in shell.job_status:
+                self.fail(f"pid {arg} is not a child of this shell", 127)
+            else:
+                self.exit_code = shell.job_status[int(arg)]
+        if shell.interactive and shell.jobs:
+            shell.report_jobs(every=True)
+
+
+class Command_typeset(Command_declare):
+    name = "typeset"
+
+
+class Command_dot(Command_source):
+    name = "."
+
+
+class Command_command(_TypeCommand):
+    """``command -v`` and ``-V`` say what a name is (mirage_coreutils); any
+    other use runs the name, past a function of that name."""
+
+    @classmethod
+    def mirage_declines(cls, args: list[str]) -> bool:
+        return False
+
+    def start(self) -> None:
+        if self.args and self.args[0] in ("-v", "-V"):
+            super().start()
+            return
+        args = list(self.args)
+        while args and args[0] in ("-p", "--"):
+            args.pop(0)
+        if not args:
+            self.exit(0)
+            return
+        target = self.protocol.getCommand(args[0], self.environ.get("PATH", "").split(":"), self.cwd)
+        if target is None:
+            self.errorWrite(f"{self.shell.error_prefix()}{args[0]}: command not found\n")
+            self.exit(127)
+            return
+        self.exec_command(self.pp, target, *args[1:])
+
+
+for _name, _class in (
+    ("let", Command_let),
+    ("shift", Command_shift),
+    ("return", Command_return),
+    ("local", Command_local),
+    ("readonly", Command_readonly),
+    ("declare", Command_declare),
+    ("typeset", Command_typeset),
+    ("export", Command_export),
+    ("unset", Command_unset),
+    ("set", Command_set),
+    ("shopt", Command_shopt),
+    ("eval", Command_eval),
+    ("source", Command_source),
+    (".", Command_dot),
+    ("builtin", Command_builtin),
+    ("command", Command_command),
+    ("cd", Command_cd),
+    ("pushd", Command_pushd),
+    ("popd", Command_popd),
+    ("dirs", Command_dirs),
+    ("alias", Command_alias),
+    ("unalias", Command_unalias),
+    ("hash", Command_hash),
+    ("trap", Command_trap),
+    ("wait", Command_wait),
+):
+    commands[_name] = _class
