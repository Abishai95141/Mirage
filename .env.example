# Copied to .env by `make env`, which fills in random values. .env is git-ignored.
CLICKHOUSE_USER=mirage
CLICKHOUSE_PASSWORD=
# Grafana reads ClickHouse as the read-only user "grafana" with this password
CLICKHOUSE_GRAFANA_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Shared by the decoys and the policy service (gate contract v1)
POLICY_TOKEN=
# Load the policy rules the integration tests use. Must be 0 on any exposed sensor.
POLICY_SELFTEST=1
# How long a decoy waits for a decision before answering as plain emulation. The spec's
# target is 50 ms (a Linux host); Docker Desktop's VM stalls for 60-150 ms now and then.
POLICY_TIMEOUT_MS=100
# Set to "lab" only for a bandit explore run; the exploring policy then acts on traffic
# from the lab explore range (198.19.0.0/16). Empty everywhere else.
POLICY_EXPLORE=
# Seed for this deployment's rendered profile (hostname, users, data, honeytokens)
MIRAGE_SEED=

# Host ports, all bound to 127.0.0.1
SSH_PORT=2222
HTTP_PORT=8081
REDIS_PORT=6380
MYSQL_PORT=3307
NATS_PORT=4222
NATS_MONITOR_PORT=8222
CLICKHOUSE_PORT=8123
GRAFANA_PORT=3300
# llama-server runs natively on the host, not in Docker (spike S2)
LLM_PORT=8090
