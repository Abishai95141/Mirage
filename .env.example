# Copied to .env by `make env`, which fills in random values. .env is git-ignored.
CLICKHOUSE_USER=mirage
CLICKHOUSE_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Host ports, all bound to 127.0.0.1
SSH_PORT=2222
NATS_PORT=4222
NATS_MONITOR_PORT=8222
CLICKHOUSE_PORT=8123
GRAFANA_PORT=3300
# llama-server runs natively on the host, not in Docker (spike S2)
LLM_PORT=8090
