     "rawSql": "SELECT start_ts, session_id, protocol, src_ip, inputs, arrayStringConcat(arrayMap(c -> concat(c.1, ' / ', c.2), credentials), ', ') AS credentials, coalesce(nullIf(JSONExtractString(fingerprints, 'client_version'), ''), nullIf(JSONExtractString(fingerprints, 'user_agent'), ''), '') AS client, arrayStringConcat(tokens, ', ') AS honeytokens FROM mirage.session_summary FINAL WHERE actor_id = '${actor}' AND match('${actor}', '^actor-[0-9a-f]{16}$') ORDER BY start_ts"
    }
   ],
