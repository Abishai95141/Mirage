{
 "uid": "mirage-actors",
 "title": "MIRAGE · Actors",
 "description": "Sessions grouped by the links between them: honeytoken use (strongest), SSH fingerprint plus credentials, and the same source within 24 hours (weakest).",
 "tags": [
  "mirage"
 ],
 "timezone": "utc",
 "schemaVersion": 41,
 "version": 1,
 "editable": false,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "links": [
  {
   "type": "dashboards",
   "tags": [
    "mirage"
   ],
   "asDropdown": false,
   "includeVars": false,
   "keepTime": true,
   "title": "MIRAGE"
  }
 ],
 "templating": {
  "list": [
   {
    "type": "textbox",
    "name": "actor",
    "label": "Actor ID",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    },
    "hide": 0
   }
  ]
 },
 "panels": [
  {
   "type": "table",
   "title": "Actors",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT actor_id, count() AS sessions, arrayStringConcat(arraySort(groupUniqArray(protocol)), ', ') AS protocols, uniqExact(src_ip) AS sources, min(start_ts) AS first_seen, max(end_ts) AS last_seen, sum(inputs) AS inputs, countIf(auth_success = 1) AS logins, length(groupUniqArrayArray(tokens)) AS honeytokens FROM mirage.session_summary FINAL WHERE $__timeFilter(start_ts) GROUP BY actor_id ORDER BY length(groupUniqArrayArray(tokens)) DESC, sessions DESC LIMIT 500"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true,
      "minWidth": 90
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(ts|start_ts|end_ts|stored_at|first_seen|last_seen|last|last_used|published_at)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 185
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(session_id|actor_id|a|b|exposed_in|token_id|request_id)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 215
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(sha256)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 270
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(source|protocol|outcome|type|action|reason|mime|kind|tactic|split|mode|gate)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 115
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(class|src_ip|sensor|rule_id|location|used_in|predicted_class|actor_class|decided_by|technique)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 150
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(seq|inputs|decisions|fallbacks|tokens|artifacts|logged_in|strength|times|size|n_sessions|sessions|attempts|succeeded|exposures|uses|logins|sources|honeytokens|auth_attempts|duration_s|latency_us|status|confidence|class_confidence|agreement|scenarios|steps|matched|procedures|techniques_seen|value|ci_low|ci_high|baseline|delta)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 95
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "actor_id"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open actor",
          "url": "/d/mirage-actors/mirage-actors?var-actor=${__value.raw}&${__url_time_range}"
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "id": 1,
   "gridPos": {
    "x": 0,
