  {
   "type": "nodeGraph",
   "title": "Selected actor: sessions and links",
   "description": "Nodes are sessions; edges are links, labelled with their reason.",
   "targets": [
    {
     "refId": "nodes",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT session_id AS id, protocol AS title, src_ip AS subtitle, concat(toString(inputs), ' in') AS mainstat, formatDateTime(start_ts, '%d %b %H:%i') AS secondarystat FROM mirage.session_summary FINAL WHERE actor_id = '${actor}' AND match('${actor}', '^actor-[0-9a-f]{16}$') LIMIT 300"
    },
    {
     "refId": "edges",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT concat(a, '|', b, '|', reason) AS id, a AS source, b AS target, reason AS mainstat FROM mirage.actor_links FINAL WHERE a IN (SELECT session_id FROM mirage.session_summary FINAL WHERE actor_id = '${actor}' AND match('${actor}', '^actor-[0-9a-f]{16}$')) LIMIT 1000"
    }
   ],
