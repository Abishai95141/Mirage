     "format": 1,
     "rawSql": "SELECT ts, JSONExtractString(payload, 'request', 'request_id') AS request_id, JSONExtractString(payload, 'command') AS input, JSONExtractString(policy, 'action') AS action, JSONExtractString(payload, 'rule_id') AS rule_id, JSONExtractString(payload, 'rules_version') AS rules_version, JSONExtractInt(payload, 'latency_us') AS latency_us FROM mirage.events FINAL WHERE source = 'policy' AND session_id IN (SELECT arrayJoin(connections) FROM mirage.session_summary FINAL WHERE session_id = '${session}' AND match('${session}', '^[A-Za-z0-9._-]{1,64}$') UNION ALL SELECT '${session}' WHERE match('${session}', '^[A-Za-z0-9._-]{1,64}$')) ORDER BY ts"
