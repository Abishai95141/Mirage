     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT actor_id, sensor, decisions, fallbacks, arrayStringConcat(arrayMap(c -> concat(c.1, ' / ', c.2), credentials), ', ') AS credentials, fingerprints, arrayStringConcat(tokens, ', ') AS honeytokens, arrayStringConcat(artifacts, ', ') AS artifacts, arrayStringConcat(connections, ', ') AS connections FROM mirage.session_summary FINAL WHERE session_id = '${session}' AND match('${session}', '^[A-Za-z0-9._-]{1,64}$')"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true,
      "minWidth": 90
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(ts|start_ts|stored_at|first_seen|last_seen|last|last_used)$"
      },
