  {
   "type": "table",
   "title": "Timeline",
   "description": "Every event in order. A policy_decision row precedes the input it decided.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT ts, action, multiIf(\n    class = 'policy_decision', concat(JSONExtractString(payload, 'action'),\n        if(JSONExtractBool(payload, 'fallback'),\n           concat(' (fallback: ', JSONExtractString(payload, 'fallback_reason'), ')'), ''),\n        '  ·  rule ', JSONExtractString(payload, 'rule_id'),\n        '  ·  ', toString(JSONExtractFloat(payload, 'latency_ms')), ' ms'),\n    class = 'authentication', concat(JSONExtractString(payload, 'username'), ' / ',\n        JSONExtractString(payload, 'password')),\n    class = 'http_activity', concat(JSONExtractString(payload, 'method'), ' ',\n        JSONExtractString(payload, 'target'), '  →  ', toString(JSONExtractInt(payload, 'status'))),\n    action = 'token_triggered', concat('honeytoken ', JSONExtractString(payload, 'token_id'),\n        ' (planted at ', JSONExtractString(payload, 'planted_at'), ')'),\n    action = 'fs_change', concat(JSONExtractString(payload, 'op'), ' ',\n        JSONExtractString(payload, 'path'), ' ', JSONExtractString(payload, 'sha256')),\n    JSONHas(payload, 'command'), JSONExtractString(payload, 'command'),\n    JSONHas(payload, 'sha256'), concat(JSONExtractString(payload, 'filename'),\n        JSONExtractString(payload, 'destfile'), ' ', JSONExtractString(payload, 'sha256')),\n    JSONHas(payload, 'client_version'), JSONExtractString(payload, 'client_version'),\n    JSONHas(payload, 'hassh'), concat('hassh ', JSONExtractString(payload, 'hassh')),\n    '') AS detail, outcome, class, source, JSONExtractInt(payload, 'seq') AS seq FROM mirage.events FINAL WHERE session_id IN (SELECT arrayJoin(connections) FROM mirage.session_summary FINAL WHERE session_id = '${session}' AND match('${session}', '^[A-Za-z0-9._-]{1,64}$') UNION ALL SELECT '${session}' WHERE match('${session}', '^[A-Za-z0-9._-]{1,64}$')) AND source != 'policy' ORDER BY ts, seq"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true,
      "minWidth": 90
     }
    },
    "overrides": [
