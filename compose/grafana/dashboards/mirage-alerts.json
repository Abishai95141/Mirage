  {
   "type": "table",
   "title": "Tactic heatmap: by predicted actor class",
   "description": "Sessions in which the tagger found each tactic, by the class the actor classifier predicted for the session. Both are model output (mirage.labels, mirage.actor_class), not the lab's ground truth.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT t.tactic AS tactic, uniqExactIf(t.lsid, ac.cls = 'scanner') AS scanner, uniqExactIf(t.lsid, ac.cls = 'scripted_bot') AS scripted_bot, uniqExactIf(t.lsid, ac.cls = 'human') AS human, uniqExactIf(t.lsid, ac.cls NOT IN ('', 'scanner', 'scripted_bot', 'human')) AS other_class, uniqExactIf(t.lsid, ac.cls = '') AS not_classified FROM (SELECT DISTINCT if(m.session_id != '', m.session_id, l.session_id) AS lsid, l.tactic AS tactic, l.technique AS technique FROM (SELECT session_id, tactic, technique FROM mirage.labels FINAL WHERE technique != '' AND $__timeFilter(ts)) AS l LEFT JOIN (SELECT conn_id, session_id FROM mirage.session_map FINAL) AS m ON m.conn_id = l.session_id) AS t LEFT JOIN (SELECT if(cm.session_id != '', cm.session_id, a.session_id) AS lsid, argMax(a.actor_class, a.ts) AS cls, argMax(a.confidence, a.ts) AS cls_confidence, argMax(a.decided_by, a.ts) AS cls_decided_by FROM (SELECT session_id, actor_class, confidence, decided_by, ts FROM mirage.actor_class FINAL WHERE 1) AS a LEFT JOIN (SELECT conn_id, session_id FROM mirage.session_map FINAL) AS cm ON cm.conn_id = a.session_id GROUP BY lsid) AS ac ON ac.lsid = t.lsid GROUP BY tactic ORDER BY tactic"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": false,
      "minWidth": 90,
      "align": "center",
      "cellOptions": {
       "type": "color-background",
       "mode": "basic"
      }
     },
     "color": {
      "mode": "continuous-YlRd"
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(ts|start_ts|end_ts|stored_at|first_seen|last_seen|last|last_used|published_at)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 185
       }
      ]
     },
     {
