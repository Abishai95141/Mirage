  {
   "type": "stat",
   "title": "Sessions labelled",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT uniqExact(session_id) FROM mirage.labels FINAL WHERE technique != '' AND $__timeFilter(ts)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "noValue": "0"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/.*/",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 4,
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   }
  },
  {
   "type": "table",
   "title": "Recent alerts",
   "description": "One row per session that triggered; newest first.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT end_ts, session_id, src_ip, protocol, arrayStringConcat(reasons, ', ') AS reasons, arrayStringConcat(techniques, ', ') AS techniques, inputs FROM mirage.alerts FINAL WHERE $__timeFilter(end_ts) ORDER BY end_ts DESC LIMIT 200"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true,
      "minWidth": 90
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(ts|start_ts|stored_at|first_seen|last_seen|last|last_used)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 185
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(session_id|actor_id|a|b|exposed_in|token_id|request_id)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 215
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(sha256)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 270
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(source|protocol|outcome|type|action|reason|mime)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 115
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(class|src_ip|sensor|rule_id|location|used_in)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 150
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(seq|inputs|decisions|fallbacks|tokens|artifacts|logged_in|strength|times|size|n_sessions|sessions|attempts|succeeded|exposures|uses|logins|sources|honeytokens|auth_attempts|duration_s|latency_us|status)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 95
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "session_id"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open session",
          "url": "/d/mirage-session/mirage-session?var-session=${__value.raw}&${__url_time_range}"
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "id": 5,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   }
  },
  {
   "type": "piechart",
   "title": "Alerts by reason",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT arrayJoin(reasons) AS reason, count() AS n FROM mirage.alerts FINAL WHERE $__timeFilter(end_ts) GROUP BY reason"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": true
    },
    "pieType": "donut",
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "values": [
      "value"
     ]
    }
   },
   "id": 6,
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   }
  },
  {
   "type": "timeseries",
   "title": "Tactics over time",
   "description": "The heatmap of attacker progression: labelled inputs per tactic over time.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "rawSql": "SELECT $__timeInterval(ts) AS time, tactic, count() AS labels FROM mirage.labels FINAL WHERE technique != '' AND $__timeFilter(ts) GROUP BY time, tactic ORDER BY time"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 70,
      "stacking": {
       "mode": "normal"
      },
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "id": 7,
   "gridPos": {
    "x": 8,
    "y": 12,
    "w": 16,
    "h": 8
   },
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   }
  },
  {
   "type": "barchart",
   "title": "Top techniques",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT technique, count() AS labels FROM mirage.labels FINAL WHERE technique != '' AND $__timeFilter(ts) GROUP BY technique ORDER BY labels DESC LIMIT 25"
    }
   ],
   "options": {
    "orientation": "horizontal",
    "showValue": "auto",
    "legend": {
     "showLegend": false
    }
   },
   "id": 8,
   "gridPos": {
