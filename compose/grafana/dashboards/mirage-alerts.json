  {
   "type": "heatmap",
   "title": "Tactic heatmap: by day",
   "description": "Sessions in which the tagger found each ATT&CK tactic, per day (UTC). Widen the time range to see more days.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "rawSql": "SELECT time, tactic, sessions FROM (SELECT toStartOfDay(t.day_ts) AS time, t.tactic AS tactic, uniqExact(t.lsid) AS sessions FROM (SELECT if(m.session_id != '', m.session_id, l.session_id) AS lsid, l.tactic AS tactic, l.ts AS day_ts FROM (SELECT session_id, tactic, ts FROM mirage.labels FINAL WHERE technique != '' AND $__timeFilter(ts)) AS l LEFT JOIN (SELECT conn_id, session_id FROM mirage.session_map FINAL) AS m ON m.conn_id = l.session_id) AS t GROUP BY time, tactic ORDER BY tactic, time WITH FILL FROM toStartOfDay($__fromTime) - INTERVAL 1 DAY TO $__toTime STEP INTERVAL 1 DAY) ORDER BY time, tactic"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byType",
       "options": "number"
      },
      "properties": [
       {
        "id": "displayName",
        "value": "${__field.labels.tactic}"
       }
      ]
     }
    ]
   },
   "options": {
    "calculate": false,
    "cellGap": 2,
    "color": {
     "mode": "scheme",
     "scheme": "Oranges",
     "fill": "dark-orange",
     "scale": "exponential",
     "exponent": 0.5,
     "steps": 64,
     "reverse": false
    },
    "yAxis": {
     "axisPlacement": "left",
     "reverse": false
    },
    "rowsFrame": {
     "layout": "auto"
    },
    "cellValues": {
     "unit": "short"
    },
    "filterValues": {
     "le": 1e-09
    },
    "showValue": "auto",
    "legend": {
     "show": true
    },
    "tooltip": {
     "mode": "single",
     "yHistogram": false,
     "showColorScale": true
    },
    "exemplars": {
     "color": "rgba(255,0,255,0.7)"
    }
   },
   "id": 8,
   "gridPos": {
    "x": 8,
    "y": 20,
    "w": 16,
    "h": 8
