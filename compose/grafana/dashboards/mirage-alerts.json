  {
   "type": "table",
   "title": "Actor alerts",
   "description": "One row per actor: every session, address and predicted class the links group under it, so an attack that moves between addresses is one alert. session_id opens the actor's first session; actor_id opens the actor.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT end_ts, actor_id, length(session_ids) AS sessions, arrayStringConcat(src_ips, ', ') AS src_ips, arrayStringConcat(protocols, ', ') AS protocols, arrayStringConcat(actor_classes, ', ') AS actor_classes, arrayStringConcat(reasons, ', ') AS reasons, arrayStringConcat(tactics, ', ') AS tactics, arrayStringConcat(techniques, ', ') AS techniques, arrayStringConcat(tokens, ', ') AS honeytokens, length(artifacts) AS n_artifacts, inputs, session_ids[1] AS session_id, arrayStringConcat(session_ids, ', ') AS all_sessions, start_ts FROM (SELECT * FROM mirage.actor_alerts FINAL WHERE notEmpty(reasons) AND $__timeFilter(end_ts)) ORDER BY end_ts DESC LIMIT 200"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true,
      "minWidth": 90
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(ts|start_ts|end_ts|stored_at|first_seen|last_seen|last|last_used|published_at)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 185
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(session_id|actor_id|a|b|exposed_in|token_id|request_id)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 215
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(sha256)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 270
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(source|protocol|outcome|type|action|reason|mime|kind|tactic|split|mode|gate)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 115
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(class|src_ip|sensor|rule_id|location|used_in|predicted_class|actor_class|decided_by|technique)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 150
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(seq|inputs|decisions|fallbacks|tokens|artifacts|logged_in|strength|times|size|n_sessions|sessions|attempts|succeeded|exposures|uses|logins|sources|honeytokens|auth_attempts|duration_s|latency_us|status|confidence|class_confidence|agreement|scenarios|steps|matched|procedures|techniques_seen|value|ci_low|ci_high|baseline|delta)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 95
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "session_id"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open session",
          "url": "/d/mirage-session/mirage-session?var-session=${__value.raw}&${__url_time_range}"
         }
        ]
       }
      ]
     },
     {
      "matcher": {
