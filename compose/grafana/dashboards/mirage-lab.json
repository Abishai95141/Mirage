  {
   "type": "table",
   "title": "Runs",
   "description": "Every lab run and its join health.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT ended_ts, run_id, mode, sessions, matched, no_event, mismatch, not_run, connections, connections_unmatched FROM mirage.sim_runs FINAL WHERE final = 1 AND $__timeFilter(ended_ts) ORDER BY ended_ts DESC LIMIT 200"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true,
      "minWidth": 90
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(ts|start_ts|stored_at|first_seen|last_seen|last|last_used)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 185
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(session_id|actor_id|a|b|exposed_in|token_id|request_id)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 215
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(sha256)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 270
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(source|protocol|outcome|type|action|reason|mime)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 115
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(class|src_ip|sensor|rule_id|location|used_in)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 150
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(seq|inputs|decisions|fallbacks|tokens|artifacts|logged_in|strength|times|size|n_sessions|sessions|attempts|succeeded|exposures|uses|logins|sources|honeytokens|auth_attempts|duration_s|latency_us|status)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 95
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
