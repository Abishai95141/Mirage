  {
   "type": "table",
   "title": "Artifacts",
   "description": "session_id is the first session the hash appeared in.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT stored_at, sha256, size, mime, source, first_seen, last_seen, sessions[1] AS session_id, length(sessions) AS n_sessions FROM mirage.artifacts WHERE $__timeFilter(stored_at) ORDER BY stored_at DESC LIMIT 500"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true,
      "minWidth": 90
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(ts|start_ts|end_ts|stored_at|first_seen|last_seen|last|last_used|published_at)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 185
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(session_id|actor_id|a|b|exposed_in|token_id|request_id)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 215
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(sha256)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 270
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(source|protocol|outcome|type|action|reason|mime|kind|tactic|split|mode|gate)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 115
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(class|src_ip|sensor|rule_id|location|used_in|predicted_class|actor_class|decided_by|technique)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 150
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(seq|inputs|decisions|fallbacks|tokens|artifacts|logged_in|strength|times|size|n_sessions|sessions|attempts|succeeded|exposures|uses|logins|sources|honeytokens|auth_attempts|duration_s|latency_us|status|confidence|class_confidence|agreement|scenarios|steps|matched|procedures|techniques_seen|value|ci_low|ci_high|baseline|delta)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 95
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "session_id"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open session",
          "url": "/d/mirage-session/mirage-session?var-session=${__value.raw}&${__url_time_range}"
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
