  {
   "type": "stat",
   "title": "Seen in sessions",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT uniqExact(s) FROM (SELECT arrayJoin(sessions) AS s FROM mirage.artifacts WHERE $__timeFilter(stored_at))"
