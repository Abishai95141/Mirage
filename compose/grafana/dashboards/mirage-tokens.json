     "editorType": "sql",
     "format": 0,
     "rawSql": "SELECT $__timeInterval(ts) AS time, JSONExtractString(payload, 'token_type') AS type, count() AS uses FROM mirage.events FINAL WHERE action = 'token_triggered' AND $__timeFilter(ts) GROUP BY time, type ORDER BY time"
