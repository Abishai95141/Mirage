  {
   "type": "stat",
   "title": "Shadow agreement",
   "description": "Share of decisions where the shadow policy's most probable action is the action that was taken.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT avg(preferred = taken) FROM (SELECT ts, JSONExtractBool(payload, 'explore') AS explored, JSONExtractString(payload, 'shadow', 'name') AS shadow, JSONExtractString(payload, 'shadow', 'version') AS shadow_version, JSONExtractString(payload, 'acting', 'action') AS taken, arrayReverseSort(x -> x.2, JSONExtractKeysAndValues(payload, 'shadow', 'probs', 'Float64'))[1].1 AS preferred FROM mirage.events WHERE source = 'policy' AND $__timeFilter(ts) AND JSONHas(payload, 'shadow', 'probs'))"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     },
     "noValue": "0"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/.*/",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "id": 10,
   "gridPos": {
