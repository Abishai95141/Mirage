  {
   "type": "timeseries",
   "title": "Shadow agreement over time",
   "description": "The same share over time, apart for decisions the exploring policy made and decisions the rules made. An explored decision departs from the rules' action about as often as the policy explores, so its agreement with any shadow is lower by design.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 0,
     "rawSql": "SELECT $__timeInterval(ts) AS time, if(explored, 'explored', 'rules decided') AS mode, avg(preferred = taken) AS agreement FROM (SELECT ts, JSONExtractBool(payload, 'explore') AS explored, JSONExtractString(payload, 'shadow', 'name') AS shadow, JSONExtractString(payload, 'shadow', 'version') AS shadow_version, JSONExtractString(payload, 'acting', 'action') AS taken, arrayReverseSort(x -> x.2, JSONExtractKeysAndValues(payload, 'shadow', 'probs', 'Float64'))[1].1 AS preferred FROM mirage.events WHERE source = 'policy' AND $__timeFilter(ts) AND JSONHas(payload, 'shadow', 'probs')) GROUP BY time, mode ORDER BY time"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "lineWidth": 1
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "id": 11,
   "gridPos": {
    "x": 6,
    "y": 20,
    "w": 18,
    "h": 8
   },
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   }
  },
  {
   "type": "table",
   "title": "Shadow policies",
   "description": "Which policy shadowed. 'shadow-fallback(epsilon-greedy)' means no trained model was loaded: the service says so instead of naming a model.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "rawSql": "SELECT shadow, shadow_version, if(explored, 'explored', 'rules decided') AS mode, count() AS decisions, round(avg(preferred = taken), 3) AS agreement, max(ts) AS last FROM (SELECT ts, JSONExtractBool(payload, 'explore') AS explored, JSONExtractString(payload, 'shadow', 'name') AS shadow, JSONExtractString(payload, 'shadow', 'version') AS shadow_version, JSONExtractString(payload, 'acting', 'action') AS taken, arrayReverseSort(x -> x.2, JSONExtractKeysAndValues(payload, 'shadow', 'probs', 'Float64'))[1].1 AS preferred FROM mirage.events WHERE source = 'policy' AND $__timeFilter(ts) AND JSONHas(payload, 'shadow', 'probs')) GROUP BY shadow, shadow_version, mode ORDER BY last DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true,
      "minWidth": 90
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(ts|start_ts|end_ts|stored_at|first_seen|last_seen|last|last_used|published_at)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 185
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(session_id|actor_id|a|b|exposed_in|token_id|request_id)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 215
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(sha256)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 270
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(source|protocol|outcome|type|action|reason|mime|kind|tactic|split|mode|gate)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 115
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(class|src_ip|sensor|rule_id|location|used_in|predicted_class|actor_class|decided_by|technique)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 150
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(seq|inputs|decisions|fallbacks|tokens|artifacts|logged_in|strength|times|size|n_sessions|sessions|attempts|succeeded|exposures|uses|logins|sources|honeytokens|auth_attempts|duration_s|latency_us|status|confidence|class_confidence|agreement|scenarios|steps|matched|procedures|techniques_seen|value|ci_low|ci_high|baseline|delta)$"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 95
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
